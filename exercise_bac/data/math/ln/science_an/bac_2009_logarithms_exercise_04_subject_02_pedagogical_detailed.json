            "title": "كتابة المساحة",
            "explanation": "\\[A=\\int_0^1[(x-1)-f(x)]dx.\\]"
          },
          {
            "step_number": 2,
            "title": "تبسيط الفرق",
            "explanation": "\\[(x-1)-f(x)=\\frac{\\ln(x+1)}{x+1}.\\]"
          },
