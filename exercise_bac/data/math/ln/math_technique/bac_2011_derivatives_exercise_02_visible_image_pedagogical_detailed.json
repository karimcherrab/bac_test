  "statement": "التمرين الثاني: (06 نقاط)\nf دالة عددية معرفة على ]0;+∞[ كما يلي:\n\\[f(x)=\\frac{a+b\\ln 2x}{4x^2}\\]\nحيث a و b عددان حقيقيان، و(C_f) المنحنى الممثل لها في المستوى المنسوب إلى المعلم المتعامد والمتجانس (O;i,j).\n1/ عين a و b بحيث يكون المماس في النقطة \\[A\\left(\\frac12;1\\right)\\] للمنحنى (C_f) موازيا لحامل محور الفواصل.\n2/ الدالة العددية g المعرفة على ]0;+∞[ كما يلي:\n\\[g(x)=\\frac{1+2\\ln 2x}{4x^2}\\]\nو(C_g) المنحنى الممثل لها في المعلم السابق.",
  "figures": [],
  "questions": [
    {
      "id": "2011_der_ex02_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1/ عين \\(a\\) و \\(b\\) بحيث يكون المماس في النقطة \\(A\\left(\\frac12;1\\right)\\) للمنحنى \\((C_f)\\) موازيا لحامل محور الفواصل.",
      "solution": {
        "strategy": "نستعمل أن A تنتمي إلى المنحنى، وأن المماس الأفقي ميله صفر.",
        "steps": [
          {
            "step_number": 1,
            "title": "شرط انتماء A إلى المنحنى",
            "explanation": "لدينا \\(f(\\frac12)=1\\). وبما أن \\(\\ln(2\\times\\frac12)=\\ln1=0\\):\\[f\\left(\\frac12\\right)=a\\]",
            "result": "\\[a=1\\]"
          },
          {
            "step_number": 2,
            "title": "نحسب مشتقة f",
            "explanation": "من أجل \\(x>0\\):\\[f'(x)=\\frac{b-2a-2b\\ln(2x)}{4x^3}\\]"
          },
          {
            "step_number": 3,
            "title": "شرط المماس الأفقي",
            "explanation": "المماس موازي لمحور الفواصل، إذن:\\[f'\\left(\\frac12\\right)=0\\] ومع \\(a=1\\) و\\(\\ln1=0\\):\\[b-2=0\\]",
            "result": "\\[b=2\\]"
          }
        ],
        "final_answer": "\\[\\boxed{a=1,\\qquad b=2}\\]",
        "verification": "نجد \\(f(\\frac12)=1\\) و\\(f'(\\frac12)=0\\)، وهو مطابق للتصحيح الرسمي.",
        "common_mistakes": [
          "استعمال شرط f(1/2)=0 بدل f(1/2)=1.",
          "نسيان أن المماس الموازي لمحور الفواصل يعني f'(1/2)=0."
        ],
        "hints": [
          "استعمل شرطي: A تنتمي إلى المنحنى، وميل المماس يساوي صفرًا."
        ],
        "introduction": "لدينا شرطان يسمحان بتحديد العددين a وb.",
        "summary": "من شرط الانتماء نحصل على a=1، ومن شرط المماس الأفقي نحصل على b=2.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2011_der_ex02_q2a",
      "display_order": 2,
      "content_type": "question",
      "text": "2/ أ) احسب \\(\\displaystyle\\lim_{x\\to0^+}g(x)\\) و \\(\\displaystyle\\lim_{x\\to+\\infty}g(x)\\)، فسر النتيجتين هندسيا.",
      "solution": {
        "strategy": "نحسب النهايتين ثم نستخرج المستقيمين المقاربين.",
        "steps": [
          {
            "step_number": 1,
            "title": "النهاية عند 0 من اليمين",
            "explanation": "عندما \\(x\\to0^+\\)، فإن \\(\\ln(2x)\\to-\\infty\\)، والبسط \\(1+2\\ln(2x)\\to-\\infty\\)، بينما \\(4x^2\\to0^+\\).",
            "result": "\\[\\lim_{x\\to0^+}g(x)=-\\infty\\]"
          },
          {
            "step_number": 2,
            "title": "التفسير الهندسي الأول",
            "explanation": "بما أن النهاية غير منتهية عند 0 من اليمين:",
            "result": "\\[x=0\\] مستقيم مقارب عمودي لـ\\((C_g)\\)."
          },
          {
            "step_number": 3,
            "title": "النهاية عند +∞",
            "explanation": "لدينا \\(\\frac{\\ln x}{x^2}\\to0\\)، ومنه:",
            "result": "\\[\\lim_{x\\to+\\infty}g(x)=0\\]"
          },
          {
            "step_number": 4,
            "title": "التفسير الهندسي الثاني",
            "explanation": "إذن:",
            "result": "\\[y=0\\] مستقيم مقارب أفقي لـ\\((C_g)\\) عند \\(+\\infty\\)."
          }
        ],
        "final_answer": "\\[\\lim_{x\\to0^+}g(x)=-\\infty,\\qquad \\lim_{x\\to+\\infty}g(x)=0\\] والمقاربان هما \\(x=0\\) و\\(y=0\\).",
        "verification": "مطابق للتصحيح الرسمي في الصفحة 5.",
        "common_mistakes": [
          "كتابة y=0 كمقارب عمودي.",
          "نسيان أن الاقتراب من 0 يكون من الجهة اليمنى فقط."
        ],
        "hints": [
          "مجال g هو ]0,+∞[، لذلك ندرس x→0⁺."
        ],
        "introduction": "النهايتان تعطينا سلوك المنحنى عند طرفي مجال التعريف.",
        "summary": "مقارب عمودي x=0 ومقارب أفقي y=0.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2011_der_ex02_q2b",
      "display_order": 3,
      "content_type": "question",
      "text": "2/ ب) ادرس اتجاه تغير الدالة \\(g\\) ثم شكل جدول تغيراتها.",
      "solution": {
        "strategy": "نحسب المشتقة ثم ندرس إشارة -ln(2x).",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب المشتقة",
            "explanation": "\\[g'(x)=-\\frac{\\ln(2x)}{x^3}\\]",
            "result": "\\[g'(x)=-\\frac{\\ln(2x)}{x^3}\\]"
          },
          {
            "step_number": 2,
            "title": "إشارة المشتقة",
            "explanation": "لأن \\(x^3>0\\) على المجال، فإن إشارة \\(g'(x)\\) هي عكس إشارة \\(\\ln(2x)\\). ومن ثم \\(g'(x)>0\\) إذا \\(0<x<\\frac12\\)، وتنعدم عند \\(x=\\frac12\\)، وتكون سالبة إذا \\(x>\\frac12\\)."
          },
          {
            "step_number": 3,
            "title": "القيمة العظمى",
            "explanation": "\\[g\\left(\\frac12\\right)=1\\]",
            "result": "\\(g\\) تبلغ قيمة عظمى تساوي 1 عند \\(x=\\frac12\\)."
          }
        ],
        "variation_table": {
          "type": "variation_table",
