    {
      "id": "2011_der_ex02_q2c",
      "display_order": 4,
      "content_type": "question",
      "text": "2/ ج) حل في \\(]0;+\\infty[\\) المعادلة \\(g(x)=0\\).",
      "solution": {
        "strategy": "بما أن المقام موجب، نحل معادلة البسط.",
        "steps": [
          {
            "step_number": 1,
            "title": "نساوي البسط بالصفر",
            "explanation": "\\[g(x)=0\\iff1+2\\ln(2x)=0\\]"
          },
          {
            "step_number": 2,
            "title": "نعزل اللوغاريتم",
            "explanation": "\\[\\ln(2x)=-\\frac12\\]"
          },
          {
            "step_number": 3,
            "title": "نستعمل الأسية",
            "explanation": "\\[2x=e^{-1/2}=\\frac1{\\sqrt e}\\]",
            "result": "\\[x=\\frac1{2\\sqrt e}=\\frac{\\sqrt e}{2e}\\]"
          }
        ],
        "final_answer": "\\[\\boxed{x=\\frac1{2\\sqrt e}}\\]",
        "verification": "مطابق للتصحيح الرسمي الذي يكتبها \\(\\frac{\\sqrt e}{2e}\\).",
        "common_mistakes": [
          "نسيان العامل 2 داخل ln(2x)."
        ],
        "hints": [
          "حل 1+2ln(2x)=0."
        ],
        "introduction": "المقام لا ينعدم على المجال، لذلك يكفي حل البسط.",
        "summary": "الحل الوحيد هو 1/(2√e).",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
