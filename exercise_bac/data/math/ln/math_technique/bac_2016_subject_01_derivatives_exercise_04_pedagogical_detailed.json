  "statement": "التمرين الرابع: (07 نقاط)\nI) الدالة العددية g المعرفة على المجال ]-1;+∞[ كما يلي:\n\\[g(x)=\\frac{x-1}{x+1}+\\ln(x+1)\\]\nII) الدالة العددية f المعرفة على المجال ]-1;+∞[ كما يلي:\n\\[f(x)=1+(x-1)\\ln(x+1)\\]",
  "figures": [],
  "questions": [
    {
      "id": "2016_s1_ex04_q1a",
      "display_order": 1,
      "content_type": "question",
      "text": "I-1) أ- احسب \\(\\lim_{x\\to-1^+}g(x)\\) و \\(\\lim_{x\\to+\\infty}g(x)\\).",
      "solution": {
        "strategy": "نحسب النهايتين مباشرة من عبارة g.",
        "steps": [
          {
            "step_number": 1,
            "title": "عند -1 من اليمين",
            "explanation": "\\(\\frac{x-1}{x+1}\\to-\\infty\\) و\\(\\ln(x+1)\\to-\\infty\\).",
            "result": "\\[\\lim_{x\\to-1^+}g(x)=-\\infty\\]"
          },
          {
            "step_number": 2,
            "title": "عند +∞",
            "explanation": "\\(\\frac{x-1}{x+1}\\to1\\) و\\(\\ln(x+1)\\to+\\infty\\).",
            "result": "\\[\\lim_{x\\to+\\infty}g(x)=+\\infty\\]"
          }
        ],
        "final_answer": "\\[\\boxed{\\lim_{x\\to-1^+}g(x)=-\\infty,\\quad\\lim_{x\\to+\\infty}g(x)=+\\infty}\\]"
      }
    },
    {
      "id": "2016_s1_ex04_q1b",
      "display_order": 2,
      "content_type": "question",
      "text": "I-1) ب- ادرس اتجاه تغير الدالة \\(g\\) على المجال \\(]-1;+\\infty[\\) ثم شكل جدول تغيراتها.",
      "solution": {
        "strategy": "نحسب المشتقة ونلاحظ أنها موجبة.",
        "steps": [
          {
            "step_number": 1,
            "title": "المشتقة",
            "explanation": "\\[g'(x)=\\frac{2}{(x+1)^2}+\\frac1{x+1}\\]"
          },
          {
            "step_number": 2,
            "title": "الإشارة",
            "explanation": "لأن \\(x+1>0\\) على المجال، فإن \\(g'(x)>0\\)."
          },
          {
            "step_number": 3,
            "title": "النتيجة",
            "explanation": "إذن g متزايدة تماما على كامل المجال."
          }
        ],
        "variation_table": {
          "type": "variation_table",
          "title": "جدول تغيرات g",
          "function_name": "g(x)",
          "derivative_name": "g'(x)",
          "domain": "]-1,+\\infty[",
          "x_values": [
            "-1^+",
            " +\\infty"
          ],
          "derivative_signs": [
            "+"
          ],
          "function": {
            "branches": [
              {
                "id": "gall",
                "start_x": "-1^+",
                "end_x": "+\\infty",
                "start_value": "-\\infty",
                "end_value": "+\\infty",
                "direction": "up"
              }
            ]
          }
        },
        "final_answer": "\\(g\\) متزايدة تماما على \\(]-1,+\\infty[\\)."
      }
    },
    {
      "id": "2016_s1_ex04_q2a",
      "display_order": 3,
      "content_type": "question",
      "text": "I-2) أ- بين أن المعادلة \\(g(x)=0\\) تقبل حلا وحيدا \\(\\alpha\\) حيث: \\(0,4<\\alpha<0,5\\).",
      "solution": {
        "strategy": "نستعمل الاستمرارية والتزايد وتغير الإشارة.",
        "steps": [
          {
            "step_number": 1,
            "title": "الوحدانية",
            "explanation": "g مستمرة ومتزايدة تماما، لذلك لها على الأكثر جذر واحد."
          },
          {
            "step_number": 2,
            "title": "عند 0.4",
            "explanation": "\\[g(0.4)\\approx -0.0921<0\\]"
          },
          {
            "step_number": 3,
            "title": "عند 0.5",
            "explanation": "\\[g(0.5)\\approx 0.0721>0\\]"
          },
          {
            "step_number": 4,
            "title": "الاستنتاج",
            "explanation": "بمبرهنة القيم المتوسطة يوجد جذر بينهما، وهو وحيد.",
            "result": "\\[0.4<\\alpha<0.5\\]"
          }
        ],
        "final_answer": "\\(\\alpha\\approx 0.454733\\)، و\\(0.4<\\alpha<0.5\\)."
      }
    },
    {
      "id": "2016_s1_ex04_q2b",
      "display_order": 4,
      "content_type": "question",
      "text": "I-2) ب- استنتج إشارة \\(g(x)\\) على المجال \\(]-1;+\\infty[\\).",
      "solution": {
        "strategy": "g متزايدة وتعبر الصفر مرة واحدة.",
        "steps": [
          {
            "step_number": 1,
            "title": "قبل α",
            "explanation": "\\[g(x)<0\\quad(-1<x<\\alpha)\\]"
          },
          {
            "step_number": 2,
            "title": "عند α",
            "explanation": "\\[g(\\alpha)=0\\]"
          },
          {
            "step_number": 3,
            "title": "بعد α",
            "explanation": "\\[g(x)>0\\quad(x>\\alpha)\\]"
          }
        ],
        "sign_table": {
          "type": "sign_table",
          "title": "إشارة g",
          "x_values": [
            "-1^+",
            "\\alpha",
            "+\\infty"
          ],
          "signs": [
            "-",
            "0",
            "+"
          ]
        },
        "final_answer": "سالبة قبل \\(\\alpha\\)، منعدمة عنده، وموجبة بعده."
      }
    },
    {
      "id": "2016_s1_ex04_q3",
      "display_order": 5,
      "content_type": "question",
      "text": "II-1) احسب \\(\\lim_{x\\to-1^+}f(x)\\) وفسر النتيجة هندسيا ثم احسب \\(\\lim_{x\\to+\\infty}f(x)\\).",
      "solution": {
        "strategy": "ندرس حاصل الضرب \\((x-1)\\ln(x+1)\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "عند -1",
            "explanation": "\\(x-1\\to-2\\) و\\(\\ln(x+1)\\to-\\infty\\)، فيكون حاصل الضرب \\(+\\infty\\).",
            "result": "\\[\\lim_{x\\to-1^+}f(x)=+\\infty\\]"
          },
          {
            "step_number": 2,
            "title": "التفسير الهندسي",
            "explanation": "\\[x=-1\\] مستقيم مقارب عمودي لـ\\((C)\\)."
          },
          {
            "step_number": 3,
            "title": "عند +∞",
            "explanation": "\\((x-1)\\ln(x+1)\\to+\\infty\\).",
            "result": "\\[\\lim_{x\\to+\\infty}f(x)=+\\infty\\]"
          }
        ],
        "final_answer": "النهايتان \\(+\\infty\\)، والمقارب العمودي هو \\(x=-1\\)."
      }
    },
    {
      "id": "2016_s1_ex04_q4a",
      "display_order": 6,
      "content_type": "question",
      "text": "II-2) أ- ادرس اتجاه تغير الدالة \\(f\\) على المجال \\(]-1;+\\infty[\\)، ثم شكل جدول تغيراتها.",
      "solution": {
        "strategy": "نشتق f فنجد f'=g، ثم نستعمل إشارة g.",
        "steps": [
          {
            "step_number": 1,
            "title": "المشتقة",
            "explanation": "\\[f'(x)=\\ln(x+1)+\\frac{x-1}{x+1}=g(x)\\]"
          },
          {
            "step_number": 2,
            "title": "قبل α",
            "explanation": "g<0، إذن f متناقصة."
          },
          {
            "step_number": 3,
            "title": "بعد α",
            "explanation": "g>0، إذن f متزايدة."
          }
        ],
        "variation_table": {
          "type": "variation_table",
          "title": "جدول تغيرات f",
          "function_name": "f(x)",
          "derivative_name": "f'(x)",
          "domain": "]-1,+\\infty[",
          "x_values": [
            "-1^+",
            "\\alpha",
            "+\\infty"
          ],
          "derivative_signs": [
            "-",
            "0",
            "+"
          ],
          "function": {
            "branches": [
              {
                "id": "fl",
                "start_x": "-1^+",
                "end_x": "\\alpha",
                "start_value": "+\\infty",
                "end_value": "0.795622",
                "direction": "down"
              },
              {
                "id": "fr",
                "start_x": "\\alpha",
                "end_x": "+\\infty",
                "start_value": "0.795622",
                "end_value": "+\\infty",
                "direction": "up"
              }
            ]
          }
        },
        "final_answer": "f متناقصة على \\(]-1,\\alpha]\\) ثم متزايدة على \\([\\alpha,+\\infty[\\)."
      }
    },
    {
      "id": "2016_s1_ex04_q4b",
      "display_order": 7,
      "content_type": "question",
      "text": "II-2) ب- بين أن \\(f(\\alpha)=-\\alpha+4-\\frac4{\\alpha+1}\\)، ثم أعط حصرا لـ\\(f(\\alpha)\\) (تدور النتائج إلى \\(10^{-2}\\)).",
      "solution": {
        "strategy": "نستعمل g(α)=0 للتعبير عن ln(α+1).",
        "steps": [
          {
            "step_number": 1,
            "title": "من g(α)=0",
            "explanation": "\\[\\ln(\\alpha+1)=\\frac{1-\\alpha}{\\alpha+1}\\]"
          },
          {
            "step_number": 2,
            "title": "التعويض",
            "explanation": "\\[f(\\alpha)=1+(\\alpha-1)\\frac{1-\\alpha}{\\alpha+1}\\]"
          },
          {
            "step_number": 3,
            "title": "التبسيط",
            "explanation": "\\[f(\\alpha)=-\\alpha+4-\\frac4{\\alpha+1}\\]"
          },
          {
            "step_number": 4,
            "title": "الحصر",
            "explanation": "من \\(0.4<\\alpha<0.5\\) والدالة \\(\\varphi(t)=-t+4-\\frac4{t+1}\\) متزايدة على هذا المجال، نحصل على \\(\\varphi(0.4)<f(\\alpha)<\\varphi(0.5)\\).",
            "result": "\\[0.74<f(\\alpha)<0.84\\]"
          }
        ],
        "final_answer": "\\[\\boxed{f(\\alpha)=-\\alpha+4-\\frac4{\\alpha+1}},\\qquad \\boxed{0.74<f(\\alpha)<0.84}\\]"
      }
    },
    {
      "id": "2016_s1_ex04_q5a",
      "display_order": 8,
      "content_type": "question",
      "text": "II-3) أ- تحقق أنه من أجل كل \\(x\\in]-1;+\\infty[\\): \\(h'(x)=f'(x)-f'(a)\\).",
      "solution": {
        "strategy": "نشتق تعريف h مباشرة.",
        "steps": [
          {
            "step_number": 1,
            "title": "التعريف",
            "explanation": "\\[h(x)=f(x)-[f'(a)(x-a)+f(a)]\\]"
          },
          {
            "step_number": 2,
            "title": "الاشتقاق",
            "explanation": "\\[h'(x)=f'(x)-f'(a)\\]"
          }
        ],
        "final_answer": "\\[\\boxed{h'(x)=f'(x)-f'(a)}\\]"
      }
    },
    {
      "id": "2016_s1_ex04_q5b",
      "display_order": 9,
      "content_type": "question",
      "text": "II-3) ب- باستعمال اتجاه تغير الدالة \\(g\\)، عين إشارة \\(h'(x)\\) حسب قيم \\(x\\) واستنتج اتجاه تغير \\(h\\) على \\(]-1;+\\infty[\\).",
      "solution": {
        "strategy": "بما أن f'=g، فإن h'=g(x)-g(a)، وg متزايدة.",
        "steps": [
          {
            "step_number": 1,
            "title": "إذا x<a",
            "explanation": "\\[g(x)<g(a)\\Rightarrow h'(x)<0\\]"
          },
          {
            "step_number": 2,
            "title": "عند a",
            "explanation": "\\[h'(a)=0\\]"
          },
          {
            "step_number": 3,
            "title": "إذا x>a",
            "explanation": "\\[g(x)>g(a)\\Rightarrow h'(x)>0\\]"
          },
          {
            "step_number": 4,
            "title": "التغير",
            "explanation": "h متناقصة قبل a ومتزايدة بعد a، وبالتالي لها قيمة دنيا عند a."
          }
        ],
        "final_answer": "h تتناقص على \\(]-1,a]\\) ثم تتزايد على \\([a,+\\infty[\\)."
      }
    },
    {
      "id": "2016_s1_ex04_q5c",
      "display_order": 10,
      "content_type": "question",
      "text": "II-3) ج- حدد الوضع النسبي للمنحنى \\((C)\\) والمستقيم \\((T_a)\\).",
      "solution": {
        "strategy": "h هو الفرق بين f وترتيب المماس.",
        "steps": [
          {
            "step_number": 1,
            "title": "القيمة الدنيا",
            "explanation": "\\[h(a)=0\\] ومع كون a موضع القيمة الدنيا نحصل على \\(h(x)\\ge0\\)."
          },
          {
            "step_number": 2,
            "title": "الوضع النسبي",
            "explanation": "\\[f(x)\\ge f'(a)(x-a)+f(a)\\]"
          }
        ],
        "final_answer": "\\[\\boxed{(C)\\text{ يقع فوق كل مماس }(T_a)}\\]"
      }
    },
    {
      "id": "2016_s1_ex04_q6a",
      "display_order": 11,
      "content_type": "question",
      "text": "II-4) أ- بين أنه يوجد مماسان \\((T_a)\\) يشملان النقطة \\(A(1;0)\\) يطلب تعيين معادلتيهما.",
      "solution": {
        "strategy": "نفرض أن A تنتمي إلى مماس f عند a ثم نحل الشرط.",
        "steps": [
          {
            "step_number": 1,
            "title": "شرط المرور بـ A",
            "explanation": "\\[0=f'(a)(1-a)+f(a)\\]"
          },
          {
            "step_number": 2,
            "title": "الحلول",
            "explanation": "بعد التبسيط نحصل على \\[-a^2+3a=0\\]",
            "result": "\\[a=0\\text{ أو }a=3\\]"
          },
          {
            "step_number": 3,
            "title": "المماس عند 0",
            "explanation": "\\[f(0)=1,\\quad f'(0)=-1\\]",
            "result": "\\[T_0:y=-x+1\\]"
          },
          {
            "step_number": 4,
            "title": "المماس عند 3",
            "explanation": "\\[f'(3)=\\frac12+\\ln4\\] وبما أنه يمر بـA(1,0):",
            "result": "\\[T_3:y=\\left(\\frac12+\\ln4\\right)(x-1)\\]"
          }
        ],
        "final_answer": "\\[\\boxed{T_0:y=-x+1},\\qquad \\boxed{T_3:y=(\\frac12+\\ln4)(x-1)}\\]"
      }
    },
