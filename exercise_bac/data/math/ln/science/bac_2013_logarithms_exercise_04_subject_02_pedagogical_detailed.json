        "steps": [
          {
            "step_number": 1,
            "title": "حساب المشتقة",
            "explanation": "\\[g'(x)=2x+2-\\frac{2}{x+1}.\\]\nبتوحيد المقام:\n\\[g'(x)=\\frac{2(x+1)^2-2}{x+1}=\\frac{2x^2+4x}{x+1}=\\frac{2x(x+2)}{x+1}.\\]",
            "result": "\\(g'(x)=\\frac{2x(x+2)}{x+1}\\)."
          },
          {
            "step_number": 2,
            "title": "إشارة المشتقة",
            "explanation": "على المجال \\(]-1,+\\infty[\\)، لدينا \\(x+1>0\\) و\\(x+2>0\\). إذن إشارة \\(g'(x)\\) هي إشارة \\(x\\)."
          },
          {
            "step_number": 3,
            "title": "اتجاه التغير",
            "explanation": "إذن \\(g\\) متناقصة تماما على \\(]-1,0]\\)، ومتزايدة تماما على \\([0,+\\infty[\\)."
          },
          {
            "step_number": 4,
            "title": "القيم والنهايات",
            "explanation": "\\[g(0)=4.\\]\nكما أن \\(g(x)\\to+\\infty\\) عندما \\(x\\to-1^+\\) وعندما \\(x\\to+\\infty\\).",
            "result": "القيمة الصغرى هي 4 عند x=0."
          }
