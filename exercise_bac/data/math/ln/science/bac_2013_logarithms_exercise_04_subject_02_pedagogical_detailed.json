          {
            "step_number": 1,
            "title": "اشتقاق الجزء الكسري",
            "explanation": "نضع \\(u(x)=1-2\\ln(x+1)\\) و\\(v(x)=x+1\\). فنجد \\(u'(x)=-\\frac2{x+1}\\) و\\(v'(x)=1\\)."
          },
          {
            "step_number": 2,
            "title": "اشتقاق f",
            "explanation": "\\[f'(x)=1-\\frac{u'v-uv'}{v^2}\\]\n\\[=1-\\frac{-2-[1-2\\ln(x+1)]}{(x+1)^2}\\]\n\\[=1+\\frac{3-2\\ln(x+1)}{(x+1)^2}.\\]"
          },
          {
            "step_number": 3,
            "title": "التعرف على g",
            "explanation": "\\[f'(x)=\\frac{(x+1)^2+3-2\\ln(x+1)}{(x+1)^2}\\]\n\\[=\\frac{x^2+2x+4-2\\ln(x+1)}{(x+1)^2}=\\frac{g(x)}{(x+1)^2}.\\]",
            "result": "\\(f'(x)=\\frac{g(x)}{(x+1)^2}\\)."
          }
        ],
