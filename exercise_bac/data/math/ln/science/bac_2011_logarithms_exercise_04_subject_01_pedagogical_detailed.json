  "questions": [
    {
      "text": "I-أ) شكل جدول تغيرات الدالة \\(g\\).",
      "solution": {
        "strategy": "نستعمل مشتقة g أو نقرأ الشكل البياني.",
        "steps": [
          {
            "step_number": 1,
            "title": "المشتقة",
            "explanation": "\\[g'(x)=\\frac{(x+1)-(x-1)}{(x+1)^2}=\\frac2{(x+1)^2}>0\\] لكل \\(x\\ne-1\\)."
          },
          {
            "step_number": 2,
            "title": "الاستنتاج",
            "explanation": "إذن g متزايدة تماما على \\(]-\\infty,-1[\\) وعلى \\(]-1,+\\infty[\\)."
          },
          {
            "step_number": 3,
            "title": "النهايات",
            "explanation": "\\[\\lim_{x\\to-\\infty}g(x)=1,\\quad \\lim_{x\\to-1^-}g(x)=+\\infty,\\quad \\lim_{x\\to-1^+}g(x)=-\\infty,\\quad \\lim_{x\\to+\\infty}g(x)=1.\\]"
          }
        ],
        "final_answer": "g متزايدة تماما على كل من \\(]-\\infty,-1[\\) و\\(]-1,+\\infty[\\).",
        "verification": "تمت مراجعة الحل مع التصحيح الرسمي لبكالوريا 2011 المرفق.",
