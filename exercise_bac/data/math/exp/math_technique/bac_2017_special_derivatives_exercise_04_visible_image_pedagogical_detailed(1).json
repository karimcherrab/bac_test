          ]
        },
        "final_answer": "\\(g\\) متناقصة على \\(]-\\infty,1]\\) ثم متزايدة على \\([1,+\\infty[\\)، وقيمتها الدنيا \\(1-\\frac2e>0\\)، ومنه \\(g(x)>0\\) على \\(\\mathbb R\\).",
        "verification": "مطابق للتصحيح النموذجي في الصفحة 9.",
        "common_mistakes": [
          "نسيان أن \\(e^{-x}\\) موجب دائمًا.",
          "استنتاج الإشارة دون فحص القيمة الدنيا."
        ],
        "hints": [
          "بعد إيجاد اتجاه التغير احسب \\(g(1)\\)."
        ],
        "introduction": "لدراسة الإشارة يكفي العثور على القيمة الدنيا للدالة.",
        "summary": "القيمة الدنيا موجبة، لذلك \\(g\\) موجبة على كامل \\(\\mathbb R\\).",
        "answer_style": "explain_then_calculate_then_conclude"
      }
