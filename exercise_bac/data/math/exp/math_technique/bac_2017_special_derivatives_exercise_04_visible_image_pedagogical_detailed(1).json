                "direction": "up"
              }
            ]
          }
        },
        "final_answer": "\\[f'(x)=g(x)>0\\] وبالتالي \\(f\\) متزايدة تمامًا على \\(\\mathbb R\\).",
        "verification": "مطابق للتصحيح الرسمي.",
        "common_mistakes": [
          "الخطأ في اشتقاق \\(2e^{-x}\\)."
        ],
