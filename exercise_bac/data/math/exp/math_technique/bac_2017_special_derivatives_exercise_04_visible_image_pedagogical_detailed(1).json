    {
      "id": "2017_special_der_ex04_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "II-1) أ) احسب \\(\\displaystyle\\lim_{x\\to-\\infty}f(x)\\) و \\(\\displaystyle\\lim_{x\\to+\\infty}f(x)\\).",
      "solution": {
        "strategy": "ندرس كل جهة باستعمال سلوك \\(e^{-x}\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "عند \\(+\\infty\\)",
            "explanation": "عندما \\(x\\to+\\infty\\)، فإن \\(e^{-x}\\to0\\)، وبالتالي:\\[f(x)=(x+1)(1+2e^{-x})\\sim x+1\\]",
            "result": "\\[\\lim_{x\\to+\\infty}f(x)=+\\infty\\]"
          },
          {
            "step_number": 2,
            "title": "عند \\(-\\infty\\)",
            "explanation": "عندما \\(x\\to-\\infty\\)، فإن \\(e^{-x}\\to+\\infty\\)، كما أن \\(x+1<0\\)، ومنه:",
            "result": "\\[\\lim_{x\\to-\\infty}f(x)=-\\infty\\]"
          }
        ],
        "final_answer": "\\[\\lim_{x\\to-\\infty}f(x)=-\\infty,\\qquad \\lim_{x\\to+\\infty}f(x)=+\\infty\\]",
        "verification": "مطابق للتصحيح النموذجي.",
        "common_mistakes": [
          "نسيان أن \\(e^{-x}\\to+\\infty\\) عندما \\(x\\to-\\infty\\)."
        ],
        "hints": [
          "راقب إشارة \\(x+1\\) عند \\(-\\infty\\)."
        ],
        "introduction": "الدالة حاصل ضرب عامل خطي وعامل أسي موجب.",
        "summary": "من \\(-\\infty\\) إلى \\(+\\infty\\).",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2017_special_der_ex04_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "II-1) ب) ادرس اتجاه تغير الدالة \\(f\\) ثم شكل جدول تغيراتها.",
      "solution": {
        "strategy": "نشتق \\(f\\) ونستعمل نتيجة الجزء I.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب المشتقة",
            "explanation": "\\[f'(x)=1+2e^{-x}-2(x+1)e^{-x}=1-2xe^{-x}\\]",
            "result": "\\[f'(x)=g(x)\\]"
          },
          {
            "step_number": 2,
            "title": "إشارة المشتقة",
            "explanation": "من الجزء I لدينا \\(g(x)>0\\) لكل \\(x\\in\\mathbb R\\).",
            "result": "\\[f'(x)>0\\quad\\forall x\\in\\mathbb R\\]"
          },
          {
            "step_number": 3,
            "title": "التغيرات",
            "explanation": "إذن \\(f\\) متزايدة تمامًا على \\(\\mathbb R\\)."
          }
        ],
        "variation_table": {
          "type": "variation_table",
          "title": "جدول تغيرات الدالة \\(f\\)",
          "function_name": "f(x)",
          "derivative_name": "f'(x)",
