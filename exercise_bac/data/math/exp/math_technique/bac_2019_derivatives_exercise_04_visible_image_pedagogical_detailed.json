      "display_order": 4,
      "content_type": "question",
      "text": "II-1) احسب \\(\\displaystyle\\lim_{x\\to-\\infty}f(x)\\) و \\(\\displaystyle\\lim_{x\\to+\\infty}f(x)\\).",
      "solution": {
        "strategy": "نستعمل سلوك \\(e^x-1\\) عند \\(\\pm\\infty\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "عند \\(-\\infty\\)",
            "explanation": "عندما \\(x\\to-\\infty\\): \\(e^x\\to0\\)، وبالتالي \\(e^x-1\\to-1\\)، و\\(x+2\\to-\\infty\\).",
            "result": "\\[\\lim_{x\\to-\\infty}f(x)=+\\infty\\]"
          },
          {
            "step_number": 2,
            "title": "عند \\(+\\infty\\)",
            "explanation": "عندما \\(x\\to+\\infty\\): كل من \\(x+2\\) و\\(e^x-1\\) موجب ويتجه إلى \\(+\\infty\\).",
            "result": "\\[\\lim_{x\\to+\\infty}f(x)=+\\infty\\]"
          }
        ],
        "final_answer": "\\[\\lim_{x\\to-\\infty}f(x)=+\\infty,\\qquad \\lim_{x\\to+\\infty}f(x)=+\\infty\\]",
        "verification": "مطابق للتصحيح النموذجي.",
        "common_mistakes": [
          "نسيان أن حاصل عددين سالبين عند \\(-\\infty\\) يعطي سلوكًا موجبًا."
        ],
        "hints": [
          "عند \\(-\\infty\\)، \\(e^x-1\\to-1\\)."
        ],
        "introduction": "نحسب كل نهاية انطلاقًا من حاصل الضرب.",
        "summary": "الدالة تتجه إلى \\(+\\infty\\) في الجهتين.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
