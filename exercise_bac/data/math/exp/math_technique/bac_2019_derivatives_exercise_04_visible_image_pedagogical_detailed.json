      "content_type": "question",
      "text": "II-5) احسب \\(f(x)-g(x)\\) ثم استنتج دالة أصلية للدالة \\(f\\) على \\(\\mathbb{R}\\).",
      "solution": {
        "strategy": "نحسب الفرق ثم نستعمل العلاقة \\(g=f'\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب الفرق",
            "explanation": "\\[f(x)-g(x)=(x+2)(e^x-1)-[(x+3)e^x-1]\\]\\[=-e^x-x-1\\]",
            "result": "\\[f(x)-g(x)=-(e^x+x+1)\\]"
          },
          {
            "step_number": 2,
            "title": "نستعمل \\(g=f'\\)",
            "explanation": "من العلاقة السابقة:\\[f(x)=f'(x)-e^x-x-1\\]"
          },
          {
            "step_number": 3,
            "title": "نبحث عن دالة أصلية",
            "explanation": "إذن مشتقة الدالة:\\[F(x)=f(x)-e^x-\\frac{x^2}{2}-x\\] هي:\\[F'(x)=f'(x)-e^x-x-1=f(x)\\]",
            "result": "\\[F(x)=f(x)-e^x-\\frac{x^2}{2}-x\\]"
          },
          {
            "step_number": 4,
            "title": "صيغة مكافئة أبسط",
            "explanation": "بالتعويض عن \\(f\\) يمكن كتابة دالة أصلية أيضًا على الشكل:\\[F(x)=(x+1)e^x-\\frac{x^2}{2}-2x\\] مع اختلاف ثابت فقط."
          }
        ],
        "final_answer": "\\[f(x)-g(x)=-(e^x+x+1)\\] ومنه دالة أصلية لـ\\(f\\) هي مثلًا:\\[\\boxed{F(x)=(x+1)e^x-\\frac{x^2}{2}-2x}\\]",
        "verification": "باشتقاق \\(F\\): \\[F'(x)=(x+2)e^x-x-2=(x+2)(e^x-1)=f(x)\\]",
        "common_mistakes": [
          "نسيان أن \\(g=f'\\).",
          "نسيان ثابت التكامل؛ أي دالتين أصليتين تختلفان بثابت."
        ],
        "hints": [
          "بعد حساب \\(f-g\\)، عوض \\(g\\) بـ\\(f'\\)."
        ],
        "introduction": "السؤال يربط الدالة بمشتقتها للوصول بسرعة إلى دالة أصلية.",
        "summary": "دالة أصلية مناسبة هي \\((x+1)e^x-\\frac{x^2}{2}-2x\\).",
        "answer_style": "explain_then_calculate_then_conclude"
      }
