      "content_type": "question",
      "text": "I-1) احسب: \\(\\displaystyle\\lim_{x\\to-\\infty}g(x)\\) و \\(\\displaystyle\\lim_{x\\to+\\infty}g(x)\\).",
      "solution": {
        "strategy": "نستعمل نهايات الأسية عند \\(\\pm\\infty\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "عند \\(-\\infty\\)",
            "explanation": "عندما \\(x\\to-\\infty\\)، فإن \\(e^x\\to0\\) و\\(xe^x\\to0\\)، ومنه:\\[\\lim_{x\\to-\\infty}(x+2)e^x=0\\]",
            "result": "\\[\\lim_{x\\to-\\infty}g(x)=-2\\]"
          },
          {
            "step_number": 2,
            "title": "عند \\(+\\infty\\)",
            "explanation": "عندما \\(x\\to+\\infty\\)، فإن \\((x+2)e^x\\to+\\infty\\).",
            "result": "\\[\\lim_{x\\to+\\infty}g(x)=+\\infty\\]"
          }
        ],
        "final_answer": "\\[\\lim_{x\\to-\\infty}g(x)=-2,\\qquad \\lim_{x\\to+\\infty}g(x)=+\\infty\\]",
        "verification": "مطابق للتصحيح النموذجي.",
        "common_mistakes": [
          "اعتبار \\((x+2)e^x\\) شكلاً غير محدد دون استعمال \\(xe^x\\to0\\) عند \\(-\\infty\\)."
        ],
        "hints": [
          "فكك \\((x+2)e^x=xe^x+2e^x\\)."
        ],
        "introduction": "نحسب النهايتين باستعمال النهايات الأساسية للأسية.",
        "summary": "يسارًا \\(-2\\)، ويمينًا \\(+\\infty\\).",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
