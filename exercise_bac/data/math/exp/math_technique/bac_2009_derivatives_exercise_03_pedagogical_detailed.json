      "display_order": 1,
      "content_type": "question",
      "text": "1. احسب \\(f(x)+f(-x)\\) من أجل كل عدد حقيقي \\(x\\)، ثم استنتج أن النقطة \\(\\omega(0;1)\\) هي مركز تناظر للمنحنى \\((C_f)\\).",
      "solution": {
        "strategy": "نحسب \\(f(-x)\\) ثم نجمعه مع \\(f(x)\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "نحسب \\(f(-x)\\)",
            "goal": "الحصول على عبارة مناسبة للجمع مع \\(f(x)\\).",
            "explanation": "\\[f(-x)=-x+\\frac{2}{e^{-x}+1}=-x+\\frac{2e^x}{e^x+1}\\]"
          },
          {
            "step_number": 2,
            "title": "نحسب المجموع",
            "explanation": "\\[f(x)+f(-x)=x+\\frac{2}{e^x+1}-x+\\frac{2e^x}{e^x+1}=\\frac{2(1+e^x)}{1+e^x}=2\\]",
            "result": "\\[f(x)+f(-x)=2\\]"
          },
          {
            "step_number": 3,
            "title": "نستنتج مركز التناظر",
            "explanation": "لدينا \\(f(x)+f(-x)=2\\). وبما أن \\(2=2\\times1\\)، فإن النقطة ذات الإحداثيين \\((0,1)\\) هي مركز تناظر للمنحنى.",
            "result": "\\(\\omega(0;1)\\) مركز تناظر للمنحنى \\((C_f)\\)."
          }
        ],
        "final_answer": "\\[f(x)+f(-x)=2\\] ومنه \\(\\omega(0;1)\\) مركز تناظر للمنحنى \\((C_f)\\).",
        "verification": "النتيجة مطابقة للتصحيح النموذجي: \\(f(x)+f(-x)=2\\).",
        "common_mistakes": [
          "نسيان تحويل \\(\\frac{1}{e^{-x}+1}\\) إلى \\(\\frac{e^x}{1+e^x}\\)."
        ],
        "hints": [
          "استعمل \\(e^{-x}=\\frac1{e^x}\\)."
        ],
        "methodology": {
          "goal": "إثبات التناظر المركزي باستعمال علاقة بين \\(f(x)\\) و\\(f(-x)\\).",
          "method": "نحسب \\(f(-x)\\)، نبسط المجموع، ثم نستعمل معيار مركز التناظر.",
          "formal_writing": [
            "إظهار حساب \\(f(-x)\\).",
            "تبسيط \\(f(x)+f(-x)\\) إلى ثابت.",
            "ذكر الاستنتاج المتعلق بمركز التناظر."
          ]
        },
        "introduction": "الفكرة بسيطة: إذا كان مجموع قيمتي الدالة عند \\(x\\) و\\(-x\\) ثابتًا ويساوي \\(2\\)، فمركز التناظر هو \\((0,1)\\).",
        "summary": "نجد \\(f(x)+f(-x)=2\\)، إذن \\(\\omega(0;1)\\) مركز تناظر.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
