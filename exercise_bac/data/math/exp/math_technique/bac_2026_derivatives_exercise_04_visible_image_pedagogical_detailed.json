        "steps": [
          {
            "step_number": 1,
            "title": "الحد الإضافي",
            "explanation": "عندما \\(x\\to+\\infty\\)، فإن \\[(1-x-x^2)e^{-x}\\to0\\]"
          },
          {
            "step_number": 2,
            "title": "النهاية",
            "explanation": "إذن:",
            "result": "\\[\\lim_{x\\to+\\infty}f(x)=1\\]"
          },
          {
            "step_number": 3,
            "title": "التفسير الهندسي",
            "explanation": "بما أن نهاية الدالة عدد حقيقي ثابت عند \\(+\\infty\\):",
            "result": "\\[y=1\\] مستقيم مقارب أفقي للمنحنى \\((C_f)\\) عند \\(+\\infty\\)."
          }
        ],
        "final_answer": "\\[\\boxed{y=1}\\] مقارب أفقي لـ\\((C_f)\\) عند \\(+\\infty\\).",
