    {
      "id": "2026_der_ex04_q2a",
      "display_order": 3,
      "content_type": "question",
      "text": "2) أ) بين أنه من أجل كل \\(x\\) من \\(\\mathbb{R}\\): \\[f'(x)=(x^2-x-2)e^{-x}\\]",
      "solution": {
        "strategy": "نشتق حاصل الضرب \\((1-x-x^2)e^{-x}\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "نشتق",
            "explanation": "\\[f'(x)=(-1-2x)e^{-x}-(1-x-x^2)e^{-x}\\]"
          },
          {
            "step_number": 2,
            "title": "نبسط",
            "explanation": "\\[f'(x)=(-1-2x-1+x+x^2)e^{-x}\\]",
            "result": "\\[f'(x)=(x^2-x-2)e^{-x}\\]"
          },
          {
            "step_number": 3,
            "title": "نحلل كثير الحدود",
            "explanation": "\\[x^2-x-2=(x+1)(x-2)\\]"
          }
        ],
        "final_answer": "\\[\\boxed{f'(x)=(x+1)(x-2)e^{-x}}\\]",
        "verification": "الاشتقاق والتبسيط تم التحقق منهما مباشرة.",
        "common_mistakes": [
          "نسيان الإشارة السالبة في مشتقة \\(e^{-x}\\)."
        ],
        "hints": [
          "استعمل قاعدة مشتقة حاصل ضرب."
        ],
        "introduction": "صيغة المشتقة ستسمح بدراسة التغيرات بسهولة.",
        "summary": "المشتقة هي \\((x+1)(x-2)e^{-x}\\).",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
