  "statement": "التمرين الرابع: (06 نقاط)\nالدالة \\(f\\) هي الدالة المعرفة على \\(\\mathbb{R}\\) بـ:\n\\[f(x)=(x-1)e^x\\]\n\\((C_f)\\) تمثيلها البياني في المستوى المنسوب إلى المعلم المتعامد المتجانس \\((O;\\vec{i},\\vec{j})\\).",
  "figures": [],
  "questions": [
    {
      "id": "2014_der_ex04_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1) عين نهاية \\(f\\) عند كل من \\(-\\infty\\) و \\(+\\infty\\).",
      "solution": {
        "strategy": "نستعمل نهايات الدالة الأسية ومقارنة نموها مع الدالة الخطية.",
        "steps": [
          {
            "step_number": 1,
            "title": "النهاية عند \\(-\\infty\\)",
            "explanation": "نكتب:\\[f(x)=(x-1)e^x=xe^x-e^x\\] وعندما \\(x\\to-\\infty\\)، لدينا \\(xe^x\\to0\\) و\\(e^x\\to0\\).",
            "result": "\\[\\lim_{x\\to-\\infty}f(x)=0\\]"
          },
          {
            "step_number": 2,
            "title": "النهاية عند \\(+\\infty\\)",
            "explanation": "عندما \\(x\\to+\\infty\\)، فإن \\(x-1\\to+\\infty\\) و\\(e^x\\to+\\infty\\)، وبالتالي:",
            "result": "\\[\\lim_{x\\to+\\infty}f(x)=+\\infty\\]"
          }
        ],
        "final_answer": "\\[\\lim_{x\\to-\\infty}f(x)=0,\\qquad \\lim_{x\\to+\\infty}f(x)=+\\infty\\]",
        "verification": "النتيجتان مطابقتان للتصحيح النموذجي.",
        "common_mistakes": [
          "اعتبار حاصل \\((-\\infty)\\times0\\) مساويًا للصفر مباشرة دون استعمال النهاية المعروفة \\(xe^x\\to0\\)."
        ],
        "hints": [
          "اكتب \\((x-1)e^x=xe^x-e^x\\)."
        ],
        "introduction": "نحسب كل نهاية على حدة باستعمال النهايات الأساسية للأسية.",
        "summary": "يسارًا تقترب الدالة من \\(0\\)، ويمينًا تتجه إلى \\(+\\infty\\).",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2014_der_ex04_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "2) أدرس اتجاه تغير الدالة \\(f\\) على \\(\\mathbb{R}\\) ثم شكل جدول تغيراتها.",
      "solution": {
        "strategy": "نحسب المشتقة ثم ندرس إشارتها.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب المشتقة",
            "explanation": "\\[f'(x)=1\\cdot e^x+(x-1)e^x=xe^x\\]",
            "result": "\\[f'(x)=xe^x\\]"
          },
          {
            "step_number": 2,
            "title": "إشارة المشتقة",
            "explanation": "بما أن \\(e^x>0\\) لكل \\(x\\)، فإن إشارة \\(f'(x)\\) هي إشارة \\(x\\). إذن \\(f'(x)<0\\) إذا \\(x<0\\)، و\\(f'(0)=0\\)، و\\(f'(x)>0\\) إذا \\(x>0\\)."
          },
          {
            "step_number": 3,
            "title": "القيمة عند الصفر",
            "explanation": "\\[f(0)=(-1)e^0=-1\\]",
            "result": "\\(f(0)=-1\\)."
          },
          {
            "step_number": 4,
            "title": "النتيجة",
            "explanation": "إذن \\(f\\) متناقصة تمامًا على \\(]-\\infty,0]\\)، ومتزايدة تمامًا على \\([0,+\\infty[\\)."
          }
        ],
        "variation_table": {
          "type": "variation_table",
          "title": "جدول تغيرات الدالة \\(f\\)",
          "function_name": "f(x)",
          "derivative_name": "f'(x)",
          "domain": "\\mathbb{R}",
          "x_values": [
            "-\\infty",
            "0",
            "+\\infty"
          ],
          "derivative_signs": [
            "-",
            "0",
            "+"
          ],
          "function": {
            "branches": [
              {
                "id": "left_branch",
                "start_x": "-\\infty",
                "end_x": "0",
                "start_value": "0",
                "end_value": "-1",
                "direction": "down"
              },
              {
                "id": "right_branch",
                "start_x": "0",
                "end_x": "+\\infty",
                "start_value": "-1",
                "end_value": "+\\infty",
                "direction": "up"
              }
            ]
          }
        },
        "final_answer": "\\[f'(x)=xe^x\\] ومنه \\(f\\) متناقصة على \\(]-\\infty,0]\\) ثم متزايدة على \\([0,+\\infty[\\)، وقيمتها الدنيا هي \\(-1\\) عند \\(x=0\\).",
        "verification": "مطابق لجدول التغيرات في التصحيح النموذجي.",
        "common_mistakes": [
          "الخطأ في اشتقاق حاصل الضرب \\((x-1)e^x\\)."
        ],
        "hints": [
          "بعد الاشتقاق لاحظ أن \\(e^x\\) موجب دائمًا."
        ],
        "introduction": "اتجاه التغير يُستخرج مباشرة من إشارة المشتقة.",
        "summary": "تنخفض \\(f\\) حتى \\((0,-1)\\)، ثم ترتفع.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2014_der_ex04_q3a",
      "display_order": 3,
      "content_type": "question",
      "text": "3) أ) بين أن المعادلة \\(f(x)=1\\) تقبل حلا وحيدا \\(\\alpha\\) على \\(\\mathbb{R}\\)، ثم تحقق أن \\(1,27<\\alpha<1,28\\).",
      "solution": {
        "strategy": "نستعمل جدول التغيرات لإثبات الوحدانية، ثم مبرهنة القيم المتوسطة للحصر.",
        "steps": [
          {
            "step_number": 1,
            "title": "عدم وجود حل سالب",
            "explanation": "على \\(]-\\infty,0]\\)، قيم \\(f\\) محصورة بين \\(-1\\) و\\(0\\)، لذلك لا يمكن أن تساوي \\(1\\)."
          },
          {
            "step_number": 2,
            "title": "الوجود والوحدانية على \\([0,+\\infty[\\)",
            "explanation": "الدالة \\(f\\) مستمرة ومتزايدة تمامًا على \\([0,+\\infty[\\)، ولدينا \\(f(0)=-1<1\\) و\\(\\lim_{x\\to+\\infty}f(x)=+\\infty\\). إذن توجد قيمة وحيدة \\(\\alpha>0\\) تحقق \\(f(\\alpha)=1\\)."
          },
          {
            "step_number": 3,
            "title": "التحقق من الحصر",
            "explanation": "\\[f(1.27)\\approx0.96<1\\]\\[f(1.28)\\approx1.01>1\\] وبما أن \\(f\\) متزايدة:",
            "result": "\\[1.27<\\alpha<1.28\\]"
          }
        ],
        "final_answer": "للمعادلة \\(f(x)=1\\) حل وحيد \\(\\alpha\\)، و\\(1.27<\\alpha<1.28\\)، وتقريبًا \\(\\alpha\\approx 1.278465\\).",
        "verification": "الحصر والقيم التقريبية مطابقة للتصحيح النموذجي.",
        "common_mistakes": [
          "نسيان استبعاد المجال السالب قبل إثبات الوحدانية."
        ],
        "hints": [
          "استعمل جدول تغيرات \\(f\\)، ثم احسب \\(f(1.27)\\) و\\(f(1.28)\\)."
        ],
        "introduction": "جدول التغيرات يكفي لإثبات أن الجذر وحيد.",
        "summary": "يوجد حل وحيد موجب، وهو بين \\(1.27\\) و\\(1.28\\).",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2014_der_ex04_q3b",
      "display_order": 4,
      "content_type": "question",
      "text": "3) ب) اكتب معادلة لـ\\((T)\\) مماس المنحنى \\((C_f)\\) عند النقطة ذات الفاصلة \\(1\\) وحدد وضعية \\((C_f)\\) بالنسبة إلى \\((T)\\).",
      "solution": {
        "strategy": "نحسب قيمة الدالة والمشتقة عند \\(x=1\\)، ثم ندرس إشارة الفرق بين المنحنى والمماس.",
        "steps": [
          {
            "step_number": 1,
            "title": "إحداثيات نقطة التماس",
            "explanation": "\\[f(1)=0\\]",
            "result": "نقطة التماس هي \\(A(1,0)\\)."
          },
          {
            "step_number": 2,
            "title": "ميل المماس",
            "explanation": "\\[f'(1)=e\\]"
          },
          {
            "step_number": 3,
            "title": "معادلة المماس",
            "explanation": "\\[y=f'(1)(x-1)+f(1)=e(x-1)\\]",
            "result": "\\[T:\\ y=ex-e\\]"
          },
          {
            "step_number": 4,
            "title": "الوضعية النسبية",
            "explanation": "\\[f(x)-(ex-e)=(x-1)(e^x-e)\\] ولأن الدالة الأسية متزايدة، فإن \\(x-1\\) و\\(e^x-e\\) لهما نفس الإشارة. إذن حاصل ضربهما غير سالب.",
            "result": "\\[f(x)-(ex-e)\\ge0\\]"
          }
        ],
        "final_answer": "معادلة المماس هي \\(T:y=ex-e\\)، والمنحنى \\((C_f)\\) يقع فوق المماس \\((T)\\) ويلامسه فقط عند \\(x=1\\).",
        "verification": "مطابق للتصحيح الرسمي.",
        "common_mistakes": [
          "كتابة \\(y=ex\\) بدل \\(y=ex-e\\).",
          "تحديد الوضعية من الرسم فقط دون دراسة إشارة الفرق."
        ],
        "hints": [
          "ادرس \\(f(x)-y_T(x)\\) وحاول تحليلها."
        ],
        "introduction": "بعد إيجاد المماس ندرس الفرق لتحديد أيهما أعلى.",
        "summary": "المماس \\(y=ex-e\\)، و\\((C_f)\\) فوقه.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2014_der_ex04_q3c",
      "display_order": 5,
      "content_type": "question",
      "text": "3) ج) ارسم \\((T)\\) و \\((C_f)\\).",
