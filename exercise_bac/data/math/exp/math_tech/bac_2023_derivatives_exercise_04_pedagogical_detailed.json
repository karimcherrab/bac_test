          {
            "step_number": 3,
            "title": "بعد \\(3/2\\)",
            "explanation": "إذا \\(x>\\frac32\\)، فالفرق موجب.",
            "result": "\\((C_f)\\) أعلى \\((\\Delta)\\)."
          },
          {
            "step_number": 4,
            "title": "نقطة التقاطع",
