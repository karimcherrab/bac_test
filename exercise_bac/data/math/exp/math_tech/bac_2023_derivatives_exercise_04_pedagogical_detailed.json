          {
            "step_number": 2,
            "title": "عند \\(\\alpha\\)",
            "explanation": "\\[g(\\alpha)=0\\]"
          },
          {
            "step_number": 3,
            "title": "بعد \\(\\alpha\\)",
            "explanation": "بعد الجذر الوحيد تكون \\(g\\) موجبة.",
            "result": "\\[g(x)>0\\quad\\text{إذا }x>\\alpha\\]"
          }
        ],
        "sign_table": {
          "type": "sign_table",
