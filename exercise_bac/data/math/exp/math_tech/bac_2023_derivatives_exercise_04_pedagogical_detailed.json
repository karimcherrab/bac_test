        "steps": [
          {
            "step_number": 1,
            "title": "إشارة الفرق",
            "explanation": "\\[f(x)-(-x+4)=(2x-3)e^x\\] وبما أن \\(e^x>0\\)، فإشارة الفرق هي إشارة \\(2x-3\\)."
          },
          {
            "step_number": 2,
            "title": "قبل \\(3/2\\)",
