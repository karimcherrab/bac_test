    {
      "id": "2023_der_ex04_q3a",
      "display_order": 3,
      "content_type": "question",
      "text": "II-1) أ) احسب \\(\\displaystyle\\lim_{x\\to-\\infty}f(x)\\) ثم بين أن \\(\\displaystyle\\lim_{x\\to+\\infty}f(x)=+\\infty\\).",
      "solution": {
        "strategy": "ندرس سلوك الحد الأسي عند طرفي اللانهاية.",
        "steps": [
          {
            "step_number": 1,
            "title": "عند \\(-\\infty\\)",
            "explanation": "عندما \\(x\\to-\\infty\\)، فإن \\(e^x\\to0\\) و\\((2x-3)e^x\\to0\\). إذن:",
            "result": "\\[\\lim_{x\\to-\\infty}f(x)=+\\infty\\]"
          },
          {
            "step_number": 2,
            "title": "عند \\(+\\infty\\)",
            "explanation": "الحد \\((2x-3)e^x\\) يتجه إلى \\(+\\infty\\) وينمو أسرع من الحد الخطي \\(-x+4\\).",
            "result": "\\[\\lim_{x\\to+\\infty}f(x)=+\\infty\\]"
          }
        ],
        "final_answer": "\\[\\lim_{x\\to-\\infty}f(x)=+\\infty,\\qquad \\lim_{x\\to+\\infty}f(x)=+\\infty\\]",
        "verification": "مطابق للتصحيح النموذجي.",
        "common_mistakes": [
          "نسيان أن \\(-x\\to+\\infty\\) عندما \\(x\\to-\\infty\\)."
        ],
        "hints": [
          "عند -∞ يختفي الحد الأسي، وعند +∞ يهيمن."
        ],
        "introduction": "نحسب النهاية في كل جهة على حدة.",
        "summary": "النهايتان تساويان +∞.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
