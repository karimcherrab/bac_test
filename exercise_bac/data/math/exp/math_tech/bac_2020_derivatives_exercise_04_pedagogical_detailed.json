          },
          {
            "step_number": 3,
            "title": "تغير الإشارة",
            "explanation": "العامل \\(4e^{-x}-1\\) موجب قبل \\(\\ln4\\) وسالب بعده، إذن \\(f''\\) يغير إشارته عند \\(\\ln4\\)."
          },
          {
            "step_number": 4,
            "title": "إحداثيات نقطة الانعطاف",
            "explanation": "\\[f(\\ln4)=\\ln4-1+\\frac14\\left(\\frac12-1\\right)^2=\\ln4-\\frac{15}{16}\\]",
            "result": "\\[W\\left(\\ln4,\\ln4-\\frac{15}{16}\\right)\\]"
          }
        ],
        "final_answer": "\\[\\boxed{W\\left(\\ln4,\\ln4-\\frac{15}{16}\\right)}\\]",
