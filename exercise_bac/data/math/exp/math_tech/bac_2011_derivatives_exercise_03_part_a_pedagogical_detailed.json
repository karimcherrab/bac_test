      "content_type": "question",
      "text": "1- ادرس تغيرات الدالة \\(f\\).",
      "solution": {
        "strategy": "نحسب النهايتين ثم المشتقة وإشارتها.",
        "steps": [
          {
            "step_number": 1,
            "title": "النهاية عند \\(-\\infty\\)",
            "explanation": "عندما \\(x\\to-\\infty\\)، فإن \\(e^x\\to0\\)، وبالتالي:\\[\\lim_{x\\to-\\infty}f(x)=3-4=-1\\]"
          },
          {
            "step_number": 2,
            "title": "النهاية عند \\(+\\infty\\)",
            "explanation": "عندما \\(x\\to+\\infty\\)، فإن \\(e^x\\to+\\infty\\) ومنه:\\[\\lim_{x\\to+\\infty}f(x)=3\\]"
          },
          {
            "step_number": 3,
            "title": "حساب المشتقة",
            "explanation": "\\[f'(x)=\\frac{4e^x}{(e^x+1)^2}\\]",
            "result": "بما أن \\(e^x>0\\) والمقام موجب، فإن \\(f'(x)>0\\) لكل \\(x\\in\\mathbb R\\)."
          },
          {
            "step_number": 4,
            "title": "النتيجة",
            "explanation": "إذن \\(f\\) متزايدة تمامًا على \\(\\mathbb R\\)، من القيمة الحدية \\(-1\\) إلى القيمة الحدية \\(3\\)."
          }
        ],
        "variation_table": {
          "type": "variation_table",
          "title": "جدول تغيرات الدالة \\(f\\)",
          "function_name": "f(x)",
          "derivative_name": "f'(x)",
