        "steps": [
          {
            "step_number": 1,
            "title": "عند \\(-\\infty\\)",
            "explanation": "\\[\\lim_{x\\to-\\infty}f(x)=-1\\]",
            "result": "إذن \\(y=-1\\) مستقيم مقارب أفقي عند \\(-\\infty\\)."
          },
          {
            "step_number": 2,
            "title": "عند \\(+\\infty\\)",
            "explanation": "\\[\\lim_{x\\to+\\infty}f(x)=3\\]",
            "result": "إذن \\(y=3\\) مستقيم مقارب أفقي عند \\(+\\infty\\)."
          }
        ],
        "final_answer": "المستقيمان المقاربان هما \\(y=-1\\) و\\(y=3\\).",
        "verification": "مطابق للتصحيح الرسمي.",
