      "solution": {
        "strategy": "نحسب f(0) وf'(0) ثم نطبق صيغة المماس.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب f(0)",
            "explanation": "\\[f(0)=1-0-1=0\\]",
            "result": "النقطة هي O(0,0)."
          },
          {
            "step_number": 2,
            "title": "حساب الميل",
            "explanation": "\\[f'(0)=1-e\\]",
            "result": "\\(f'(0)=1-e\\)."
          },
          {
            "step_number": 3,
            "title": "معادلة المماس",
            "explanation": "\\[y=f'(0)(x-0)+f(0)=(1-e)x\\]",
            "result": "\\(T:y=(1-e)x\\)."
          }
        ],
        "final_answer": "\\(\\boxed{T:y=(1-e)x}\\).",
