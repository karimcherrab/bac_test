      "text": "1-أ) احسب \\(\\lim_{x\\to-\\infty} f(x)\\) و \\(\\lim_{x\\to+\\infty} f(x)\\).",
      "solution": {
        "strategy": "ندرس سلوك الجزء الأسي والجزء الخطي عند طرفي المجال.",
        "steps": [
          {
            "step_number": 1,
            "title": "النهاية عند -∞",
            "explanation": "عندما \\(x\\to-\\infty\\)، فإن \\(e^x\\to0\\) و \\(-ex\\to+\\infty\\)، لذلك \\(f(x)=e^x-ex-1\\to+\\infty\\).",
            "result": "\\(\\lim_{x\\to-\\infty}f(x)=+\\infty\\)."
          },
          {
            "step_number": 2,
            "title": "النهاية عند +∞",
            "explanation": "عندما \\(x\\to+\\infty\\)، فإن \\(e^x\\) ينمو أسرع من \\(ex\\)، لذلك \\(e^x-ex-1\\to+\\infty\\).",
            "result": "\\(\\lim_{x\\to+\\infty}f(x)=+\\infty\\)."
          }
        ],
        "final_answer": "\\(\\boxed{\\lim_{x\\to-\\infty}f(x)=+\\infty}\\) و \\(\\boxed{\\lim_{x\\to+\\infty}f(x)=+\\infty}\\).",
