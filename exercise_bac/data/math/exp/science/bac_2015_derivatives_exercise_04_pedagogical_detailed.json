    {
      "text": "II-6-أ) تحقق أنه لكل \\(x\\in\\mathbb{R}\\): \\(2f(x)+f'(x)-f''(x)=1-2x-3e^{2x+2}\\).",
      "solution": {
        "strategy": "نحسب f' وf'' ثم نعوض ونبسط.",
        "steps": [
          {
            "step_number": 1,
            "title": "المشتقة الأولى",
            "explanation": "\\[f'(x)=(1+2x)e^{2x+2}-1\\]."
          },
          {
            "step_number": 2,
            "title": "المشتقة الثانية",
            "explanation": "\\[f''(x)=4(x+1)e^{2x+2}\\]."
          },
          {
            "step_number": 3,
            "title": "التعويض",
            "explanation": "\\[2f+f'-f''=2(xe^{2x+2}-x+1)+((1+2x)e^{2x+2}-1)-4(x+1)e^{2x+2}\\]\\[=1-2x-3e^{2x+2}\\].",
            "result": "العلاقة صحيحة."
          }
        ],
        "final_answer": "\\(\\boxed{2f(x)+f'(x)-f''(x)=1-2x-3e^{2x+2}}\\).",
        "verification": "تمت مراجعة النتيجة مع التصحيح الرسمي لبكالوريا 2015.",
        "common_mistakes": [],
        "hints": [],
        "introduction": "نحسب f' وf'' ثم نعوض ونبسط.",
        "summary": "\\(\\boxed{2f(x)+f'(x)-f''(x)=1-2x-3e^{2x+2}}\\).",
        "answer_style": "explain_then_calculate_then_conclude"
      },
