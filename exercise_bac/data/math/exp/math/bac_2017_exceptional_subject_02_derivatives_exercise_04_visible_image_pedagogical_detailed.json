  "statement": "التمرين الرابع: (07 نقاط)\\nالمستوي منسوب إلى المعلم المتعامد المتجانس \\((O;\\vec{i},\\vec{j})\\) حيث: \\(\\|\\vec{i}\\|=1cm\\).\\nI- نعتبر الدالة \\(f\\) المعرفة على \\(\\mathbb{R}\\) كما يلي: \\(f(x)=(x+1)^2e^{-x}\\). \\((C)\\) تمثيلها البياني.",
  "figures": [],
  "questions": [
    {
      "id": "2017_exc_s02_der_ex04_qI1",
      "display_order": 1,
      "content_type": "question",
      "text": "1) احسب \\(\\displaystyle\\lim_{x\\to-\\infty}f(x)\\) و \\(\\displaystyle\\lim_{x\\to+\\infty}f(x)\\).",
      "solution": {
        "strategy": "نستعمل عبارة \\(f(x)=(x+1)^2e^{-x}\\) وسلوك كثيرة الحدود والأسية عند طرفي المجال.",
        "steps": [
          {
            "step_number": 1,
            "title": "النهاية عند \\(-\\infty\\)",
            "explanation": "عندما \\(x\\to-\\infty\\)، فإن \\((x+1)^2\\to+\\infty\\) و\\(e^{-x}\\to+\\infty\\).",
            "result": "\\[\\boxed{\\lim_{x\\to-\\infty}f(x)=+\\infty}\\]"
          },
          {
            "step_number": 2,
            "title": "النهاية عند \\(+\\infty\\)",
            "explanation": "نكتب \\(f(x)=(x^2+2x+1)e^{-x}\\). الأسية المتناقصة \\(e^{-x}\\) تتغلب على كل كثير حدود.",
            "result": "\\[\\boxed{\\lim_{x\\to+\\infty}f(x)=0}\\]"
          }
        ],
        "final_answer": "\\[\\boxed{\\lim_{x\\to-\\infty}f(x)=+\\infty\\quad\\text{و}\\quad\\lim_{x\\to+\\infty}f(x)=0}\\]",
        "verification": "النتيجتان مطابقتان للتصحيح النموذجي.",
        "common_mistakes": [
          "اعتبار الشكل \\(+\\infty\\times0\\) عند \\(+\\infty\\) نتيجة مباشرة دون استعمال غلبة الأسية."
        ],
        "hints": [
          "استعمل أن \\(x^ne^{-x}\\to0\\) عندما \\(x\\to+\\infty\\)."
        ],
        "introduction": "نستعمل عبارة \\(f(x)=(x+1)^2e^{-x}\\) وسلوك كثيرة الحدود والأسية عند طرفي المجال.",
        "summary": "\\[\\boxed{\\lim_{x\\to-\\infty}f(x)=+\\infty\\quad\\text{و}\\quad\\lim_{x\\to+\\infty}f(x)=0}\\]",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2017_exc_s02_der_ex04_qI2",
      "display_order": 2,
      "content_type": "question",
      "text": "2) ادرس اتجاه تغير الدالة \\(f\\) ثم شكل جدول تغيراتها.",
      "solution": {
        "strategy": "نحسب المشتقة ونفككها إلى عوامل بسيطة لتحديد إشارتها.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب المشتقة",
            "explanation": "نشتق الجداء \\((x+1)^2e^{-x}\\).",
            "result": "\\[f'(x)=2(x+1)e^{-x}-(x+1)^2e^{-x}\\]"
          },
          {
            "step_number": 2,
            "title": "تبسيط المشتقة",
            "explanation": "نستخرج العامل \\((x+1)e^{-x}\\).",
            "result": "\\[f'(x)=(x+1)(1-x)e^{-x}=\\boxed{(1-x^2)e^{-x}}\\]"
          },
          {
            "step_number": 3,
            "title": "إشارة المشتقة",
            "explanation": "بما أن \\(e^{-x}>0\\)، فإن إشارة \\(f'\\) هي إشارة \\(1-x^2\\).",
            "result": "\\[f'(x)<0\\text{ إذا }x<-1,\\quad f'(x)>0\\text{ إذا }-1<x<1,\\quad f'(x)<0\\text{ إذا }x>1\\]"
          },
          {
            "step_number": 4,
            "title": "القيم المميزة",
            "explanation": "نحسب قيم الدالة عند نقطتي انعدام المشتقة.",
            "result": "\\[f(-1)=0,\\qquad f(1)=\\frac4e\\]"
          }
        ],
        "final_answer": "\\[\\boxed{f\\text{ متناقصة تماما على }]-\\infty,-1]\\text{ و }[1,+\\infty[\\text{ ومتزايدة تماما على }[-1,1]}\\]",
        "verification": "اتجاهات التغير مطابقة للتصحيح النموذجي.",
        "common_mistakes": [
          "الخلط بين إشارة \\(1-x^2\\) وإشارة \\(x^2-1\\)."
        ],
        "hints": [
          "الجذران هما \\(-1\\) و\\(1\\)، و\\(1-x^2\\) موجب بينهما."
        ],
        "introduction": "نحسب المشتقة ونفككها إلى عوامل بسيطة لتحديد إشارتها.",
        "summary": "\\[\\boxed{f\\text{ متناقصة تماما على }]-\\infty,-1]\\text{ و }[1,+\\infty[\\text{ ومتزايدة تماما على }[-1,1]}\\]",
        "answer_style": "explain_then_calculate_then_conclude",
