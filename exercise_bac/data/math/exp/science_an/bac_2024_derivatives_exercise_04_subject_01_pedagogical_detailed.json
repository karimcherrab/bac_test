    {
      "text": "II-5-أ) باستعمال المكاملة بالتجزئة، بين أن \\(\\int_0^1 xe^{-x+1}dx=e-2\\).",
      "solution": {
        "strategy": "نطبق المكاملة بالتجزئة على \\(xe^{1-x}\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "اختيار u وdv",
            "explanation": "نأخذ \\(u=x\\) و\\(dv=e^{1-x}dx\\). إذن \\(du=dx\\) و\\(v=-e^{1-x}\\)."
          },
          {
            "step_number": 2,
            "title": "تطبيق الصيغة",
            "explanation": "\\[\\int xe^{1-x}dx=-xe^{1-x}+\\int e^{1-x}dx=-xe^{1-x}-e^{1-x}+C.\\]"
          },
          {
            "step_number": 3,
            "title": "التعويض بين 0 و1",
            "explanation": "\\[\\int_0^1 xe^{1-x}dx=\\left[-(x+1)e^{1-x}\\right]_0^1=-2+e=e-2.\\]",
            "result": "\\(e-2\\)."
          }
        ],
        "final_answer": "\\(\\boxed{\\int_0^1 xe^{-x+1}dx=e-2}\\).",
        "verification": "تمت مراجعة النتيجة مع التصحيح الرسمي لبكالوريا 2024.",
        "common_mistakes": [],
        "hints": [],
        "introduction": "نطبق المكاملة بالتجزئة على \\(xe^{1-x}\\).",
        "summary": "\\(\\boxed{\\int_0^1 xe^{-x+1}dx=e-2}\\).",
        "answer_style": "explain_then_calculate_then_conclude"
      },
      "id": "2024_s1_der_ex04_q9",
