    {
      "text": "II-1-أ) احسب نهايتي \\(f\\) عند \\(-\\infty\\) و\\(+\\infty\\).",
      "solution": {
        "strategy": "ندرس الحد \\(xe^{1-x}\\) عند كل نهاية.",
        "steps": [
          {
            "step_number": 1,
            "title": "عند +∞",
            "explanation": "عندما \\(x\\to+\\infty\\)، فإن \\(xe^{1-x}=e\\,xe^{-x}\\to0\\)، وبالتالي \\[f(x)=-2x+3-xe^{1-x}\\to-\\infty.\\]",
            "result": "\\(\\lim_{x\\to+\\infty}f(x)=-\\infty\\)."
          },
          {
            "step_number": 2,
            "title": "عند -∞",
            "explanation": "عندما \\(x\\to-\\infty\\)، فإن \\(e^{1-x}\\to+\\infty\\) و\\(x<0\\)، وبالتالي \\(xe^{1-x}\\to-\\infty\\)، ومنه \\(-xe^{1-x}\\to+\\infty\\).",
            "result": "\\(\\lim_{x\\to-\\infty}f(x)=+\\infty\\)."
          }
        ],
        "final_answer": "\\(\\boxed{\\lim_{x\\to-\\infty}f(x)=+\\infty}\\)، و\\(\\boxed{\\lim_{x\\to+\\infty}f(x)=-\\infty}\\).",
        "verification": "تمت مراجعة النتيجة مع التصحيح الرسمي لبكالوريا 2024.",
