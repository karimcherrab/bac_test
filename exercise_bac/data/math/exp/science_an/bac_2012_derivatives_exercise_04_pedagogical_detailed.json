      "content_type": "question",
      "text": "II-6-أ) عين \\(a\\) و \\(b\\) بحيث تكون \\(h(x)=(ax+b)e^x\\) دالة أصلية لـ \\(xe^x\\).",
      "solution": {
        "strategy": "نشتق h ثم نطابق المعاملات.",
        "steps": [
          {
            "step_number": 1,
            "title": "اشتقاق h",
            "explanation": "\\[h'(x)=(ax+a+b)e^x\\].",
            "result": "\\(h'(x)=(ax+a+b)e^x\\)."
          },
          {
            "step_number": 2,
            "title": "المطابقة",
            "explanation": "نريد \\((ax+a+b)e^x=xe^x\\)، إذن \\(a=1\\) و \\(a+b=0\\).",
            "result": "\\(a=1, b=-1\\)."
          }
        ],
        "final_answer": "\\(\\boxed{a=1,\\ b=-1}\\)، ومنه \\(h(x)=(x-1)e^x\\).",
