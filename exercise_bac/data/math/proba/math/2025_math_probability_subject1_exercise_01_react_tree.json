      ],
      "statement_graphs": [],
      "solution": {
        "strategy": "نستعمل \\(P(A\\cap\\overline B)=P(A)P(\\overline B|A)\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "احتمال B̄ بشرط A",
            "explanation": "\\[\nP(\\overline B|A)=1-P(B|A)=1-\\frac3{44}=\\frac{41}{44}.\n\\]"
          },
          {
            "step_number": 2,
            "title": "الحساب",
            "explanation": "\\[\nP(A\\cap\\overline B)=\\frac23\\times\\frac{41}{44}=\\frac{41}{66}.\n\\]"
          }
        ],
        "final_answer": "\\[P(A\\cap\\overline B)=\\frac{41}{66}.\\]"
      }
    },
    {
      "id": "2025_s1_probability_ex01_q2c",
      "display_order": 4,
      "content_type": "question",
      "text": "ج) احسب \\(P_{\\overline B}(A)\\) احتمال سحب 3 كريات من \\(U_1\\) علما أنها ليست من نفس اللون.",
