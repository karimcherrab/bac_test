      "statement_graphs": [],
      "solution": {
        "strategy": "نستعمل قانون الاحتمالات الكلية على الحدثين A وĀ.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب P(B)",
            "explanation": "\\[\nP(B)=P(A)P(B|A)+P(\\overline A)P(B|\\overline A)\n=\\frac23\\times\\frac3{44}+\\frac13\\times\\frac17=\\frac{43}{462}.\n\\]"
          },
          {
            "step_number": 2,
            "title": "حساب P(C)",
            "explanation": "الحدث \\(C\\) لا يمكن أن يتحقق عند السحب من \\(U_2\\)، لذلك:\n\\[\nP(C)=\\frac23\\times\\frac{12}{44}=\\frac2{11}.\n\\]"
          },
          {
            "step_number": 3,
            "title": "حساب P(D)",
            "explanation": "\\[\nP(D)=\\frac23\\times\\frac{29}{44}+\\frac13\\times\\frac67=\\frac{335}{462}.\n\\]"
          },
          {
            "step_number": 4,
            "title": "حساب P(B∪C)",
            "explanation": "الحادثتان \\(B\\) و\\(C\\) متنافيتان، لذلك:\n\\[\nP(B\\cup C)=P(B)+P(C)=\\frac{43}{462}+\\frac{84}{462}=\\frac{127}{462}.\n\\]"
          }
        ],
        "final_answer": "\\[P(B)=\\frac{43}{462},\\qquad P(C)=\\frac2{11},\\qquad P(D)=\\frac{335}{462},\\qquad P(B\\cup C)=\\frac{127}{462}.\\]"
      }
