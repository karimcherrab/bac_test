      "statement_graphs": [],
      "solution": {
        "strategy": "المطلوب هو \\(P(A|\\overline B)\\). نحسب أولا \\(P(\\overline B)\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب P(B̄)",
            "explanation": "\\[\nP(\\overline B)=1-P(B)=1-\\frac{43}{462}=\\frac{419}{462}.\n\\]"
          },
          {
            "step_number": 2,
            "title": "الاحتمال الشرطي",
            "explanation": "ولدينا:\n\\[\nP(A\\cap\\overline B)=\\frac{41}{66}=\\frac{287}{462}.\n\\]\nإذن:\n\\[\nP_{\\overline B}(A)=\\frac{P(A\\cap\\overline B)}{P(\\overline B)}=\\frac{287}{419}.\n\\]"
          }
        ],
        "final_answer": "\\[P_{\\overline B}(A)=\\frac{287}{419}.\\]"
      }
    },
    {
      "id": "2025_s1_probability_ex01_q3",
