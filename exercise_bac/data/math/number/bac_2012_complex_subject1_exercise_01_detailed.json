        ],
        "introduction": "المميز سالب، لذلك للمعادلة حلان مركبان مترافقان.",
        "summary": "الحلان هما \\(\frac{\\sqrt2}{2}(1+i)\\) و\\(\frac{\\sqrt2}{2}(1-i)\\).",
        "answer_style": "explain_then_calculate_then_conclude"
      }
