          {
            "step_number": 2,
            "title": "صورة A",
            "explanation": "\\[\nz_{A'}=e^{i\\pi/4}z_A\n=e^{i\\pi/4}e^{i\\pi/4}\n=e^{i\\pi/2}=i.\n\\]",
            "result": "\\(z_{A'}=i\\)."
          },
          {
            "step_number": 3,
            "title": "صورة B",
            "explanation": "\\[\nz_{B'}=e^{i\\pi/4}z_B\n=e^{i\\pi/4}e^{-i\\pi/4}=1.\n\\]",
            "result": "\\(z_{B'}=1\\)."
          },
          {
            "step_number": 4,
            "title": "صورة C",
            "explanation": "أولا:\n\\[\nz_C=z_A+z_B\n=\\frac{1+i+1-i}{\\sqrt2}=\\sqrt2.\n\\]\nإذن:\n\\[\nz_{C'}=e^{i\\pi/4}\\sqrt2\n=\\sqrt2\\left(\\frac{\\sqrt2}{2}+i\\frac{\\sqrt2}{2}\\right)\n=1+i.\n\\]",
            "result": "\\(z_{C'}=1+i\\)."
          }
