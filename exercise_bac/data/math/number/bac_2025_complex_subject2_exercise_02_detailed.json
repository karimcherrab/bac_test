      "id": "2025_complex_s2_ex02_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1) حل في \\(\\mathbb C\\):\n\\[\n(iz-1+2i)(z^2-4z+5)=0.\n\\]",
      "solution": {
        "strategy": "نستعمل خاصية الجداء المعدوم.",
        "steps": [
          {
            "step_number": 1,
            "title": "حل العامل الأول",
            "explanation": "\\[\niz-1+2i=0\n\\Longleftrightarrow iz=1-2i.\n\\]\nبقسمة الطرفين على \\(i\\):\n\\[\nz=\\frac{1-2i}{i}=-2-i.\n\\]",
            "result": ""
          },
          {
            "step_number": 2,
            "title": "حل العامل الثاني",
            "explanation": "نحل:\n\\[\nz^2-4z+5=0.\n\\]\nلدينا:\n\\[\n\\Delta=16-20=-4.\n\\]\nإذن:\n\\[\nz=\\frac{4\\pm2i}{2}=2\\pm i.\n\\]",
            "result": ""
          }
        ],
        "final_answer": "\\[\n\\boxed{S=\\{-2-i,\\ 2-i,\\ 2+i\\}}\n\\]",
        "verification": "مطابق لعناصر الإجابة النموذجية المرفقة.",
        "common_mistakes": [],
        "hints": [],
        "introduction": "",
        "summary": "\\[\n\\boxed{S=\\{-2-i,\\ 2-i,\\ 2+i\\}}\n\\]",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
