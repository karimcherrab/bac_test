  "questions": [
    {
      "id": "2011_tm_s2_complex_ex02_q1a",
      "display_order": 1,
      "content_type": "question",
      "text": "1/ أ) العدد المركب \\(L\\) معرف كما يلي: \\(L=\\frac{-4\\sqrt2+i\\sqrt2}{5+3i}\\). اكتب \\(L\\) على الشكل الجبري ثم على الشكل الأسي.",
      "axis_tags": [
        "complex_algebraic_form",
        "complex_exponential_form"
      ],
      "statement_graphs": [],
      "solution": {
        "strategy": "نبسط الكسر بضرب البسط والمقام في مرافق المقام، ثم نستخرج الطويلة والعمدة.",
        "steps": [
          {
            "step_number": 1,
            "title": "الضرب في المرافق",
            "explanation": "\\[\nL=\\frac{(-4\\sqrt2+i\\sqrt2)(5-3i)}{(5+3i)(5-3i)}.\n\\]\nالمقام:\n\\[\n25+9=34.\n\\]"
          },
          {
            "step_number": 2,
            "title": "تطوير البسط",
            "explanation": "\\[\n(-4\\sqrt2+i\\sqrt2)(5-3i)\n=-20\\sqrt2+12\\sqrt2 i+5\\sqrt2 i+3\\sqrt2\n=-17\\sqrt2+17\\sqrt2 i.\n\\]\nإذن:\n\\[\nL=-\\frac{\\sqrt2}{2}+i\\frac{\\sqrt2}{2}.\n\\]"
          },
          {
            "step_number": 3,
            "title": "الشكل الأسي",
            "explanation": "طويلة \\(L\\) هي \\(1\\)، كما أن:\n\\[\n\\cos\\theta=-\\frac{\\sqrt2}{2},\\qquad \\sin\\theta=\\frac{\\sqrt2}{2}.\n\\]\nإذن يمكن أخذ:\n\\[\n\\theta=\\frac{3\\pi}{4}.\n\\]\nومن ثم:\n\\[\nL=e^{i3\\pi/4}.\n\\]"
          }
        ],
        "final_answer": "\\(L=-\\frac{\\sqrt2}{2}+i\\frac{\\sqrt2}{2}=e^{i3\\pi/4}\\)."
      }
    },
    {
      "id": "2011_tm_s2_complex_ex02_q1b",
      "display_order": 2,
      "content_type": "question",
      "text": "ب) بين أن: \\(L^{12}+1=0\\)، ثم احسب: \\((-4\\sqrt2+i\\sqrt2)^{12}+(5+3i)^{12}\\).",
      "axis_tags": [
        "complex_powers"
      ],
      "statement_graphs": [],
      "solution": {
        "strategy": "نستعمل الشكل الأسي لـ L، ثم نرجع إلى تعريف L كنسبة بين العددين الموجودين في العبارة المطلوبة.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب L أس 12",
            "explanation": "\\[\nL^{12}=\\left(e^{i3\\pi/4}\\right)^{12}=e^{i9\\pi}=-1.\n\\]\nإذن:\n\\[\nL^{12}+1=0.\n\\]"
          },
          {
            "step_number": 2,
            "title": "استعمال تعريف L",
            "explanation": "بما أن:\n\\[\nL=\\frac{-4\\sqrt2+i\\sqrt2}{5+3i},\n\\]\nفإن:\n\\[\nL^{12}=\\frac{(-4\\sqrt2+i\\sqrt2)^{12}}{(5+3i)^{12}}=-1.\n\\]"
          },
          {
            "step_number": 3,
            "title": "استخراج العبارة المطلوبة",
            "explanation": "إذن:\n\\[\n(-4\\sqrt2+i\\sqrt2)^{12}=-(5+3i)^{12}.\n\\]\nوبالتالي:\n\\[\n(-4\\sqrt2+i\\sqrt2)^{12}+(5+3i)^{12}=0.\n\\]"
          }
        ],
        "final_answer": "\\(L^{12}=-1\\)، وبالتالي القيمة المطلوبة هي \\(0\\)."
      }
    },
    {
      "id": "2011_tm_s2_complex_ex02_q1c",
      "display_order": 3,
      "content_type": "question",
      "text": "ج) \\(n\\) عدد طبيعي فردي و\\(p\\) عدد طبيعي زوجي. أثبت أن: \\(L^{4n}+L^{4p}=0\\).",
      "axis_tags": [
        "complex_powers"
      ],
      "statement_graphs": [],
      "solution": {
        "strategy": "نحسب أولًا L أس 4، ثم نستعمل زوجية أو فردية الأسين.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب L أس 4",
            "explanation": "\\[\nL^4=\\left(e^{i3\\pi/4}\\right)^4=e^{i3\\pi}=-1.\n\\]"
          },
          {
            "step_number": 2,
            "title": "استعمال فردية n",
            "explanation": "بما أن \\(n\\) فردي:\n\\[\nL^{4n}=(L^4)^n=(-1)^n=-1.\n\\]"
          },
          {
            "step_number": 3,
            "title": "استعمال زوجية p",
            "explanation": "وبما أن \\(p\\) زوجي:\n\\[\nL^{4p}=(L^4)^p=(-1)^p=1.\n\\]"
          },
          {
            "step_number": 4,
            "title": "الجمع",
            "explanation": "إذن:\n\\[\nL^{4n}+L^{4p}=-1+1=0.\n\\]"
          }
        ],
        "final_answer": "\\(L^{4n}+L^{4p}=0\\)."
      }
    },
    {
      "id": "2011_tm_s2_complex_ex02_q2a",
      "display_order": 4,
      "content_type": "question",
      "text": "2/ أ) النقطتان \\(A\\) و\\(B\\) لاحقتاهما على الترتيب: \\(z_A=5+3i\\) و\\(z_B=5-3i\\). عين اللاحقة \\(z_{A'}\\) للنقطة \\(A'\\) صورة النقطة \\(A\\) بالتشابه المباشر الذي مركزه النقطة \\(B\\) ونسبته \\(\\sqrt2\\) وزاويته \\(\\frac{3\\pi}{4}\\).",
      "axis_tags": [
        "direct_similarity",
        "complex_geometry"
      ],
      "statement_graphs": [],
      "solution": {
        "strategy": "نستعمل الصيغة المركبة للتشابه المباشر: \\(z_{A'}-z_B=k e^{i\\theta}(z_A-z_B)\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "كتابة معامل التشابه",
            "explanation": "\\[\n\\sqrt2e^{i3\\pi/4}=\\sqrt2\\left(-\\frac{\\sqrt2}{2}+i\\frac{\\sqrt2}{2}\\right)=-1+i.\n\\]"
          },
          {
            "step_number": 2,
            "title": "حساب zA-zB",
            "explanation": "\\[\nz_A-z_B=(5+3i)-(5-3i)=6i.\n\\]"
          },
          {
            "step_number": 3,
            "title": "تطبيق صيغة التشابه",
            "explanation": "\\[\nz_{A'}-z_B=(-1+i)(6i)=-6-6i.\n\\]\nإذن:\n\\[\nz_{A'}=(5-3i)+(-6-6i)=-1-9i.\n\\]"
          }
        ],
        "final_answer": "\\(z_{A'}=-1-9i\\)."
      }
    },
    {
      "id": "2011_tm_s2_complex_ex02_q2b",
      "display_order": 5,
      "content_type": "question",
      "text": "ب) عين \\(z_G\\) لاحقة النقطة \\(G\\) مركز ثقل المثلث \\(ABA'\\).",
      "axis_tags": [
        "complex_geometry"
      ],
      "statement_graphs": [],
      "solution": {
        "strategy": "لاحقة مركز ثقل مثلث هي المتوسط الحسابي للواحق رؤوسه.",
        "steps": [
          {
            "step_number": 1,
            "title": "كتابة علاقة مركز الثقل",
            "explanation": "\\[\nz_G=\\frac{z_A+z_B+z_{A'}}{3}.\n\\]"
          },
          {
            "step_number": 2,
            "title": "التعويض",
            "explanation": "\\[\nz_G=\\frac{(5+3i)+(5-3i)+(-1-9i)}{3}.\n\\]"
          },
          {
            "step_number": 3,
            "title": "التبسيط",
            "explanation": "\\[\nz_G=\\frac{9-9i}{3}=3-3i.\n\\]"
          }
        ],
        "final_answer": "\\(z_G=3-3i\\)."
      }
    }
  ],
