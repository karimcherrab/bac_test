        "summary": "\\[\\boxed{S\\text{ تشابه مباشر، }k=\\sqrt2,\\ \\alpha=\\frac{\\pi}{2},\\ z_\\Omega=\\frac{2-i\\sqrt2}{3}}\\]",
        "answer_style": "explain_then_calculate_then_conclude"
      }
