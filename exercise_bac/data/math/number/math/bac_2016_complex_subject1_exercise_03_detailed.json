        "steps": [
          {
            "step_number": 1,
            "title": "داخل القوس",
            "explanation": "\\[\n\\frac{z_0(1+i\\sqrt3)}2\n=e^{i\\pi/12}e^{i\\pi/3}\n=e^{i5\\pi/12}.\n\\]",
            "result": ""
          },
          {
            "step_number": 2,
            "title": "القوة n",
            "explanation": "\\[\n\\left(e^{i5\\pi/12}\\right)^n=e^{i5n\\pi/12}.\n\\]",
            "result": ""
          },
          {
            "step_number": 3,
            "title": "الشكل المثلثي",
            "explanation": "\\[\n\\cos\\left(\\frac{5n\\pi}{12}\\right)\n+i\\sin\\left(\\frac{5n\\pi}{12}\\right).\n\\]",
            "result": ""
          }
        ],
        "final_answer": "\\[\\boxed{\\cos\\frac{5n\\pi}{12}+i\\sin\\frac{5n\\pi}{12}}\\]",
        "verification": "تمت مراجعة النتيجة مع عناصر الإجابة الرسمية.",
