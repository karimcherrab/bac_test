      "content_type": "question",
      "text": "2-ب) عين \\(\\theta\\).",
      "solution": {
        "strategy": "نكتب \\(z_0=e^{i\theta}\\) لأن طويلته 1.",
        "steps": [
          {
            "step_number": 1,
            "title": "التعويض",
            "explanation": "\\[\n\\frac{z_0(1+i\\sqrt3)}{\\overline{z_0}}\n=\\frac{e^{i\\theta}\\,2e^{i\\pi/3}}{e^{-i\\theta}}\n=2e^{i(2\\theta+\\pi/3)}.\n\\]",
            "result": ""
          },
          {
            "step_number": 2,
            "title": "مقارنة العمد",
            "explanation": "\\[2\\theta+\\frac{\\pi}{3}=\\frac{\\pi}{2}+2k\\pi.\\]",
            "result": ""
          },
          {
            "step_number": 3,
            "title": "استعمال المجال",
            "explanation": "\\[\\theta=\\frac{\\pi}{12}+k\\pi.\\] ومع \\(0\\le\\theta\\le\\pi/2\\) نحصل على \\(\\theta=\\pi/12\\).",
            "result": ""
          }
        ],
        "final_answer": "\\[\\boxed{\\theta=\\frac{\\pi}{12}}\\]",
        "verification": "تمت مراجعة النتيجة مع عناصر الإجابة الرسمية.",
        "common_mistakes": [],
        "hints": [],
        "introduction": "",
        "summary": "\\[\\boxed{\\theta=\\frac{\\pi}{12}}\\]",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
