      "id": "2016_c_s1_e3_q1a",
      "display_order": 1,
      "content_type": "question",
      "text": "1-أ) حل \\(z^2-4z+5=0\\).",
      "solution": {
        "strategy": "نحسب المميز ثم الجذرين.",
        "steps": [
          {
            "step_number": 1,
            "title": "المميز",
            "explanation": "\\[\\Delta=(-4)^2-4\\times1\\times5=-4=(2i)^2.\\]",
            "result": "\\(\\Delta=-4\\)"
          },
          {
            "step_number": 2,
            "title": "الحلان",
            "explanation": "\\[z=\\frac{4\\pm2i}{2}=2\\pm i.\\]",
            "result": "\\(z_1=2+i,\\ z_2=2-i\\)"
          }
        ],
        "final_answer": "\\[\\boxed{z=2+i\\quad\\text{أو}\\quad z=2-i}\\]",
        "verification": "تمت مراجعة النتيجة مع عناصر الإجابة الرسمية.",
        "common_mistakes": [],
        "hints": [],
        "introduction": "",
        "summary": "\\[\\boxed{z=2+i\\quad\\text{أو}\\quad z=2-i}\\]",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2016_c_s1_e3_q1b",
      "display_order": 2,
      "content_type": "question",
      "text": "1-ب) استنتج حلول المعادلة الثانية.",
      "solution": {
        "strategy": "نضع متغيرا مساعدا لتحويلها إلى المعادلة السابقة.",
        "steps": [
          {
            "step_number": 1,
            "title": "التغيير",
            "explanation": "نضع \\[Z=z+1+i(1-\\sqrt3).\\] عندئذ تصبح المعادلة \\[Z^2-4Z+5=0.\\]",
            "result": ""
          },
          {
            "step_number": 2,
            "title": "استعمال السؤال السابق",
            "explanation": "\\[Z=2+i\\quad\\text{أو}\\quad Z=2-i.\\]",
            "result": ""
          },
          {
            "step_number": 3,
            "title": "الرجوع إلى z",
            "explanation": "من \\(z=Z-1-i(1-\\sqrt3)\\):\n\\[\nz'=1+i\\sqrt3,\n\\]\nو\n\\[\nz''=1+i(\\sqrt3-2).\n\\]",
            "result": ""
          }
        ],
        "final_answer": "\\[\\boxed{z'=1+i\\sqrt3,\\qquad z''=1+i(\\sqrt3-2)}\\]",
        "verification": "تمت مراجعة النتيجة مع عناصر الإجابة الرسمية.",
        "common_mistakes": [],
        "hints": [],
        "introduction": "",
        "summary": "\\[\\boxed{z'=1+i\\sqrt3,\\qquad z''=1+i(\\sqrt3-2)}\\]",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
