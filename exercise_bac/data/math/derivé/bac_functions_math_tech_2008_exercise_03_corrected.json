    {
      "id": "2008_ex3_q1c",
      "text": "برهن أنه إذا كان x∈[0,2] فإن f(x)∈[0,2].",
      "axis_tags": [
        "derivative_sign_variation",
        "extrema_variation_table"
      ],
      "solution": {
        "strategy": "نستغل كون f متزايدة على [0,2] للحصول على حصر قيمها.",
        "steps": [
          {
            "step_number": 1,
            "title": "استعمال التزايد",
            "explanation": "لكل x∈[0,2]، وبما أن f متزايدة، فإن f(0)≤f(x)≤f(2)."
          },
          {
            "step_number": 2,
            "title": "تعويض قيم الطرفين",
            "explanation": "نعوض القيم المحسوبة سابقًا.",
            "latex": "\\frac32\\le f(x)\\le\\frac74"
          },
          {
            "step_number": 3,
            "title": "المقارنة مع المجال [0,2]",
            "explanation": "لدينا 0≤3/2 و7/4≤2، إذن المجال [3/2,7/4] محتوى في [0,2]."
          }
        ],
        "final_answer": "لكل \\(x\\in[0,2]\\): \\(f(x)\\in[\frac32,\frac74]\\subset[0,2]\\).",
        "verification": "الحصر أدق من المطلوب، وبالتالي يثبت النتيجة مباشرة.",
        "common_mistakes": [
          "الاكتفاء بقول إن f متزايدة دون كتابة حصر القيم."
        ],
        "hints": [
          "استعمل f(0)≤f(x)≤f(2)."
        ],
