    {
      "id": "2025_tech_math_s2_ex02_q1c",
      "display_order": 3,
      "content_type": "question",
      "text": "1-ج) ادرس اتجاه تغير المتتالية \\((u_n)\\).",
      "solution": {
        "introduction": "ندرس الفرق بين حدين متتاليين.",
        "strategy": "نوحد المقام ثم نفكك البسط.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب الفرق",
            "explanation": "\\[u_{n+1}-u_n=\\frac{3+5u_n}{3+u_n}-u_n.\\]\nإذن:\n\\[u_{n+1}-u_n=\\frac{-u_n^2+2u_n+3}{3+u_n}.\\]"
          },
          {
            "step_number": 2,
            "title": "تفكيك البسط",
            "explanation": "\\[-u_n^2+2u_n+3=(3-u_n)(1+u_n).\\]\nإذن:\n\\[u_{n+1}-u_n=\\frac{(3-u_n)(1+u_n)}{3+u_n}.\\]"
          },
          {
            "step_number": 3,
            "title": "إشارة الفرق",
            "explanation": "من \\(0\\le u_n<3\\):\n\\[3-u_n>0,\\quad1+u_n>0,\\quad3+u_n>0.\\]\nإذن:",
            "result": "\\[u_{n+1}-u_n>0.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{(u_n)\\text{ متزايدة تماما}}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الثاني، التمرين الثاني.",
        "common_mistakes": [
          "الخطأ في تفكيك -u_n²+2u_n+3."
        ],
        "hints": [
          "حاول الحصول على العامل 3-u_n."
        ],
        "summary": "الفرق موجب لكل n، لذا المتتالية متزايدة تماما.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2025_tech_math_s2_ex02_q2a",
      "display_order": 4,
      "content_type": "question",
      "text": "2-أ) بين أن المتتالية \\((v_n)\\) هندسية أساسها \\(\\frac13\\) ثم اكتب \\(v_n\\) بدلالة \\(n\\).",
      "solution": {
        "introduction": "نحسب v_{n+1} باستعمال العلاقة التراجعية.",
        "strategy": "نحسب u_{n+1}-3 وu_{n+1}+1 ثم نقسم.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب uₙ₊₁-3",
            "explanation": "\\[u_{n+1}-3=\\frac{3+5u_n}{3+u_n}-3\n=\\frac{2u_n-6}{3+u_n}=\\frac{2(u_n-3)}{3+u_n}.\\]"
          },
          {
            "step_number": 2,
            "title": "حساب uₙ₊₁+1",
            "explanation": "\\[u_{n+1}+1=\\frac{3+5u_n}{3+u_n}+1\n=\\frac{6+6u_n}{3+u_n}=\\frac{6(1+u_n)}{3+u_n}.\\]"
          },
          {
            "step_number": 3,
            "title": "حساب vₙ₊₁",
            "explanation": "\\[v_{n+1}=\\frac{u_{n+1}-3}{u_{n+1}+1}\n=\\frac{2(u_n-3)}{6(1+u_n)}=\\frac13v_n.\\]",
            "result": "\\((v_n)\\) هندسية أساسها 1/3."
          },
          {
            "step_number": 4,
            "title": "حساب v₀ والحد العام",
            "explanation": "\\[v_0=\\frac{0-3}{1+0}=-3.\\]\nإذن:\n\\[v_n=v_0\\left(\\frac13\\right)^n=-3\\left(\\frac13\\right)^n.\\]",
            "result": "\\(v_n=-3(1/3)^n\\)."
          }
        ],
        "final_answer": "\\(\\boxed{v_n=-3(\\frac13)^n}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الثاني، التمرين الثاني.",
        "common_mistakes": [
          "نسيان أن v₀=-3."
        ],
        "hints": [
          "احسب u_{n+1}-3 وu_{n+1}+1 على حدة."
        ],
        "summary": "النسبة ثابتة وتساوي 1/3.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2025_tech_math_s2_ex02_q2b",
      "display_order": 5,
      "content_type": "question",
      "text": "2-ب) استنتج عبارة \\(u_n\\) بدلالة \\(n\\) ثم احسب \\(\\lim_{n\\to+\\infty}u_n\\).",
      "solution": {
        "introduction": "نستخرج u_n من تعريف v_n ثم نعوض بالحد العام لـv_n.",
        "strategy": "نحل المعادلة v_n=(u_n-3)/(u_n+1).",
        "steps": [
          {
            "step_number": 1,
            "title": "عزل uₙ",
            "explanation": "من:\n\\[v_n=\\frac{u_n-3}{u_n+1}\\]\nنحصل على:\n\\[v_n(u_n+1)=u_n-3.\\]\nإذن:\n\\[(1-v_n)u_n=v_n+3.\\]\nومن ثم:\n\\[u_n=\\frac{v_n+3}{1-v_n}.\\]"
          },
          {
            "step_number": 2,
            "title": "التعويض بعبارة vₙ",
            "explanation": "بما أن:\n\\[v_n=-3\\left(\\frac13\\right)^n,\\]\nفإن:\n\\[u_n=\\frac{3-3(1/3)^n}{1+3(1/3)^n}.\\]\nويمكن أيضا كتابتها:\n\\[u_n=-1+\\frac6{1+3(1/3)^n}.\\]",
            "result": "العبارة الصريحة لـu_n."
          },
          {
            "step_number": 3,
            "title": "حساب النهاية",
            "explanation": "بما أن:\n\\[\\left(\\frac13\\right)^n\\to0,\\]\nفإن:",
            "result": "\\[\\lim_{n\\to+\\infty}u_n=3.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{u_n=\\frac{3-3(1/3)^n}{1+3(1/3)^n}}\\) و\\(\\boxed{\\lim_{n\\to+\\infty}u_n=3}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الثاني، التمرين الثاني.",
        "common_mistakes": [
          "الخطأ في عزل u_n من تعريف v_n."
        ],
        "hints": [
          "اجمع حدود u_n في طرف واحد."
        ],
        "summary": "الصيغة الصريحة تجعل النهاية مباشرة.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2025_tech_math_s2_ex02_q3a",
      "display_order": 6,
      "content_type": "question",
      "text": "3-أ) بين أنه من أجل كل عدد طبيعي \\(n\\): \\(\\frac4{1+u_n}=1-v_n\\).",
      "solution": {
        "introduction": "العلاقة تنتج مباشرة من تعريف v_n.",
        "strategy": "نحسب 1-v_n على مقام مشترك.",
        "steps": [
          {
            "step_number": 1,
            "title": "الحساب",
            "explanation": "\\[1-v_n=1-\\frac{u_n-3}{u_n+1}.\\]\nإذن:\n\\[1-v_n=\\frac{u_n+1-u_n+3}{u_n+1}=\\frac4{u_n+1}.\\]",
            "result": "العلاقة المطلوبة."
          }
        ],
        "final_answer": "\\(\\boxed{\\frac4{1+u_n}=1-v_n}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الثاني، التمرين الثاني.",
