        ],
        "summary": "العلاقة بسيطة وتربط حدود المجموع بالمتتالية الهندسية v.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2025_tech_math_s2_ex02_q3b",
      "display_order": 7,
      "content_type": "question",
      "text": "3-ب) استنتج بدلالة \\(n\\) حساب المجموع \\(S_n=\\frac4{1+u_0}+\\frac4{1+u_1}+\\cdots+\\frac4{1+u_n}\\).",
      "solution": {
        "introduction": "نستعمل العلاقة السابقة لتحويل المجموع إلى مجموع 1-v_k.",
        "strategy": "نحسب مجموع v_k الهندسي.",
        "steps": [
          {
            "step_number": 1,
            "title": "تحويل المجموع",
            "explanation": "\\[S_n=\\sum_{k=0}^{n}(1-v_k)=(n+1)-\\sum_{k=0}^{n}v_k.\\]"
          },
          {
            "step_number": 2,
            "title": "حساب مجموع vₖ",
            "explanation": "لدينا:\n\\[v_k=-3\\left(\\frac13\\right)^k.\\]\nإذن:\n\\[\\sum_{k=0}^{n}v_k=-3\\frac{1-(1/3)^{n+1}}{1-1/3}\n=-\\frac92\\left(1-\\left(\\frac13\\right)^{n+1}\\right).\\]"
          },
          {
            "step_number": 3,
            "title": "التعويض والتبسيط",
            "explanation": "\\[S_n=n+1+\\frac92\\left(1-\\left(\\frac13\\right)^{n+1}\\right).\\]\nإذن:\n\\[S_n=n+\\frac{11}{2}-\\frac32\\left(\\frac13\\right)^n.\\]",
            "result": "النتيجة المطلوبة."
          }
        ],
        "final_answer": "\\(\\boxed{S_n=n+1+\\frac92(1-(\\frac13)^{n+1})=n+\\frac{11}{2}-\\frac32(\\frac13)^n}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الثاني، التمرين الثاني.",
        "common_mistakes": [
          "نسيان أن مجموع 1 من k=0 إلى n يساوي n+1."
        ],
        "hints": [
