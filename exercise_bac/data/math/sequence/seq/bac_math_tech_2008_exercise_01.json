    {
      "id": "math_tech_2008_01_q3",
      "text": "برهن بالتراجع أن \\(0\\le U_n\\le\\sqrt3\\)، ثم برهن أن \\(U_{n+1}>U_n\\) واستنتج التقارب.",
      "display_order": 3,
      "content_type": "question",
      "axis_tags": [
        "mathematical_induction",
        "seq_monotonicity",
        "sequence_limits"
      ],
      "solution": {
        "strategy": "نثبت الحصر ثم ندرس فرق حدين متتاليين.",
        "methodology": {
          "goal": "حل السؤال بطريقة منظمة وفق منهجية البكالوريا.",
          "method": "نثبت الحصر ثم ندرس فرق حدين متتاليين.",
          "why_this_method": "لأنها تستعمل المعطيات بالترتيب وتقدم تبريرا واضحا لكل استنتاج.",
          "used_theorem": "كل متتالية متزايدة ومحدودة من الأعلى متقاربة.",
          "bac_template": [
            "نكتب العلاقة أو الخاصية المستعملة.",
            "نعوض بالمعطيات ونبسط الحساب تدريجيا.",
            "نبرر الإشارة أو النهاية أو الرتابة.",
            "نكتب الاستنتاج النهائي بوضوح."
          ],
          "formal_writing": [
            "تحديد المجال أو شروط الاستعمال.",
            "ترتيب الحسابات على شكل مساويات.",
            "ذكر المبرهنة المناسبة عند الحاجة.",
            "ختم الحل بجواب مباشر."
          ]
        },
        "steps": [
          {
            "step_number": 1,
            "title": "التهيئة",
            "explanation": "\\(U_0=0\\in[0,\\sqrt3]\\)."
          },
          {
            "step_number": 2,
            "title": "الوراثة",
            "explanation": "إذا كان \\(0\\le U_n\\le\\sqrt3\\)، فبما أن \\(f\\) متزايدة و\\(f(\\sqrt3)=\\sqrt3\\):",
            "latex": "0<f(0)\\le U_{n+1}\\le f(\\sqrt3)=\\sqrt3"
          },
          {
            "step_number": 3,
            "title": "الفرق",
            "explanation": "",
            "latex": "U_{n+1}-U_n=\\frac{3-U_n^2}{U_n+2}>0"
          },
          {
            "step_number": 4,
            "title": "التقارب",
            "explanation": "المتتالية متزايدة ومحدودة من الأعلى، إذن متقاربة. حدها يحل \\(\\ell=f(\\ell)\\).",
            "latex": "\\ell^2=3,\\ \\ell\\ge0\\Rightarrow\\ell=\\sqrt3"
          }
        ],
        "final_answer": "\\(0\\le U_n\\le\\sqrt3\\)، و\\((U_n)\\) متزايدة، و\\(\\lim U_n=\\sqrt3\\).",
        "verification": "نراجع النتيجة بالتعويض في العلاقة الأصلية وبمقارنة الحدود الأولى عند الإمكان.",
        "common_mistakes": [
          "الخلط بين الفهرسين \\(n\\) و\\(n+1\\).",
          "استنتاج التقارب دون إثبات الرتابة والمحدودية أو دون صيغة صريحة.",
          "نسيان تحديد الحد الأول عند تحويل المتتالية إلى متتالية هندسية أو حسابية."
        ],
