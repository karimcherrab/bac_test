      "id": "math_tech_2008_01_q4",
      "text": "استعمل المتراجحة المعطاة لإيجاد \\(k\\in]0,1[\\) يحقق \\(|U_{n+1}-\\sqrt3|\\le k|U_n-\\sqrt3|\\)، ثم استنتج النهاية.",
      "display_order": 4,
      "content_type": "question",
      "axis_tags": [
        "contraction",
        "sequence_limits"
      ],
      "solution": {
        "strategy": "نبسط معامل الانكماش ونأخذ أكبر قيمة مناسبة.",
        "methodology": {
          "goal": "حل السؤال بطريقة منظمة وفق منهجية البكالوريا.",
          "method": "نبسط معامل الانكماش ونأخذ أكبر قيمة مناسبة.",
          "why_this_method": "لأنها تستعمل المعطيات بالترتيب وتقدم تبريرا واضحا لكل استنتاج.",
          "used_theorem": "",
          "bac_template": [
            "نكتب العلاقة أو الخاصية المستعملة.",
            "نعوض بالمعطيات ونبسط الحساب تدريجيا.",
            "نبرر الإشارة أو النهاية أو الرتابة.",
            "نكتب الاستنتاج النهائي بوضوح."
          ],
          "formal_writing": [
            "تحديد المجال أو شروط الاستعمال.",
            "ترتيب الحسابات على شكل مساويات.",
            "ذكر المبرهنة المناسبة عند الحاجة.",
            "ختم الحل بجواب مباشر."
          ]
        },
        "steps": [
          {
            "step_number": 1,
            "title": "العلاقة",
            "explanation": "",
            "latex": "|U_{n+1}-\\sqrt3|=\\frac{2-\\sqrt3}{U_n+2}|U_n-\\sqrt3|"
          },
          {
            "step_number": 2,
            "title": "الحصر",
            "explanation": "لأن \\(U_n\\ge0\\)، فإن \\(\\frac{2-\\sqrt3}{U_n+2}\\le\\frac{2-\\sqrt3}{2}\\)."
          },
          {
            "step_number": 3,
            "title": "اختيار الثابت",
            "explanation": "",
            "latex": "k=\\frac{2-\\sqrt3}{2}\\in]0,1["
          },
          {
            "step_number": 4,
            "title": "التكرار",
            "explanation": "",
            "latex": "|U_n-\\sqrt3|\\le k^n|U_0-\\sqrt3|"
          },
          {
            "step_number": 5,
            "title": "النهاية",
            "explanation": "بما أن \\(k^n\\to0\\)، فإن \\(U_n\\to\\sqrt3\\)."
          }
        ],
        "final_answer": "\\(k=\\frac{2-\\sqrt3}{2}\\) ومنه \\(\\lim U_n=\\sqrt3\\).",
