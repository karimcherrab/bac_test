    {
      "id": "math_tech_2025_02_q3",
      "text": "احسب \\(S_n=v_0+\\cdots+v_n\\)، ثم استنتج \\(P_n=u_0u_1\\cdots u_n\\).",
      "display_order": 3,
      "content_type": "question",
      "axis_tags": [
