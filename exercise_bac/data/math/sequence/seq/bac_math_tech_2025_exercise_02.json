    {
      "id": "math_tech_2025_02_q2",
      "text": "بين أن \\((v_n)\\) هندسية أساسها \\(\\frac12\\)، ثم اكتب \\(v_n,u_n\\) واحسب النهاية.",
      "display_order": 2,
      "content_type": "question",
      "axis_tags": [
        "logarithm",
        "geometric_sequence",
        "explicit_sequence"
      ],
      "solution": {
        "strategy": "نأخذ اللوغاريتم.",
        "methodology": {
          "goal": "حل السؤال بطريقة منظمة وفق منهجية البكالوريا.",
          "method": "نأخذ اللوغاريتم.",
          "why_this_method": "لأنها تستعمل المعطيات بالترتيب وتقدم تبريرا واضحا لكل استنتاج.",
          "used_theorem": "",
          "bac_template": [
            "نكتب العلاقة أو الخاصية المستعملة.",
            "نعوض بالمعطيات ونبسط الحساب تدريجيا.",
            "نبرر الإشارة أو النهاية أو الرتابة.",
            "نكتب الاستنتاج النهائي بوضوح."
          ],
          "formal_writing": [
            "تحديد المجال أو شروط الاستعمال.",
            "ترتيب الحسابات على شكل مساويات.",
            "ذكر المبرهنة المناسبة عند الحاجة.",
            "ختم الحل بجواب مباشر."
          ]
        },
        "steps": [
          {
            "step_number": 1,
            "title": "العلاقة",
            "explanation": "",
            "latex": "\\ln u_{n+1}=\\ln2+\\frac12\\ln u_n"
          },
          {
            "step_number": 2,
            "title": "التحويل",
            "explanation": "",
            "latex": "v_{n+1}=\\frac12v_n"
          },
          {
            "step_number": 3,
            "title": "الحد الأول",
            "explanation": "",
            "latex": "v_0=2-2\\ln2"
          },
          {
            "step_number": 4,
            "title": "الحد العام",
            "explanation": "",
            "latex": "v_n=(2-2\\ln2)\\left(\\frac12\\right)^n"
          },
          {
            "step_number": 5,
            "title": "العودة",
            "explanation": "",
            "latex": "u_n=\\exp\\left(2\\ln2+(2-2\\ln2)2^{-n}\\right)"
          },
          {
            "step_number": 6,
            "title": "النهاية",
            "explanation": "",
            "latex": "\\lim u_n=4"
          }
        ],
        "final_answer": "\\(u_n=4\\exp((2-2\\ln2)/2^n)\\) و\\(\\lim u_n=4\\).",
