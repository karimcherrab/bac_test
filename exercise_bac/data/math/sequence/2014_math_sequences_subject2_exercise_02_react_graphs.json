      "id": "2014_s2_sequences_ex02_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1) بين أن الدالة \\(f\\) متزايدة تماما.",
      "axis_tags": [
        "sequence_graphical_representation"
      ],
      "statement_graphs": [],
      "solution": {
        "strategy": "نحسب مشتقة الدالة ثم ندرس إشارتها على المجال.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب المشتقة",
            "explanation": "\\[\nf'(x)=\\frac{(4x)(x+4)-2x^2}{(x+4)^2}=\\frac{2x(x+8)}{(x+4)^2}.\n\\]"
          },
          {
            "step_number": 2,
            "title": "إشارة المشتقة",
            "explanation": "على \\([0,+\\infty[\\) لدينا \\(x\\ge0\\)، \\(x+8>0\\) و\\((x+4)^2>0\\)، إذن:\n\\[\nf'(x)\\ge0.\n\\]\nوتكون موجبة من أجل \\(x>0\\)."
          }
        ],
        "final_answer": "إذن الدالة \\(f\\) متزايدة تماما على \\([0,+\\infty[\\)."
      }
    },
