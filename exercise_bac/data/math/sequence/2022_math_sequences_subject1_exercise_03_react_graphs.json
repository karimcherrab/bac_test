    {
      "id": "2022_s1_sequences_ex03_q1a",
      "display_order": 1,
      "content_type": "question",
      "text": "1) أ- أدرس وضعية \\((C)\\) بالنسبة إلى المستقيم \\((\\Delta)\\) ذي المعادلة \\(y=x\\).",
      "axis_tags": [
        "sequence_graphical_representation"
      ],
      "statement_graphs": [],
      "solution": {
        "strategy": "ندرس إشارة الفرق \\(f(x)-x\\) على \\([0,+\\infty[\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب الفرق",
            "explanation": "\\[\nf(x)-x=\\frac{2x^2+5}{2x+1}-x\n=\\frac{5-x}{2x+1}.\n\\]"
          },
          {
            "step_number": 2,
            "title": "الإشارة",
            "explanation": "على \\([0,+\\infty[\\) لدينا \\(2x+1>0\\)، لذلك إشارة \\(f(x)-x\\) هي إشارة \\(5-x\\).\nإذن \\((C)\\) فوق \\((\\Delta)\\) عندما \\(0\\le x<5\\)، ويتقاطعان عند \\(x=5\\)، و\\((C)\\) تحت \\((\\Delta)\\) عندما \\(x>5\\)."
          }
        ],
        "final_answer": "\\((C)\\) فوق \\((\\Delta)\\) على \\([0,5[\\)، ويتقاطعان عند \\((5,5)\\)، و\\((C)\\) تحت \\((\\Delta)\\) على \\(]5,+\\infty[\\)."
      }
    },
