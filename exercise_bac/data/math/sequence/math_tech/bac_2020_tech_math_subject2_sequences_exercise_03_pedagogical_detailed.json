      "content_type": "question",
      "text": "2-أ) بين أنه من أجل كل عدد طبيعي \\(n\\): \\(u_{n+1}-u_n=\\frac{(2-u_n)(1+u_n)}{u_n+2}\\).",
      "solution": {
        "introduction": "نحسب الفرق ونبسطه.",
        "strategy": "نوحد المقام ثم نفكك البسط.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب الفرق",
            "explanation": "\\[u_{n+1}-u_n=3-\\frac4{u_n+2}-u_n.\\]"
          },
          {
            "step_number": 2,
            "title": "توحيد المقام",
            "explanation": "\\[u_{n+1}-u_n=\\frac{(3-u_n)(u_n+2)-4}{u_n+2}.\\]"
          },
          {
            "step_number": 3,
            "title": "تفكيك البسط",
            "explanation": "\\[(3-u_n)(u_n+2)-4=-u_n^2+u_n+2=(2-u_n)(1+u_n).\\]",
            "result": "\\[u_{n+1}-u_n=\\frac{(2-u_n)(1+u_n)}{u_n+2}.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{u_{n+1}-u_n=\\frac{(2-u_n)(1+u_n)}{u_n+2}}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2020، الموضوع الثاني، التمرين الثالث.",
        "common_mistakes": [
          "الخطأ في نشر (3-u_n)(u_n+2)."
        ],
        "hints": [
          "وحد المقام ثم فكك -u_n²+u_n+2."
        ],
        "summary": "بعد التوحيد يظهر البسط على شكل جداء مناسب لدراسة الإشارة.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
