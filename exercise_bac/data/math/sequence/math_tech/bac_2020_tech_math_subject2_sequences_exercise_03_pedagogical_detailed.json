      "content_type": "question",
      "text": "3-أ) اوجد \\(\\alpha\\) حتى تكون المتتالية \\((v_n)\\) هندسية أساسها \\(\\frac14\\)، ثم احسب حدها الأول \\(v_0\\).",
      "solution": {
        "introduction": "نبحث عن قيمة \\(\\alpha\\) التي تجعل \\(v_{n+1}=\\frac14v_n\\).",
        "strategy": "نبسط u_{n+1} أولا، ثم نختار α بحيث تتحول النسبة إلى ثابت.",
        "steps": [
          {
            "step_number": 1,
            "title": "كتابة u_{n+1} على شكل كسر",
            "explanation": "\\[u_{n+1}=\\frac{3u_n+2}{u_n+2}.\\]"
          },
          {
            "step_number": 2,
            "title": "اختيار α",
            "explanation": "نحسب \\(u_{n+1}-2=\\frac{u_n-2}{u_n+2}\\) و\\(u_{n+1}+1=\\frac{4(u_n+1)}{u_n+2}\\). باختيار \\(\\alpha=-2\\): \\[v_{n+1}=\\frac14v_n.\\]",
            "result": "\\(\\alpha=-2\\)."
          },
          {
            "step_number": 3,
            "title": "حساب v₀",
            "explanation": "\\[v_0=\\frac{1/2-2}{1/2+1}=-1.\\]",
            "result": "\\(v_0=-1\\)."
          }
        ],
        "final_answer": "\\(\\boxed{\\alpha=-2}\\) و\\(\\boxed{v_0=-1}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2020، الموضوع الثاني، التمرين الثالث.",
        "common_mistakes": [
          "اختيار α=2 بدل -2."
        ],
        "hints": [
          "قارن u_{n+1}-2 مع u_n-2."
        ],
        "summary": "القيمة α=-2 تجعل النسبة ثابتة وتساوي 1/4.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
