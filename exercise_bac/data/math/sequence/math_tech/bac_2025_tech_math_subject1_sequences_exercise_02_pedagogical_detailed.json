  "statement": "التمرين الثاني: (04 نقاط)\n\n1) \\((u_n)\\) المتتالية العددية المعرفة بـ:\n\\[\nu_0=e^2\n\\]\nومن أجل كل عدد طبيعي \\(n\\):\n\\[\nu_{n+1}=2\\sqrt{u_n}.\n\\]\n\nأ) احسب الحدين \\(u_1\\) و \\(u_2\\) ثم خمن اتجاه تغير المتتالية \\((u_n)\\).\n\nب) برهن بالتراجع أنه من أجل كل عدد طبيعي \\(n\\):\n\\[\n4<u_n\\le e^2.\n\\]\n\nج) ادرس اتجاه تغير المتتالية \\((u_n)\\).\n\n2) \\((v_n)\\) المتتالية العددية المعرفة على \\(\\mathbb N\\) بـ:\n\\[\nv_n=\\ln u_n-2\\ln2.\n\\]\n\nأ) بين أن المتتالية \\((v_n)\\) هندسية أساسها:\n\\[\n\\frac12\n\\]\nثم اكتب \\(v_n\\) بدلالة \\(n\\).\n\nب) استنتج كتابة \\(u_n\\) بدلالة \\(n\\) ثم احسب:\n\\[\n\\lim_{n\\to+\\infty}u_n.\n\\]\n\n3) أ) احسب بدلالة \\(n\\) المجموع \\(S_n\\) حيث:\n\\[\nS_n=v_0+v_1+\\cdots+v_n.\n\\]\n\nب) استنتج بدلالة \\(n\\) الجداء \\(P_n\\) حيث:\n\\[\nP_n=u_0\\times u_1\\times\\cdots\\times u_n.\n\\]",
  "questions": [
    {
      "id": "2025_tech_math_s1_ex02_q1a",
      "display_order": 1,
      "content_type": "question",
      "text": "1-أ) احسب الحدين \\(u_1\\) و \\(u_2\\) ثم خمن اتجاه تغير المتتالية \\((u_n)\\).",
      "solution": {
        "introduction": "نحسب الحدين الأولين بالتعويض في العلاقة التراجعية، ثم نقارن القيم للحصول على تخمين.",
        "strategy": "نبدأ من u₀=e²، ثم نحسب u₁ وu₂ بالتتابع.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب u₁",
            "explanation": "\\[u_1=2\\sqrt{u_0}=2\\sqrt{e^2}=2e.\\]",
            "result": "\\(u_1=2e\\)."
          },
          {
            "step_number": 2,
            "title": "حساب u₂",
            "explanation": "\\[u_2=2\\sqrt{u_1}=2\\sqrt{2e}.\\]",
            "result": "\\(u_2=2\\sqrt{2e}\\)."
          },
          {
            "step_number": 3,
            "title": "التخمين",
            "explanation": "لدينا تقريبًا:\n\\[u_0=e^2\\approx7.39,\\quad u_1=2e\\approx5.44,\\quad u_2=2\\sqrt{2e}\\approx4.66.\\]\nفنلاحظ أن الحدود الأولى تتناقص.",
            "result": "نتخمن أن \\((u_n)\\) متناقصة تماما."
          }
        ],
        "final_answer": "\\(\\boxed{u_1=2e,\\quad u_2=2\\sqrt{2e}}\\)، والتخمين: \\((u_n)\\) متناقصة تماما.",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الأول، التمرين الثاني.",
        "common_mistakes": [
          "كتابة \\(\\sqrt{e^2}=e^2\\) بدل \\(e\\)."
        ],
        "hints": [
          "تذكر أن e>0، لذلك √(e²)=e."
        ],
        "summary": "الحدود الأولى توحي بأن المتتالية متناقصة.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2025_tech_math_s1_ex02_q1b",
      "display_order": 2,
      "content_type": "question",
      "text": "1-ب) برهن بالتراجع أنه من أجل كل عدد طبيعي \\(n\\): \\(4<u_n\\le e^2\\).",
      "solution": {
        "introduction": "نثبت أن جميع حدود المتتالية تبقى داخل المجال \\(]4,e^2]\\).",
        "strategy": "نستعمل البرهان بالتراجع مع العلاقة u_{n+1}=2√u_n.",
        "steps": [
          {
            "step_number": 1,
            "title": "التحقق عند n=0",
            "explanation": "لدينا:\n\\[u_0=e^2.\\]\nوبما أن \\(e>2\\)، فإن \\(e^2>4\\). لذلك:\n\\[4<u_0\\le e^2.\\]"
          },
          {
            "step_number": 2,
            "title": "فرضية التراجع",
            "explanation": "نفترض أنه من أجل عدد طبيعي \\(n\\):\n\\[4<u_n\\le e^2.\\]"
          },
          {
            "step_number": 3,
            "title": "إثبات الحد السفلي",
            "explanation": "من \\(u_n>4\\) نحصل على:\n\\[\\sqrt{u_n}>2.\\]\nإذن:\n\\[u_{n+1}=2\\sqrt{u_n}>4.\\]"
          },
          {
            "step_number": 4,
            "title": "إثبات الحد العلوي",
            "explanation": "من \\(u_n\\le e^2\\):\n\\[\\sqrt{u_n}\\le e.\\]\nإذن:\n\\[u_{n+1}\\le2e.\\]\nوبما أن \\(e>2\\)، فإن:\n\\[2e<e^2.\\]\nومن ثم:\n\\[u_{n+1}\\le e^2.\\]",
            "result": "\\[4<u_{n+1}\\le e^2.\\]"
          },
          {
            "step_number": 5,
            "title": "الخلاصة",
            "explanation": "حسب مبدأ التراجع:\n\\[4<u_n\\le e^2\\]\nلكل \\(n\\in\\mathbb N\\)."
          }
        ],
        "final_answer": "\\(\\boxed{4<u_n\\le e^2\\text{ لكل }n\\in\\mathbb N}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الأول، التمرين الثاني.",
        "common_mistakes": [
          "نسيان استعمال e>2 لإثبات 2e<e²."
        ],
        "hints": [
          "من u_n>4 استنتج √u_n>2."
        ],
        "summary": "المجال ]4,e²] مستقر بالعلاقة التراجعية.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2025_tech_math_s1_ex02_q1c",
      "display_order": 3,
      "content_type": "question",
      "text": "1-ج) ادرس اتجاه تغير المتتالية \\((u_n)\\).",
      "solution": {
        "introduction": "نحسب الفرق بين حدين متتاليين ونستعمل الحصر السابق.",
        "strategy": "نستخرج √u_n عاملا مشتركا.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب الفرق",
            "explanation": "\\[u_{n+1}-u_n=2\\sqrt{u_n}-u_n.\\]\nنكتب \\(u_n=(\\sqrt{u_n})^2\\)، فنحصل على:\n\\[u_{n+1}-u_n=\\sqrt{u_n}(2-\\sqrt{u_n}).\\]"
          },
          {
            "step_number": 2,
            "title": "إشارة الفرق",
            "explanation": "من السؤال السابق:\n\\[u_n>4\\Rightarrow\\sqrt{u_n}>2.\\]\nإذن:\n\\[2-\\sqrt{u_n}<0.\\]\nكما أن \\(\\sqrt{u_n}>0\\). لذلك:",
            "result": "\\[u_{n+1}-u_n<0.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{(u_n)\\text{ متناقصة تماما}}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الأول، التمرين الثاني.",
        "common_mistakes": [
          "دراسة إشارة 2-√u_n دون استعمال u_n>4."
        ],
        "hints": [
          "اكتب u_n=(√u_n)²."
        ],
        "summary": "الفرق سالب لكل n، لذا المتتالية متناقصة تماما.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2025_tech_math_s1_ex02_q2a",
      "display_order": 4,
      "content_type": "question",
      "text": "2-أ) بين أن المتتالية \\((v_n)\\) هندسية أساسها \\(\\frac12\\) ثم اكتب \\(v_n\\) بدلالة \\(n\\).",
      "solution": {
        "introduction": "نحسب v_{n+1} باستعمال العلاقة التراجعية للمتتالية u.",
        "strategy": "نستعمل خواص اللوغاريتم ثم نحسب v₀.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب vₙ₊₁",
            "explanation": "\\[v_{n+1}=\\ln u_{n+1}-2\\ln2.\\]\nوبما أن:\n\\[u_{n+1}=2\\sqrt{u_n},\\]\nفإن:\n\\[v_{n+1}=\\ln(2\\sqrt{u_n})-2\\ln2.\\]\nأي:\n\\[v_{n+1}=\\ln2+\\frac12\\ln u_n-2\\ln2\n=\\frac12(\\ln u_n-2\\ln2).\\]"
          },
          {
            "step_number": 2,
            "title": "العلاقة الهندسية",
            "explanation": "\\[v_{n+1}=\\frac12v_n.\\]",
            "result": "\\((v_n)\\) هندسية أساسها \\(1/2\\)."
          },
          {
            "step_number": 3,
            "title": "حساب v₀",
            "explanation": "\\[v_0=\\ln(e^2)-2\\ln2=2-2\\ln2=2(1-\\ln2).\\]"
          },
          {
            "step_number": 4,
            "title": "الحد العام",
            "explanation": "\\[v_n=v_0\\left(\\frac12\\right)^n\n=2(1-\\ln2)\\left(\\frac12\\right)^n.\\]\nومن ثم:\n\\[v_n=\\frac{1-\\ln2}{2^{n-1}}.\\]",
            "result": "العبارة المطلوبة."
          }
        ],
        "final_answer": "\\(\\boxed{v_n=2(1-\\ln2)(\\frac12)^n=\\frac{1-\\ln2}{2^{n-1}}}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الأول، التمرين الثاني.",
        "common_mistakes": [
          "نسيان أن ln√u_n=(1/2)ln u_n."
        ],
        "hints": [
          "اكتب ln(2√u_n)=ln2+(1/2)lnu_n."
        ],
        "summary": "اللوغاريتم يحول العلاقة الجذرية إلى متتالية هندسية.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2025_tech_math_s1_ex02_q2b",
      "display_order": 5,
      "content_type": "question",
      "text": "2-ب) استنتج كتابة \\(u_n\\) بدلالة \\(n\\) ثم احسب \\(\\lim_{n\\to+\\infty}u_n\\).",
      "solution": {
        "introduction": "نرجع من v_n إلى u_n باستعمال تعريف v_n.",
        "strategy": "نعزل ln u_n ثم نطبق الدالة الأسية.",
        "steps": [
          {
            "step_number": 1,
            "title": "استخراج ln uₙ",
            "explanation": "من:\n\\[v_n=\\ln u_n-2\\ln2\\]\nنحصل على:\n\\[\\ln u_n=v_n+2\\ln2.\\]"
          },
          {
            "step_number": 2,
            "title": "استخراج uₙ",
            "explanation": "\\[u_n=e^{v_n+2\\ln2}=e^{v_n}e^{\\ln4}=4e^{v_n}.\\]\nإذن:\n\\[u_n=4e^{\\frac{1-\\ln2}{2^{n-1}}}.\\]",
            "result": "العبارة الصريحة لـu_n."
          },
          {
            "step_number": 3,
            "title": "حساب النهاية",
            "explanation": "بما أن:\n\\[\\frac{1-\\ln2}{2^{n-1}}\\to0,\\]\nفإن:\n\\[e^{\\frac{1-\\ln2}{2^{n-1}}}\\to1.\\]\nلذلك:",
            "result": "\\[\\lim_{n\\to+\\infty}u_n=4.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{u_n=4e^{\\frac{1-\\ln2}{2^{n-1}}}}\\) و\\(\\boxed{\\lim_{n\\to+\\infty}u_n=4}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الأول، التمرين الثاني.",
        "common_mistakes": [
          "نسيان أن e^{2ln2}=4."
        ],
        "hints": [
          "استعمل ln u_n=v_n+ln4."
        ],
        "summary": "الأس في الصيغة الصريحة يقترب من الصفر، فتقترب u_n من 4.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2025_tech_math_s1_ex02_q3a",
      "display_order": 6,
      "content_type": "question",
      "text": "3-أ) احسب بدلالة \\(n\\) المجموع \\(S_n=v_0+v_1+\\cdots+v_n\\).",
      "solution": {
        "introduction": "المتتالية v هندسية أساسها 1/2، لذلك نستعمل قانون مجموع متتالية هندسية.",
        "strategy": "نطبق قانون المجموع من k=0 إلى n.",
        "steps": [
          {
            "step_number": 1,
            "title": "تطبيق قانون المجموع",
            "explanation": "\\[S_n=v_0\\frac{1-(1/2)^{n+1}}{1-1/2}.\\]"
          },
          {
            "step_number": 2,
            "title": "التعويض بـv₀",
            "explanation": "بما أن:\n\\[v_0=2(1-\\ln2),\\]\nفإن:\n\\[S_n=2(1-\\ln2)\\times2\\left(1-\\left(\\frac12\\right)^{n+1}\\right).\\]",
            "result": "\\[S_n=4(1-\\ln2)\\left(1-\\left(\\frac12\\right)^{n+1}\\right).\\]"
          }
        ],
        "final_answer": "\\(\\boxed{S_n=4(1-\\ln2)(1-(\\frac12)^{n+1})}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الأول، التمرين الثاني.",
        "common_mistakes": [
          "نسيان العامل 2 الناتج عن القسمة على 1-1/2."
        ],
        "hints": [
          "عدد الحدود من v₀ إلى v_n هو n+1."
        ],
        "summary": "المجموع هندسي مباشر.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2025_tech_math_s1_ex02_q3b",
      "display_order": 7,
      "content_type": "question",
      "text": "3-ب) استنتج بدلالة \\(n\\) الجداء \\(P_n=u_0u_1\\cdots u_n\\).",
      "solution": {
        "introduction": "نستعمل العلاقة \\(u_k=4e^{v_k}\\) لكل k.",
        "strategy": "نحوّل الجداء إلى قوة للعدد 4 مضروبة في أس مجموع v_k.",
        "steps": [
          {
            "step_number": 1,
            "title": "تعويض uₖ",
            "explanation": "\\[u_k=4e^{v_k}.\\]\nإذن:\n\\[P_n=\\prod_{k=0}^{n}(4e^{v_k}).\\]"
          },
          {
            "step_number": 2,
            "title": "تجميع العوامل",
            "explanation": "يوجد \\(n+1\\) عاملًا من العدد 4، لذلك:\n\\[P_n=4^{n+1}e^{v_0+v_1+\\cdots+v_n}.\\]\nوبما أن المجموع هو \\(S_n\\):",
            "result": "\\[P_n=4^{n+1}e^{S_n}.\\]"
          },
          {
            "step_number": 3,
            "title": "صيغة كاملة بدلالة n",
            "explanation": "بالتعويض بعبارة \\(S_n\\):\n\\[P_n=4^{n+1}\\exp\\left(4(1-\\ln2)\\left(1-\\left(\\frac12\\right)^{n+1}\\right)\\right).\\]"
          }
        ],
        "final_answer": "\\(\\boxed{P_n=4^{n+1}e^{S_n}}\\)، أي \\(\\boxed{P_n=4^{n+1}\\exp(4(1-\\ln2)(1-(1/2)^{n+1}))}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2025، الموضوع الأول، التمرين الثاني.",
        "common_mistakes": [
          "نسيان أن عدد عوامل 4 هو n+1."
        ],
        "hints": [
          "عند ضرب e^{v_k} نجمع الأسس."
        ],
        "summary": "الجداء يتحول إلى قوة في 4 وأس لمجموع v_k.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    }
