  "statement": "التمرين الثاني: (04 نقاط)\n\n\\((u_n)\\) المتتالية العددية المعرفة بـ:\n\\[\nu_0=1\n\\]\nومن أجل كل عدد طبيعي \\(n\\):\n\\[\nu_{n+1}=\\frac23u_n+1.\n\\]\n\n1) برهن بالتراجع أنه من أجل كل عدد طبيعي \\(n\\):\n\\[\nu_n<3.\n\\]\n\n2) بين أن \\((u_n)\\) متزايدة تماما.\n\n3) \\((v_n)\\) المتتالية العددية المعرفة على \\(\\mathbb N\\) بـ:\n\\[\nv_n=u_n-3.\n\\]\n\nأ) بين أن المتتالية \\((v_n)\\) هندسية أساسها:\n\\[\n\\frac23\n\\]\nيطلب تعيين حدها الأول \\(v_0\\).\n\nب) عين عبارة الحد العام \\(v_n\\) بدلالة \\(n\\) ثم استنتج أنه من أجل كل عدد طبيعي \\(n\\):\n\\[\nu_n=-2\\left(\\frac23\\right)^n+3.\n\\]\n\nج) احسب:\n\\[\n\\lim_{n\\to+\\infty}u_n.\n\\]\n\n4) نضع من أجل كل عدد طبيعي \\(n\\):\n\\[\nS_n=v_0+v_1+\\cdots+v_n\n\\]\nو:\n\\[\nT_n=u_0+u_1+\\cdots+u_n.\n\\]\n\nاحسب \\(S_n\\) بدلالة \\(n\\) ثم بين أنه من أجل كل عدد طبيعي \\(n\\):\n\\[\nT_n=3n-3+4\\left(\\frac23\\right)^n.\n\\]",
  "questions": [
    {
      "id": "2023_tech_math_s1_ex02_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1) برهن بالتراجع أنه من أجل كل عدد طبيعي \\(n\\): \\(u_n<3\\).",
      "solution": {
        "introduction": "نثبت أن كل حدود المتتالية تبقى أصغر من 3 باستعمال البرهان بالتراجع.",
        "strategy": "نتحقق من البداية عند n=0 ثم نثبت انتقال الخاصية إلى n+1.",
        "steps": [
          {
            "step_number": 1,
            "title": "التحقق عند n=0",
            "explanation": "لدينا:\n\\[u_0=1<3.\\]",
            "result": "الخاصية صحيحة عند \\(n=0\\)."
          },
          {
            "step_number": 2,
            "title": "فرضية التراجع",
            "explanation": "نفترض أنه من أجل عدد طبيعي \\(n\\):\n\\[u_n<3.\\]"
          },
          {
            "step_number": 3,
            "title": "الانتقال إلى n+1",
            "explanation": "من فرضية التراجع:\n\\[\\frac23u_n<\\frac23\\times3=2.\\]\nبإضافة 1:\n\\[\\frac23u_n+1<3.\\]\nلكن:\n\\[u_{n+1}=\\frac23u_n+1.\\]\nإذن:",
            "result": "\\[u_{n+1}<3.\\]"
          },
          {
            "step_number": 4,
            "title": "الخلاصة",
            "explanation": "حسب مبدأ التراجع:\n\\[u_n<3\\]\nلكل \\(n\\in\\mathbb N\\)."
          }
        ],
        "final_answer": "\\(\\boxed{u_n<3\\text{ لكل }n\\in\\mathbb N}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2023، الموضوع الأول، التمرين الثاني.",
        "common_mistakes": [
          "نسيان إضافة 1 بعد ضرب المتراجحة في 2/3."
        ],
        "hints": [
          "استعمل مباشرة العلاقة u_{n+1}=2u_n/3+1."
        ],
        "summary": "الحد 3 يبقى حدا أعلى لجميع حدود المتتالية.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2023_tech_math_s1_ex02_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "2) بين أن \\((u_n)\\) متزايدة تماما.",
      "solution": {
        "introduction": "ندرس الفرق بين حدين متتاليين.",
        "strategy": "نحسب \\(u_{n+1}-u_n\\) ثم نستعمل الحصر السابق \\(u_n<3\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب الفرق",
            "explanation": "\\[u_{n+1}-u_n=\\frac23u_n+1-u_n=1-\\frac13u_n.\\]\nأي:\n\\[u_{n+1}-u_n=\\frac{3-u_n}{3}.\\]"
          },
          {
            "step_number": 2,
            "title": "إشارة الفرق",
            "explanation": "من السؤال السابق:\n\\[u_n<3\\Rightarrow 3-u_n>0.\\]\nإذن:",
            "result": "\\[u_{n+1}-u_n>0.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{(u_n)\\text{ متزايدة تماما}}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2023، الموضوع الأول، التمرين الثاني.",
        "common_mistakes": [
          "الخطأ في تبسيط u_{n+1}-u_n."
        ],
        "hints": [
          "استعمل u_n<3."
        ],
        "summary": "الفرق موجب لكل n، لذلك المتتالية متزايدة تماما.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
    {
      "id": "2023_tech_math_s1_ex02_q3a",
      "display_order": 3,
      "content_type": "question",
      "text": "3-أ) بين أن المتتالية \\((v_n)\\) هندسية أساسها \\(\\frac23\\) يطلب تعيين حدها الأول \\(v_0\\).",
      "solution": {
        "introduction": "نحسب \\(v_{n+1}\\) باستعمال تعريف \\(v_n\\).",
        "strategy": "نعوض u_{n+1} ثم نكتب النتيجة بدلالة v_n.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب vₙ₊₁",
            "explanation": "\\[v_{n+1}=u_{n+1}-3=\\frac23u_n+1-3.\\]\nإذن:\n\\[v_{n+1}=\\frac23u_n-2=\\frac23(u_n-3).\\]"
          },
          {
            "step_number": 2,
            "title": "استخراج العلاقة",
            "explanation": "بما أن \\(v_n=u_n-3\\)، نحصل على:\n\\[v_{n+1}=\\frac23v_n.\\]",
            "result": "\\((v_n)\\) هندسية أساسها \\(2/3\\)."
          },
          {
            "step_number": 3,
            "title": "حساب v₀",
            "explanation": "\\[v_0=u_0-3=1-3=-2.\\]",
            "result": "\\(v_0=-2\\)."
          }
        ],
        "final_answer": "\\(\\boxed{v_{n+1}=\\frac23v_n},\\quad\\boxed{v_0=-2}\\).",
        "verification": "تمت مراجعة الحل مع الإجابة النموذجية الرسمية لبكالوريا 2023، الموضوع الأول، التمرين الثاني.",
        "common_mistakes": [
          "نسيان أن v_n=u_n-3."
        ],
        "hints": [
          "حاول استخراج العامل 2/3."
        ],
        "summary": "وجدنا نسبة ثابتة تساوي 2/3 وحدا أول يساوي -2.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
    },
