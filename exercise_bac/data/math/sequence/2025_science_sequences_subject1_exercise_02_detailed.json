  "questions": [
    {
      "id": "2025_s1_ex02_q1a",
      "display_order": 1,
      "content_type": "question",
      "text": "1) أ) انقل الشكل على ورقة الإجابة ثم مثل على حامل محور الفواصل الحدود \\(u_0\\)، \\(u_1\\)، \\(u_2\\) و \\(u_3\\) (دون حسابها مبرزا خطوط التمثيل).",
      "axis_tags": [
        "graphical_sequence"
      ],
      "statement_graphs": [
        "2025_s1_ex02_source_graph"
      ],
      "solution": {
        "strategy": "نستعمل طريقة السلم بين المنحنى \\((C_f)\\) والمستقيم \\((\\Delta):y=x\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "الانطلاق من u_0",
            "explanation": "نضع \\(u_0=-1\\) على محور الفواصل."
          },
          {
            "step_number": 2,
            "title": "إنشاء u_1",
            "explanation": "من \\(u_0\\) نصعد عموديا إلى المنحنى \\((C_f)\\)، ثم نتحرك أفقيا إلى المستقيم \\(y=x\\)، وبعدها نسقط على محور الفواصل فنحصل على \\(u_1\\)."
          },
          {
            "step_number": 3,
            "title": "إنشاء u_2 وu_3",
            "explanation": "نكرر نفس العملية انطلاقا من \\(u_1\\) للحصول على \\(u_2\\)، ثم من \\(u_2\\) للحصول على \\(u_3\\)."
          }
        ],
        "final_answer": "تمثل الحدود \\(u_0,u_1,u_2,u_3\\) بيانيا بطريقة السلم كما في الشكل."
      }
    },
    {
      "id": "2025_s1_ex02_q1b",
      "display_order": 2,
      "content_type": "question",
      "text": "ب) ضع تخمينا حول اتجاه تغير المتتالية \\((u_n)\\) وتقاربها.",
      "axis_tags": [
        "graphical_conjecture",
        "sequence_convergence"
      ],
      "statement_graphs": [
        "2025_s1_ex02_source_graph"
      ],
      "solution": {
        "strategy": "نقرأ سلوك الحدود من الرسم.",
        "steps": [
          {
            "step_number": 1,
            "title": "اتجاه التغير",
            "explanation": "من التمثيل نلاحظ أن الحدود تتناوب حول نقطة ثابتة، لذلك لا يظهر اتجاه تغير واحد ثابت؛ فنخمن أن المتتالية ليست رتيبة."
          },
          {
            "step_number": 2,
            "title": "التقارب",
            "explanation": "السلم البياني يقترب من نقطة تقاطع \\((C_f)\\) مع \\(y=x\\). نقطة التقاطع الموجبة تحقق:\n\\[\nx=\\frac3{x+2}\\iff x^2+2x-3=0.\n\\]\nومنها \\(x=1\\) أو \\(x=-3\\)، لكن \\(-3\\notin[-1,+\\infty[\\)، إذن القيمة المناسبة هي \\(1\\)."
          },
          {
            "step_number": 3,
            "title": "التخمين النهائي",
            "explanation": "إذن نتخمن أن \\((u_n)\\) ليست رتيبة ومتقاربة نحو \\(1\\)."
          }
        ],
        "final_answer": "التخمين: \\(\\boxed{(u_n)\\text{ ليست رتيبة و }u_n\\to1}\\)."
      }
    },
    {
      "id": "2025_s1_ex02_q2a",
      "display_order": 3,
      "content_type": "question",
      "text": "2) أ) بين أن المتتالية \\((v_n)\\) هندسية أساسها \\(-\\frac13\\) ثم اكتب \\(v_n\\) بدلالة \\(n\\).",
      "axis_tags": [
        "auxiliary_sequence",
        "geometric_sequence"
      ],
      "solution": {
        "strategy": "نحسب \\(v_{n+1}\\) بدلالة \\(v_n\\)، ثم نحسب \\(v_0\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "كتابة v_{n+1}",
            "explanation": "\\[\nv_{n+1}=\\frac{1-u_{n+1}}{3+u_{n+1}}.\n\\]"
          },
          {
            "step_number": 2,
            "title": "استعمال u_{n+1}=3/(u_n+2)",
            "explanation": "لدينا:\n\\[\n1-u_{n+1}=1-\\frac3{u_n+2}=\\frac{u_n-1}{u_n+2},\n\\]\nوكذلك:\n\\[\n3+u_{n+1}=3+\\frac3{u_n+2}=\\frac{3(u_n+3)}{u_n+2}.\n\\]"
          },
          {
            "step_number": 3,
            "title": "إظهار العلاقة الهندسية",
            "explanation": "إذن:\n\\[\nv_{n+1}=\\frac{u_n-1}{3(u_n+3)}=-\\frac13\\frac{1-u_n}{u_n+3}=-\\frac13v_n.\n\\]\nفتكون \\((v_n)\\) هندسية أساسها:\n\\[\n\\boxed{q=-\\frac13}.\n\\]"
          },
          {
            "step_number": 4,
            "title": "حساب v_0",
            "explanation": "\\[\nv_0=\\frac{1-u_0}{3+u_0}=\\frac{1-(-1)}{3-1}=1.\n\\]"
          },
          {
            "step_number": 5,
            "title": "الحد العام",
            "explanation": "\\[\n\\boxed{v_n=\\left(-\\frac13\\right)^n}.\n\\]"
          }
        ],
        "final_answer": "\\(\\boxed{v_n=(-\\frac13)^n}\\)."
      }
    },
    {
      "id": "2025_s1_ex02_q2b",
      "display_order": 4,
      "content_type": "question",
      "text": "ب) استنتج كتابة \\(u_n\\) بدلالة \\(n\\) ثم احسب \\(\\lim_{n\\to+\\infty}u_n\\).",
      "axis_tags": [
        "explicit_sequence_formula",
        "sequence_limit"
      ],
      "solution": {
        "strategy": "نحل تعريف \\(v_n\\) بالنسبة إلى \\(u_n\\)، ثم نعوض \\(v_n=(-1/3)^n\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "الانطلاق من تعريف v_n",
            "explanation": "\\[\nv_n=\\frac{1-u_n}{3+u_n}.\n\\]\nإذن:\n\\[\nv_n(3+u_n)=1-u_n.\n\\]"
          },
          {
            "step_number": 2,
            "title": "تجميع حدود u_n",
            "explanation": "\\[\n3v_n+v_nu_n=1-u_n\n\\Rightarrow u_n(1+v_n)=1-3v_n.\n\\]\nومن ثم:\n\\[\n\\boxed{u_n=\\frac{1-3v_n}{1+v_n}}.\n\\]"
          },
          {
            "step_number": 3,
            "title": "التعويض عن v_n",
            "explanation": "\\[\n\\boxed{u_n=\\frac{1-3(-\\frac13)^n}{1+(-\\frac13)^n}}.\n\\]\nويمكن أيضا كتابتها:\n\\[\n\\boxed{u_n=-3+\\frac4{1+(-\\frac13)^n}}.\n\\]"
          },
          {
            "step_number": 4,
            "title": "حساب النهاية",
            "explanation": "بما أن:\n\\[\n\\left(-\\frac13\\right)^n\\to0,\n\\]\nفإن:\n\\[\n\\lim u_n=\\frac{1-0}{1+0}=1.\n\\]"
          }
        ],
        "final_answer": "\\(\\boxed{u_n=\\frac{1-3(-\\frac13)^n}{1+(-\\frac13)^n}}\\)، و \\(\\boxed{\\lim u_n=1}\\)."
      }
    },
    {
      "id": "2025_s1_ex02_q3",
      "display_order": 5,
      "content_type": "question",
      "text": "3) احسب بدلالة \\(n\\) كلا من \\(S_n\\) و \\(T_n\\) حيث: \\(S_n=v_0+v_1+\\cdots+v_n\\) و \\(T_n=\\ln|v_0|+\\ln|v_1|+\\cdots+\\ln|v_n|\\).",
      "axis_tags": [
        "geometric_sum",
        "logarithmic_sum"
      ],
      "solution": {
        "strategy": "نحسب \\(S_n\\) كمجموع هندسي، ثم نحسب \\(T_n\\) باستعمال القيمة المطلقة لـ\\(v_k\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب S_n",
            "explanation": "لدينا \\(v_0=1\\) و\\(q=-\\frac13\\)، إذن:\n\\[\nS_n=\\frac{1-(-\\frac13)^{n+1}}{1+\\frac13}\n=\\frac34\\left[1-\\left(-\\frac13\\right)^{n+1}\\right].\n\\]\nأي:\n\\[\n\\boxed{S_n=\\frac34\\left[1-(-\\frac13)^{n+1}\\right]}.\n\\]"
          },
          {
            "step_number": 2,
            "title": "كتابة |v_k|",
            "explanation": "بما أن:\n\\[\nv_k=\\left(-\\frac13\\right)^k,\n\\]\nفإن:\n\\[\n|v_k|=\\left(\\frac13\\right)^k.\n\\]"
          },
          {
            "step_number": 3,
            "title": "حساب كل لوغاريتم",
            "explanation": "\\[\n\\ln|v_k|=\\ln\\left(\\frac13\\right)^k=k\\ln\\left(\\frac13\\right)=-k\\ln3.\n\\]"
          },
          {
            "step_number": 4,
            "title": "حساب T_n",
            "explanation": "إذن:\n\\[\nT_n=-\\ln3\\sum_{k=0}^{n}k.\n\\]\nومعلوم أن:\n\\[\n\\sum_{k=0}^{n}k=\\frac{n(n+1)}2.\n\\]\nومن ثم:\n\\[\n\\boxed{T_n=-\\frac12n(n+1)\\ln3}.\n\\]"
          }
        ],
        "final_answer": "\\(\\boxed{S_n=\\frac34[1-(-\\frac13)^{n+1}]}\\)، و \\(\\boxed{T_n=-\\frac12n(n+1)\\ln3}\\)."
      }
    }
  ]
