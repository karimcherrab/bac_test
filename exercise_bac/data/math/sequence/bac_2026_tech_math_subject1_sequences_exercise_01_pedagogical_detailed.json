      "text": "1-أ) احسب \\(u_1\\) و \\(u_2\\).",
      "solution": {
        "introduction": "نحسب الحدين الأولين بالتعويض المباشر في العلاقة التراجعية.",
        "strategy": "نستعمل n=0 لحساب u₁ ثم n=1 لحساب u₂.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب u₁",
            "explanation": "عند \\(n=0\\):\n\\[u_1=2u_0+3\\times0+4.\\]\nوبما أن \\(u_0=1\\):\n\\[u_1=2+4=6.\\]",
            "result": "\\(u_1=6\\)."
          },
          {
            "step_number": 2,
            "title": "حساب u₂",
            "explanation": "عند \\(n=1\\):\n\\[u_2=2u_1+3\\times1+4=2\\times6+3+4=19.\\]",
            "result": "\\(u_2=19\\)."
          }
        ],
        "final_answer": "\\(\\boxed{u_1=6,\\quad u_2=19}\\).",
        "verification": "تمت مراجعة الحل حسابيا خطوة بخطوة انطلاقا من نص الموضوع المرفق لسنة 2026. ملف الموضوع المرفق لا يحتوي على تصحيح نموذجي.",
        "common_mistakes": [
          "نسيان تغيير n عند الانتقال من u₁ إلى u₂."
        ],
        "hints": [
          "ابدأ بـ n=0 ثم n=1."
        ],
        "summary": "بالتعويض المباشر نجد u₁=6 وu₂=19.",
        "answer_style": "explain_then_calculate_then_conclude"
      }
