      "text": "4) بيّن أنه من أجل كل عدد طبيعي \\(n\\): \\[v_0v_1\\cdots v_{n-1}=\\left(\\frac{14}{3}\\right)^{2n}\\left(\\frac12\\right)^{n^2-n}.\\]",
      "axis_tags": [
        "sequence_products"
      ],
      "solution": {
        "strategy": "نستعمل عبارة \\(v_k\\) ثم نحسب حاصل الضرب.",
        "methodology": {
          "goal": "الوصول إلى النتيجة بطريقة منظمة ومناسبة لكتابة البكالوريا.",
          "method": "نستعمل عبارة \\(v_k\\) ثم نحسب حاصل الضرب.",
          "why_this_method": "لأنها تربط مباشرة بين المعطيات والنتيجة المطلوبة وتسمح بحساب تدريجي واضح.",
          "used_theorem": "",
          "bac_template": [
            "نكتب العلاقة أو الخاصية المستعملة.",
            "نعوض بالمعطيات ونبسط الحساب تدريجيا.",
            "ندرس الإشارة أو النهاية عند الحاجة.",
            "نكتب الاستنتاج النهائي بوضوح."
          ],
          "formal_writing": [
            "نكتب العلاقة المستعملة قبل التعويض.",
            "نحافظ على ترتيب المساويات.",
            "نختم بجملة رياضية تجيب عن المطلوب."
          ]
        },
        "steps": [
          {
            "step_number": 1,
            "title": "كل عامل",
            "explanation": "لدينا.",
            "latex": "v_k=\\frac{196}{9}\\left(\\frac14\\right)^k=\\left(\\frac{14}{3}\\right)^2\\left(\\frac12\\right)^{2k}"
          },
          {
            "step_number": 2,
            "title": "حاصل الضرب",
            "explanation": "نضرب من \\(k=0\\) إلى \\(n-1\\).",
            "latex": "\\prod_{k=0}^{n-1}v_k=\\left(\\frac{14}{3}\\right)^{2n}\\left(\\frac12\\right)^{2\\sum_{k=0}^{n-1}k}"
          },
          {
            "step_number": 3,
            "title": "مجموع الفهارس",
            "explanation": "نستعمل \\(\\sum_{k=0}^{n-1}k=\\frac{n(n-1)}2\\).",
            "latex": "\\prod_{k=0}^{n-1}v_k=\\left(\\frac{14}{3}\\right)^{2n}\\left(\\frac12\\right)^{n^2-n}"
          }
        ],
