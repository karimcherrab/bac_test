    {
      "id": "2017_ex2_q3",
      "text": "3) لتكن \\((v_n)\\) معرفة بـ \\(v_nu_n=1-4v_n\\). أثبت أن \\((v_n)\\) حسابية أساسها \\(\\frac17\\)، ثم احسب \\(S=v_0u_0+v_1u_1+\\cdots+v_{2016}u_{2016}\\).",
      "axis_tags": [
        "arithmetic_sequences",
        "sequence_sums"
      ],
      "solution": {
        "strategy": "نستخرج \\(v_n\\) بدلالة \\(u_n\\)، ثم نحسب الفرق.",
        "methodology": {
          "goal": "إثبات أن المتتالية حسابية وتحديد أساسها.",
          "method": "نستخرج \\(v_n\\) بدلالة \\(u_n\\)، ثم نحسب الفرق.",
          "why_this_method": "لأن ثبات الفرق v_{n+1}-v_n يثبت أن المتتالية حسابية.",
          "used_theorem": "تعريف المتتالية الحسابية.",
          "bac_template": [
            "نحسب v_{n+1}-v_n.",
            "نبسط حتى نحصل على عدد ثابت.",
            "نستنتج أن المتتالية حسابية ونكتب حدها العام."
          ],
          "formal_writing": [
            "من أجل كل n نحسب v_{n+1}-v_n.",
            "بما أن الفرق ثابت فإن (v_n) حسابية.",
            "نكتب حدها العام حسب بداية الترقيم."
          ]
        },
        "steps": [
          {
            "step_number": 1,
            "title": "استخراج \\(v_n\\)",
            "explanation": "من العلاقة المعطاة:",
            "latex": "v_n(u_n+4)=1\\Rightarrow v_n=\\frac1{u_n+4}"
          },
          {
            "step_number": 2,
            "title": "حساب \\(v_{n+1}\\)",
            "explanation": "نعوض بعبارة \\(u_{n+1}\\).",
            "latex": "v_{n+1}=\\frac1{u_{n+1}+4}=\\frac1{\\frac{7(u_n+4)}{u_n+11}}=\\frac{u_n+11}{7(u_n+4)}"
          },
          {
            "step_number": 3,
            "title": "الفرق",
            "explanation": "نفصل البسط.",
            "latex": "v_{n+1}=v_n+\\frac17"
          },
          {
            "step_number": 4,
            "title": "حساب المجموع",
            "explanation": "من العلاقة \\(v_nu_n=1-4v_n\\)، نحصل على:",
            "latex": "S=\\sum_{k=0}^{2016}(1-4v_k)=2017-4\\sum_{k=0}^{2016}v_k"
          },
          {
            "step_number": 5,
            "title": "مجموع \\(v_k\\)",
            "explanation": "لدينا \\(v_0=\\frac14\\) و\\(v_k=\\frac14+\\frac{k}{7}\\).",
            "latex": "\\sum_{k=0}^{2016}v_k=2017\\cdot\\frac14+\\frac1{7}\\frac{2016\\cdot2017}{2}"
          },
          {
            "step_number": 6,
            "title": "النتيجة",
            "explanation": "بعد التبسيط:",
            "latex": "S=-\\frac{2016\\cdot2017}{7}=-580608"
          }
        ],
        "final_answer": "\\(S=-580608\\).",
        "verification": "نتحقق من النتيجة بالتعويض في العلاقة الأصلية أو بمقارنة أول حدين.",
        "common_mistakes": [
          "الخلط بين الفهرسين n و n+1.",
