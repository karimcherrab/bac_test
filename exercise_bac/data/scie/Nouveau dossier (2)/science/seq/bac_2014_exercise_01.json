    },
    {
      "id": "2014_ex1_q4",
      "text": "4) احسب بدلالة \\(n\\) المجموع \\(S_n\\) حيث: \\[S_n=u_0+u_1+u_2+\\cdots+u_n.\\]",
      "axis_tags": [
        "seq_sum"
      ],
      "solution": {
        "strategy": "نعوض عبارة u_k ثم نفصل مجموعا هندسيا وثابتا.",
        "methodology": {
          "goal": "حساب S_n.",
          "method": "S_n=5Σ(2/3)^k-4(n+1).",
          "simple_plan": [
            "نعوض u_k.",
            "نفصل المجموعين.",
            "نطبق قانون المجموع الهندسي.",
            "نبسط."
          ],
          "why_this_method": "u_k مجموع حد هندسي وثابت."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "التعويض",
            "explanation": "لدينا:",
            "latex": "S_n=\\sum_{k=0}^n\\left[5\\left(\\frac23\\right)^k-4\\right]"
          },
          {
            "step_number": 2,
            "title": "فصل المجموع",
            "explanation": "إذن:",
            "latex": "S_n=5\\sum_{k=0}^n\\left(\\frac23\\right)^k-4(n+1)"
          },
          {
            "step_number": 3,
            "title": "المجموع الهندسي",
            "explanation": "نطبق القانون:",
            "latex": "\\sum_{k=0}^n\\left(\\frac23\\right)^k=\\frac{1-(\\frac23)^{n+1}}{1-\\frac23}=3\\left[1-\\left(\\frac23\\right)^{n+1}\\right]"
          },
          {
            "step_number": 4,
            "title": "النتيجة",
            "explanation": "ومن ثم:",
            "latex": "S_n=15\\left[1-\\left(\\frac23\\right)^{n+1}\\right]-4(n+1)"
          }
        ],
        "final_answer": "\\(S_n=15[1-(\\frac23)^{n+1}]-4(n+1)\\).",
        "common_mistakes": [
          "الخطأ في عدد الحدود: من 0 إلى n يوجد n+1 حدا.",
          "استعمال قانون مجموع متتالية هندسية دون تحديد الحد الأول والأساس.",
          "نسيان تبسيط النتيجة النهائية."
        ],
        "hints": [],
        "presentation": {
          "show_method_first": true,
          "show_steps_one_by_one": true,
          "show_calculations_separately": true,
          "show_graph_only_when_required": true,
          "show_formal_writing": true
        }
      },
      "display_order": 4,
      "content_type": "question"
    },
    {
      "id": "2014_ex1_q5a",
      "text": "5-أ) لتكن المتتالية العددية \\((w_n)\\) المعرفة على \\(\\mathbb N\\) كما يلي: \\[w_n=5\\left(\\frac1{v_n+5}-1\\right).\\] بيّن أن المتتالية \\((w_n)\\) متزايدة تماما على \\(\\mathbb N\\).",
      "axis_tags": [
        "seq_monotonicity"
      ],
      "solution": {
        "strategy": "نعوض v_n ثم نكتب w_n بدلالة t_n=(2/3)^n ونقارن w_{n+1}-w_n.",
        "methodology": {
          "goal": "إثبات تزايد w_n.",
          "method": "الحساب المباشر للفرق بعد التبسيط.",
          "simple_plan": [
            "نعوض v_n.",
            "نبسط w_n.",
            "نحسب الفرق.",
            "نحدد الإشارة."
          ],
          "formal_writing": [
            "لدراسة اتجاه تغير المتتالية نحسب الفرق u_{n+1}-u_n أو نستعمل تعبير الحد العام إن كان متوفرا.",
            "نحدد إشارة الفرق مع الاستفادة من الحصر المثبت سابقا.",
            "نستنتج الرتابة فقط بعد تبرير الإشارة لكل عدد طبيعي n."
          ],
          "why_this_method": "صيغة w_n كسرية في متتالية هندسية موجبة."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "كتابة w_n",
            "explanation": "بما أن v_n=5(2/3)^n:",
            "latex": "w_n=5\\left(\\frac1{5(\\frac23)^n+5}-1\\right)=\\frac1{1+(\\frac23)^n}-5"
          },
          {
            "step_number": 2,
            "title": "حساب الفرق",
            "explanation": "نضع a=(2/3)^n>0:",
            "latex": "w_{n+1}-w_n=\\frac1{1+\\frac23a}-\\frac1{1+a}"
          },
          {
            "step_number": 3,
            "title": "التبسيط والإشارة",
            "explanation": "إذن:",
            "latex": "w_{n+1}-w_n=\\frac{a/3}{(1+\\frac23a)(1+a)}>0"
          }
        ],
        "final_answer": "\\((w_n)\\) متزايدة تماما.",
        "common_mistakes": [
          "تحديد الإشارة دون استعمال الحصر المعروف للمتتالية.",
          "الخطأ في تحليل الفرق أو في إشارة المقام.",
          "القول إن المتتالية متقاربة من الرتابة فقط دون إثبات المحدودية."
        ],
        "hints": [],
        "presentation": {
          "show_method_first": true,
          "show_steps_one_by_one": true,
          "show_calculations_separately": true,
          "show_graph_only_when_required": true,
          "show_formal_writing": true
        }
      },
      "display_order": 5,
