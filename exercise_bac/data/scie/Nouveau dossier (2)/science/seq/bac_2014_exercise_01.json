    },
    {
      "id": "2014_ex1_q5b",
      "text": "5-ب) احسب \\(\\displaystyle\\lim_{n\\to+\\infty}(u_n-w_n)\\).",
      "axis_tags": [
        "seq_limits"
      ],
      "solution": {
        "strategy": "نحسب نهايتي u_n وw_n ثم نهاية الفرق.",
        "methodology": {
          "goal": "حساب lim(u_n-w_n).",
          "method": "استعمال (2/3)^n→0.",
          "simple_plan": [
            "نحسب lim u_n.",
            "نحسب lim w_n.",
            "نطرح."
          ],
          "formal_writing": [
            "نحدد أولا المبرهنة أو النهاية المرجعية المستعملة.",
            "نعوض في عبارة الحد العام أو نستعمل مبرهنة التقارب الرتيب بعد إثبات الرتابة والمحدودية.",
            "نكتب النتيجة النهائية بصيغة واضحة مع ذكر قيمة النهاية."
          ],
          "why_this_method": "كلتا العبارتين صريحتان."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "نهاية u_n",
            "explanation": "لأن (2/3)^n→0:",
            "latex": "u_n=5(\\frac23)^n-4\\to-4"
          },
          {
            "step_number": 2,
            "title": "نهاية w_n",
            "explanation": "من عبارتها:",
            "latex": "w_n=\\frac1{1+(\\frac23)^n}-5\\to1-5=-4"
          },
          {
            "step_number": 3,
            "title": "نهاية الفرق",
            "explanation": "إذن:",
            "latex": "u_n-w_n\\to-4-(-4)=0"
          }
        ],
        "final_answer": "\\(\\displaystyle\\lim_{n\\to+\\infty}(u_n-w_n)=0\\).",
        "common_mistakes": [
          "تعويض النهاية قبل إثبات وجودها.",
          "نسيان استعمال شرط |q|<1 عند نهاية متتالية هندسية.",
          "إهمال تبرير تطبيق مبرهنة الحصر أو التقارب الرتيب."
        ],
