  "statement": "لتكن \\((u_n)\\) المتتالية العددية المعرفة كما يلي: \\(u_0=1\\)، ومن أجل كل عدد طبيعي \\(n\\): \\[u_{n+1}=\\frac23u_n-\\frac43,\\] و\\((v_n)\\) المتتالية العددية المعرفة كما يلي، من أجل كل عدد طبيعي \\(n\\): \\[v_n=u_n+4.\\]",
  "questions": [
    {
      "id": "2014_ex1_q1",
      "text": "1) بيّن أن \\((v_n)\\) متتالية هندسية يطلب تعيين أساسها وحدها الأول.",
      "axis_tags": [
        "seq_geometric"
      ],
      "solution": {
        "strategy": "نحسب v_{n+1} باستعمال u_{n+1}.",
        "methodology": {
          "goal": "إثبات أن v_n هندسية.",
          "method": "تعويض التعريف ثم التبسيط.",
          "simple_plan": [
            "نكتب v_{n+1}=u_{n+1}+4.",
            "نعوض.",
            "نستخرج v_n.",
            "نحسب v0."
          ],
          "formal_writing": [
            "نحسب v_{n+1} انطلاقا من تعريف v_n والعلاقة المعطاة.",
            "نبسط حتى نحصل على v_{n+1}=qv_n حيث q ثابت لا يتعلق بـ n.",
            "نستنتج أن (v_n) هندسية أساسها q، ثم نحسب حدها الأول."
          ],
          "why_this_method": "الإزاحة +4 تلغي الحد الثابت في العلاقة التراجعية."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "حساب الحد الموالي",
            "explanation": "لدينا:",
            "latex": "v_{n+1}=u_{n+1}+4=\\frac23u_n-\\frac43+4"
          },
          {
            "step_number": 2,
            "title": "التبسيط",
            "explanation": "فنحصل على:",
            "latex": "v_{n+1}=\\frac23(u_n+4)=\\frac23v_n"
          },
          {
            "step_number": 3,
            "title": "الحد الأول",
            "explanation": "نحسب:",
            "latex": "v_0=u_0+4=5"
          }
        ],
        "final_answer": "\\((v_n)\\) هندسية أساسها \\(q=\\frac23\\) وحدها الأول \\(v_0=5\\).",
        "common_mistakes": [
          "عدم حساب الحد الأول.",
          "الخلط بين أساس المتتالية وحدها الأول.",
          "كتابة عبارة الحد العام بفهرسة غير مناسبة."
        ],
        "hints": [],
        "presentation": {
          "show_method_first": true,
          "show_steps_one_by_one": true,
          "show_calculations_separately": true,
          "show_graph_only_when_required": true,
          "show_formal_writing": true
        }
      },
      "display_order": 1,
      "content_type": "question"
    },
    {
      "id": "2014_ex1_q2",
      "text": "2) اكتب كلا من \\(v_n\\) و\\(u_n\\) بدلالة \\(n\\).",
      "axis_tags": [
        "seq_geometric"
      ],
      "solution": {
        "strategy": "نستعمل عبارة الحد العام لمتتالية هندسية ثم العلاقة u_n=v_n-4.",
        "methodology": {
          "goal": "كتابة v_n وu_n بدلالة n.",
          "method": "تطبيق v_n=v_0q^n.",
          "simple_plan": [
            "نكتب v_n.",
            "نرجع إلى u_n."
          ],
          "why_this_method": "تم إثبات أن v_n هندسية."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "عبارة v_n",
            "explanation": "بما أن v_n هندسية:",
            "latex": "v_n=5\\left(\\frac23\\right)^n"
          },
          {
            "step_number": 2,
            "title": "عبارة u_n",
            "explanation": "لأن v_n=u_n+4:",
            "latex": "u_n=5\\left(\\frac23\\right)^n-4"
          }
        ],
        "final_answer": "\\(v_n=5(\\frac23)^n\\) و\\(u_n=5(\\frac23)^n-4\\).",
        "common_mistakes": [],
        "hints": [],
        "presentation": {
          "show_method_first": true,
          "show_steps_one_by_one": true,
          "show_calculations_separately": true,
          "show_graph_only_when_required": true,
          "show_formal_writing": true
        }
      },
      "display_order": 2,
      "content_type": "question"
    },
    {
      "id": "2014_ex1_q3",
      "text": "3) ادرس اتجاه تغير المتتالية \\((u_n)\\) على \\(\\mathbb N\\).",
      "axis_tags": [
        "seq_monotonicity"
      ],
      "solution": {
        "strategy": "ندرس إشارة u_{n+1}-u_n باستعمال العبارة الصريحة.",
        "methodology": {
          "goal": "تحديد اتجاه تغير u_n.",
          "method": "حساب الفرق من العبارة الصريحة.",
          "simple_plan": [
            "نحسب الفرق.",
            "نحدد الإشارة.",
            "نستنتج."
          ],
          "formal_writing": [
            "لدراسة اتجاه تغير المتتالية نحسب الفرق u_{n+1}-u_n أو نستعمل تعبير الحد العام إن كان متوفرا.",
            "نحدد إشارة الفرق مع الاستفادة من الحصر المثبت سابقا.",
            "نستنتج الرتابة فقط بعد تبرير الإشارة لكل عدد طبيعي n."
          ],
          "why_this_method": "القوة (2/3)^n موجبة وتناقصية."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "حساب الفرق",
            "explanation": "من العبارة الصريحة:",
            "latex": "u_{n+1}-u_n=5\\left(\\frac23\\right)^n\\left(\\frac23-1\\right)"
          },
          {
            "step_number": 2,
            "title": "الإشارة",
            "explanation": "أي:",
            "latex": "u_{n+1}-u_n=-\\frac53\\left(\\frac23\\right)^n<0"
          }
        ],
        "final_answer": "\\((u_n)\\) متناقصة تماما على \\(\\mathbb N\\).",
        "common_mistakes": [
          "تحديد الإشارة دون استعمال الحصر المعروف للمتتالية.",
          "الخطأ في تحليل الفرق أو في إشارة المقام.",
          "القول إن المتتالية متقاربة من الرتابة فقط دون إثبات المحدودية."
        ],
        "hints": [],
        "presentation": {
          "show_method_first": true,
          "show_steps_one_by_one": true,
          "show_calculations_separately": true,
          "show_graph_only_when_required": true,
          "show_formal_writing": true
        }
      },
      "display_order": 3,
