    },
    {
      "id": "2014_ex2_q3",
      "text": "I-3) احسب بدلالة \\(n\\) المجموع \\(S_n\\) حيث: \\[S_n=u_0+u_1+u_2+\\cdots+u_n.\\]",
      "axis_tags": [
        "seq_sum"
      ],
      "solution": {
        "strategy": "نطبق قانون مجموع n+1 حدود هندسية.",
        "methodology": {
          "goal": "حساب S_n.",
          "method": "S_n=u0(1-q^{n+1})/(1-q).",
          "simple_plan": [
            "نحدد عدد الحدود.",
            "نطبق القانون.",
            "نبسط."
          ],
          "why_this_method": "u_n هندسية."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "تطبيق القانون",
            "explanation": "من 0 إلى n يوجد n+1 حدا:",
            "latex": "S_n=\\sqrt e\\,\\frac{1-(1/e)^{n+1}}{1-1/e}"
          },
          {
            "step_number": 2,
            "title": "التبسيط",
            "explanation": "يمكن كتابة:",
            "latex": "S_n=\\frac{e\\sqrt e}{e-1}\\left(1-e^{-(n+1)}\\right)"
          }
        ],
        "final_answer": "\\(S_n=\\sqrt e\\frac{1-e^{-(n+1)}}{1-e^{-1}}\\).",
        "common_mistakes": [
          "الخطأ في عدد الحدود: من 0 إلى n يوجد n+1 حدا.",
          "استعمال قانون مجموع متتالية هندسية دون تحديد الحد الأول والأساس.",
          "نسيان تبسيط النتيجة النهائية."
        ],
        "hints": [],
        "presentation": {
          "show_method_first": true,
          "show_steps_one_by_one": true,
          "show_calculations_separately": true,
          "show_graph_only_when_required": true,
          "show_formal_writing": true
        }
      },
      "display_order": 3,
      "content_type": "question"
    },
    {
      "id": "2014_ex2_q4",
      "text": "II-1) عبّر عن \\(v_n\\) بدلالة \\(n\\) ثم استنتج نوع المتتالية \\((v_n)\\).",
      "axis_tags": [
        "seq_arithmetic"
      ],
      "solution": {
        "strategy": "نستعمل ln(e^a)=a.",
        "methodology": {
          "goal": "التعبير عن v_n وتحديد نوعها.",
          "method": "تبسيط اللوغاريتم.",
          "simple_plan": [
            "نعوض u_n.",
            "نطبق خاصية اللوغاريتم.",
            "نحدد الفرق الثابت."
          ],
          "why_this_method": "u_n قوة للعدد e."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "التبسيط",
            "explanation": "لدينا:",
            "latex": "v_n=\\ln(u_n)=\\ln(e^{\\frac12-n})=\\frac12-n"
          },
          {
            "step_number": 2,
            "title": "تحديد النوع",
            "explanation": "نحسب:",
            "latex": "v_{n+1}-v_n=-1"
          }
        ],
        "final_answer": "\\((v_n)\\) حسابية أساسها \\(-1\\) وحدها الأول \\(v_0=\\frac12\\).",
        "common_mistakes": [],
