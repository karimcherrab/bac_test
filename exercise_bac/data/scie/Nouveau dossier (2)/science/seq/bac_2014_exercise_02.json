    {
      "id": "2014_ex2_q5a",
      "text": "II-2-أ) احسب بدلالة \\(n\\) العدد \\(P_n\\) حيث: \\[P_n=\\ln(u_0\\times u_1\\times u_2\\times\\cdots\\times u_n).\\]",
      "axis_tags": [
        "seq_sum",
        "seq_logarithm"
      ],
      "solution": {
        "strategy": "نستعمل ln(product)=sum ln ثم مجموع متتالية حسابية.",
        "methodology": {
          "goal": "حساب P_n.",
          "method": "P_n=Σv_k.",
          "simple_plan": [
            "نحوّل لوغاريتم الجداء إلى مجموع.",
            "نعوض v_k.",
            "نحسب مجموع الأعداد من 0 إلى n."
          ],
          "why_this_method": "تعريف P_n لوغاريتم جداء."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "تحويل الجداء",
            "explanation": "لدينا:",
            "latex": "P_n=\\sum_{k=0}^n\\ln(u_k)=\\sum_{k=0}^n v_k"
          },
          {
            "step_number": 2,
            "title": "التعويض",
            "explanation": "إذن:",
            "latex": "P_n=\\sum_{k=0}^n\\left(\\frac12-k\\right)=\\frac{n+1}{2}-\\frac{n(n+1)}2"
          },
          {
            "step_number": 3,
            "title": "التبسيط",
            "explanation": "فنحصل على:",
            "latex": "P_n=\\frac{(n+1)(1-n)}2=\\frac{1-n^2}{2}"
          }
        ],
        "final_answer": "\\(P_n=\\frac{1-n^2}{2}\\).",
        "common_mistakes": [
          "الخطأ في عدد الحدود: من 0 إلى n يوجد n+1 حدا.",
          "استعمال قانون مجموع متتالية هندسية دون تحديد الحد الأول والأساس.",
          "نسيان تبسيط النتيجة النهائية."
        ],
