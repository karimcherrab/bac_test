    },
    {
      "id": "2014_ex2_q5b",
      "text": "II-2-ب) عيّن مجموعة قيم العدد الطبيعي \\(n\\) بحيث: \\(P_n+4n>0\\).",
      "axis_tags": [
        "seq_inequalities"
      ],
      "solution": {
        "strategy": "نعوض P_n ثم نحل متراجحة من الدرجة الثانية على N.",
        "methodology": {
          "goal": "تعيين n بحيث P_n+4n>0.",
          "method": "تحليل العبارة إلى جداء.",
          "simple_plan": [
            "نعوض.",
            "نضرب في 2 الموجب.",
            "نحل المتراجحة.",
            "نقاطع مع N."
          ],
          "why_this_method": "بعد التعويض نحصل على كثيرة حدود."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "التعويض",
            "explanation": "لدينا:",
            "latex": "P_n+4n=\\frac{1-n^2}{2}+4n=\\frac{-n^2+8n+1}{2}"
          },
          {
            "step_number": 2,
            "title": "حل المتراجحة",
            "explanation": "نطلب:",
            "latex": "-n^2+8n+1>0\\iff n^2-8n-1<0"
          },
          {
            "step_number": 3,
            "title": "الجذور",
            "explanation": "جذرا كثيرة الحدود هما:",
            "latex": "4-\\sqrt{17}\\quad\\text{و}\\quad4+\\sqrt{17}"
          },
          {
            "step_number": 4,
            "title": "التقاطع مع N",
            "explanation": "إذن 4-√17<n<4+√17، وبما أن n طبيعي:",
            "latex": "n\\in\\{0,1,2,3,4,5,6,7,8\\}"
          }
        ],
        "final_answer": "\\(n\\in\\{0,1,2,3,4,5,6,7,8\\}\\).",
