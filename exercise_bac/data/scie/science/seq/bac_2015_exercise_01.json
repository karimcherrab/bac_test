    {
      "id": "2015_ex1_q4a",
      "text": "4-أ) نضع من أجل كل عدد طبيعي \\(n\\): \\(v_n=3(1+u_n)\\). أثبت أن \\((v_n)\\) متتالية هندسية يطلب تعيين أساسها وحدها الأول.",
      "axis_tags": [
        "seq_geometric"
      ],
      "solution": {
        "strategy": "نحسب v_{n+1} بدلالة v_n.",
        "methodology": {
          "goal": "إثبات أن v_n هندسية.",
          "method": "استعمال 1+u_{n+1}=e^{-2}(1+u_n).",
          "simple_plan": [
            "نكتب v_{n+1}.",
            "نعوض.",
            "نحدد q وv0."
          ],
          "formal_writing": [
            "نحسب v_{n+1} انطلاقا من تعريف v_n والعلاقة المعطاة.",
            "نبسط حتى نحصل على v_{n+1}=qv_n حيث q ثابت لا يتعلق بـ n.",
            "نستنتج أن (v_n) هندسية أساسها q، ثم نحسب حدها الأول."
          ],
          "why_this_method": "تعريف v_n يضرب 1+u_n بثابت فقط."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "حساب الحد الموالي",
            "explanation": "لدينا:",
            "latex": "v_{n+1}=3(1+u_{n+1})=3e^{-2}(1+u_n)=e^{-2}v_n"
          },
          {
            "step_number": 2,
            "title": "الحد الأول",
            "explanation": "نحسب:",
            "latex": "v_0=3(1+u_0)=3e^2"
          }
        ],
        "final_answer": "\\((v_n)\\) هندسية أساسها \\(q=e^{-2}\\) وحدها الأول \\(v_0=3e^2\\).",
        "common_mistakes": [
          "عدم حساب الحد الأول.",
          "الخلط بين أساس المتتالية وحدها الأول.",
          "كتابة عبارة الحد العام بفهرسة غير مناسبة."
        ],
        "hints": [],
