      "solution": {
        "strategy": "نستخرج علاقة مباشرة لـ1+u_{n+1} ثم نستعمل التراجع أو الصيغة المتكررة.",
        "methodology": {
          "goal": "إثبات 1+u_n>0.",
          "method": "ملاحظة أن 1+u_{n+1}=e^{-2}(1+u_n).",
          "simple_plan": [
            "التهيئة.",
            "فرضية التراجع.",
            "الانتقال.",
            "الخلاصة."
          ],
          "why_this_method": "عامل موجب يحافظ على الإشارة."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "التهيئة",
            "explanation": "لدينا:",
            "latex": "1+u_0=e^2>0"
          },
          {
            "step_number": 2,
            "title": "فرضية التراجع",
            "explanation": "نفرض:",
            "latex": "1+u_n>0"
          },
          {
            "step_number": 3,
            "title": "الانتقال",
            "explanation": "من العلاقة:",
            "latex": "1+u_{n+1}=e^{-2}(1+u_n)"
