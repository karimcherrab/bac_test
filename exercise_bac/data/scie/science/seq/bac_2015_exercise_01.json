  "statement": "\\((u_n)\\) المتتالية العددية المعرفة بـ: \\(u_0=e^2-1\\)، ومن أجل كل عدد طبيعي \\(n\\): \\[u_{n+1}=(1+u_n)e^{-2}-1.\\]",
  "questions": [
    {
      "id": "2015_ex1_q1",
      "text": "1) احسب \\(u_1\\)، \\(u_2\\) و\\(u_3\\).",
      "axis_tags": [
        "seq_recursive"
      ],
      "solution": {
        "strategy": "نعوض بالتتابع في العلاقة التراجعية.",
        "methodology": {
          "goal": "حساب u1,u2,u3.",
          "method": "استعمال العلاقة مرة بعد مرة.",
          "simple_plan": [
            "نعوض n=0.",
            "ثم n=1.",
            "ثم n=2."
          ],
          "why_this_method": "القيم الأولى مطلوبة مباشرة."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "حساب u_1",
            "explanation": "نعوض u0=e²-1:",
            "latex": "u_1=(1+u_0)e^{-2}-1=e^2e^{-2}-1=0"
          },
          {
            "step_number": 2,
            "title": "حساب u_2",
            "explanation": "نعوض u1=0:",
            "latex": "u_2=(1+0)e^{-2}-1=e^{-2}-1"
          },
          {
            "step_number": 3,
            "title": "حساب u_3",
            "explanation": "نعوض u2=e^{-2}-1:",
            "latex": "u_3=e^{-2}e^{-2}-1=e^{-4}-1"
          }
        ],
        "final_answer": "\\(u_1=0\\)، \\(u_2=e^{-2}-1\\)، \\(u_3=e^{-4}-1\\).",
