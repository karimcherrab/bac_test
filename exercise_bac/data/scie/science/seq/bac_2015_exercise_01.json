            "title": "الإشارة",
            "explanation": "بما أن e^{-2}>0 و1+u_n>0، فإن:",
            "latex": "1+u_{n+1}>0"
          },
          {
            "step_number": 5,
            "title": "الخلاصة",
            "explanation": "بالتراجع: 1+u_n>0 لكل n طبيعي."
          }
        ],
        "final_answer": "من أجل كل \\(n\\): \\(1+u_n>0\\).",
        "common_mistakes": [
