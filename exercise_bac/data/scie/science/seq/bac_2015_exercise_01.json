    {
      "id": "2015_ex1_q3",
      "text": "3) بيّن أن المتتالية \\((u_n)\\) متناقصة. هل هي متقاربة؟ علل.",
      "axis_tags": [
        "seq_monotonicity",
        "seq_limits"
      ],
      "solution": {
        "strategy": "نحسب الفرق ثم نثبت المحدودية من الأسفل.",
        "methodology": {
          "goal": "إثبات التناقص ثم التقارب.",
          "method": "حساب u_{n+1}-u_n، ثم استعمال 1+u_n>0 وe^{-2}-1<0؛ وبعدها إثبات u_n>-1.",
          "simple_plan": [
            "نحسب الفرق.",
            "نحدد الإشارة.",
            "نحدد حدا سفليا.",
            "نطبق مبرهنة التقارب الرتيب."
          ],
          "formal_writing": [
            "لدراسة اتجاه تغير المتتالية نحسب الفرق u_{n+1}-u_n أو نستعمل تعبير الحد العام إن كان متوفرا.",
            "نحدد إشارة الفرق مع الاستفادة من الحصر المثبت سابقا.",
            "نستنتج الرتابة فقط بعد تبرير الإشارة لكل عدد طبيعي n."
          ],
          "why_this_method": "المتتالية المتناقصة لا تكفي وحدها؛ نحتاج حدا سفليا."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "حساب الفرق",
            "explanation": "لدينا:",
            "latex": "u_{n+1}-u_n=(1+u_n)e^{-2}-1-u_n=(1+u_n)(e^{-2}-1)"
          },
          {
            "step_number": 2,
            "title": "الإشارة",
            "explanation": "بما أن 1+u_n>0 وe^{-2}-1<0:",
            "latex": "u_{n+1}-u_n<0"
          },
          {
            "step_number": 3,
            "title": "المحدودية من الأسفل",
            "explanation": "من 1+u_n>0 نستنتج:",
            "latex": "u_n>-1"
          },
          {
            "step_number": 4,
            "title": "التقارب",
            "explanation": "إذن (u_n) متناقصة ومحدودة من الأسفل، فهي متقاربة."
          }
        ],
        "final_answer": "\\((u_n)\\) متناقصة تماما ومحدودة من الأسفل بـ\\(-1\\)، لذلك هي متقاربة.",
        "common_mistakes": [
          "تحديد الإشارة دون استعمال الحصر المعروف للمتتالية.",
          "الخطأ في تحليل الفرق أو في إشارة المقام.",
          "القول إن المتتالية متقاربة من الرتابة فقط دون إثبات المحدودية."
        ],
