    {
      "id": "2015_ex1_q4b",
      "text": "4-ب) اكتب \\(v_n\\) و\\(u_n\\) بدلالة \\(n\\)، ثم احسب \\(\\displaystyle\\lim_{n\\to+\\infty}u_n\\).",
      "axis_tags": [
        "seq_geometric",
        "seq_limits"
      ],
      "solution": {
        "strategy": "نكتب الحد العام لـv_n ثم نستخرج u_n.",
        "methodology": {
          "goal": "كتابة v_n وu_n ثم حساب النهاية.",
          "method": "v_n=v0q^n ثم u_n=v_n/3-1.",
          "simple_plan": [
            "نكتب v_n.",
            "نستخرج u_n.",
            "نحسب النهاية."
          ],
          "formal_writing": [
            "نحدد أولا المبرهنة أو النهاية المرجعية المستعملة.",
            "نعوض في عبارة الحد العام أو نستعمل مبرهنة التقارب الرتيب بعد إثبات الرتابة والمحدودية.",
            "نكتب النتيجة النهائية بصيغة واضحة مع ذكر قيمة النهاية."
          ],
          "why_this_method": "تم إثبات أن v_n هندسية."
        },
        "steps": [
          {
            "step_number": 1,
            "title": "عبارة v_n",
            "explanation": "لدينا:",
            "latex": "v_n=3e^2(e^{-2})^n=3e^{2-2n}"
          },
          {
            "step_number": 2,
            "title": "عبارة u_n",
            "explanation": "من v_n=3(1+u_n):",
            "latex": "u_n=e^{2-2n}-1"
          },
          {
            "step_number": 3,
            "title": "النهاية",
            "explanation": "لأن e^{2-2n}→0:",
            "latex": "\\lim u_n=-1"
          }
        ],
        "final_answer": "\\(v_n=3e^{2-2n}\\)، \\(u_n=e^{2-2n}-1\\)، و\\(\\lim u_n=-1\\).",
        "common_mistakes": [
          "تعويض النهاية قبل إثبات وجودها.",
          "نسيان استعمال شرط |q|<1 عند نهاية متتالية هندسية.",
          "إهمال تبرير تطبيق مبرهنة الحصر أو التقارب الرتيب."
        ],
