          "formal_writing": [
            "تحديد المجال أو شروط الاستعمال.",
            "ترتيب الحسابات على شكل مساويات.",
            "ذكر المبرهنة المناسبة عند الحاجة.",
            "ختم الحل بجواب مباشر."
          ]
        },
        "steps": [
          {
            "step_number": 1,
            "title": "التحويل",
            "explanation": "",
            "latex": "u_{n+1}=5-\\frac{12}{3+u_n}"
          },
          {
            "step_number": 2,
            "title": "الحصر",
            "explanation": "بالتراجع: إذا \\(0\\le u_n<3\\)، فإن \\(1\\le u_{n+1}<3\\)."
          },
          {
            "step_number": 3,
            "title": "الفرق",
            "explanation": "",
            "latex": "u_{n+1}-u_n=\\frac{(3-u_n)(u_n+1)}{u_n+3}>0"
          },
          {
            "step_number": 4,
            "title": "الرتابة",
            "explanation": "إذن المتتالية متزايدة."
          }
        ],
        "final_answer": "\\(0\\le u_n<3\\) والمتتالية متزايدة.",
