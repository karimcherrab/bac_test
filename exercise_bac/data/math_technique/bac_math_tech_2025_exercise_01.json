          ]
        },
        "steps": [
          {
            "step_number": 1,
            "title": "العلاقة",
            "explanation": "",
            "latex": "v_{n+1}=\\frac13v_n"
          },
          {
            "step_number": 2,
            "title": "الحد الأول",
            "explanation": "",
            "latex": "v_0=-3"
          },
          {
            "step_number": 3,
            "title": "الحد العام",
            "explanation": "",
            "latex": "v_n=-3\\left(\\frac13\\right)^n=-3^{1-n}"
          },
          {
            "step_number": 4,
            "title": "العودة",
            "explanation": "",
            "latex": "v_n=\\frac{u_n-3}{u_n+1}\\Rightarrow u_n=\\frac{v_n+3}{1-v_n}"
          },
          {
            "step_number": 5,
            "title": "النهاية",
            "explanation": "لأن \\(v_n\\to0\\)، فإن \\(u_n\\to3\\)."
          }
        ],
        "final_answer": "\\(v_n=-3^{1-n}\\)، \\(u_n=\\frac{3-3^{1-n}}{1+3^{1-n}}\\)، و\\(\\lim u_n=3\\).",
