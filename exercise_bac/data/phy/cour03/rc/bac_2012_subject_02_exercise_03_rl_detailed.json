  "questions": [
    {
      "id": "2012_s02_ex03_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1- نغلق القاطعة K:\nأ- اكتب العلاقة التي تربط التوتر الكهربائي بين طرفي الوشيعة u_b(t) والتوتر الكهربائي بين طرفي المقاومة u_R(t) و E.\nب- جد عبارة u_b(t) بدلالة شدة التيار الكهربائي i(t)، ثم بدلالة u_R(t).\nج- استنتج المعادلة التفاضلية التي يحققها u_R(t) للدارة.",
      "axis_tags": [
        "inductor_fundamental_relations",
        "rl_current_establishment_differential_equation"
      ],
      "solution": {
        "strategy": "نطبق قانون جمع التوترات ثم نعبر عن توتر الوشيعة الحقيقية، وبعد ذلك نعوض i=u_R/R.",
        "steps": [
          {
            "step_number": 1,
            "title": "1-أ — قانون جمع التوترات",
            "explanation": "\\[\\boxed{E=u_R(t)+u_b(t)}.\\]"
          },
          {
            "step_number": 2,
            "title": "1-ب — u_b بدلالة i",
            "explanation": "\\[\\boxed{u_b(t)=L\\frac{di(t)}{dt}+r\\,i(t)}.\\]"
          },
          {
            "step_number": 3,
            "title": "u_b بدلالة u_R",
            "explanation": "لأن \\(u_R=Ri\\): \\[i=\\frac{u_R}{R},\\qquad \\frac{di}{dt}=\\frac1R\\frac{du_R}{dt}.\\] لذلك: \\[\\boxed{u_b(t)=\\frac{L}{R}\\frac{du_R}{dt}+\\frac{r}{R}u_R(t)}.\\]"
          },
          {
            "step_number": 4,
            "title": "1-ج — المعادلة التفاضلية",
            "explanation": "نعوض في \\(E=u_R+u_b\\): \\[E=u_R+\\frac{L}{R}\\frac{du_R}{dt}+\\frac{r}{R}u_R.\\] ومنه: \\[\\boxed{\\frac{du_R}{dt}+\\frac{R+r}{L}u_R=\\frac{R}{L}E}.\\]"
          }
        ],
        "final_answer": "\\(E=u_R+u_b\\)، \\(u_b=Ldi/dt+ri\\)، و\\(du_R/dt+(R+r)u_R/L=RE/L\\)."
      }
    },
    {
      "id": "2012_s02_ex03_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "2- يعطى حل المعادلة التفاضلية بالشكل التالي:\nu_R(t)=A+Be^(-mt) حيث A و B و m ثوابت يطلب تعيينها.",
      "axis_tags": [
        "rl_current_establishment_differential_equation"
      ],
      "solution": {
        "strategy": "نشتق الحل المقترح ثم نعوض في المعادلة التفاضلية، ونستعمل الشرط الابتدائي u_R(0)=0.",
        "steps": [
          {
            "step_number": 1,
            "title": "اشتقاق الحل",
            "explanation": "\\[\\frac{du_R}{dt}=-Bm e^{-mt}.\\]"
          },
          {
            "step_number": 2,
            "title": "تعيين m وA",
            "explanation": "بالتعويض في المعادلة التفاضلية والمطابقة: \\[\\boxed{m=\\frac{R+r}{L}},\\qquad \\boxed{A=\\frac{R}{R+r}E}.\\]"
          },
          {
            "step_number": 3,
            "title": "تعيين B",
            "explanation": "عند \\(t=0\\)، شدة التيار منعدمة وبالتالي \\(u_R(0)=0\\). إذن: \\[A+B=0\\Rightarrow\\boxed{B=-\\frac{R}{R+r}E}.\\]"
          },
          {
            "step_number": 4,
            "title": "الحل النهائي",
            "explanation": "\\[\\boxed{u_R(t)=\\frac{R}{R+r}E\\left(1-e^{-\\frac{R+r}{L}t}\\right)}.\\]"
          }
        ],
        "final_answer": "\\(A=RE/(R+r)\\)، \\(B=-RE/(R+r)\\)، \\(m=(R+r)/L\\)."
      }
    },
    {
      "id": "2012_s02_ex03_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "3- يسمح تجهيز الـExAO بمتابعة التطور الزمني لشدة التيار الكهربائي i(t) المار في الدارة فنحصل على المنحنى البياني (الشكل-2).\nلتكن I_0 شدة التيار الكهربائي الأعظمي في النظام الدائم.\nأ- جد العبارة الحرفية للشدة I_0.\nب- حدد بيانيا قيمة الشدة I_0 ثم استنتج قيمة مقاومة الوشيعة r.\nج- اكتب عبارة ثابت الزمن τ للدارة وبين بالتحليل البعدي أن τ متجانس مع الزمن.\nد- جد بيانيا قيمة τ، ثم استنتج قيمة ذاتية الوشيعة L.",
      "axis_tags": [
        "rl_time_constant_graphical_analysis"
      ],
      "solution": {
        "strategy": "نستعمل النظام الدائم لاستخراج I0 وr، ثم نربط τ بـL وR+r ونقرأ τ بيانيا بطريقة 63% أو المماس.",
        "steps": [
          {
            "step_number": 1,
            "title": "3-أ — العبارة الحرفية لـ I₀",
            "explanation": "في النظام الدائم \\(di/dt=0\\)، لذلك: \\[\\boxed{I_0=\\frac{E}{R+r}}.\\]"
          },
          {
            "step_number": 2,
            "title": "3-ب — قراءة I₀",
            "explanation": "من المنحنى: \\[\\boxed{I_0\\approx18\\,mA}=0,018A.\\]"
          },
          {
            "step_number": 3,
            "title": "استنتاج r",
            "explanation": "\\[r=\\frac{E}{I_0}-R=\\frac2{0,018}-100\\approx11,1\\Omega.\\] ومنه: \\[\\boxed{r\\approx11\\,\\Omega}.\\]"
          },
          {
            "step_number": 4,
            "title": "3-ج — عبارة τ",
            "explanation": "\\[\\boxed{\\tau=\\frac{L}{R+r}}.\\]"
          },
          {
            "step_number": 5,
            "title": "التحليل البعدي",
            "explanation": "لأن \\([L]=[U][T]/[I]\\) و\\([R]=[U]/[I]\\)، فإن: \\[\\left[\\frac{L}{R+r}\\right]=[T].\\] لذلك \\(\\tau\\) متجانس مع الزمن."
          },
          {
            "step_number": 6,
            "title": "3-د — القراءة البيانية",
            "explanation": "من المماس عند \\(t=0\\) أو بطريقة \\(63\\%\\) نجد: \\[\\boxed{\\tau\\approx4\\,ms}.\\]"
          },
          {
            "step_number": 7,
            "title": "استنتاج L",
            "explanation": "\\[L=\\tau(R+r)=4\\times10^{-3}(100+11)\\approx0,444H.\\] إذن: \\[\\boxed{L\\approx0,44\\,H}.\\]"
          }
        ],
        "final_answer": "\\(I_0=E/(R+r)\\)، \\(I_0\\approx18mA\\)، \\(r\\approx11\\Omega\\)، \\(\\tau\\approx4ms\\)، \\(L\\approx0,44H\\)."
      },
