  "questions": [
    {
      "id": "2015_s01_ex04_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1- بتطبيق قانون جمع التوترات، بين أن المعادلة التفاضلية لشدة التيار تكتب بالشكل: di(t)/dt + αi(t)=β، حيث α و β ثابتان يطلب تحديد عبارتيهما مستعينا بالمقادير التالية: E، r، R، L.",
      "axis_tags": [
        "inductor_fundamental_relations",
        "rl_current_establishment_differential_equation"
      ],
      "solution": {
        "strategy": "نكتب قانون جمع التوترات في الدارة التسلسلية ثم نقسم على L ونطابق مع الشكل المطلوب.",
        "steps": [
          {
            "step_number": 1,
            "title": "قانون جمع التوترات",
            "explanation": "\\[E=u_R+u_b=Ri+ri+L\\frac{di}{dt}.\\]"
          },
          {
            "step_number": 2,
            "title": "المعادلة التفاضلية",
            "explanation": "\\[L\\frac{di}{dt}+(R+r)i=E.\\] بالقسمة على L: \\[\\boxed{\\frac{di}{dt}+\\frac{R+r}{L}i=\\frac{E}{L}}.\\]"
          },
          {
            "step_number": 3,
            "title": "تحديد α وβ",
            "explanation": "بالمقارنة مع \\(di/dt+\\alpha i=\\beta\\): \\[\\boxed{\\alpha=\\frac{R+r}{L}},\\qquad \\boxed{\\beta=\\frac{E}{L}}.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{\\alpha=(R+r)/L}\\) و\\(\\boxed{\\beta=E/L}\\)."
      }
    },
    {
      "id": "2015_s01_ex04_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "2- تحقق أن العبارة i(t)=β/α (1-e^{-αt}) هي حلا للمعادلة التفاضلية.",
      "axis_tags": [
        "rl_current_establishment_differential_equation"
      ],
      "solution": {
        "strategy": "نشتق الحل المقترح ثم نعوضه في المعادلة التفاضلية.",
        "steps": [
          {
            "step_number": 1,
            "title": "اشتقاق i(t)",
            "explanation": "\\[i(t)=\\frac{\\beta}{\\alpha}(1-e^{-\\alpha t})\\Rightarrow\\frac{di}{dt}=\\beta e^{-\\alpha t}.\\]"
          },
          {
            "step_number": 2,
            "title": "التحقق",
            "explanation": "\\[\\frac{di}{dt}+\\alpha i=\\beta e^{-\\alpha t}+\\alpha\\frac{\\beta}{\\alpha}(1-e^{-\\alpha t})=\\beta.\\] إذن العبارة تحقق المعادلة."
          }
        ],
        "final_answer": "العبارة المقترحة تحقق \\(di/dt+\\alpha i=\\beta\\)، فهي حل للمعادلة التفاضلية."
      }
    },
    {
      "id": "2015_s01_ex04_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "3- بين أن عبارة التوتر بين طرفي الوشيعة تعطى بالعلاقة: u_b(t)=E/(R+r) (r+Re^{-((R+r)/L)t}).",
      "axis_tags": [
        "inductor_fundamental_relations",
        "rl_current_establishment_differential_equation"
      ],
      "solution": {
        "strategy": "نستعمل u_b=Ldi/dt+ri مع عبارة i(t) بعد تعويض α وβ.",
        "steps": [
          {
            "step_number": 1,
            "title": "عبارة التيار",
            "explanation": "\\[i(t)=\\frac{E}{R+r}\\left(1-e^{-\\frac{R+r}{L}t}\\right).\\]"
          },
          {
            "step_number": 2,
            "title": "المشتقة",
            "explanation": "\\[\\frac{di}{dt}=\\frac{E}{L}e^{-\\frac{R+r}{L}t}.\\]"
          },
          {
            "step_number": 3,
            "title": "توتر الوشيعة",
            "explanation": "\\[u_b=L\\frac{di}{dt}+ri=Ee^{-\\frac{R+r}{L}t}+\\frac{rE}{R+r}\\left(1-e^{-\\frac{R+r}{L}t}\\right).\\]"
          },
          {
            "step_number": 4,
            "title": "التبسيط",
            "explanation": "\\[\\boxed{u_b(t)=\\frac{E}{R+r}\\left(r+Re^{-\\frac{R+r}{L}t}\\right)}.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{u_b(t)=\\frac{E}{R+r}(r+Re^{-((R+r)/L)t})}\\)."
      }
    },
    {
      "id": "2015_s01_ex04_q4",
      "display_order": 4,
      "content_type": "question",
