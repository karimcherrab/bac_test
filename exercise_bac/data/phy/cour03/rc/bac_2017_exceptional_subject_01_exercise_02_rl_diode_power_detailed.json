      "display_order": 6,
      "content_type": "question",
      "text": "6) أثبت أن زمن تناقص الاستطاعة الأعظمية المصروفة في الناقل الأومي R إلى النصف هو: t_{1/2}=τ/2 ln2، ثم أوجد قيمته.",
      "axis_tags": [
        "rl_energy_power"
      ],
      "solution": {
        "strategy": "نضع P(t1/2)=Pmax/2 ونحل المعادلة الأسية.",
        "steps": [
          {
            "step_number": 1,
            "title": "شرط نصف الاستطاعة",
            "explanation": "\\[P_{max}e^{-2t_{1/2}/\\tau}=\\frac{P_{max}}2.\\]"
          },
          {
            "step_number": 2,
            "title": "استخراج الزمن",
            "explanation": "\\[e^{-2t_{1/2}/\\tau}=\\frac12\\Rightarrow\\boxed{t_{1/2}=\\frac{\\tau}{2}\\ln2}.\\]"
          },
          {
            "step_number": 3,
            "title": "الحساب",
            "explanation": "\\[t_{1/2}=\\frac{10}{2}\\ln2\\approx\\boxed{3,46ms}.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{t_{1/2}=\\frac{\\tau}{2}\\ln2\\approx3,46ms}\\)."
      }
    }
