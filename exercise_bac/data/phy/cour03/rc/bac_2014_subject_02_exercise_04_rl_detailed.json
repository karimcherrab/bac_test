  "questions": [
    {
      "id": "2014_s02_ex04_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1- أعط عبارة التوتر الكهربائي u_AB(t) بدلالة i(t).",
      "axis_tags": [
        "inductor_fundamental_relations"
      ],
      "solution": {
        "strategy": "بين A وB توجد الوشيعة الحقيقية ذات الذاتية L والمقاومة الداخلية r.",
        "steps": [
          {
            "step_number": 1,
            "title": "توتر الوشيعة الحقيقية",
            "explanation": "\\[\\boxed{u_{AB}(t)=L\\frac{di(t)}{dt}+r\\,i(t)}.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{u_{AB}=L\\,di/dt+ri}\\)."
      }
    },
    {
      "id": "2014_s02_ex04_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "2- اكتب عبارة u_CB(t) بدلالة i(t).",
      "axis_tags": [
        "electric_circuits_fundamentals"
      ],
      "solution": {
        "strategy": "بين C وB يوجد الناقل الأومي R، فنطبق قانون أوم حسب جهة التوتر المحددة في التمرين.",
        "steps": [
          {
            "step_number": 1,
            "title": "قانون أوم",
            "explanation": "\\[\\boxed{u_{CB}(t)=R\\,i(t)}.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{u_{CB}=Ri}\\)."
      }
    },
    {
      "id": "2014_s02_ex04_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "3- أرفق كل منحنى بالتوتر الكهربائي الموافق u_AB و u_CB مع التعليل.",
      "axis_tags": [
        "inductor_fundamental_relations",
        "rl_time_constant_graphical_analysis"
      ],
      "solution": {
        "strategy": "نقارن القيم عند اللحظة t=0. التيار لا يقفز في الوشيعة، لذا i(0)=0.",
        "steps": [
          {
            "step_number": 1,
            "title": "عند t=0",
            "explanation": "لأن \\(i(0)=0\\): \\[u_{CB}(0)=Ri(0)=0.\\] إذن المنحنى (2) الذي يبدأ من الصفر يمثل \\(u_{CB}\\)."
          },
          {
            "step_number": 2,
            "title": "المنحنى الآخر",
            "explanation": "عند الغلق يكون توتر الوشيعة \\(u_{AB}(0)=E=6V\\)، لذلك المنحنى (1) المتناقص من 6V يمثل \\(u_{AB}\\)."
          }
        ],
        "final_answer": "المنحنى (1) ↔ \\(u_{AB}\\)، والمنحنى (2) ↔ \\(u_{CB}\\)."
      },
