      "tables": [],
      "solution": {
        "strategy": "نحل السؤال بطريقة بسيطة ومفهومة خطوة بخطوة: نشتق العبارة المقترحة ونعوضها في المعادلة ثم نطابق المعاملات.",
        "steps": [
          {
            "step_number": 1,
            "title": "الاشتقاق",
            "explanation": "\\[\\frac{du_R}{dt}=B e^{-At}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "التعويض والمطابقة",
            "explanation": "بعد التعويض في المعادلة: \\[Be^{-At}+\\frac{R+r}{L}\\frac{B}{A}(1-e^{-At})=\\frac{RE}{L}.\\] حتى تتحقق لكل t نجد: \\[\\boxed{A=\\frac{R+r}{L}},\\qquad\\boxed{B=\\frac{RE}{L}}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "صيغة u_R",
            "explanation": "بما أن \\(B/A=RE/(R+r)\\): \\[\\boxed{u_R(t)=\\frac{RE}{R+r}\\left(1-e^{-t/\\tau}\\right)},\\quad \\tau=\\frac{L}{R+r}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(A=(R+r)/L\\)، \\(B=RE/L\\)، ومنه \\(u_R=RE/(R+r)(1-e^{-t/\\tau})\\).",
        "verification": "التحقق: نراجع الوحدات والإشارة ونقارن النتيجة بالسلوك الفيزيائي المتوقع أو بالبيان التجريبي.",
