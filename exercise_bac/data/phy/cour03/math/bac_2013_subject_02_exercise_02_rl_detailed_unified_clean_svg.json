      "solution": {
        "strategy": "نحل السؤال بطريقة بسيطة ومفهومة خطوة بخطوة: عند نقطة التقاطع يكون u_R(t_C)=u_b(t_C). نعوض عبارتي التوترين ونحل بالنسبة إلى e^{-t_C/τ}.",
        "steps": [
          {
            "step_number": 1,
            "title": "4-أ — شرط التقاطع",
            "explanation": "عند \\(t=t_C\\): \\[u_R(t_C)=u_b(t_C).\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "التعويض",
            "explanation": "\\[\\frac{RE}{R+r}(1-e^{-t_C/\\tau})=\\frac{E}{R+r}(r+Re^{-t_C/\\tau}).\\] بحذف العامل المشترك: \\[R-Re^{-t_C/\\tau}R=r+Re^{-t_C/\\tau}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "استخراج τ",
            "explanation": "إذن: \\[R-r=2R e^{-t_C/\\tau}\\Rightarrow e^{-t_C/\\tau}=\\frac{R-r}{2R}.\\] بأخذ اللوغاريتم: \\[\\boxed{\\tau=\\frac{t_C}{\\ln\\left(\\frac{2R}{R-r}\\right)}}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 4,
            "title": "القيمة العددية",
            "explanation": "من البيان تكون نقطة التقاطع عند نحو \\(t_C\\approx8,1ms\\). مع \\(R=90\\Omega\\) و\\(r=10\\Omega\\): \\[\\tau=\\frac{8,1}{\\ln(180/80)}\\approx\\boxed{10ms}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 5,
            "title": "4-ب — حساب L",
            "explanation": "بما أن \\[\\tau=\\frac{L}{R+r},\\] فإن: \\[L=\\tau(R+r)=10\\times10^{-3}(90+10)=\\boxed{1,0H}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\tau=t_C/\\ln(2R/(R-r))\\approx10ms\\)، ومنه \\(\\boxed{L=1,0H}\\).",
