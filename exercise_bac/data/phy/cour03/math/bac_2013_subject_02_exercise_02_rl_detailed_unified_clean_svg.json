        ],
        "final_answer": "\\(\\boxed{du_R/dt+(R+r)u_R/L=RE/L}\\).",
        "verification": "التحقق: نراجع الإشارات والوحدات، ونتأكد أن النتيجة منسجمة مع اتجاهات التوترات المرسومة ومع السلوك الفيزيائي للدارة.",
        "hints": [
          "ابدأ برسم الدارة وتثبيت جهة التيار واتجاهات التوترات قبل تطبيق قانون جمع التوترات.",
          "اكتب العلاقة الحرفية أولا، ثم عوض بعلاقات العناصر ورتب المعادلة خطوة بخطوة."
        ],
        "common_mistakes": [
          "الخطأ في إشارة أحد التوترات بسبب عدم تحديد اتجاه السهم المرجعي على الدارة.",
          "الانتقال مباشرة إلى النتيجة النهائية دون كتابة قانون جمع التوترات ثم علاقات العناصر."
        ]
