  "questions": [
    {
      "id": "2017_elec_ex41_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "في التجربة الأولى: بيّن كيفية ربط راسم الاهتزاز لمتابعة u_R(t) وu_C(t).",
      "solution": {
        "strategy": "توصيل قناتين على R وC.",
        "steps": [
          {
            "step_number": 1,
            "title": "الربط",
            "explanation": "Y1 لقياس uR وY2 لقياس uC مع مرجع مشترك."
          }
        ],
        "final_answer": "Y1→uR، Y2→uC."
      }
    },
    {
      "id": "2017_elec_ex41_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "انسب المنحنيين (a) و(b) للتوتر الموافق مع التعليل.",
      "solution": {
        "strategy": "نستعمل القيم الابتدائية.",
        "steps": [
          {
            "step_number": 1,
            "title": "a",
            "explanation": "uC(0)=0، لذلك (a) يمثل uC."
          },
          {
            "step_number": 2,
            "title": "b",
            "explanation": "uR(0)=E، لذلك (b) يمثل uR."
          }
        ],
        "final_answer": "a→uC، b→uR."
      }
    },
    {
      "id": "2017_elec_ex41_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "حدد t1 وt2 الموافقتين لشحن 40% و90%، وتحقق أن Δt≈1.79τ، ثم احسب τ وR.",
      "solution": {
        "strategy": "حل معادلة الشحن.",
        "steps": [
          {
            "step_number": 1,
            "title": "t1",
            "explanation": "\\[t_1=-\\tau\\ln0.6\\]"
          },
          {
            "step_number": 2,
            "title": "t2",
            "explanation": "\\[t_2=-\\tau\\ln0.1\\]"
          },
          {
            "step_number": 3,
            "title": "القراءة",
            "explanation": "من البيان t1≈5ms وt2≈23ms، ومنه τ≈10ms."
          },
          {
            "step_number": 4,
            "title": "R",
            "explanation": "\\[R=\\tau/C=10k\\Omega\\]"
          }
        ],
        "final_answer": "τ=10ms، R=10kΩ."
      }
    },
    {
      "id": "2017_elec_ex41_q4",
      "display_order": 4,
      "content_type": "question",
      "text": "في التجربة الثانية: صنف الاهتزازات واربط α وβ وγ بالقيم R'=0Ω،100Ω،5000Ω.",
      "solution": {
        "strategy": "التخميد يزداد بزيادة المقاومة.",
        "steps": [
          {
            "step_number": 1,
            "title": "α",
            "explanation": "اهتزازات حرة غير متخامدة → R'=0Ω."
          },
          {
            "step_number": 2,
            "title": "β",
            "explanation": "اهتزازات متخامدة شبه دورية → R'=100Ω."
          },
          {
            "step_number": 3,
            "title": "γ",
            "explanation": "نظام لا دوري حرج تقريباً → R'=5000Ω."
          }
        ],
        "final_answer": "α→0Ω، β→100Ω، γ→5000Ω."
      }
    },
    {
      "id": "2017_elec_ex41_q5",
      "display_order": 5,
      "content_type": "question",
      "text": "من أجل R'=0: أوجد المعادلة التفاضلية لـuC، ثم استنتج T0 وL.",
      "solution": {
        "strategy": "دارة LC مثالية.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[\\frac{d^2u_C}{dt^2}+\\frac1{LC}u_C=0\\]"
          },
          {
            "step_number": 2,
            "title": "الحل",
            "explanation": "في uC=A cos(Bt): A=E وB=1/√(LC)."
          },
          {
            "step_number": 3,
            "title": "T0",
            "explanation": "من الشكل: 2T0=2.5ms، إذن T0=1.25ms."
          },
          {
            "step_number": 4,
            "title": "L",
            "explanation": "\\[L=\\frac{T_0^2}{4\\pi^2C}=40mH\\]"
          }
        ],
        "final_answer": "T0=1.25ms، L=40mH."
      }
    }
  ],
