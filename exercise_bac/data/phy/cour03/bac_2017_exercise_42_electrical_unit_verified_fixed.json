  "questions": [
    {
      "id": "2017_elec_ex42_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "في الوضع (1): ما الظاهرة التي تحدث؟ وضح اتجاه التيار والتوترين uC وuR.",
      "solution": {
        "strategy": "الوضع الأول للشحن.",
        "steps": [
          {
            "step_number": 1,
            "title": "الظاهرة",
            "explanation": "شحن المكثفة."
          }
        ],
        "final_answer": "شحن المكثفة."
      }
    },
    {
      "id": "2017_elec_ex42_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "اكتب المعادلة التفاضلية لـuC، وحدد A وB وα في uC=A+B e^{-αt}.",
      "solution": {
        "strategy": "معادلة RC.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[\\frac{du_C}{dt}+\\frac1{RC}u_C=\\frac E{RC}\\]"
          },
          {
            "step_number": 2,
            "title": "الثوابت",
            "explanation": "A=E، B=-E، α=1/(RC)، ووحدة α هي s^{-1}."
          }
        ],
        "final_answer": "A=E، B=-E، α=1/(RC)."
      }
    },
    {
      "id": "2017_elec_ex42_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "باستغلال البيانين أوجد τ وE وC وR.",
      "solution": {
        "strategy": "نستعمل قراءات التصحيح.",
        "steps": [
          {
            "step_number": 1,
            "title": "النتائج",
            "explanation": "τ=0.5s، E=9V، C≈49.4µF، R≈10.1kΩ."
          }
        ],
        "final_answer": "τ=0.5s، E=9V، C≈49.4µF، R≈10.1kΩ."
      }
    },
    {
      "id": "2017_elec_ex42_q4",
      "display_order": 4,
      "content_type": "question",
      "text": "في الوضع (2): اكتب معادلة LC واستنتج T0 وL من الشكل 71.",
      "solution": {
        "strategy": "دارة LC مثالية.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[\\frac{d^2u_C}{dt^2}+\\frac1{LC}u_C=0\\]"
          },
          {
            "step_number": 2,
            "title": "الدور",
            "explanation": "من منحنى الطاقة: T0=2ms."
          },
          {
            "step_number": 3,
            "title": "L",
            "explanation": "\\[L\\approx2mH\\]"
          }
        ],
        "final_answer": "T0=2ms، L≈2mH."
      }
    }
  ],
