  "questions": [
    {
      "id": "2017_elec_ex46_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1) في الوضع (1): ما الظاهرة؟ مثّل الاتجاهات، جد معادلة uC، وبيّن أن uC=E(1-e^{-t/(RC)}) حل لها.",
      "solution": {
        "strategy": "الوضع الأول شحن RC.",
        "steps": [
          {
            "step_number": 1,
            "title": "الظاهرة",
            "explanation": "شحن المكثفة."
          },
          {
            "step_number": 2,
            "title": "المعادلة",
            "explanation": "\\[\\frac{du_C}{dt}+\\frac1{RC}u_C=\\frac E{RC}\\]"
          },
          {
            "step_number": 3,
            "title": "التحقق",
            "explanation": "باشتقاق الحل والتعويض تتحقق المعادلة."
          }
        ],
        "final_answer": "شحن RC."
      }
    },
    {
      "id": "2017_elec_ex46_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "2) في الوضع (2): جد المعادلة التفاضلية لـi(t). إذا كان i=Ae^{-Rt/L}+B فجد A وB.",
      "solution": {
        "strategy": "دارة RL.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[\\frac{di}{dt}+\\frac RL i=\\frac EL\\]"
          },
          {
            "step_number": 2,
            "title": "B",
            "explanation": "في النظام الدائم B=E/R."
          },
          {
            "step_number": 3,
            "title": "A",
            "explanation": "من i(0)=0 نحصل على A=-E/R."
          }
        ],
        "final_answer": "A=-E/R، B=E/R."
      }
    },
    {
      "id": "2017_elec_ex46_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "3) من البيانين: أرفق كل منحنى بالوضع المناسب واستنتج E وR وC وL.",
      "solution": {
        "strategy": "نقرأ القيم النهائية والثوابت الزمنية.",
        "steps": [
          {
            "step_number": 1,
            "title": "الإسناد",
            "explanation": "(a) يمثل تيار RL في الوضع (2)، و(b) يمثل uC في الوضع (1)."
          },
          {
            "step_number": 2,
            "title": "E",
            "explanation": "من (b): E=6V."
          },
          {
            "step_number": 3,
            "title": "R",
            "explanation": "من (a): Imax=12mA ⇒ R=500Ω."
          },
          {
            "step_number": 4,
            "title": "C",
            "explanation": "من (b): τb=5ms ⇒ C=τ/R=10µF."
          },
          {
            "step_number": 5,
            "title": "L",
            "explanation": "من (a): τa=0.5ms ⇒ L=Rτ=0.25H."
          }
        ],
        "final_answer": "E=6V، R=500Ω، C=10µF، L=0.25H."
      }
    }
  ],
