  "questions": [
    {
      "id": "2017_elec_ex45_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1) أعد رسم دارة الشحن موضحاً الجهة الاصطلاحية للتيار والتوتر بين طرفي كل عنصر.",
      "solution": {
        "strategy": "نوجه دارة RC.",
        "steps": [
          {
            "step_number": 1,
            "title": "التوجيه",
            "explanation": "التيار الاصطلاحي يخرج من المولد ويمر عبر R نحو C.",
            "graph_data": {
              "diagram_type": "ex45_oriented",
              "title": "دارة الشحن الموجهة",
              "description": "دارة الشحن الموجهة",
              "svg": "<svg viewBox=\"0 0 800 320\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"25\" y=\"20\" width=\"750\" height=\"260\" rx=\"18\" fill=\"white\" stroke=\"#cbd5e1\"/><path d=\"M130 80 H650 V240 H130 Z\" fill=\"none\" stroke=\"#111827\" stroke-width=\"5\"/><circle cx=\"130\" cy=\"160\" r=\"30\" fill=\"white\" stroke=\"#111827\" stroke-width=\"4\"/><text x=\"118\" y=\"168\" font-size=\"22\">E</text><rect x=\"250\" y=\"55\" width=\"100\" height=\"50\" fill=\"white\" stroke=\"#111827\" stroke-width=\"3\"/><text x=\"270\" y=\"87\" font-size=\"20\">R</text><line x1=\"430\" y1=\"80\" x2=\"430\" y2=\"130\" stroke=\"#111827\" stroke-width=\"5\"/><line x1=\"400\" y1=\"130\" x2=\"460\" y2=\"130\" stroke=\"#111827\" stroke-width=\"6\"/><line x1=\"400\" y1=\"165\" x2=\"460\" y2=\"165\" stroke=\"#111827\" stroke-width=\"6\"/><text x=\"475\" y=\"155\" font-size=\"22\">C/L</text><text x=\"560\" y=\"70\" font-size=\"20\">K</text></svg>",
              "render_mode": "inline",
              "responsive": true
            }
          }
        ],
        "final_answer": "كما في الرسم."
      }
    },
    {
      "id": "2017_elec_ex45_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "2) باستعمال قانون جمع التوترات اكتب المعادلة التفاضلية للشحنة q(t).",
      "solution": {
        "strategy": "E=uR+uC.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[\\frac{dq}{dt}+\\frac1{RC}q=\\frac ER\\]"
          }
        ],
        "final_answer": "dq/dt+q/(RC)=E/R."
      }
    },
    {
      "id": "2017_elec_ex45_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "3) إذا كان q(t)=A(1-e^{-bt})، جد A وb.",
      "solution": {
        "strategy": "المطابقة.",
        "steps": [
          {
            "step_number": 1,
            "title": "الثوابت",
            "explanation": "A=CE=Qmax، وb=1/(RC)."
          }
        ],
        "final_answer": "A=CE، b=1/(RC)."
      }
    },
    {
      "id": "2017_elec_ex45_q4",
      "display_order": 4,
      "content_type": "question",
      "text": "4) جد عبارة شدة التيار i(t).",
      "solution": {
        "strategy": "i=dq/dt.",
        "steps": [
          {
            "step_number": 1,
            "title": "العبارة",
            "explanation": "\\[i(t)=\\frac ER e^{-t/(RC)}\\]"
          }
        ],
        "final_answer": "i=(E/R)e^-t/RC."
      }
    },
    {
      "id": "2017_elec_ex45_q5",
      "display_order": 5,
      "content_type": "question",
      "text": "5) باستعمال البيان: احسب R، ثم بيّن أن C=2µF.",
      "solution": {
        "strategy": "قراءة I0 وτ.",
        "steps": [
          {
            "step_number": 1,
            "title": "R",
            "explanation": "I0=4.8mA ⇒ R=E/I0=1250Ω."
          },
          {
            "step_number": 2,
            "title": "C",
            "explanation": "من المماس τ=2.5ms، ومنه C=τ/R=2µF."
          }
        ],
        "final_answer": "R=1250Ω، C=2µF."
      }
    },
    {
      "id": "2017_elec_ex45_q6",
      "display_order": 6,
      "content_type": "question",
      "text": "6) في الوضع (2): بيّن معادلة LC، اختر المنحنى الموافق، احسب L وطاقة المكثفة عند t=0 وt=T/4، وفسر التغير.",
      "solution": {
        "strategy": "الوشيعة مثالية فلا يحدث تخامد.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[\\frac{d^2u_C}{dt^2}+\\frac1{LC}u_C=0\\]"
          },
          {
            "step_number": 2,
            "title": "المنحنى",
            "explanation": "المنحنى الصحيح هو الشكل 81 لأنه جيبي غير متخامد."
          },
          {
            "step_number": 3,
            "title": "L",
            "explanation": "من T0=2.8ms: L=0.10H."
          },
          {
            "step_number": 4,
            "title": "الطاقة عند 0",
            "explanation": "EC(0)=1/2 CE²=3.6×10^-5J."
          },
          {
            "step_number": 5,
            "title": "عند T/4",
            "explanation": "uC=0 ⇒ EC=0."
          },
          {
            "step_number": 6,
            "title": "التفسير",
            "explanation": "انتقلت الطاقة من المكثفة إلى الوشيعة دون ضياع."
          }
        ],
        "final_answer": "الشكل81، L=0.10H، EC(0)=3.6×10^-5J، EC(T/4)=0."
      }
    }
  ],
