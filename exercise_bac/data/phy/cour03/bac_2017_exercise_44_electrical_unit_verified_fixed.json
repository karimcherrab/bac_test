  "questions": [
    {
      "id": "2017_elec_ex44_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "I-1) حدّد المنحنى الموافق لكل حالة مع التعليل.",
      "solution": {
        "strategy": "وجود النواة يزيد الذاتية وثابت الزمن.",
        "steps": [
          {
            "step_number": 1,
            "title": "النتيجة",
            "explanation": "τa=4ms وτb=16ms، لذا (a) بدون النواة و(b) مع النواة."
          }
        ],
        "final_answer": "a بدون نواة، b مع نواة."
      }
    },
    {
      "id": "2017_elec_ex44_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "I-2) احسب مقاومة الوشيعة ثم ذاتيتها في كل تجربة.",
      "solution": {
        "strategy": "من I0=0.12A وR=40Ω.",
        "steps": [
          {
            "step_number": 1,
            "title": "r",
            "explanation": "r=6/0.12-40=10Ω."
          },
          {
            "step_number": 2,
            "title": "بدون النواة",
            "explanation": "L=4ms×50Ω=0.20H."
          },
          {
            "step_number": 3,
            "title": "مع النواة",
            "explanation": "L=16ms×50Ω=0.80H."
          }
        ],
        "final_answer": "r=10Ω، L=0.20H و0.80H."
      }
    },
    {
      "id": "2017_elec_ex44_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "I-3) احسب الطاقة الأعظمية المخزنة في الوشيعة في التجربتين وبرر الاختلاف.",
      "solution": {
        "strategy": "EL=1/2LI0².",
        "steps": [
          {
            "step_number": 1,
            "title": "مع النواة",
            "explanation": "5.76×10^-3 J."
          },
          {
            "step_number": 2,
            "title": "بدون النواة",
            "explanation": "1.44×10^-3 J."
          },
          {
            "step_number": 3,
            "title": "السبب",
            "explanation": "الاختلاف ناتج عن اختلاف الذاتية L."
          }
        ],
        "final_answer": "5.76mJ و1.44mJ."
      }
    },
    {
      "id": "2017_elec_ex44_q4",
      "display_order": 4,
      "content_type": "question",
      "text": "II-1) احسب سعة المكثفة.",
      "solution": {
        "strategy": "C=Q/U0.",
        "steps": [
          {
            "step_number": 1,
            "title": "الحساب",
            "explanation": "C=2.5µC/5V=0.5µF."
          }
        ],
        "final_answer": "C=0.5µF."
      }
    },
    {
      "id": "2017_elec_ex44_q5",
      "display_order": 5,
      "content_type": "question",
      "text": "II-2) حدّد نمط الاهتزازات، واستنتج ذاتية الوشيعة الجديدة، وهل هي مماثلة للوشيعة السابقة؟",
      "solution": {
        "strategy": "نستعمل منحنى طاقة المكثفة.",
        "steps": [
          {
            "step_number": 1,
            "title": "النمط",
            "explanation": "اهتزازات حرة غير متخامدة ودورية."
          },
          {
            "step_number": 2,
            "title": "T0",
            "explanation": "من منحنى الطاقة T0/2=1ms ⇒ T0=2ms."
          },
          {
            "step_number": 3,
            "title": "L",
            "explanation": "L'=T0²/(4π²C)=0.20H."
          },
          {
            "step_number": 4,
            "title": "المقارنة",
            "explanation": "غير مماثلة لأن مقاومتها هنا معدومة تقريباً رغم تساوي الذاتية مع إحدى الحالتين."
          }
        ],
        "final_answer": "T0=2ms، L'=0.20H."
      }
    }
  ],
