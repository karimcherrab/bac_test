      "solution": {
        "strategy": "نحسب \\(x_f\\) من تركيز الهيدرونيوم، ثم نقسمه على \\(x_{max}=CV\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "التقدم النهائي",
            "explanation": "\\[\n[H_3O^+]_f=10^{-pH}=10^{-2.9}\n\\]\nإذن:\n\\[\nx_f=[H_3O^+]_fV=10^{-2.9}V\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
