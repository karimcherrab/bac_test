    {
      "id": "2009_s01_ex4_q3",
      "display_order": 3,
      "label": "3",
      "group_id": "main",
      "content_type": "question",
      "text": "أوجد عبارة \\([H_3O^+]\\) بدلالة \\(C\\) و\\(\tau\\)، حيث \\(\tau\\) هي نسبة تقدم التفاعل.",
      "axis_tags": [
        "chemical_equilibrium",
        "final_progress_ratio"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نستعمل تعريف \\(\tau=x_f/x_{max}\\)، ومع \\(x_{max}=CV\\) و\\(x_f=n_f(H_3O^+)\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "ربط التقدم بتركيز الهيدرونيوم",
            "explanation": "\\[\nx_f=n_f(H_3O^+)=[H_3O^+]_fV\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "استعمال نسبة التقدم",
            "explanation": "\\[\n\\tau=\\frac{x_f}{x_{max}}\n=\\frac{x_f}{CV}\n\\]\nإذن:\n\\[\nx_f=\\tau CV\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "العبارة النهائية",
            "explanation": "\\[\n[H_3O^+]_f=\\frac{x_f}{V}\n=\\frac{\\tau CV}{V}\n\\]\nومنها:\n\\[\n\\boxed{[H_3O^+]_f=\\tau C}\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\[\n\\boxed{[H_3O^+]_f=\\tau C}\n\\]",
        "verification": "مطابق للتصحيح الرسمي.",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2009_s01_ex4_q4",
      "display_order": 4,
      "label": "4",
      "group_id": "main",
      "content_type": "question",
      "text": "بين أن ثابت الحموضة للثنائية \\(CH_3COOH/CH_3COO^-\\) يكتب:\n\\[\nK_a=\\frac{\\tau^2C}{1-\\tau}\n\\]",
      "axis_tags": [
        "chemical_equilibrium",
        "acid_dissociation_constant"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نكتب تراكيز الأنواع عند التوازن بدلالة \\(C\\) و\\(\tau\\)، ثم نعوض في تعريف \\(K_a\\).",
        "steps": [
          {
            "step_number": 1,
            "title": "تركيز الهيدرونيوم والأساس المرافق",
            "explanation": "\\[\n[H_3O^+]_f=[CH_3COO^-]_f=\\tau C\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "تركيز الحمض المتبقي",
            "explanation": "كمية الحمض النهائية:\n\\[\nn_f(CH_3COOH)=CV-x_f=CV-\\tau CV\n\\]\nإذن:\n\\[\n[CH_3COOH]_f=C(1-\\tau)\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "التعويض في \\(K_a\\)",
            "explanation": "\\[\nK_a=\n\\frac{[H_3O^+]_f[CH_3COO^-]_f}{[CH_3COOH]_f}\n\\]\n\\[\nK_a=\n\\frac{(\\tau C)(\\tau C)}{C(1-\\tau)}\n\\]\nإذن:\n\\[\n\\boxed{K_a=\\frac{\\tau^2C}{1-\\tau}}\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\[\n\\boxed{K_a=\\frac{\\tau^2C}{1-\\tau}}\n\\]",
        "verification": "مطابق للتصحيح الرسمي.",
        "hints": [],
        "common_mistakes": []
      }
    },
