  "questions": [
    {
      "id": "2015_s01_exp_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "1- اكتب معادلة تفاعل المعايرة الحادث.",
      "axis_tags": [
        "acid_base_titration_equivalence"
      ],
      "solution": {
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[\\boxed{C_6H_5CO_2H_{(aq)}+HO^-_{(aq)}\\rightarrow C_6H_5CO_2^-_{(aq)}+H_2O_{(l)}}\\]"
          }
        ],
        "final_answer": "\\(\\boxed{C_6H_5CO_2H+HO^-\\rightarrow C_6H_5CO_2^-+H_2O}\\)."
      }
    },
    {
      "id": "2015_s01_exp_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "2- حدد بيانيا إحداثيتي نقطة التكافؤ \\(E\\).",
      "figure_ids": [
        "2015_s01_exp_f6"
      ],
      "axis_tags": [
        "acid_base_titration_equivalence"
      ],
      "solution": {
        "steps": [
          {
            "step_number": 1,
            "title": "قراءة التكافؤ",
            "explanation": "من الشكل-6: \\(\\boxed{V_{bE}=20mL}\\) و \\(\\boxed{pH_E=8,4}\\)، أي \\(\\boxed{E(20mL;8,4)}\\)."
          }
        ],
        "final_answer": "\\(\\boxed{E(20mL;8,4)}\\)."
      }
    },
    {
      "id": "2015_s01_exp_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "3- احسب التركيز المولي \\(C_a\\) للحمض.",
      "axis_tags": [
        "acid_base_titration_equivalence"
      ],
      "solution": {
        "steps": [
          {
            "step_number": 1,
            "title": "شرط التكافؤ",
            "explanation": "\\[C_aV_a=C_bV_{bE}\\Rightarrow C_a=\\frac{10^{-1}\\times20}{20}=10^{-1}mol.L^{-1}.\\]"
          }
        ],
        "final_answer": "\\(\\boxed{C_a=1,0\\times10^{-1}mol.L^{-1}}\\)."
      }
    },
    {
      "id": "2015_s01_exp_q4",
      "display_order": 4,
      "content_type": "question",
      "text": "4- عين بيانيا قيمة \\(pK_a\\) للثنائية: \\(C_6H_5CO_2H/C_6H_5CO_2^-\\).",
      "figure_ids": [
        "2015_s01_exp_f6"
      ],
      "axis_tags": [
        "acid_dissociation_constant_strength",
        "ph_pka_relation_dominance_domains"
      ],
      "solution": {
        "steps": [
          {
            "step_number": 1,
            "title": "نصف التكافؤ",
            "explanation": "عند \\(V_b=V_{bE}/2=10mL\\) يكون \\(pH=pK_a\\). من البيان: \\(\\boxed{pK_a=4,2}\\)."
          }
        ],
        "final_answer": "\\(\\boxed{pK_a=4,2}\\)."
      }
    },
    {
      "id": "2015_s01_exp_q5",
      "display_order": 5,
      "content_type": "question",
      "text": "5- احسب تراكيز الأفراد الكيميائية المتواجدة في المحلول عند سكب \\(14mL\\) من المحلول الأساسي ثم أوجد قيمة نسبة التقدم النهائي \\(\\tau_f\\) للتفاعل. ماذا تستنتج؟\nعلما أن المعايرة تمت عند الدرجة \\(25^\\circ C\\).",
      "figure_ids": [
        "2015_s01_exp_f6"
      ],
      "axis_tags": [
        "acid_base_titration_equivalence",
        "final_advancement_limited_transformation"
      ],
      "solution": {
        "steps": [
          {
            "step_number": 1,
            "title": "قراءة pH",
            "explanation": "من البيان عند \\(V_b=14mL\\): \\(pH\\approx4,5\\). لذلك \\([H_3O^+]=10^{-4,5}=3,16\\times10^{-5}mol.L^{-1}\\) و \\([HO^-]=10^{-9,5}=3,16\\times10^{-10}mol.L^{-1}\\)."
          },
          {
            "step_number": 2,
            "title": "الحجم الكلي",
            "explanation": "\\(V_T=20+14=34mL\\)."
          },
          {
            "step_number": 3,
            "title": "تركيز Na+",
            "explanation": "\\[[Na^+]=\\frac{C_bV_b}{V_T}=4,11\\times10^{-2}mol.L^{-1}.\\]"
          },
          {
            "step_number": 4,
            "title": "تركيز البنزوات",
            "explanation": "\\[[C_6H_5CO_2^-]=\\frac{C_bV_b}{V_T}=4,11\\times10^{-2}mol.L^{-1}.\\]"
          },
          {
            "step_number": 5,
            "title": "تركيز الحمض المتبقي",
            "explanation": "\\[[C_6H_5CO_2H]=\\frac{C_aV_a-C_bV_b}{V_T}=1,765\\times10^{-2}mol.L^{-1}.\\]"
          },
          {
            "step_number": 6,
            "title": "نسبة التقدم النهائي",
            "explanation": "\\(x_{max}=C_bV_b=1,4\\times10^{-3}mol\\) و \\(x_f\\approx x_{max}\\)، ومنه \\(\\boxed{\\tau_f\\approx1}\\)."
          },
          {
            "step_number": 7,
            "title": "الاستنتاج",
            "explanation": "تفاعل المعايرة كلي عمليا."
          }
        ],
        "final_answer": "\\([H_3O^+]=3,16\\times10^{-5}\\)، \\([HO^-]=3,16\\times10^{-10}\\)، \\([Na^+]=[C_6H_5CO_2^-]=4,11\\times10^{-2}\\)، \\([C_6H_5CO_2H]=1,765\\times10^{-2}mol.L^{-1}\\)، و \\(\\boxed{\\tau_f\\approx1}\\)."
      }
    }
  ],
