  "questions": [
    {
      "id": "2010_s02_eq_ex04_q1a",
      "display_order": 1,
      "label": "1-أ",
      "group_id": null,
      "content_type": "question",
      "text": "احسب التركيز المولي \\(C_1\\) للمحلول \\(S_1\\)، علما أن الحجم المولي في شروط التجربة \\(V_m=24L.mol^{-1}\\).",
      "axis_tags": [
        "bronsted_acid_base_pairs"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نحوّل حجم غاز النشادر إلى كمية مادة ثم نقسم على حجم المحلول.",
        "steps": [
          {
            "step_number": 1,
            "title": "1-أ — حساب كمية مادة NH₃",
            "explanation": "\\[n(NH_3)=\\frac{V_g}{V_m}=\\frac{1.2}{24}=5.0\\times10^{-2}\\,mol.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "1-أ — حساب التركيز C₁",
            "explanation": "حجم المحلول \\(V_1=500mL=0.500L\\).\n\\[C_1=\\frac{n}{V_1}=\\frac{5.0\\times10^{-2}}{0.500}=0.10\\,mol\\cdot L^{-1}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{C_1=0.10\\,mol\\cdot L^{-1}}\\).",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2010_s02_eq_ex04_q1b",
      "display_order": 2,
      "label": "1-ب",
      "group_id": null,
      "content_type": "question",
      "text": "اكتب المعادلة الكيميائية للتفاعل المنمذج للتحول الكيميائي الحاصل.",
      "axis_tags": [
        "bronsted_acid_base_pairs"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نكتب تفاعل النشادر مع الماء وفق برونستد.",
        "steps": [
          {
            "step_number": 1,
            "title": "1-ب — معادلة التفاعل",
            "explanation": "النشادر \\(NH_3\\) أساس برونستد يستقبل بروتونا من الماء:\n\\[NH_3{}_{(g)}+H_2O_{(l)}\\rightleftharpoons NH_4^+{}_{(aq)}+HO^-{}_{(aq)}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{NH_3+H_2O\\rightleftharpoons NH_4^++HO^-}\\).",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2010_s02_eq_ex04_q2a",
      "display_order": 3,
      "label": "2-أ",
      "group_id": "part_2",
      "content_type": "question",
      "text": "أنشئ جدولا لتقدم التفاعل.",
      "axis_tags": [
        "ph_aqueous_solutions_ionic_product",
        "final_advancement_limited_transformation",
        "strong_weak_acids_bases"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نكتب كميات المادة بدلالة التقدم.",
        "steps": [
          {
            "step_number": 1,
            "title": "2-أ — جدول التقدم",
            "explanation": "للتفاعل:\n\\[NH_3+H_2O\\rightleftharpoons NH_4^++HO^-\\]\n- ابتدائيا: \\(n(NH_3)=C_1V_1=0.1V_1\\)، الماء بوفرة، \\(n(NH_4^+)=0\\)، \\(n(HO^-)=0\\).\n- عند تقدم \\(x\\): \\(0.1V_1-x\\)، الماء بوفرة، \\(x\\)، \\(x\\).\n- نهائيا: \\(0.1V_1-x_f\\)، الماء بوفرة، \\(x_f\\)، \\(x_f\\).",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": [
              {
