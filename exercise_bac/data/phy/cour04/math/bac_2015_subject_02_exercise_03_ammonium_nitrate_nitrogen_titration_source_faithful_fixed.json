      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "من شرط التكافؤ نحسب تركيز NH4+ في Sa، ثم نحسب كمية NH4NO3 في كامل العينة، ومنها كمية وكتلة الأزوت.",
        "steps": [
          {
            "step_number": 1,
            "title": "شرط التكافؤ",
            "explanation": "\\[C_aV_a=C_bV_{bE}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "حساب Ca",
            "explanation": "\\[C_a=\\frac{C_bV_{bE}}{V_a}=\\frac{0,2\\times14}{10}=\\boxed{0,28\\,mol\\cdot L^{-1}}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "كمية نترات الأمونيوم في كامل المحلول",
            "explanation": "\\[n(NH_4NO_3)=C_aV=0,28\\times0,250=0,070\\,mol.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 4,
            "title": "كمية مادة الأزوت",
            "explanation": "كل مول من \\(NH_4NO_3\\) يحتوي على مولين من ذرات N، لذلك \\[n(N)=2\\times0,070=0,140\\,mol.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 5,
            "title": "كتلة الأزوت",
            "explanation": "\\[m_N=n(N)M(N)=0,140\\times14=\\boxed{1,96\\,g}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{C_a=0,28\\,mol\\cdot L^{-1}}\\)، و\\(\\boxed{m_N=1,96\\,g}\\).",
        "verification": "",
