        "steps": [
          {
            "step_number": 1,
            "title": "كمية NH4+ الابتدائية",
            "explanation": "\\[n_1=C_1V_1=0,15\\times20\\times10^{-3}=3,0\\times10^{-3}\\,mol.\\]",
