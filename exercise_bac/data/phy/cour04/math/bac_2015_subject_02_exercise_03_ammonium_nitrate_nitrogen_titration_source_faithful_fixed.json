    {
      "id": "2015_s02_ex03_q1c",
      "display_order": 3,
      "label": "1-ج",
      "group_id": "part_1",
      "content_type": "question",
      "text": "بين أنه عند التوازن: \\(x_{eq}=1,5\\times10^{-3}mol\\).",
      "axis_tags": [
        "ph_pka_relation_dominance_domains",
        "final_advancement_limited_transformation"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "بما أن pH=pKa للثنائية NH4+/NH3 فإن تركيزي الشكلين متساويان.",
        "steps": [
          {
            "step_number": 1,
            "title": "استعمال pH=pKa",
            "explanation": "\\[pH=pK_a+\\log\\frac{[NH_3]}{[NH_4^+]}.\\] وبما أن \\(pH=pK_a=9,2\\) نحصل على \\([NH_3]=[NH_4^+]\\).",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "الكتابة بدلالة xeq",
            "explanation": "الحجم نفسه لكل الأنواع، لذلك تساوي التركيزين يعني تساوي كميتي المادة:\n\\[x_{eq}=3,0\\times10^{-3}-x_{eq}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "الحل",
            "explanation": "\\[2x_{eq}=3,0\\times10^{-3}\\Rightarrow\\boxed{x_{eq}=1,5\\times10^{-3}\\,mol}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{x_{eq}=1,5\\times10^{-3}\\,mol}\\).",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2015_s02_ex03_q1d",
