            "title": "كمية HO- الابتدائية",
            "explanation": "\\[n_2=C_2V_2=0,15\\times10\\times10^{-3}=1,5\\times10^{-3}\\,mol.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "جدول التقدم",
            "explanation": "ابتدائيا: \\(n(NH_4^+)=3,0\\times10^{-3}\\), \\(n(HO^-)=1,5\\times10^{-3}\\), و\\(n(NH_3)=0\\).\nأثناء التفاعل: \\(3,0\\times10^{-3}-x\\), \\(1,5\\times10^{-3}-x\\), \\(x\\).\nعند النهاية: نفس العبارات مع \\(x=x_f\\).",
            "calculation": "",
            "result": "",
