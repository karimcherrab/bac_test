            "title": "الحساب",
            "explanation": "\\[\\tau_f=\\frac{x_{eq}}{x_{max}}=\\frac{1,5\\times10^{-3}}{1,5\\times10^{-3}}=\\boxed{1}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
