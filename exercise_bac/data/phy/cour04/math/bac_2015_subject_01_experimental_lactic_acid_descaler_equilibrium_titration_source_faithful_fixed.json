      "solution": {
        "strategy": "حمض اللاكتيك حمض كربوكسيلي ضعيف يمنح بروتونا للماء.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[C_3H_6O_3(aq)+H_2O(l)\\rightleftharpoons C_3H_5O_3^-(aq)+H_3O^+(aq).\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{C_3H_6O_3+H_2O\\rightleftharpoons C_3H_5O_3^-+H_3O^+}\\).",
        "verification": "",
