      "label": "1",
      "group_id": null,
      "content_type": "question",
      "text": "اكتب معادلة التفاعل المنمذجة لانحلال حمض الإيثانويك في الماء.",
      "axis_tags": [
        "bronsted_acid_base_pairs"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نعتبر حمض الإيثانويك حمض برونستد ضعيفا يمنح بروتونا لجزيء الماء.",
        "steps": [
          {
            "step_number": 1,
            "title": "تحديد الأنواع المتبادلة للبروتون",
            "explanation": "حمض الإيثانويك \\(CH_3COOH\\) يمنح بروتونا \\(H^+\\) للماء، فيتشكل \\(CH_3COO^-\\) و\\(H_3O^+\\).",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "كتابة معادلة التفاعل",
            "explanation": "\\[CH_3COOH_{(aq)}+H_2O_{(l)}\\rightleftharpoons CH_3COO^-_{(aq)}+H_3O^+_{(aq)}\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{CH_3COOH_{(aq)}+H_2O_{(l)}\\rightleftharpoons CH_3COO^-_{(aq)}+H_3O^+_{(aq)}}\\).",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
