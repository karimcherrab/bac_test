  "questions": [
    {
      "id": "2013_s01_ex03_q1",
      "display_order": 1,
      "label": "1-أ",
      "group_id": "part_1",
      "content_type": "question",
      "text": "احسب التركيز المولي \\(c_1\\) للمحلول \\((S_1)\\).",
      "axis_tags": [
        "strong_weak_acids_bases"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نحسب الكتلة المولية لحمض الإيثانويك ثم كمية المادة وأخيرا التركيز المولي.",
        "steps": [
          {
            "step_number": 1,
            "title": "الكتلة المولية",
            "explanation": "\\[M(CH_3COOH)=2M(C)+4M(H)+2M(O)=2\\times12+4\\times1+2\\times16=60\\,g\\cdot mol^{-1}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "كمية المادة",
            "explanation": "\\[n=\\frac{m}{M}=\\frac{0,72}{60}=1,2\\times10^{-2}\\,mol.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "التركيز المولي",
            "explanation": "\\[c_1=\\frac{n}{V}=\\frac{1,2\\times10^{-2}}{0,800}=1,5\\times10^{-2}\\,mol\\cdot L^{-1}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{c_1=1,5\\times10^{-2}\\,mol\\cdot L^{-1}}\\).",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2013_s01_ex03_q2",
      "display_order": 2,
      "label": "1-ب",
      "group_id": "part_1",
      "content_type": "question",
      "text": "اكتب المعادلة النموذجية لتفاعل حمض الإيثانويك مع الماء.",
      "axis_tags": [
        "bronsted_acid_base_pairs",
        "strong_weak_acids_bases"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "حمض الإيثانويك يمنح بروتونا للماء.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[CH_3COOH_{(aq)}+H_2O_{(l)}\\rightleftharpoons CH_3COO^-_{(aq)}+H_3O^+_{(aq)}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{CH_3COOH+H_2O\\rightleftharpoons CH_3COO^-+H_3O^+}\\).",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2013_s01_ex03_q3",
      "display_order": 3,
      "label": "1-ج",
      "group_id": "part_1",
      "content_type": "question",
      "text": "أنشئ جدولا لتقدم التفاعل.",
      "axis_tags": [
        "final_advancement_limited_transformation"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نرمز لكمية حمض الإيثانويك الابتدائية بـ n0 وللتقدم بـ x.",
        "steps": [
          {
            "step_number": 1,
            "title": "جدول التقدم",
            "explanation": "للتفاعل \\(CH_3COOH+H_2O\\rightleftharpoons CH_3COO^-+H_3O^+\\):\n- الحالة الابتدائية: \\(n(CH_3COOH)=n_0\\)، الماء بوفرة، و\\(n(CH_3COO^-)=0\\)، \\(n(H_3O^+)=0\\).\n- أثناء التفاعل: \\(n_0-x\\)، الماء بوفرة، \\(x\\)، \\(x\\).\n- عند التوازن: \\(n_0-x_{eq}\\)، الماء بوفرة، \\(x_{eq}\\)، \\(x_{eq}\\).",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": [
              {
                "id": "2013_s01_ex03_q1c_table",
                "usage": "solution",
                "placement": "solution",
                "title": "جدول تقدم التفاعل",
                "columns": [
                  "الحالة",
                  "CH₃COOH",
                  "H₂O",
                  "CH₃COO⁻",
                  "H₃O⁺"
                ],
                "rows": [
                  [
                    "ابتدائية",
                    "n₀",
                    "بوفرة",
                    "0",
                    "0"
                  ],
                  [
                    "أثناء التحول (x)",
                    "n₀-x",
                    "بوفرة",
                    "x",
                    "x"
                  ],
                  [
                    "نهائية / توازن",
                    "n₀-x_f",
                    "بوفرة",
                    "x_f",
                    "x_f"
                  ]
                ]
              }
            ]
          }
        ],
        "final_answer": "عند التوازن: \\(n(CH_3COOH)=n_0-x_{eq}\\)، و\\(n(CH_3COO^-)=n(H_3O^+)=x_{eq}\\).",
        "verification": "",
