    },
    {
      "id": "2013_s01_ex03_q4",
      "display_order": 4,
      "label": "1-د",
      "group_id": "part_1",
      "content_type": "question",
      "text": "عبر عن التقدم \\(x_{eq}\\) عند التوازن بدلالة: \\(pH\\) و \\(V\\)، حيث \\(V\\): حجم المحلول \\((S_1)\\).",
      "axis_tags": [
        "ph_aqueous_solutions_ionic_product",
        "final_advancement_limited_transformation"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "من تعريف pH نحسب تركيز H3O+، ثم كمية مادته وهي مساوية للتقدم عند التوازن.",
        "steps": [
          {
            "step_number": 1,
            "title": "تركيز الهيدرونيوم",
            "explanation": "\\[[H_3O^+]_{eq}=10^{-pH}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "التقدم عند التوازن",
            "explanation": "\\[x_{eq}=n(H_3O^+)_{eq}=[H_3O^+]_{eq}V=\\boxed{10^{-pH}V}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{x_{eq}=10^{-pH}V}\\) مع أخذ \\(V\\) باللتر.",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2013_s01_ex03_q5",
      "display_order": 5,
      "label": "1-هـ",
      "group_id": "part_1",
      "content_type": "question",
      "text": "بين أن قيمة الـ \\(pK_a\\) للثنائية: \\(CH_3-COOH/CH_3-COO^-\\) هي \\(4,76\\).",
      "axis_tags": [
        "acid_dissociation_constant_strength",
        "ph_pka_relation_dominance_domains"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نستعمل علاقة Henderson-Hasselbalch مع تراكيز الحمض والأساس المرافق في حالة التوازن.",
        "steps": [
          {
            "step_number": 1,
            "title": "كمية H3O+ عند التوازن",
            "explanation": "\\[n(H_3O^+)=10^{-3,3}\\times0,800\\approx4,0\\times10^{-4}\\,mol.\\]\nومن جدول التقدم \\(n(CH_3COO^-)=x_{eq}=4,0\\times10^{-4}\\,mol\\).",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "كمية الحمض المتبقية",
            "explanation": "\\[n(CH_3COOH)=n_0-x_{eq}=1,2\\times10^{-2}-4,0\\times10^{-4}=1,16\\times10^{-2}\\,mol.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "استعمال علاقة pH وpKa",
            "explanation": "\\[pH=pK_a+\\log\\frac{[CH_3COO^-]}{[CH_3COOH]}.\\]\nإذن:\n\\[pK_a=pH-\\log\\frac{n(CH_3COO^-)}{n(CH_3COOH)}=3,3-\\log\\left(\\frac{4,0\\times10^{-4}}{1,16\\times10^{-2}}\\right)\\approx4,76.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{pK_a(CH_3COOH/CH_3COO^-)=4,76}\\).",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2013_s01_ex03_q6",
      "display_order": 6,
      "label": "2-أ",
      "group_id": "part_2",
      "content_type": "question",
      "text": "اكتب معادلة التفاعل الحادث بين: \\(CH_3-COOH\\) و \\(NH_3\\).",
      "axis_tags": [
        "acid_base_reactions_equilibrium_constant"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "ينتقل البروتون من حمض الإيثانويك إلى النشادر.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[CH_3COOH_{(aq)}+NH_3{}_{(aq)}\\rightleftharpoons CH_3COO^-_{(aq)}+NH_4^+{}_{(aq)}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{CH_3COOH+NH_3\\rightleftharpoons CH_3COO^-+NH_4^+}\\).",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2013_s01_ex03_q7",
      "display_order": 7,
      "label": "2-ب",
      "group_id": "part_2",
      "content_type": "question",
      "text": "احسب ثابت التوازن \\(K\\).",
      "axis_tags": [
        "acid_base_reactions_equilibrium_constant",
        "acid_dissociation_constant_strength"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "للتفاعل بين الحمض CH3COOH والأساس NH3 نستعمل فرق قيم pKa.",
        "steps": [
          {
            "step_number": 1,
            "title": "العلاقة",
            "explanation": "\\[K=10^{pK_a(NH_4^+/NH_3)-pK_a(CH_3COOH/CH_3COO^-)}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "الحساب",
            "explanation": "\\[K=10^{9,2-4,76}=10^{4,44}\\approx\\boxed{2,75\\times10^4}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{K\\approx2,75\\times10^4}\\).",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2013_s01_ex03_q8",
      "display_order": 8,
      "label": "2-ج",
      "group_id": "part_2",
      "content_type": "question",
      "text": "بين أن النسبة النهائية \\(\\tau_{eq}\\) لتقدم التفاعل يمكن كتابتها على الشكل: \\(\\tau_{eq}=\\frac{\\sqrt K}{1+\\sqrt K}\\).",
      "axis_tags": [
        "final_advancement_limited_transformation",
        "acid_base_reactions_equilibrium_constant"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "بما أن كميتي الحمض والنشادر في البداية متساويتان n0 ومعاملات التفاعل 1:1، نكتب كميات التوازن بدلالة xeq ثم نعوض τ=xeq/n0.",
        "steps": [
          {
            "step_number": 1,
            "title": "كميات المادة عند التوازن",
            "explanation": "ابتدائيا: \\(n_0\\) من \\(CH_3COOH\\) و\\(n_0\\) من \\(NH_3\\). عند التوازن:\n\\(n(CH_3COOH)=n(NH_3)=n_0-x_{eq}\\)، و\\(n(CH_3COO^-)=n(NH_4^+)=x_{eq}\\).",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "كتابة K",
            "explanation": "لأن جميع الأنواع في نفس الحجم النهائي:\n\\[K=\\frac{x_{eq}^2}{(n_0-x_{eq})^2}.\\]\nإذن \\(\\sqrt K=\\frac{x_{eq}}{n_0-x_{eq}}\\).",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "إدخال نسبة التقدم",
            "explanation": "بما أن \\(x_{max}=n_0\\) فإن \\(\\tau_{eq}=x_{eq}/n_0\\). ومنه:\n\\[\\sqrt K=\\frac{\\tau_{eq}}{1-\\tau_{eq}}\\Rightarrow\\boxed{\\tau_{eq}=\\frac{\\sqrt K}{1+\\sqrt K}}.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{\\tau_{eq}=\\frac{\\sqrt K}{1+\\sqrt K}}\\).",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2013_s01_ex03_q9",
      "display_order": 9,
      "label": "2-د",
      "group_id": "part_2",
      "content_type": "question",
      "text": "احسب \\(\\tau_{eq}\\). ماذا تستنتج؟",
      "axis_tags": [
        "final_advancement_limited_transformation",
        "acid_base_reactions_equilibrium_constant"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نعوض K في العلاقة السابقة ثم نفسر قيمة τ.",
        "steps": [
          {
            "step_number": 1,
            "title": "الحساب",
            "explanation": "\\[\\tau_{eq}=\\frac{\\sqrt{2,75\\times10^4}}{1+\\sqrt{2,75\\times10^4}}\\approx0,994\\approx0,99.\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "الاستنتاج",
            "explanation": "النسبة قريبة جدا من 1، إذن التفاعل بين حمض الإيثانويك والنشادر تام تقريبا.",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\(\\boxed{\\tau_{eq}\\approx0,99\\approx1}\\)، وبالتالي التفاعل تام تقريبا.",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
    }
