  "questions": [
    {
      "id": "2018_s01_exp_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "التجربة الأولى:\n1. نحضر محلولا \\((S)\\) حجمه \\(V_S=500mL\\) وتركيزه المولي \\(c_a\\) مخففا 100 مرة، انطلاقا من المنظف التجاري الذي تركيزه المولي \\(c_0\\).\n1.1 ما هو حجم المحلول التجاري \\(V_0\\) الواجب استعماله لتحضير المحلول \\((S)\\)؟\n1.2 اذكر البروتوكول التجريبي اللازم لتحضير المحلول \\((S)\\).",
      "solution": {
        "strategy": "عامل التمديد 100، فنحسب الحجم المأخوذ من المنظف التجاري ثم نختار الماصة والحوجلة المناسبتين.",
        "steps": [
          {
            "step_number": 1,
            "title": "1.1 حساب V0",
            "explanation": "\\[F=\\frac{V_S}{V_0}=100\\Rightarrow V_0=\\frac{500}{100}=5mL\\]\\[\\boxed{V_0=5mL}\\]"
          },
          {
            "step_number": 2,
            "title": "1.2 البروتوكول",
            "explanation": "نأخذ بواسطة ماصة عيارية \\(5mL\\) من المنظف التجاري، ونسكبه في حوجلة عيارية \\(500mL\\) بها كمية من الماء المقطر، ثم نكمل بالماء المقطر حتى خط العيار ونرج الحوجلة للحصول على محلول متجانس."
          }
        ],
        "final_answer": "\\(\\boxed{V_0=5mL}\\)، ماصة عيارية 5mL وحوجلة عيارية 500mL."
      }
    },
    {
      "id": "2018_s01_exp_q2",
