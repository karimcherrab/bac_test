    {
      "id": "2016_s02_e04_q1",
      "display_order": 1,
      "content_type": "text",
      "text": "I/1- مثل في لحظة كيفية القوى المؤثرة على الجسم (S).",
      "axis_tags": [
        "spring_oscillator",
        "forces"
      ],
      "solution": {
        "strategy": "على السطح الأفقي عديم الاحتكاك تؤثر قوة الثقل ورد الفعل وقوة شد النابض.",
        "steps": [
          {
            "step_number": 1,
            "title": "تمثيل القوى",
            "explanation": "القوى هي: \\(\\vec P\\) ثقل الجسم نحو الأسفل، \\(\\vec R\\) رد فعل السطح نحو الأعلى، و\\(\\vec T\\) قوة النابض أفقيا نحو موضع التوازن.",
            "graph_data": {
              "id": "2016_s2_e4_forces_solution",
              "type": "svg",
              "usage": "solution",
              "placement": "solution",
              "title": "القوى المؤثرة على النواس",
              "description": "الثقل ورد الفعل وقوة النابض.",
              "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 680 520\" role=\"img\" aria-label=\"القوى المؤثرة على الجسم المتصل بالنابض\">\n<rect width=\"680\" height=\"520\" fill=\"white\"/>\n<defs><marker id=\"a16sf\" markerWidth=\"10\" markerHeight=\"10\" refX=\"8\" refY=\"3\" orient=\"auto\"><path d=\"M0,0 L0,6 L9,3 z\" fill=\"#111827\"/></marker></defs>\n<line x1=\"90\" y1=\"340\" x2=\"605\" y2=\"340\" stroke=\"#111827\" stroke-width=\"3\"/>\n<rect x=\"300\" y=\"275\" width=\"100\" height=\"65\" fill=\"#f3f4f6\" stroke=\"#111827\" stroke-width=\"2.5\"/>\n<text x=\"335\" y=\"315\" font-size=\"24\" font-family=\"DejaVu Sans,Arial\">S</text>\n<line x1=\"350\" y1=\"275\" x2=\"350\" y2=\"110\" stroke=\"#111827\" stroke-width=\"4\" marker-end=\"url(#a16sf)\"/>\n<text x=\"370\" y=\"128\" font-size=\"28\" font-family=\"DejaVu Sans,Arial\">R⃗</text>\n<line x1=\"350\" y1=\"340\" x2=\"350\" y2=\"475\" stroke=\"#111827\" stroke-width=\"4\" marker-end=\"url(#a16sf)\"/>\n<text x=\"370\" y=\"455\" font-size=\"28\" font-family=\"DejaVu Sans,Arial\">P⃗</text>\n<line x1=\"300\" y1=\"305\" x2=\"155\" y2=\"305\" stroke=\"#111827\" stroke-width=\"4\" marker-end=\"url(#a16sf)\"/>\n<text x=\"175\" y=\"285\" font-size=\"28\" font-family=\"DejaVu Sans,Arial\">T⃗</text>\n</svg>",
              "render_mode": "inline",
              "responsive": true
            }
          }
        ],
        "final_answer": "\\(\\vec P\\)، \\(\\vec R\\)، و\\(\\vec T\\)."
      },
