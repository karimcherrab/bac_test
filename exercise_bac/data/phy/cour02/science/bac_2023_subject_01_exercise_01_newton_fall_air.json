              "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 470\" role=\"img\" aria-label=\"القوى المؤثرة على الجسم عند t=0 وعند t أكبر من صفر\">\n<rect width=\"900\" height=\"470\" fill=\"white\"/><defs><marker id=\"a23f2\" markerWidth=\"10\" markerHeight=\"10\" refX=\"8\" refY=\"3\" orient=\"auto\"><path d=\"M0,0 L0,6 L9,3 z\" fill=\"#111827\"/></marker></defs>\n<text x=\"250\" y=\"55\" text-anchor=\"middle\" font-size=\"25\" font-family=\"DejaVu Sans,Arial\">t = 0</text>\n<circle cx=\"250\" cy=\"220\" r=\"28\" fill=\"#e5e7eb\" stroke=\"#111827\" stroke-width=\"2.5\"/>\n<line x1=\"250\" y1=\"220\" x2=\"250\" y2=\"370\" stroke=\"#111827\" stroke-width=\"3\" marker-end=\"url(#a23f2)\"/><text x=\"272\" y=\"365\" font-size=\"25\" font-family=\"DejaVu Sans,Arial\">P⃗</text>\n<line x1=\"250\" y1=\"220\" x2=\"250\" y2=\"135\" stroke=\"#111827\" stroke-width=\"3\" marker-end=\"url(#a23f2)\"/><text x=\"274\" y=\"142\" font-size=\"25\" font-family=\"DejaVu Sans,Arial\">Π⃗</text>\n<text x=\"650\" y=\"55\" text-anchor=\"middle\" font-size=\"25\" font-family=\"DejaVu Sans,Arial\">t &gt; 0</text>\n<circle cx=\"650\" cy=\"220\" r=\"28\" fill=\"#e5e7eb\" stroke=\"#111827\" stroke-width=\"2.5\"/>\n<line x1=\"650\" y1=\"220\" x2=\"650\" y2=\"370\" stroke=\"#111827\" stroke-width=\"3\" marker-end=\"url(#a23f2)\"/><text x=\"672\" y=\"365\" font-size=\"25\" font-family=\"DejaVu Sans,Arial\">P⃗</text>\n<line x1=\"650\" y1=\"220\" x2=\"650\" y2=\"150\" stroke=\"#111827\" stroke-width=\"3\" marker-end=\"url(#a23f2)\"/><text x=\"673\" y=\"154\" font-size=\"25\" font-family=\"DejaVu Sans,Arial\">Π⃗</text>\n<line x1=\"650\" y1=\"220\" x2=\"650\" y2=\"95\" stroke=\"#111827\" stroke-width=\"3\" marker-end=\"url(#a23f2)\"/><text x=\"618\" y=\"102\" font-size=\"25\" font-family=\"DejaVu Sans,Arial\">f⃗</text>\n</svg>",
              "render_mode": "inline",
