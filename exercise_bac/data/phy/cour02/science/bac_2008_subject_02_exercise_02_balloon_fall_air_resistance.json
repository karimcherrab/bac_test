" font-family=\"DejaVu Sans,Arial\">0,2</text>\n<text x=\"270\" y=\"575\" font-size=\"22\" font-family=\"DejaVu Sans,Arial\" direction=\"rtl\">الخط المستمر: المنحنى النظري للفرضية f=kv</text>\n</svg>",
