      "text": "1) مثل القوى واكتب المعادلة التفاضلية.",
      "axis_tags": [
        "vertical_fall_in_fluid"
      ],
      "display_order": 1,
      "content_type": "question",
      "solution": {
        "strategy": "نختار الأسفل موجبًا ونطبق نيوتن.",
        "steps": [
          {
            "step_number": 1,
            "title": "القوى",
            "explanation": "الثقل إلى الأسفل، ودافعة أرخميدس والاحتكاك إلى الأعلى.",
            "graph_data": {
              "diagram_type": "balloon_forces_2018",
              "title": "تمثيل القوى على البالون",
              "description": "كما في التصحيح: عند t=0 الثقل P ودافعة أرخميدس Π؛ وخلال الحركة تضاف قوة الاحتكاك f نحو الأعلى."
            }
          },
          {
            "step_number": 2,
            "title": "معادلة نيوتن",
            "explanation": "\\[mg-kv-\\rho_aVg=m\\frac{dv}{dt}\\]"
          },
          {
            "step_number": 3,
            "title": "الترتيب",
            "explanation": "\\[\\frac{dv}{dt}+\\frac{k}{m}v=g\\left(1-\\frac{\\rho_a}{\\rho}\\right)\\]"
          },
          {
            "step_number": 4,
            "title": "الثابتان",
            "explanation": "\\[A=\\frac{k}{m},\\qquad B=g\\left(1-\\frac{\\rho_a}{\\rho}\\right)\\]"
          },
          {
            "step_number": 5,
            "title": "مدلول B",
            "explanation": "يمثل التسارع الابتدائي لأن \\(v(0)=0\\)."
          }
        ],
        "final_answer": "\\(A=k/m\\)، و\\(B=g(1-\\rho_a/\\rho)\\).",
