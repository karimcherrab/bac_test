      "solution": {
        "strategy": "نختار الأسفل موجبًا ونطبق نيوتن.",
        "steps": [
          {
            "step_number": 1,
            "title": "القوى",
            "explanation": "الثقل نحو الأسفل، ودافعة أرخميدس والاحتكاك نحو الأعلى.",
