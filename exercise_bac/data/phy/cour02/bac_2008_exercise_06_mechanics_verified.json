      "solution": {
        "strategy": "نحسب A من الكتل الحجمية ثم B من شرط النظام الدائم.",
        "steps": [
          {
            "step_number": 1,
            "title": "A",
            "explanation": "\\[A=9.81\\left(1-\\frac{1.3}{4.1}\\right)\\approx6.7\\,m\\,s^{-2}\\]"
