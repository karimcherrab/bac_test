      "group_id": "main",
      "content_type": "question",
      "text": "في أي مرجع تتم دراسة حركة هذا القمر الاصطناعي؟ وما هي الفرضية المتعلقة بهذا المرجع والتي تسمح بتطبيق القانون الثاني لنيوتن؟",
      "axis_tags": [
        "satellites_planets_kepler",
        "circular_path_motion",
        "newton_laws_and_forces",
        "mechanical_energy_data_analysis"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نحدد المرجع المناسب ثم نذكر الفرضية التي تسمح بتطبيق القانون الثاني لنيوتن.",
        "steps": [
          {
            "step_number": 1,
            "title": "نحدد المرجع",
            "explanation": "تدرس حركة القمر في مرجع جيومركزي مبدؤه مركز الأرض ومحاوره موجهة نحو نجوم بعيدة.",
            "result": "المرجع الجيومركزي.",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "نذكر الفرضية",
            "explanation": "نعتبر هذا المرجع غاليليًا (عطاليًا) بتقريب جيد، لأن مدة دراسة/دور القمر صغيرة جدًا مقارنة بدور حركة الأرض حول الشمس.",
            "result": "المرجع الجيومركزي مفترض غاليليًا.",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "المرجع هو المرجع الجيومركزي ونفترضه غاليليًا.",
        "verification": "",
        "hints": [],
        "common_mistakes": []
      }
