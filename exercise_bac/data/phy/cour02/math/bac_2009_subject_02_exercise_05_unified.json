      "display_order": 1,
      "label": "1",
      "group_id": "main",
      "content_type": "question",
      "text": "تحت أي شرط يمكن اعتبار المرجع الأرضي غاليليا بتقريب جيد؟",
      "axis_tags": [
        "mechanical_motion_description",
        "newton_laws_and_forces",
        "mechanical_energy_data_analysis"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نقارن مدة التجربة بمدة دوران الأرض حتى نبرر تقريب المرجع الغاليلي.",
        "steps": [
          {
            "step_number": 1,
            "title": "نحدد الشرط",
            "explanation": "يمكن اعتبار المرجع الأرضي غاليليًا بتقريب جيد عندما تكون مدة الحركة الاهتزازية المدروسة صغيرة جدًا أمام مدة دوران الأرض حول نفسها.",
            "result": "مدة الدراسة صغيرة جدًا مقارنة بمدة دوران الأرض.",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "يمكن اعتبار المرجع الأرضي غاليليًا إذا كانت مدة الدراسة صغيرة جدًا أمام مدة دوران الأرض حول نفسها.",
