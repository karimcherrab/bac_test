            "step_number": 1,
            "title": "كمية الزنك",
            "explanation": "\\[n_0(Zn)=\\frac{m}{M}=\\frac{1.0}{65}=1.54\\times10^{-2}\\,mol\\]"
          },
          {
            "step_number": 2,
            "title": "كمية شوارد الهيدروجين",
            "explanation": "\\[n_0(H^+)=cV=0.50\\times0.040=2.0\\times10^{-2}\\,mol\\]"
          },
          {
            "step_number": 3,
            "title": "العلاقة بين التقدم والغاز",
            "explanation": "من جدول التقدم: \\(n(H_2)=x\\)، ومن الحجم المولي:\n\\[x=n(H_2)=\\frac{V_{H_2}}{V_M}\\]"
