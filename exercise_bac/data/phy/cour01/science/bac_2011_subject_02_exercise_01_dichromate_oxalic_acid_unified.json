    {
      "id": "2011_s02_ex1_q1a",
      "display_order": 1,
      "label": "1-أ",
      "group_id": "part_1",
      "content_type": "question",
      "text": "اكتب المعادلة المعبرة عن تفاعل أكسدة-إرجاع المنمذج للتحول الكيميائي الحادث.",
      "axis_tags": [
        "oxidation_reduction"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نكتب نصفي التفاعل للثنائيتين، نوازن الإلكترونات ثم نجمعهما.",
        "steps": [
          {
            "step_number": 1,
            "title": "اختزال البيكرومات",
            "explanation": "\\[\nCr_2O_7^{2-}(aq)+14H^+(aq)+6e^-\n\\rightarrow 2Cr^{3+}(aq)+7H_2O(\\ell)\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "أكسدة حمض الأكساليك",
            "explanation": "\\[\nC_2H_2O_4(aq)\\rightarrow 2CO_2(aq)+2H^+(aq)+2e^-\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "موازنة الإلكترونات",
            "explanation": "نضرب معادلة أكسدة حمض الأكساليك في 3 حتى يصبح عدد الإلكترونات 6.",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 4,
            "title": "المعادلة الإجمالية",
            "explanation": "بعد الجمع والاختزال:\n\\[\n\\boxed{\n3C_2H_2O_4(aq)+8H^+(aq)+Cr_2O_7^{2-}(aq)\n\\rightarrow6CO_2(aq)+2Cr^{3+}(aq)+7H_2O(\\ell)\n}\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\[\n\\boxed{\n3C_2H_2O_4+8H^++Cr_2O_7^{2-}\n\\rightarrow6CO_2+2Cr^{3+}+7H_2O\n}\n\\]",
        "verification": "مطابق للتصحيح النموذجي.",
        "hints": [],
        "common_mistakes": []
      }
    },
