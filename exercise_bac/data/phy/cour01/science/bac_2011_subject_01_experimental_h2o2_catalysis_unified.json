    {
      "id": "2011_s01_exp_q3",
      "display_order": 3,
      "label": "أولا-3",
      "group_id": "part_1",
      "content_type": "question",
      "text": "احسب التركيز المولي للمحلول S₀، استنتج التركيز المولي للمحلول S.",
      "axis_tags": [
        "stoichiometry",
        "dilution"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نستغل عبارة 10V: كل 1L من S₀ يحرر 10L من O₂ في الشرطين النظاميين، ثم نستعمل ستوكيومترية التفكك ومعامل التمديد 40.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب كمية مادة O₂ المنطلقة من 1L",
            "explanation": "الحجم المولي \\(V_M=22.4L\\cdot mol^{-1}\\).",
