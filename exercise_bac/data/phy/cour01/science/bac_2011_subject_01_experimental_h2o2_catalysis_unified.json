      "id": "2011_s01_exp_q1",
      "display_order": 1,
      "label": "أولا-1",
      "group_id": "part_1",
      "content_type": "question",
      "text": "ضع بروتوكولا تجريبيا لتحضير المحلول S.",
      "axis_tags": [
        "dilution"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نحسب أولا حجم العينة الواجب أخذها من S₀ باستعمال معامل التمديد، ثم نختار الزجاجيات المناسبة.",
        "steps": [
          {
            "step_number": 1,
            "title": "حساب حجم العينة",
            "explanation": "معامل التمديد هو:\n\\[\nf=\\frac{C_0}{C}=\\frac{V}{V_0}=40\n\\]\nوالحجم النهائي المطلوب \\(V=200mL\\).",
            "calculation": "\\[\nV_0=\\frac{V}{40}=\\frac{200}{40}=5mL\n\\]",
            "result": "\\(V_0=5mL\\)",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "الأدوات المناسبة",
            "explanation": "نستعمل ماصة عيارية 5mL مع إجاصة مص، وحوجلة عيارية سعتها 200mL، وماء مقطر.",
            "calculation": "",
            "result": "ماصة 5mL + حوجلة 200mL + ماء مقطر.",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "طريقة العمل",
            "explanation": "نسحب 5mL من المحلول S₀ بالماصة العيارية، ونضعها في الحوجلة العيارية 200mL، ثم نضيف الماء المقطر حتى خط العيار، ونغلق الحوجلة ونمزج جيدا للحصول على محلول متجانس.",
            "calculation": "",
            "result": "",
            "figures": [
              {
                "id": "2011_s01_exp_q1_dilution",
