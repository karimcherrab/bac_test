    {
      "id": "2016_s01_exp_q1",
      "display_order": 1,
      "label": "1",
      "group_id": "part_1",
      "content_type": "question",
      "text": "اكتب المعادلتين النصفيتين للأكسدة والإرجاع مع تحديد الثنائيتين Ox/Red المشاركتين في التفاعل.",
      "axis_tags": [
        "oxidation_reduction"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نكتب نصف تفاعل أكسدة الألمنيوم ونصف تفاعل إرجاع شوارد الهيدرونيوم، ثم نحدد الثنائيتين الموافقـتين.",
        "steps": [
          {
            "step_number": 1,
            "title": "نصف تفاعل الأكسدة",
            "explanation": "\\[\nAl(s)\\rightarrow Al^{3+}(aq)+3e^-\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "نصف تفاعل الإرجاع",
            "explanation": "\\[\n2H_3O^+(aq)+2e^-\\rightarrow H_2(g)+2H_2O(l)\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "الثنائيتان Ox/Red",
            "explanation": "الثنائيتان المشاركتان هما:",
            "calculation": "\\[\n(H_3O^+(aq)/H_2(g))\n\\qquad\n(Al^{3+}(aq)/Al(s))\n\\]",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\[\n\\boxed{Al\\rightarrow Al^{3+}+3e^-}\n\\]\n\\[\n\\boxed{2H_3O^++2e^-\\rightarrow H_2+2H_2O}\n\\]\nوالثنائيتان هما \\((H_3O^+/H_2)\\) و\\((Al^{3+}/Al)\\).",
        "verification": "مطابق للتصحيح النموذجي الرسمي.",
        "hints": [],
        "common_mistakes": []
      }
    },
