      "tables": [],
      "solution": {
        "strategy": "من جدول التقدم تكون كمية مادة الهيدروجين \\(n(H_2)=3x\\)، ونربطها بالحجم المولي.",
        "steps": [
          {
            "step_number": 1,
            "title": "كمية مادة H₂",
            "explanation": "\\[\nn(H_2)=3x\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "استعمال الحجم المولي",
            "explanation": "\\[\nn(H_2)=\\frac{V_{H_2}}{V_M}\n\\]\nإذن:\n\\[\n3x=\\frac{V_{H_2}}{V_M}\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "العلاقة المطلوبة",
            "explanation": "\\[\n\\boxed{x(t)=\\frac{V_{H_2}(t)}{3V_M}}\n\\]",
