      "id": "2016_s02_ex1_q1",
      "display_order": 1,
      "label": "1",
      "group_id": "main",
      "content_type": "question",
      "text": "هل التحول الحادث سريع أم بطيء؟ برر إجابتك.",
      "axis_tags": [],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "نستدل من زمن متابعة التحول على طبيعته الحركية.",
        "steps": [
          {
            "step_number": 1,
            "title": "الاستدلال من البيان",
            "explanation": "يمكن متابعة كتلة الفضة المتشكلة خلال عدة دقائق، أي أن التحول لا يحدث لحظيا.",
            "calculation": "",
            "result": "التحول بطيء.",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "التحول الكيميائي بطيء لأنه يمكن متابعته زمنيا خلال عدة دقائق.",
        "verification": "مطابق للتصحيح النموذجي الرسمي.",
        "hints": [],
        "common_mistakes": []
      }
    },
    {
      "id": "2016_s02_ex1_q2",
      "display_order": 2,
      "label": "2",
      "group_id": "main",
      "content_type": "question",
      "text": "حدد الثنائيتين \\(Ox/Red\\) المشاركتين في التفاعل، واكتب المعادلتين النصفيتين للأكسدة والإرجاع.",
      "axis_tags": [
        "oxidation_reduction"
      ],
      "figures": [],
      "tables": [],
      "solution": {
        "strategy": "النحاس يتأكسد إلى Cu²⁺ وشوارد الفضة تختزل إلى Ag.",
        "steps": [
          {
            "step_number": 1,
            "title": "الثنائيتان",
            "explanation": "\\[\n(Cu^{2+}/Cu)\n\\qquad\n(Ag^+/Ag)\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 2,
            "title": "معادلة الأكسدة",
            "explanation": "\\[\nCu(s)\\rightarrow Cu^{2+}(aq)+2e^-\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          },
          {
            "step_number": 3,
            "title": "معادلة الإرجاع",
            "explanation": "\\[\n2Ag^+(aq)+2e^-\\rightarrow2Ag(s)\n\\]",
            "calculation": "",
            "result": "",
            "figures": [],
            "tables": []
          }
        ],
        "final_answer": "\\[\n\\boxed{Cu\\rightarrow Cu^{2+}+2e^-}\n\\qquad\n\\boxed{2Ag^++2e^-\\rightarrow2Ag}\n\\]",
        "verification": "مطابق للتصحيح النموذجي الرسمي.",
        "hints": [],
        "common_mistakes": []
      }
    },
