  "questions": [
    {
      "id": "2017_elec_ex43_q1",
      "display_order": 1,
      "content_type": "question",
      "text": "عند t=0 نفتح K. ما الظاهرة التي تحدث؟",
      "solution": {
        "strategy": "الوشيعة تعارض الانقطاع المفاجئ.",
        "steps": [
          {
            "step_number": 1,
            "title": "الظاهرة",
            "explanation": "التحريض الذاتي: ينقطع التيار تدريجياً."
          }
        ],
        "final_answer": "التحريض الذاتي."
      }
    },
    {
      "id": "2017_elec_ex43_q2",
      "display_order": 2,
      "content_type": "question",
      "text": "بتطبيق قانون جمع التوترات جد المعادلة التفاضلية لـu_R(t).",
      "solution": {
        "strategy": "حلقة R والوشيعة بعد فتح القاطعة.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة",
            "explanation": "\\[\\frac{du_R}{dt}+\\frac{R+r}{L}u_R=0\\]"
          }
        ],
        "final_answer": "uR'+(R+r)uR/L=0."
      }
    },
    {
      "id": "2017_elec_ex43_q3",
      "display_order": 3,
      "content_type": "question",
      "text": "إذا كان u_R=Ae^{-t/α}، حدّد A وα ثم استنتج i(t).",
      "solution": {
        "strategy": "نستعمل uR=Ri.",
        "steps": [
          {
            "step_number": 1,
            "title": "الثوابت",
            "explanation": "A=RI0، وα=τ=L/(R+r)."
          },
          {
            "step_number": 2,
            "title": "التيار",
            "explanation": "\\[i(t)=I_0e^{-t/\\tau}\\]"
          }
        ],
        "final_answer": "A=RI0، α=τ."
      }
    },
    {
      "id": "2017_elec_ex43_q4",
      "display_order": 4,
      "content_type": "question",
      "text": "اكتب عبارة الاستطاعة اللحظية P(t) المحولة في R.",
      "solution": {
        "strategy": "P=Ri².",
        "steps": [
          {
            "step_number": 1,
            "title": "العبارة",
            "explanation": "\\[P(t)=RI_0^2e^{-2t/\\tau}=P_{max}e^{-2t/\\tau}\\]"
          }
        ],
        "final_answer": "P=Pmax e^-2t/τ."
      }
    },
    {
      "id": "2017_elec_ex43_q5",
      "display_order": 5,
      "content_type": "question",
      "text": "من الشكل 73: برهن خاصية المماس ثم استنتج τ وI0 وr وL.",
      "solution": {
        "strategy": "نستعمل مشتقة P والقيمة العظمى.",
        "steps": [
          {
            "step_number": 1,
            "title": "المماس",
            "explanation": "P'(0)=-2Pmax/τ، لذلك يقطع المماس محور الزمن عند τ/2."
          },
          {
            "step_number": 2,
            "title": "τ",
            "explanation": "من البيان τ/2=5ms، إذن τ=10ms."
          },
          {
            "step_number": 3,
            "title": "I0",
            "explanation": "Pmax=0.50W ⇒ I0=√(0.50/50)=0.10A."
          },
          {
            "step_number": 4,
            "title": "r",
            "explanation": "r=E/I0-R=10Ω."
          },
          {
            "step_number": 5,
            "title": "L",
            "explanation": "L=τ(R+r)=0.60H."
          }
        ],
        "final_answer": "τ=10ms، I0=0.10A، r=10Ω، L=0.60H."
      }
    },
    {
      "id": "2017_elec_ex43_q6",
      "display_order": 6,
      "content_type": "question",
      "text": "أثبت أن زمن تناقص الاستطاعة إلى النصف هو t1/2=(τ/2)ln2 ثم احسبه.",
      "solution": {
        "strategy": "نضع P=Pmax/2.",
        "steps": [
          {
            "step_number": 1,
            "title": "النتيجة",
            "explanation": "\\[t_{1/2}=\\frac{\\tau}{2}\\ln2\\approx3.47ms\\]"
          }
        ],
        "final_answer": "t1/2≈3.47ms."
      }
    }
  ],
