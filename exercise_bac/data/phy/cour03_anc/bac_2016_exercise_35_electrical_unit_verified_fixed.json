    {
      "id": "2016_elec_ex35_q5",
      "display_order": 5,
      "content_type": "question",
      "text": "5) احسب قيمة \\(C\\) للمكثفة.",
      "solution": {
        "strategy": "C=τ/R.",
        "steps": [
          {
            "step_number": 1,
            "title": "الحساب",
            "explanation": "\\[C=\\frac{0.10}{10^4}=10^{-5}F=\\boxed{10\\mu F}\\]"
          }
        ],
        "final_answer": "\\(C=10\\mu F\\)."
      }
    }
