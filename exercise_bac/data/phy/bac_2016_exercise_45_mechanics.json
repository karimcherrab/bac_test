    {
      "id": "2016_ex45_q2",
      "text": "2) استخرج عبارة السرعة والدور والقانون الثالث لكبلر.",
      "axis_tags": [
        "satellites_planets_kepler"
      ],
      "display_order": 2,
      "content_type": "question",
      "solution": {
        "strategy": "نساوي قوة الجذب بالتسارع الناظمي.",
        "steps": [
          {
            "step_number": 1,
            "title": "السرعة",
            "explanation": "\\[G\\frac{m_PM_S}{r^2}=m_P\\frac{v^2}{r}\\Rightarrow v=\\sqrt{\\frac{GM_S}{r}}\\]"
          },
          {
            "step_number": 2,
            "title": "الدور",
            "explanation": "\\[T=\\frac{2\\pi r}{v}=2\\pi\\sqrt{\\frac{r^3}{GM_S}}\\]"
          },
          {
            "step_number": 3,
            "title": "القانون الثالث",
            "explanation": "\\[\\frac{T^2}{r^3}=\\frac{4\\pi^2}{GM_S}=\\text{ثابت}\\]"
          }
        ],
        "detailed_explanation": "حل مفصل وبسيط وفق منهجية البكالوريا.",
