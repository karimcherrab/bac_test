      ],
      "display_order": 1,
      "content_type": "question",
      "solution": {
        "strategy": "نقرأ شكل المدار وتساوي الأزمنة.",
        "steps": [
          {
            "step_number": 1,
            "title": "القانون الأول",
            "explanation": "مدار كل كوكب إهليلجي وتحتل الشمس إحدى بؤرتيه."
          },
          {
            "step_number": 2,
            "title": "القانون الثاني",
            "explanation": "الشعاع الواصل بين الشمس والكوكب يمسح مساحات متساوية خلال أزمنة متساوية."
          }
        ],
        "detailed_explanation": "حل مفصل وبسيط وفق منهجية البكالوريا.",
        "final_answer": "قانون المدار الإهليلجي وقانون المساحات المتساوية.",
        "verification": "",
        "common_mistakes": [],
        "hints": [],
        "solution_style": "الفكرة، القانون، التعويض العددي، النتيجة، ثم الاستنتاج.",
        "methodology": {
          "goal": "حل السؤال بدقة وبطريقة بسيطة ومنظمة.",
          "method": "تحديد الجملة والمرجع، جرد القوى، كتابة القانون الحرفي، تحويل الوحدات، التعويض، ثم الاستنتاج.",
