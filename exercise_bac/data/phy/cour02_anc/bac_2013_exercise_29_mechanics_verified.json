        "steps": [
          {
            "step_number": 1,
            "title": "المعادلة الأصلية",
            "explanation": "\\[mg-kv^2=m\\frac{dv}{dt}\\]",
            "graph_data": {
              "diagram_type": "parachutist_open_force_2013",
              "title": "القوى بعد فتح المظلة",
