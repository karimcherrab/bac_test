  "questions": [
    {
      "id": "2010_ex15_q1",
      "text": "1) ادرس طبيعة حركة الكرة في المعلم \\((Ox,Oy)\\)، بأخذ مبدأ الأزمنة لحظة القذف. استنتج معادلة المسار \\(y=f(x)\\).",
      "axis_tags": [
        "projectile_motion"
      ],
      "display_order": 1,
      "content_type": "question",
      "solution": {
        "strategy": "نطبق القانون الثاني لنيوتن ثم نحذف الزمن.",
        "steps": [
          {
            "step_number": 1,
            "title": "القوة والتسارع",
            "explanation": "\\[a_x=0,\\qquad a_y=-g\\]"
          },
          {
            "step_number": 2,
            "title": "المعادلات الزمنية",
            "explanation": "\\[x(t)=v_0\\cos\\alpha\\,t\\]\\[y(t)=v_0\\sin\\alpha\\,t-\\frac12gt^2\\]"
          },
          {
            "step_number": 3,
            "title": "طبيعة الحركة",
            "explanation": "أفقيًا حركة مستقيمة منتظمة، وشاقوليًا حركة متغيرة بانتظام."
          },
          {
            "step_number": 4,
            "title": "معادلة المسار",
            "explanation": "\\[y=x\\tan\\alpha-\\frac{g}{2v_0^2\\cos^2\\alpha}x^2\\]"
          }
        ],
        "detailed_explanation": "حل مفصل ومنظم وفق منهجية البكالوريا: الفكرة، القانون، التعويض، النتيجة، ثم الاستنتاج.",
        "final_answer": "\\(y=x\\tan\\alpha-\\dfrac{g}{2v_0^2\\cos^2\\alpha}x^2\\).",
        "verification": "المسار قطع مكافئ.",
        "common_mistakes": [],
        "hints": [],
        "solution_style": "حل مفصل ومنظم: الفكرة، القانون، التعويض، النتيجة، ثم الاستنتاج.",
        "methodology": {
          "goal": "الإجابة عن السؤال بدقة وبطريقة مفهومة.",
          "method": "تحديد الجملة والمرجع، كتابة القانون أو العلاقة، تحويل الوحدات، التعويض، ثم الاستنتاج.",
          "why_this_method": "لأنها المنهجية القياسية في تمارين الميكانيك في البكالوريا.",
