      "id": "2016_ex47_q1",
      "text": "1) أوجد المعادلات الزمنية ومعادلة المسار وسرعة الكرة عند الذروة.",
      "axis_tags": [
        "projectile_motion"
      ],
      "display_order": 1,
      "content_type": "question",
      "solution": {
        "strategy": "ندرس حركة قذيفة مائلة.",
        "steps": [
          {
            "step_number": 1,
            "title": "المعادلات الزمنية",
            "explanation": "\\[x=v_0\\cos\\alpha\\,t\\] \\[y=h_B+v_0\\sin\\alpha\\,t-\\frac12gt^2\\]"
          },
          {
            "step_number": 2,
            "title": "العبارات العددية",
            "explanation": "\\[x=5\\sqrt3\\,t\\] \\[y=2+5t-5t^2\\]"
          },
          {
            "step_number": 3,
            "title": "معادلة المسار",
            "explanation": "\\[y=h_B+x\\tan\\alpha-\\frac{g}{2v_0^2\\cos^2\\alpha}x^2\\]"
          },
          {
            "step_number": 4,
            "title": "السرعة عند الذروة",
            "explanation": "عند الذروة \\(v_y=0\\)، لذلك \\[v_S=v_x=v_0\\cos30^\\circ\\approx8.66\\,m\\,s^{-1}\\]"
          }
        ],
