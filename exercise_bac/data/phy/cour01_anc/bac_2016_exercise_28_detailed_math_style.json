            "step_number": 2,
            "title": "في لتر واحد",
            "explanation": "\\[n(ClO^-)=c_0\\times1=c_0\\]"
          },
          {
            "step_number": 3,
            "title": "حجم الكلور",
            "explanation": "\\[V(Cl_2)=nV_M=c_0V_M\\]"
