      "id": "2016_ex49_q1",
      "text": "1) أوجد المعادلات الزمنية ومعادلة المسار.",
      "axis_tags": [
        "projectile_motion"
      ],
      "display_order": 1,
      "content_type": "question",
      "solution": {
        "strategy": "ندرس قذفًا مائلًا.",
        "steps": [
          {
            "step_number": 1,
            "title": "التسارع",
            "explanation": "\\[a_x=0,\\qquad a_z=-g\\]"
          },
          {
            "step_number": 2,
            "title": "المعادلات الزمنية",
            "explanation": "\\[x=v_0\\cos\\alpha\\,t\\] \\[z=v_0\\sin\\alpha\\,t-\\frac12gt^2\\]"
          },
          {
            "step_number": 3,
            "title": "المسار",
            "explanation": "\\[z=x\\tan\\alpha-\\frac{g}{2v_0^2\\cos^2\\alpha}x^2\\]"
          }
