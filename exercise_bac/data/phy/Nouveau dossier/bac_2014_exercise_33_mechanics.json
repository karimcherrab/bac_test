            "title": "الثبات",
            "explanation": "نعم، لأن \\(r=R_T+h\\) ثابت وكتلتي الأرض والقمر ثابتتان."
          },
          {
            "step_number": 2,
            "title": "العلاقة",
            "explanation": "\\[F=G\\frac{mM_T}{(R_T+h)^2}\\]"
