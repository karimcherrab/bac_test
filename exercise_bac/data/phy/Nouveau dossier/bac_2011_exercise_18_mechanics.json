          {
            "step_number": 1,
            "title": "المرجع",
            "explanation": "المرجع المركزي الأرضي (الجيومركزي)."
          },
          {
            "step_number": 2,
            "title": "السرعة",
            "explanation": "\\[v=\\frac{2\\pi r}{T_L}\\]"
          },
          {
            "step_number": 3,
            "title": "التحويل والحساب",
            "explanation": "\\[T_L=25.5\\times86400\\,s\\Rightarrow v\\approx1.1\\times10^3\\,m\\,s^{-1}\\]"
          }
        ],
        "detailed_explanation": "حل مفصل ومنظم وفق منهجية البكالوريا: الفكرة، القانون، التعويض، النتيجة، ثم الاستنتاج.",
        "final_answer": "المرجع جيومركزي، و\\(v\\approx1.1\\times10^3\\,m\\,s^{-1}\\).",
        "verification": "",
        "common_mistakes": [
