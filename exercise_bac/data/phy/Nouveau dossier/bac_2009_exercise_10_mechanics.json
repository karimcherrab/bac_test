  "questions": [
    {
      "id": "2009_ex10_q1",
      "text": "1) بتطبيق القانون الثاني لنيوتن، بيّن أن المعادلة التفاضلية لحركة المظلي من الشكل: \\(\\dfrac{dv}{dt}=Av+B\\)، حيث \\(A\\) و\\(B\\) ثابتان يطلب تعيين عبارتيهما.",
      "axis_tags": [
        "vertical_fall_in_fluid"
      ],
      "display_order": 1,
      "content_type": "question",
      "solution": {
        "strategy": "نختار الأسفل جهة موجبة ونطبق قانون نيوتن.",
        "steps": [
          {
            "step_number": 1,
            "title": "القوى",
            "explanation": "الثقل \\(P=mg\\) نحو الأسفل، والمقاومة \\(f=kv\\) نحو الأعلى."
          },
          {
            "step_number": 2,
            "title": "الإسقاط",
            "explanation": "\\[mg-kv=m\\frac{dv}{dt}\\]"
          },
          {
            "step_number": 3,
            "title": "المعادلة",
            "explanation": "\\[\\frac{dv}{dt}=-\\frac{k}{m}v+g\\]\\Rightarrow A=-\\frac{k}{m},\\quad B=g"
          }
        ],
        "detailed_explanation": "حل مفصل ومنظم وفق منهجية البكالوريا: الفكرة، القانون، التعويض، النتيجة، ثم الاستنتاج.",
        "final_answer": "\\(A=-k/m\\)، و\\(B=g\\).",
        "verification": "إشارة A سالبة لأن مقاومة الهواء تقلل التسارع.",
        "common_mistakes": [
          "وضع الاحتكاك في جهة الحركة.",
          "نسيان القسمة على الكتلة."
        ],
        "hints": [],
        "solution_style": "حل مفصل ومنظم: الفكرة، القانون، التعويض، النتيجة، ثم الاستنتاج.",
        "methodology": {
          "goal": "الإجابة عن السؤال بدقة وبطريقة مفهومة.",
          "method": "تحديد الجملة والمرجع، كتابة القانون أو العلاقة، تحويل الوحدات، التعويض، ثم الاستنتاج.",
