  "questions": [
    {
      "id": "2009_ex08_q1",
      "text": "1) في أي مرجع تتم دراسة حركة هذا القمر الاصطناعي؟ وما الفرضية المتعلقة بهذا المرجع التي تسمح بتطبيق القانون الثاني لنيوتن؟",
      "axis_tags": [
        "satellites_planets_kepler"
      ],
      "display_order": 1,
      "content_type": "question",
      "solution": {
        "strategy": "نحدد المرجع الملائم للحركة حول الأرض.",
        "steps": [
          {
            "step_number": 1,
            "title": "المرجع",
            "explanation": "تدرس الحركة في مرجع مركزي أرضي (جيومركزي)، مبدؤه مركز الأرض ومحاوره موجهة نحو نجوم بعيدة."
          },
          {
            "step_number": 2,
            "title": "الفرضية",
            "explanation": "نعتبر هذا المرجع غاليليًا تقريبًا، حتى يمكن تطبيق القانون الثاني لنيوتن."
          }
        ],
        "detailed_explanation": "حل مفصل ومنظم وفق منهجية البكالوريا: الفكرة، القانون، التعويض، النتيجة، ثم الاستنتاج.",
        "final_answer": "المرجع مركزي أرضي، ونفترضه غاليليًا.",
        "verification": "",
        "common_mistakes": [
          "الخلط بين المرجع السطحي الأرضي والمرجع المركزي الأرضي."
        ],
        "hints": [],
        "solution_style": "حل مفصل ومنظم: الفكرة، القانون، التعويض، النتيجة، ثم الاستنتاج.",
        "methodology": {
          "goal": "الإجابة عن السؤال بدقة وبطريقة مفهومة.",
          "method": "تحديد الجملة والمرجع، كتابة القانون أو العلاقة، تحويل الوحدات، التعويض، ثم الاستنتاج.",
          "why_this_method": "لأنها المنهجية القياسية في تمارين الميكانيك في البكالوريا.",
          "bac_template": [
            "نحدد الجملة والمرجع والمعلم عند الحاجة.",
            "نكتب القانون أو العلاقة الحرفية قبل التعويض.",
            "نحوّل الوحدات إلى النظام الدولي.",
            "نعوض عدديًا ونرفق النتيجة بوحدتها.",
            "نختم باستنتاج فيزيائي واضح."
          ],
          "formal_writing": [
            "استعمال الرموز الفيزيائية بصورة صحيحة.",
            "احترام التوجيهات والإشارات على المحاور.",
            "إرفاق كل نتيجة عددية بوحدتها.",
            "ذكر الفرضيات المستعملة."
          ]
        }
      }
    },
