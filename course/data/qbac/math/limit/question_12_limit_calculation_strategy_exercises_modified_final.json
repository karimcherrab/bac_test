            "order": 2,
            "title": "نهاية المقام",
            "explanation": "من اليمين يكون \\(\\sqrt{x}>2\\).",
            "calculation": "\\(\\sqrt{x}-2\\to0^+\\)",
            "result": "المقام يؤول إلى صفر موجب."
