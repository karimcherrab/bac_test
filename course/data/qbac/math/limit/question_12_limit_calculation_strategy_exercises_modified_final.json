          {
            "order": 3,
            "title": "النتيجة",
            "explanation": "عدد موجب على صفر موجب يعطي زائد ما لا نهاية.",
            "calculation": "\\(\\frac5{0^+}=+\\infty\\)",
            "result": "النهاية \\(+\\infty\\)."
          }
        ],
        "final_answer": "\\(\\lim_{x\\to4^+}\\frac{x+1}{\\sqrt{x}-2}=+\\infty\\).",
        "common_mistakes": [
          {
            "mistake": "كتابة \\(5/0\\) دون تحديد الإشارة.",
            "correction": "في النهاية الجانبية يجب كتابة \\(0^+\\) أو \\(0^-\\)."
          }
        ],
        "hints": [
          "حدد إشارة \\(\\sqrt{x}-2\\) من اليمين."
        ]
      }
    },
    {
