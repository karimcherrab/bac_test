          {
            "order": 2,
            "title": "اختيار الطريقة",
            "explanation": "البسط فرق مربعين.",
            "calculation": "\\(x^2-9=(x-3)(x+3)\\)",
            "result": "نستعمل التحليل والاختزال."
          },
          {
            "order": 3,
            "title": "التبسيط والحساب",
            "explanation": "نختزل \\(x-3\\) ثم نعوض.",
            "calculation": "\\(\\frac{(x-3)(x+3)}{x-3}=x+3\\to6\\)",
            "result": "النهاية تساوي \\(6\\)."
          }
        ],
        "final_answer": "\\(\\lim_{x\\to3}\\frac{x^2-9}{x-3}=6\\).",
        "hints": [
          "حلل فرق المربعين."
        ]
      }
    },
    {
