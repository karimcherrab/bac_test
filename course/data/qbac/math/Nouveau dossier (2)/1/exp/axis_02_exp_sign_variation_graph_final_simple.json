          "steps": [
            "نكتب \\(f(x)=e^x\\).",
            "نحسب المشتقة: \\(f'(x)=e^x\\).",
            "نعرف أن \\(e^x>0\\) لكل \\(x\\).",
            "إذن \\(f'(x)>0\\)، وبالتالي \\(f\\) متزايدة تمامًا على \\(\\mathbb{R}\\)."
          ],
          "rule": "\\(f'(x)=e^x>0\\Rightarrow f\\text{ متزايدة تمامًا على }\\mathbb{R}\\).",
          "memory_tip": "مشتقتها نفسها، وهي موجبة، إذن هي متزايدة.",
          "attention": "التزايد صحيح على كل \\(\\mathbb{R}\\)، وليس فقط عندما \\(x>0\\).",
          "takeaway": "إشارة المشتقة هي السبب في تزايد الدالة الأسية."
        }
      },
      {
        "id": "step_4",
        "type": "concept",
        "title": "نهايتا الدالة الأسية",
        "content": {
