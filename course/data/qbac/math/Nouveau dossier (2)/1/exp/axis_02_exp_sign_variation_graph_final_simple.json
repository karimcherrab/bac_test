          "simple_explanation": [
            "عندما يصبح \\(x\\) سالبًا جدًا، تبقى \\(e^x\\) موجبة لكنها تقترب أكثر فأكثر من الصفر.",
            "عندما يصبح \\(x\\) موجبًا جدًا، تكبر \\(e^x\\) دون حد."
          ],
          "example_values": [
            "\\(e^{-4}\\approx0.018\\)",
            "\\(e^{-2}\\approx0.135\\)",
            "\\(e^0=1\\)",
            "\\(e^2\\approx7.389\\)"
          ],
          "attention": "النهاية 0 لا تعني أن الدالة تساوي 0.",
          "takeaway": "يسارًا تقترب من 0، ويمينًا تتجه إلى \\(+\\infty\\)."
        }
