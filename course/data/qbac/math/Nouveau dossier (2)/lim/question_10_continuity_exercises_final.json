    {
      "id": "continuity_01",
      "number": "42",
      "text": "لتكن \\(f\\) معرفة على \\([-2,4[\\) بـ:\n\\[\nf(x)=x^2+x\\;\\text{إذا }x\\in[-2,1[,\n\\qquad f(x)=x-1\\;\\text{إذا }x\\in[1,4[.\n\\]\nادرس استمراريتها عند \\(1\\).",
      "skill": "مقارنة النهاية بقيمة الدالة",
      "difficulty": "medium",
      "solution": {
        "strategy": "نحسب النهاية من اليسار والنهاية من اليمين، ثم نقارن بقيمة الدالة عند نقطة الفصل.",
        "steps": [
          {
            "order": 1,
            "title": "قيمة الدالة عند 1",
            "explanation": "عند x=1 نستعمل الفرع الثاني لأن المجال فيه يبدأ من 1.",
            "calculation": "\\(f(1)=1-1=0\\)",
            "result": "\\(f(1)=0\\)"
          },
          {
            "order": 2,
            "title": "النهاية من اليسار",
            "explanation": "من اليسار نستعمل الفرع \\(x^2+x\\).",
            "calculation": "\\(\\lim_{x\\to1^-}(x^2+x)=1+1=2\\)",
            "result": "النهاية اليسرى تساوي \\(2\\)."
          },
          {
            "order": 3,
            "title": "النهاية من اليمين",
            "explanation": "من اليمين نستعمل الفرع \\(x-1\\).",
            "calculation": "\\(\\lim_{x\\to1^+}(x-1)=0\\)",
            "result": "النهاية اليمنى تساوي \\(0\\)."
          },
          {
            "order": 4,
            "title": "الاستنتاج",
            "explanation": "النهايتان الجانبيتان مختلفتان.",
            "calculation": "\\(2\\ne0\\)",
            "result": "الدالة غير مستمرة عند \\(1\\)."
          }
        ],
        "final_answer": "\\(\\boxed{f\\text{ غير مستمرة عند }1}\\)",
        "common_mistakes": [
          {
            "mistake": "استعمال الفرع الأول لحساب \\(f(1)\\).",
            "correction": "لأن \\(1\\in[1,4[\\)، نستعمل الفرع الثاني."
          }
        ],
        "hints": [
          "احسب النهاية من كل جهة باستعمال الفرع المناسب.",
          "قارن النهاية اليسرى بالنهاية اليمنى."
        ]
      }
    },
    {
      "id": "continuity_02",
      "number": "43",
      "text": "لتكن \\(f\\) معرفة على \\(\\mathbb R\\) بـ:\n\\[\nf(x)=x^2-2x+1\\;\\text{إذا }x\\le2,\n\\qquad f(x)=x^2+x-5\\;\\text{إذا }x>2.\n\\]\nادرس استمراريتها عند \\(2\\).",
      "skill": "مقارنة النهاية بقيمة الدالة",
      "difficulty": "medium",
      "solution": {
        "strategy": "نحسب قيمة الدالة والنهايتين الجانبيتين عند نقطة الفصل.",
        "steps": [
          {
            "order": 1,
            "title": "قيمة الدالة عند 2",
            "explanation": "عند x=2 نستعمل الفرع الأول لأنه يحتوي الرمز \\(\\le\\).",
            "calculation": "\\(f(2)=2^2-2\\times2+1=1\\)",
            "result": "\\(f(2)=1\\)"
          },
          {
            "order": 2,
            "title": "النهاية من اليسار",
            "explanation": "من اليسار نستعمل \\(x^2-2x+1\\).",
            "calculation": "\\(\\lim_{x\\to2^-}(x^2-2x+1)=1\\)",
            "result": "النهاية اليسرى تساوي \\(1\\)."
          },
          {
            "order": 3,
            "title": "النهاية من اليمين",
            "explanation": "من اليمين نستعمل \\(x^2+x-5\\).",
            "calculation": "\\(\\lim_{x\\to2^+}(x^2+x-5)=4+2-5=1\\)",
            "result": "النهاية اليمنى تساوي \\(1\\)."
          },
          {
            "order": 4,
            "title": "الاستنتاج",
            "explanation": "النهايتان الجانبيتان وقيمة الدالة متساوية.",
            "calculation": "\\(\\lim_{x\\to2^-}f(x)=\\lim_{x\\to2^+}f(x)=f(2)=1\\)",
            "result": "الدالة مستمرة عند \\(2\\)."
          }
        ],
        "final_answer": "\\(\\boxed{f\\text{ مستمرة عند }2}\\)",
        "common_mistakes": [
          {
            "mistake": "الاكتفاء بتساوي النهايتين الجانبيتين.",
            "correction": "يجب أيضًا التحقق من أنهما تساويان \\(f(2)\\)."
          }
        ],
        "hints": [
          "حدد الفرع الذي يعطي \\(f(2)\\).",
          "احسب النهاية من اليسار ومن اليمين."
        ]
      }
    },
    {
      "id": "continuity_03",
      "number": "45",
      "text": "لتكن \\(f(x)=\\frac{x^3-1}{x-1}\\) إذا \\(x\\ne1\\)، و\\(f(1)=3\\). ادرس الاستمرارية عند \\(1\\).",
      "skill": "مقارنة النهاية بقيمة الدالة",
      "difficulty": "medium",
      "solution": {
        "strategy": "نحسب النهاية بعد تحليل البسط، ثم نقارنها بقيمة الدالة عند 1.",
        "steps": [
          {
            "order": 1,
            "title": "قيمة الدالة",
            "explanation": "القيمة معطاة مباشرة.",
            "calculation": "\\(f(1)=3\\)",
            "result": "\\(f(1)=3\\)"
          },
          {
            "order": 2,
            "title": "تحليل البسط",
            "explanation": "نستعمل فرق المكعبين.",
            "calculation": "\\(x^3-1=(x-1)(x^2+x+1)\\)",
            "result": "من أجل \\(x\\ne1\\)، تصبح الدالة \\(x^2+x+1\\)."
          },
          {
            "order": 3,
            "title": "حساب النهاية",
            "explanation": "نعوض في العبارة المبسطة.",
            "calculation": "\\(\\lim_{x\\to1}(x^2+x+1)=3\\)",
            "result": "النهاية تساوي \\(3\\)."
          },
          {
            "order": 4,
            "title": "الاستنتاج",
            "explanation": "النهاية تساوي قيمة الدالة.",
            "calculation": "\\(\\lim_{x\\to1}f(x)=f(1)=3\\)",
            "result": "الدالة مستمرة عند \\(1\\)."
          }
        ],
        "final_answer": "\\(\\boxed{f\\text{ مستمرة عند }1}\\)",
        "common_mistakes": [
          {
            "mistake": "التوقف عند الشكل \\(0/0\\).",
            "correction": "يجب تحليل البسط واختزال العامل المشترك قبل حساب النهاية."
          }
        ],
        "hints": [
          "حلل \\(x^3-1\\).",
          "قارن النهاية بالقيمة \\(f(1)=3\\)."
        ]
      }
    },
    {
      "id": "continuity_08",
      "number": "104",
      "text": "لتكن \\(f(x)=\\frac{x+2-\\sqrt{4+x^2}}{x}\\) إذا \\(x\\ne0\\)، و\\(f(0)=\\alpha\\). عين \\(\\alpha\\) حتى تكون \\(f\\) مستمرة عند \\(0\\).",
      "skill": "مقارنة النهاية بقيمة الدالة",
      "difficulty": "medium",
      "solution": {
        "strategy": "نحسب نهاية العبارة عند الصفر ثم نجعلها مساوية لقيمة الدالة \\(\\alpha\\).",
        "steps": [
          {
            "order": 1,
            "title": "شرط الاستمرارية",
            "explanation": "لكي تكون الدالة مستمرة عند 0 يجب أن تكون النهاية مساوية لـ\\(f(0)=\\alpha\\).",
            "calculation": "\\(\\alpha=\\lim_{x\\to0}\\frac{x+2-\\sqrt{4+x^2}}{x}\\)",
            "result": "نبدأ بحساب النهاية."
          },
          {
            "order": 2,
            "title": "الضرب في المرافق",
            "explanation": "نضرب البسط والمقام في مرافق البسط.",
            "calculation": "\\(\\frac{x+2-\\sqrt{4+x^2}}{x}\\times\\frac{x+2+\\sqrt{4+x^2}}{x+2+\\sqrt{4+x^2}}\\)",
            "result": "يصبح البسط فرق مربعين."
          },
          {
            "order": 3,
            "title": "التبسيط",
            "explanation": "نبسط البسط ثم نختزل x من أجل \\(x\\ne0\\).",
            "calculation": "\\(\\frac{(x+2)^2-(4+x^2)}{x(x+2+\\sqrt{4+x^2})}=\\frac{4}{x+2+\\sqrt{4+x^2}}\\)",
            "result": "زالت حالة عدم التعيين."
          },
          {
            "order": 4,
            "title": "حساب النهاية",
            "explanation": "نعوض x بالصفر في العبارة المبسطة.",
            "calculation": "\\(\\lim_{x\\to0}\\frac4{x+2+\\sqrt{4+x^2}}=\\frac4{2+2}=1\\)",
            "result": "النهاية تساوي \\(1\\)."
          },
          {
            "order": 5,
            "title": "تحديد الوسيط",
            "explanation": "حتى تتحقق الاستمرارية يجب أن تكون \\(\\alpha\\) مساوية للنهاية.",
            "calculation": "\\(\\alpha=1\\)",
            "result": "تكون الدالة مستمرة عند 0 من أجل \\(\\alpha=1\\)."
          }
        ],
        "final_answer": "\\(\\boxed{\\alpha=1}\\)",
        "common_mistakes": [
          {
            "mistake": "اعتبار \\(0/0\\) هو الجواب النهائي.",
            "correction": "يجب إزالة حالة عدم التعيين ثم حساب النهاية."
          }
        ],
        "hints": [
          "استعمل مرافق البسط.",
          "بعد التبسيط اجعل النهاية مساوية لـ\\(\\alpha\\)."
        ]
      }
    }
  ]
