        }
      },
      {
        "id": "step_2",
        "type": "guided_explanation",
        "title": "لا تخلط بين f وf'",
        "content": {
          "comparison": [
            {
              "expression": "\\(f(x)\\)",
              "role": "موقع المنحنى بالنسبة لمحور الفواصل."
            },
            {
              "expression": "\\(f'(x)\\)",
              "role": "اتجاه تغير المنحنى."
            }
          ],
          "example": {
            "function": "\\(f(x)=5-x\\)",
            "function_sign": "موجبة عندما x<5.",
            "derivative": "\\(f'(x)=-1<0\\)",
            "variation": "متناقصة على \\(\\mathbb{R}\\)."
          },
          "takeaway": "قد تكون الدالة موجبة ومتناقصة في الوقت نفسه."
        }
      },
      {
        "id": "step_3",
        "type": "method",
        "title": "الخطة العامة لدراسة إشارة دالة",
        "content": {
          "method": [
            {
              "step_number": 1,
              "title": "المجال",
              "instruction": "حدد D_f واستبعد القيم الممنوعة."
            },
            {
              "step_number": 2,
              "title": "الجذور",
              "instruction": "حل f(x)=0."
            },
            {
              "step_number": 3,
              "title": "التحليل",
              "instruction": "اكتب f على شكل جداء أو خارج قسمة."
            },
            {
              "step_number": 4,
              "title": "إشارة العوامل",
              "instruction": "حدد إشارة كل عامل مع الانتباه للأسس."
            },
            {
              "step_number": 5,
              "title": "الجدول",
              "instruction": "رتب الجذور والقيم الممنوعة واستنتج إشارة f."
            },
            {
              "step_number": 6,
              "title": "النتيجة",
              "instruction": "اكتب مجالات الموجب والسالب أو حلول المتراجحة."
            }
          ],
          "memory_tip": "المجال ← الجذور ← التحليل ← الإشارات ← النتيجة."
        }
      },
      {
        "id": "step_4",
        "type": "rule",
        "title": "إشارة عامل من الدرجة الأولى",
        "content": {
          "general_form": "\\(ax+b\\) حيث \\(a\\ne0\\)",
          "root": "\\(x_0=-\\frac{b}{a}\\)",
          "rules": [
            {
              "condition": "\\(a>0\\)",
              "sign": "سالب قبل الجذر وموجب بعده."
            },
            {
              "condition": "\\(a<0\\)",
              "sign": "موجب قبل الجذر وسالب بعده."
            }
          ],
          "example": {
            "factor": "\\(2x-4\\)",
            "root": "2",
            "sign": "سالب قبل 2، منعدم عند 2، موجب بعد 2."
          },
          "takeaway": "العامل الخطي يغير إشارته عند جذره."
        }
      },
      {
        "id": "step_5",
        "type": "worked_example",
        "title": "مثال: جداء عاملين",
        "content": {
          "statement": "ادرس إشارة \\(f(x)=(x-2)(x+1)\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "الجذور",
              "calculation": "\\(x=-1\\) و\\(x=2\\)."
            },
            {
              "step_number": 2,
              "title": "ترتيب القيم",
              "result": "نرتب −1 ثم 2 على محور الأعداد."
            },
            {
              "step_number": 3,
              "title": "إشارة الجداء",
              "result": "موجب خارج الجذرين وسالب بينهما."
            }
          ],
          "sign_table": {
            "x": [
              "−∞",
              "−1",
              "2",
              "+∞"
            ],
            "f": [
              "+",
              "0",
              "−",
              "0",
              "+"
            ]
          },
          "conclusions": [
            "\\(f(x)>0\\) على \\(]-\\infty,-1[\\cup]2,+\\infty[\\).",
            "\\(f(x)<0\\) على \\(]-1,2[\\)."
          ]
        }
      },
      {
        "id": "step_6",
        "type": "concept",
        "title": "أثر الأس الزوجي والأس الفردي",
        "content": {
          "rules": [
            {
              "factor": "\\((x-a)^{2k}\\)",
              "effect": "لا تتغير الإشارة عند a."
            },
            {
              "factor": "\\((x-a)^{2k+1}\\)",
              "effect": "تتغير الإشارة عند a."
            }
          ],
          "example": "في \\(f(x)=(x-2)^2(x+1)\\)، لا تتغير الإشارة عند 2، وتتغير عند −1.",
          "memory_tip": "زوجي: لا تبديل، فردي: تبديل."
        }
      },
      {
        "id": "step_7",
        "type": "method",
        "title": "دراسة إشارة دالة كسرية",
        "content": {
          "method": [
            "حدد قيم المقام الممنوعة.",
            "حل معادلة البسط لإيجاد أصفار الدالة.",
            "ادرس إشارة البسط والمقام.",
            "استنتج إشارة الخارج."
          ],
          "attention": "جذر المقام قيمة ممنوعة وليس جذرًا للدالة.",
          "takeaway": "أصفار الدالة من البسط، والقيم الممنوعة من المقام."
        }
      },
      {
        "id": "step_8",
        "type": "worked_example",
        "title": "مثال: دالة كسرية",
        "content": {
          "statement": "ادرس إشارة \\(f(x)=\\frac{x-1}{x+2}\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "المجال",
              "calculation": "\\(D_f=\\mathbb{R}\\setminus\\{-2\\}\\)."
            },
            {
              "step_number": 2,
              "title": "الجذر",
              "calculation": "\\(x-1=0\\iff x=1\\)."
            },
            {
              "step_number": 3,
              "title": "الترتيب",
              "result": "نرتب −2 كقيمة ممنوعة و1 كجذر."
            },
            {
              "step_number": 4,
              "title": "النتيجة",
              "result": "الدالة موجبة قبل −2 وبعد 1، وسالبة بين −2 و1."
            }
          ],
          "sign_table": {
            "x": [
              "−∞",
              "−2",
              "1",
              "+∞"
            ],
            "f": [
              "+",
              "غير معرفة",
              "−",
              "0",
              "+"
            ]
          },
          "attention": "لا تضم −2 إلى أي مجموعة حلول."
        }
      },
      {
        "id": "step_9",
        "type": "method",
        "title": "استنتاج الإشارة من جدول التغيرات",
        "content": {
          "teacher": "عندما يصعب تحليل f، يمكن تحديد إشارتها من جدول تغيراتها إذا عرفت جذورها واتجاه التغير.",
          "method": [
            "حدد أين تساوي f الصفر.",
            "اتبع سهام التغير لمعرفة هل القيم أعلى من الصفر أم أدنى منه.",
            "اكتب مجالات الموجب والسالب."
          ],
          "attention": "لا يمكن تحديد الإشارة من التغيرات وحدها دون معرفة قيمة أو جذر مرجعي."
        }
      },
      {
        "id": "step_10",
        "type": "application",
        "title": "حل المتراجحات بجدول الإشارة",
        "content": {
          "rules": [
            {
              "inequality": "\\(f(x)>0\\)",
              "reading": "خذ المجالات التي تحمل إشارة + دون الجذور."
            },
            {
              "inequality": "\\(f(x)\\ge0\\)",
              "reading": "خذ المجالات الموجبة وأضف الجذور المعرفة."
            },
            {
              "inequality": "\\(f(x)<0\\)",
              "reading": "خذ المجالات التي تحمل إشارة −."
            },
            {
              "inequality": "\\(f(x)\\le0\\)",
              "reading": "خذ المجالات السالبة وأضف الجذور المعرفة."
            }
          ],
          "attention": "القيم الممنوعة لا تضم أبدًا، حتى مع ≥ أو ≤."
        }
      },
      {
        "id": "step_11",
        "type": "graph_reading",
        "title": "قراءة الإشارة من المنحنى",
        "content": {
          "method": [
            "حدد نقاط تقاطع المنحنى مع محور الفواصل.",
            "اقرأ المقاطع الواقعة فوق المحور كمجالات موجبة.",
            "اقرأ المقاطع الواقعة تحته كمجالات سالبة."
          ],
          "takeaway": "الرسم يعطي الإشارة مباشرة من موقع المنحنى."
