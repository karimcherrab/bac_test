  "questions": [
    {
      "id": "exp_composite_derivative_01",
      "number": 1,
      "title": "تحديد الدالة الداخلية",
      "text": "حدد الدالة الداخلية \\(u(x)\\) في كل حالة: \\(e^{3x-2}\\)، \\(e^{x^2+1}\\)، \\(e^{1/x}\\).",
      "skill": "تحديد ما داخل الأس في الدالة المركبة.",
      "difficulty": "easy",
      "solution": {
        "steps": [
          {
            "order": 1,
            "result": "في \\(e^{3x-2}\\): \\(u(x)=3x-2\\)."
          },
          {
            "order": 2,
            "result": "في \\(e^{x^2+1}\\): \\(u(x)=x^2+1\\)."
          },
          {
            "order": 3,
            "result": "في \\(e^{1/x}\\): \\(u(x)=1/x\\)."
          }
        ],
        "final_answer": "الدالة الداخلية هي كامل التعبير الموجود داخل الأس."
      }
    },
    {
      "id": "exp_composite_derivative_02",
      "number": 2,
      "title": "أس خطي",
      "text": "احسب مشتقة الدالة \\(f(x)=e^{5x-3}\\).",
      "skill": "تطبيق قاعدة \\((e^{u})'=u'e^u\\) على أس خطي.",
      "difficulty": "easy",
      "solution": {
        "steps": [
          {
            "order": 1,
            "calculation": "\\(u(x)=5x-3\\Rightarrow u'(x)=5\\)."
          },
          {
            "order": 2,
            "calculation": "\\(f'(x)=u'(x)e^{u(x)}=5e^{5x-3}\\)."
          }
        ],
        "final_answer": "\\(f'(x)=5e^{5x-3}\\)."
      }
    },
    {
      "id": "exp_composite_derivative_03",
      "number": 3,
      "title": "أس تربيعي",
      "text": "احسب مشتقة الدالة \\(f(x)=e^{x^2+2x-1}\\).",
      "skill": "اشتقاق دالة أسية ذات أس كثير حدود.",
      "difficulty": "easy",
      "solution": {
        "steps": [
          {
            "order": 1,
            "calculation": "\\(u(x)=x^2+2x-1\\Rightarrow u'(x)=2x+2\\)."
          },
          {
            "order": 2,
            "calculation": "\\(f'(x)=(2x+2)e^{x^2+2x-1}\\)."
          }
        ],
        "final_answer": "\\(f'(x)=2(x+1)e^{x^2+2x-1}\\)."
      }
    },
    {
      "id": "exp_composite_derivative_04",
      "number": 4,
      "title": "الأس السالب",
      "text": "احسب مشتقة الدالة \\(f(x)=e^{-x^2}\\).",
      "skill": "عدم نسيان مشتقة الأس.",
      "difficulty": "easy",
      "solution": {
        "steps": [
          {
            "order": 1,
            "calculation": "\\(u(x)=-x^2\\Rightarrow u'(x)=-2x\\)."
          },
          {
            "order": 2,
            "calculation": "\\(f'(x)=-2xe^{-x^2}\\)."
          }
        ],
        "final_answer": "\\(f'(x)=-2xe^{-x^2}\\)."
      }
    },
    {
