            "result": "البسط يؤول إلى \\(0\\)."
          },
          {
            "order": 2,
            "title": "نهاية المقام",
            "explanation": "المقام هو x نفسه.",
            "calculation": "\\(x\\to0\\)",
            "result": "المقام يؤول إلى \\(0\\)."
          },
          {
            "order": 3,
            "title": "تحديد الحالة",
            "explanation": "البسط والمقام يؤولان معًا إلى الصفر.",
            "calculation": "\\(\\frac{0}{0}\\)",
            "result": "حالة عدم تعيين من الشكل \\(0/0\\)."
