      "text": "أثبت باستعمال المقارنة أن \\(\\lim_{x\\to+\\infty}(x^2+\\sqrt{x})=+\\infty\\).",
      "skill": "المقارنة نحو زائد ما لا نهاية",
      "difficulty": "easy",
      "solution": {
        "strategy": "نبحث عن حد سفلي بسيط يؤول إلى زائد ما لا نهاية.",
        "steps": [
          {
            "order": 1,
            "title": "بناء المقارنة",
            "explanation": "من أجل \\(x\\ge0\\)، لدينا \\(\\sqrt{x}\\ge0\\).",
            "calculation": "\\(x^2+\\sqrt{x}\\ge x^2\\)",
            "result": "وجدنا حدًا سفليًا للدالة."
          },
          {
            "order": 2,
            "title": "نهاية الحد السفلي",
            "explanation": "نعلم أن \\(x^2\\to+\\infty\\).",
            "calculation": "\\(\\lim_{x\\to+\\infty}x^2=+\\infty\\)",
            "result": "الحد السفلي يؤول إلى زائد ما لا نهاية."
          },
          {
            "order": 3,
            "title": "تطبيق المقارنة",
            "explanation": "الدالة أكبر من دالة تؤول إلى زائد ما لا نهاية.",
            "calculation": "\\(x^2+\\sqrt{x}\\ge x^2\\)",
            "result": "النهاية تساوي \\(+\\infty\\)."
          }
        ],
        "final_answer": "\\(\\lim_{x\\to+\\infty}(x^2+\\sqrt{x})=+\\infty\\).",
        "common_mistakes": [
          {
            "mistake": "البحث عن حد علوي لإثبات النهاية \\(+\\infty\\).",
            "correction": "نحتاج إلى حد سفلي يؤول إلى \\(+\\infty\\)."
          }
        ],
        "hints": [
          "استعمل أن \\(\\sqrt{x}\\ge0\\)."
        ]
      }
