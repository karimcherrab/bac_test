            "order": 3,
            "title": "الاختزال",
            "explanation": "من أجل \\(x\\ne1\\)، نختزل العامل \\(x-1\\).",
            "calculation": "\\(\\frac{(x-1)(x+1)}{x-1}=x+1\\)",
            "result": "زالت حالة عدم التعيين."
          },
          {
            "order": 4,
            "title": "حساب النهاية",
            "explanation": "نعوض في العبارة المبسطة.",
            "calculation": "\\(1+1=2\\)",
            "result": "النهاية تساوي \\(2\\)."
          }
        ],
        "final_answer": "\\(\\lim_{x\\to1}\\frac{x^2-1}{x-1}=2\\).",
        "common_mistakes": [
