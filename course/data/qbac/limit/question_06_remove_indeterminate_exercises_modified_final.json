          {
            "order": 2,
            "title": "تحليل البسط",
            "explanation": "نستعمل فرق مربعين.",
            "calculation": "\\(x^2-1=(x-1)(x+1)\\)",
            "result": "ظهر العامل المشترك \\(x-1\\)."
