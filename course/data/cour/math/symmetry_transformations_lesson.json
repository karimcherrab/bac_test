      {
        "id": "step_2",
        "type": "concept",
        "title": "تناظر مجال التعريف",
        "content": {
          "teacher": "قبل دراسة الزوجية أو الفردية يجب أن يكون مجال تعريف الدالة متناظرًا بالنسبة إلى الصفر.",
          "condition": "\\(x\\in D_f\\Longrightarrow -x\\in D_f\\)",
          "examples": [
            {
              "domain": "\\(\\mathbb{R}\\)",
              "symmetric": true
            },
            {
              "domain": "\\([-3,3]\\)",
              "symmetric": true
            },
            {
              "domain": "\\(\\mathbb{R}\\setminus\\{0\\}\\)",
              "symmetric": true
            },
            {
              "domain": "\\([0,+\\infty[\\)",
              "symmetric": false
            }
          ],
          "why": "لا يمكن مقارنة f(x) وf(-x) إذا كانت إحدى القيمتين غير معرفة.",
          "how_to_think": "اختبر المجال قبل العبارة.",
          "attention": "حتى لو تحققت علاقة جبرية في جزء من المجال، لا نصف الدالة بالزوجية أو الفردية إذا لم يكن المجال متناظرًا.",
          "quick_check": {
            "question": "هل المجال [0,+∞[ متناظر بالنسبة إلى الصفر؟",
            "answer": "لا."
          }
        }
      },
      {
        "id": "step_3",
        "type": "definition",
        "title": "الدالة الزوجية",
        "content": {
          "teacher": "تكون f زوجية إذا كان مجالها متناظرًا بالنسبة إلى الصفر وكانت قيمة الدالة لا تتغير عند تعويض x بـ -x.",
          "definition": "\\(f(-x)=f(x)\\)",
          "geometric_interpretation": "منحنى الدالة الزوجية متناظر بالنسبة إلى محور التراتيب.",
          "point_mapping": "\\((x,f(x))\\mapsto(-x,f(x))\\)",
          "example": "\\(f(x)=x^2\\) لأن \\((-x)^2=x^2\\).",
          "why": "النقطتان ذواتا الفاصلتين المتعاكستين لهما الترتيب نفسه.",
          "how_to_think": "بدّل x بـ -x ثم بسط.",
          "attention": "العلاقة المطلوبة هي f(-x)=f(x)، وليست f(-x)=-f(x).",
          "quick_check": {
            "question": "ما محور تناظر منحنى دالة زوجية؟",
            "answer": "محور التراتيب."
          },
          "visualization": {
            "type": "even_function_symmetry",
            "renderer": "jsx_svg_or_recharts",
            "function": {
              "expression": "x^2-1",
              "domain": [
                -4,
                4
              ]
            },
            "symmetry_axis": {
              "equation": "x=0"
            },
            "movable_point": {
              "control": {
                "name": "a",
                "min": 0,
                "max": 3.5,
                "step": 0.1,
                "default": 2
              },
              "point_1": {
                "x_expression": "a",
                "y_expression": "a^2-1"
              },
              "point_2": {
                "x_expression": "-a",
                "y_expression": "a^2-1"
              }
            },
            "show_reflection_segment": true,
            "axes": {
              "x_min": -4,
              "x_max": 4,
              "y_min": -3,
              "y_max": 12
            }
          }
        }
      },
      {
        "id": "step_4",
        "type": "definition",
        "title": "الدالة الفردية",
        "content": {
          "teacher": "تكون f فردية إذا كان مجالها متناظرًا بالنسبة إلى الصفر وتغيرت إشارة قيمة الدالة عند تعويض x بـ -x.",
          "definition": "\\(f(-x)=-f(x)\\)",
          "equivalent_form": "\\(f(-x)+f(x)=0\\)",
          "geometric_interpretation": "منحنى الدالة الفردية يقبل مبدأ المعلم مركز تناظر.",
          "point_mapping": "\\((x,f(x))\\mapsto(-x,-f(x))\\)",
          "example": "\\(f(x)=x^3\\) لأن \\((-x)^3=-x^3\\).",
          "why": "كل نقطة من المنحنى تقابلها نقطة معاكسة بالنسبة إلى الأصل.",
          "how_to_think": "بدّل x بـ -x وابحث هل النتيجة هي -f(x).",
          "attention": "إذا كانت f معرفة عند الصفر وفردية، فإن f(0)=0.",
          "quick_check": {
            "question": "ما مركز تناظر منحنى دالة فردية؟",
            "answer": "مبدأ المعلم O."
          },
          "visualization": {
            "type": "odd_function_symmetry",
            "renderer": "jsx_svg_or_recharts",
            "function": {
              "expression": "x^3-x",
              "domain": [
                -2.5,
                2.5
              ]
            },
            "symmetry_center": {
              "x": 0,
              "y": 0
            },
            "movable_point": {
              "control": {
                "name": "a",
                "min": 0,
                "max": 2.2,
                "step": 0.1,
                "default": 1.7
              },
              "point_1": {
                "x_expression": "a",
                "y_expression": "a^3-a"
              },
              "point_2": {
                "x_expression": "-a",
                "y_expression": "-(a^3-a)"
              }
            },
            "show_center_segment": true,
            "axes": {
              "x_min": -2.5,
              "x_max": 2.5,
              "y_min": -10,
              "y_max": 10
            }
          }
        }
      },
      {
        "id": "step_5",
        "type": "comparison",
        "title": "التمييز بين الزوجية والفردية",
        "content": {
          "table": [
            {
              "property": "العلاقة",
              "even": "\\(f(-x)=f(x)\\)",
              "odd": "\\(f(-x)=-f(x)\\)"
            },
            {
              "property": "التناظر",
              "even": "محور التراتيب",
              "odd": "مبدأ المعلم"
            },
            {
              "property": "تحويل النقطة",
              "even": "\\((x,y)\\to(-x,y)\\)",
              "odd": "\\((x,y)\\to(-x,-y)\\)"
            },
            {
              "property": "مثال",
              "even": "\\(x^2\\)",
              "odd": "\\(x^3\\)"
            }
          ],
          "memory_tip": "زوجية: نفس y. فردية: عكس x وعكس y.",
          "quick_check": {
            "question": "إذا كان f(-x)+f(x)=0، فما نوع الدالة؟",
            "answer": "فردية."
          }
        }
      },
      {
        "id": "step_6",
        "type": "worked_example",
        "title": "مثال على دراسة الشفعية",
        "content": {
          "statement": "ادرس شفعية الدالة \\(f(x)=x^4-3x^2+2\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "المجال",
              "calculation": "\\(D_f=\\mathbb{R}\\)",
              "result": "المجال متناظر بالنسبة إلى الصفر."
            },
            {
              "step_number": 2,
              "title": "حساب f(-x)",
              "calculation": "\\(f(-x)=(-x)^4-3(-x)^2+2\\)",
              "result": "نعوض كل x بـ -x."
            },
            {
              "step_number": 3,
              "title": "التبسيط",
              "calculation": "\\(f(-x)=x^4-3x^2+2=f(x)\\)",
              "result": "تحققت علاقة الزوجية."
            }
          ],
          "final_conclusion": "الدالة f زوجية، ومنحناها متناظر بالنسبة إلى محور التراتيب.",
          "attention": "يجب ذكر تناظر المجال قبل النتيجة."
        }
      },
      {
        "id": "step_7",
        "type": "rule",
        "title": "مركز تناظر عام ω(α,β)",
        "content": {
          "teacher": "لا يقتصر مركز التناظر على مبدأ المعلم. يمكن إثبات أن النقطة ω(α,β) مركز تناظر لمنحنى f بعلاقة عامة.",
          "criterion": "\\(f(2\\alpha-x)+f(x)=2\\beta\\)",
          "equivalent_form": "\\(f(2\\alpha-x)=2\\beta-f(x)\\)",
          "point_mapping": "\\((x,f(x))\\mapsto(2\\alpha-x,2\\beta-f(x))\\)",
          "why": "النقطة ω هي منتصف النقطتين المتناظرتين.",
          "how_to_think": "عوض x بالنظير 2α-x ثم اجمع القيمتين.",
          "attention": "عندما α=0 وβ=0 نعود إلى شرط الدالة الفردية.",
          "quick_check": {
            "question": "ما العلاقة التي تثبت أن ω(α,β) مركز تناظر؟",
            "answer": "\\(f(2\\alpha-x)+f(x)=2\\beta\\)."
          }
        }
      },
      {
        "id": "step_8",
        "type": "worked_example",
        "title": "مثال على مركز تناظر غير الأصل",
        "content": {
          "statement": "بيّن أن النقطة \\(\\omega(1,2)\\) مركز تناظر لمنحنى \\(f(x)=(x-1)^3+2\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "نحسب النظير الجبري للفاصلة",
              "calculation": "\\(2\\alpha-x=2-x\\)",
              "result": "لأن α=1."
            },
            {
              "step_number": 2,
              "title": "نحسب f(2-x)",
              "calculation": "\\(f(2-x)=((2-x)-1)^3+2=(1-x)^3+2\\)",
              "result": "\\(f(2-x)=-(x-1)^3+2\\)."
            },
            {
              "step_number": 3,
              "title": "نجمع",
              "calculation": "\\(f(2-x)+f(x)=4=2\\beta\\)",
              "result": "تحقق الشرط."
            }
          ],
          "final_conclusion": "\\(\\omega(1,2)\\) مركز تناظر للمنحنى.",
          "visualization": {
            "type": "general_center_symmetry",
            "renderer": "jsx_svg_or_recharts",
            "function": {
              "expression": "(x-1)^3+2",
              "domain": [
                -1.5,
                3.5
              ]
            },
            "center": {
              "x": 1,
              "y": 2,
              "label": "ω(1,2)"
            },
            "movable_point": {
              "control": {
                "name": "a",
                "min": -1,
                "max": 3,
                "step": 0.1,
                "default": 2.2
              },
              "point_1": {
                "x_expression": "a",
                "y_expression": "(a-1)^3+2"
              },
              "point_2": {
                "x_expression": "2-a",
                "y_expression": "4-((a-1)^3+2)"
              }
            },
            "show_midpoint": true,
            "axes": {
              "x_min": -1.5,
              "x_max": 3.5,
              "y_min": -8,
              "y_max": 12
            }
          }
        }
      },
      {
        "id": "step_9",
        "type": "rule",
        "title": "محور تناظر عام x=α",
        "content": {
          "teacher": "يكون المستقيم x=α محور تناظر للمنحنى إذا كانت قيم الدالة متساوية عند فاصلتين متناظرتين بالنسبة إلى α.",
          "criterion": "\\(f(2\\alpha-x)=f(x)\\)",
          "point_mapping": "\\((x,f(x))\\mapsto(2\\alpha-x,f(x))\\)",
          "why": "الفاصلتان تبعدان المسافة نفسها عن المستقيم x=α.",
          "how_to_think": "عوض x بـ 2α-x وتحقق من بقاء قيمة الدالة نفسها.",
          "attention": "عندما α=0 نحصل على شرط الدالة الزوجية.",
          "quick_check": {
            "question": "ما شرط محور التناظر x=α؟",
            "answer": "\\(f(2\\alpha-x)=f(x)\\)."
          }
        }
      },
      {
        "id": "step_10",
        "type": "worked_example",
        "title": "مثال على محور تناظر غير محور التراتيب",
        "content": {
          "statement": "بيّن أن المستقيم \\(x=2\\) محور تناظر لمنحنى \\(f(x)=(x-2)^2+1\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "الفاصلة المتناظرة",
              "calculation": "\\(2\\alpha-x=4-x\\)",
              "result": "لأن α=2."
            },
            {
              "step_number": 2,
              "title": "حساب الصورة",
              "calculation": "\\(f(4-x)=((4-x)-2)^2+1=(2-x)^2+1\\)",
              "result": "\\((2-x)^2=(x-2)^2\\)."
            },
            {
              "step_number": 3,
              "title": "المقارنة",
              "calculation": "\\(f(4-x)=f(x)\\)",
              "result": "تحقق شرط محور التناظر."
            }
          ],
          "final_conclusion": "المستقيم x=2 محور تناظر للمنحنى.",
          "visualization": {
            "type": "general_axis_symmetry",
            "renderer": "jsx_svg_or_recharts",
            "function": {
              "expression": "(x-2)^2+1",
              "domain": [
