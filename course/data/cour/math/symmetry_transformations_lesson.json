            }
          }
        }
      },
      {
        "id": "step_11",
        "type": "rule",
        "title": "الانسحاب العمودي: h(x)=f(x)+k",
        "content": {
          "teacher": "إضافة العدد k إلى قيم الدالة تغير كل ترتيب y إلى y+k دون تغيير الفاصلة.",
          "transformation": "\\(h(x)=f(x)+k\\)",
          "vector": "\\(\\vec{v}=(0,k)\\)",
          "point_mapping": "\\((x,y)\\mapsto(x,y+k)\\)",
          "cases": [
            {
              "condition": "k>0",
              "effect": "انتقال إلى الأعلى."
            },
            {
              "condition": "k<0",
              "effect": "انتقال إلى الأسفل."
            }
          ],
          "why": "التعديل وقع خارج الدالة، لذلك يؤثر في الترتيب.",
          "how_to_think": "خارج f يعني حركة عمودية.",
          "attention": "شكل المنحنى لا يتغير.",
          "quick_check": {
            "question": "كيف نحصل على منحنى f(x)-3؟",
            "answer": "ننقل منحنى f ثلاث وحدات إلى الأسفل."
          },
          "visualization": {
            "type": "vertical_translation",
            "renderer": "jsx_svg_or_recharts",
            "base_function": {
              "expression": "x^2",
              "domain": [
                -3,
                3
              ]
            },
            "transformed_function": {
              "expression": "x^2+k"
            },
            "control": {
              "name": "k",
              "min": -4,
              "max": 4,
              "step": 0.5,
              "default": 2
            },
            "vector_expression": "(0,k)",
            "show_corresponding_points": true,
            "axes": {
