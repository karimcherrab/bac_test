    "axis_title": "التناظر وتحويلات المنحنيات",
    "estimated_minutes": 85,
    "difficulty": "medium",
    "source_note": "أُنجز هذا المحور بالاعتماد على فقرة الشفعية والتناظر وفقرة استنتاج تمثيل بياني لدالة انطلاقًا من تمثيل دالة أخرى في الملخص المرفق. حافظ المحتوى على العلاقات الواردة في المصدر: مركز التناظر، محور التناظر، الزوجية والفردية، الانسحابات الأفقية والعمودية، الانعكاس بالنسبة إلى المحورين ومبدأ المعلم، وتحويلات القيمة المطلقة. أضيفت مواصفات رسم منظمة لتتمكن واجهة React من توليد التحويلات تفاعليًا بدل الاعتماد على صور ثابتة.",
    "lesson_goal": "أن يحدد التلميذ شفعية الدالة وعناصر تناظر منحناها، ويستنتج تمثيل دالة جديدة انطلاقًا من منحنى دالة مرجعية باستعمال الانسحاب والانعكاس والقيمة المطلقة، ويربط كل تحويل جبري بتحويل هندسي صحيح.",
    "prerequisites": [
      "معرفة مفهوم الدالة ومجال تعريفها.",
      "معرفة التمثيل البياني للدالة.",
      "إتقان التعويض في عبارة دالة.",
      "معرفة الإحداثيات في معلم متعامد ومتجانس.",
      "معرفة الانسحاب والتناظر المحوري والتناظر المركزي.",
      "معرفة دالة القيمة المطلقة وتمثيلها القطعي."
    ],
    "learning_outcomes": [
      "يتحقق من تناظر مجال تعريف الدالة بالنسبة إلى الصفر.",
      "يميز بين الدالة الزوجية والدالة الفردية.",
      "يستنتج محور تناظر منحنى دالة زوجية.",
      "يستنتج مركز تناظر منحنى دالة فردية.",
      "يثبت أن نقطة ω(α,β) مركز تناظر لمنحنى.",
      "يثبت أن المستقيم x=α محور تناظر لمنحنى.",
      "يستنتج منحنى f(x)+k من منحنى f.",
      "يستنتج منحنى f(x+b) من منحنى f.",
      "يستنتج منحنى f(x+b)+k بانسحاب واحد.",
      "يستنتج منحنيات -f(x)، f(-x)، و-f(-x).",
      "يرسم f(|x|) وf(-|x|) و|f(x)| انطلاقًا من منحنى f.",
      "يحدد شعاع الانسحاب الصحيح واتجاهه.",
      "يتجنب الخلط بين التحويل داخل المتغير والتحويل خارج الدالة."
    ],
    "learning_path": [
      {
        "id": "step_1",
        "type": "motivation",
        "title": "هل يجب رسم كل دالة من البداية؟",
        "content": {
          "teacher": "عندما نعرف منحنى دالة f، يمكننا رسم عدد كبير من الدوال المرتبطة بها دون إعادة دراسة كاملة. يكفي فهم كيف تغير العبارة إحداثيات نقاط المنحنى.",
          "examples": [
            "\\(f(x)+2\\) يرفع المنحنى.",
            "\\(f(x-3)\\) ينقل المنحنى أفقيًا.",
            "\\(-f(x)\\) يعكس المنحنى بالنسبة إلى محور الفواصل."
          ],
          "goal": "ربط كل تعديل جبري بحركة هندسية واضحة.",
          "bac_relevance": "تظهر هذه الأسئلة في نهاية دراسة الدالة، وفي استنتاج منحنيات جديدة والمناقشة البيانية.",
          "why": "التحويل يحافظ على شكل أساسي للمنحنى ويغير موضعه أو اتجاهه.",
          "how_to_think": "اسأل: هل التغيير وقع خارج f أم داخل المتغير x؟",
          "attention": "التغيير داخل القوس يكون اتجاهه الأفقي عكس الإشارة الظاهرة.",
          "quick_check": {
            "question": "هل f(x)+k تحويل أفقي أم عمودي؟",
            "answer": "تحويل عمودي."
          },
          "visualization": {
