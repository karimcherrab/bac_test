    ],
    "mastery_criterion": "يحسب التلميذ معاملات التوفيق ويستعمل خصائصها، ثم يطور ثنائي حد أو يستخرج حدًا أو معاملًا محددًا دون أخطاء في المؤشرات أو الأسس.",
    "assessment_method": "جزء حسابي مباشر حول معاملات التوفيق وخصائصها ودستور ثنائي الحد، ثم وضعية توظف C_n^p داخل مسألة عد أو احتمال.",
    "learning_path": [
      {
        "id": "step_1",
        "type": "motivation",
        "title": "ما الذي يعنيه C_n^p؟",
        "content": {
          "teacher": "قبل أي صيغة: C_n^p يجيب عن سؤال واحد بسيط: كم طريقة أستطيع أن أختار بها p عناصر من بين n عندما لا يهم الترتيب؟",
          "mini_example": {
            "situation": "نختار شخصين من 5 لتشكيل فريق.",
            "meaning": "AB هو نفسه BA، لذلك نعد المجموعة مرة واحدة."
          },
          "takeaway": "C_n^p = اختيار دون ترتيب."
        }
      },
      {
        "id": "step_2",
        "type": "law",
        "title": "حساب معامل التوفيق",
        "content": {
          "law_guides": [
            {
              "title": "معامل التوفيق",
              "law": "\\(C_n^p=\\frac{n!}{p!(n-p)!}\\)",
              "meaning": "عدد طرق اختيار p عناصر من n دون ترتيب.",
              "how_to_use": "حدد n وp ثم اختصر العوامل قبل الحساب.",
              "warning": "يجب أن يكون \\(0\\le p\\le n\\)."
            }
          ],
          "takeaway": "حدد n وp ثم طبق الصيغة."
        }
      },
      {
        "id": "step_3",
        "type": "worked_example",
        "title": "أول حساب لـ C_n^p",
        "content": {
          "statement": "احسب \\(C_5^2\\).",
          "steps": [
            "\\(C_5^2=\\frac{5!}{2!3!}\\).",
            "نختصر 3!: \\(\\frac{5\\times4}{2\\times1}\\).",
            "نحصل على 10."
          ],
          "final_answer": "\\(C_5^2=10\\).",
          "takeaway": "الاختصار قبل الحساب أسهل."
        }
      },
      {
        "id": "step_4",
        "type": "concept",
        "title": "قيم سهلة يجب أن تفهمها",
        "content": {
          "teacher": "بعض القيم واضحة حتى دون حساب.",
          "rules": [
            "\\(C_n^0=1\\): توجد طريقة واحدة لاختيار لا شيء.",
            "\\(C_n^n=1\\): توجد طريقة واحدة لاختيار كل العناصر.",
            "\\(C_n^1=n\\): اختيار عنصر واحد من n يعطي n طرق."
          ],
          "takeaway": "هذه القيم تأتي من معنى الاختيار."
        }
      },
      {
        "id": "step_5",
        "type": "concept",
        "title": "خاصية التناظر",
        "content": {
          "teacher": "اختيار 2 أشخاص من 5 يكافئ تحديد 3 أشخاص نتركهم خارج الاختيار. لذلك تظهر خاصية التناظر.",
          "law_guides": [
            {
              "title": "التناظر",
              "law": "\\(C_n^p=C_n^{n-p}\\)",
              "meaning": "اختيار p عناصر يعادل اختيار العناصر المتبقية n-p.",
              "how_to_use": "استعمل الأصغر بين p وn-p لتسهيل الحساب."
            }
          ],
          "mini_example": {
            "example": "\\(C_{10}^{8}=C_{10}^{2}\\)"
          },
          "takeaway": "p وn-p يعطيان نفس العدد."
        }
      },
      {
        "id": "step_6",
        "type": "concept",
        "title": "علاقة باسكال ببساطة",
        "content": {
          "teacher": "إذا جمعت معاملين متجاورين في مثلث باسكال تحصل على العدد الموجود تحتهما.",
          "law_guides": [
            {
              "title": "علاقة باسكال",
              "law": "\\(C_n^p+C_n^{p+1}=C_{n+1}^{p+1}\\)",
              "meaning": "معاملان متجاوران يعطيان معاملًا في السطر التالي."
            }
          ],
          "takeaway": "معاملان متجاوران → معامل واحد."
        }
      },
      {
        "id": "step_7",
        "type": "worked_example",
        "title": "مثال على علاقة باسكال",
        "content": {
          "statement": "بسط \\(C_{8}^{2}+C_{8}^{3}\\).",
          "steps": [
            "العدد العلوي نفسه 8.",
            "المؤشران متتاليان 2 و3.",
            "إذن \\(C_8^2+C_8^3=C_9^3\\)."
          ],
          "final_answer": "\\(C_9^3\\).",
          "takeaway": "ابحث عن الخاصية قبل الحساب الطويل."
        }
      },
      {
        "id": "step_8",
        "type": "concept",
        "title": "مثلث باسكال",
        "content": {
          "teacher": "مثلث باسكال طريقة سهلة لرؤية معاملات التوفيق.",
          "rows": [
            "1",
            "1 1",
            "1 2 1",
            "1 3 3 1",
            "1 4 6 4 1",
            "1 5 10 10 5 1"
          ],
          "connection": "السطر n يعطي \\(C_n^0,C_n^1,...,C_n^n\\).",
          "takeaway": "كل عدد داخلي = مجموع العددين فوقه."
        }
      },
      {
        "id": "step_9",
        "type": "motivation",
        "title": "ما علاقة التوفيقات بـ (a+b)^n؟",
        "content": {
          "teacher": "الأعداد الموجودة في مثلث باسكال تظهر نفسها كمعاملات عند تطوير (a+b)^n. لذلك ثنائي الحد ليس موضوعًا منفصلًا تمامًا عن التوفيقات.",
          "mini_example": {
            "example": "\\((a+b)^2=a^2+2ab+b^2\\) والمعاملات 1،2،1 هي سطر باسكال n=2."
          },
          "takeaway": "معاملات التوفيق هي معاملات حدود ثنائي الحد."
        }
      },
      {
        "id": "step_10",
        "type": "law",
        "title": "دستور ثنائي الحد",
        "content": {
          "teacher": "في كل حد: قوة a تنقص، وقوة b تزيد، والمعامل هو C_n^k.",
          "law_guides": [
            {
              "title": "دستور نيوتن",
              "law": "\\((a+b)^n=\\sum_{k=0}^{n}C_n^k a^{n-k}b^k\\)",
              "meaning": "لكل k حد واحد.",
              "how_to_use": "ابدأ من k=0 حتى k=n.",
              "warning": "مجموع الأسين في كل حد يجب أن يساوي n."
            }
          ],
          "takeaway": "المعامل C_n^k، أس a هو n-k، وأس b هو k."
        }
      },
      {
        "id": "step_11",
        "type": "worked_example",
        "title": "أول تطوير كامل",
        "content": {
          "statement": "طور \\((x+1)^3\\).",
          "steps": [
            "معاملات السطر الثالث: 1،3،3،1.",
            "\\((x+1)^3=x^3+3x^2+3x+1\\)."
          ],
          "final_answer": "\\(x^3+3x^2+3x+1\\).",
          "takeaway": "راقب المعاملات والأسس."
        }
      },
      {
        "id": "step_12",
        "type": "worked_example",
        "title": "تطوير (x+2)^4 خطوة بخطوة",
        "content": {
          "statement": "طور \\((x+2)^4\\).",
          "steps": [
            "المعاملات: 1،4،6،4،1.",
            "قوة x تنقص 4،3،2،1،0.",
            "قوة 2 تزيد 0،1،2،3،4.",
            "نحصل على \\(x^4+8x^3+24x^2+32x+16\\)."
          ],
          "final_answer": "\\((x+2)^4=x^4+8x^3+24x^2+32x+16\\)."
        }
      },
      {
        "id": "step_13",
        "type": "concept",
        "title": "الحد العام",
        "content": {
          "teacher": "إذا طلب منك معامل حد واحد فقط، لا تنشر التعبير كله. استعمل الحد العام.",
          "law": "\\(T_{k+1}=C_n^k a^{n-k}b^k\\)",
          "important_note": "k يبدأ من 0، لذلك الحد رقم k+1.",
          "takeaway": "لاستخراج حد واحد، استعمل الحد العام."
        }
      },
      {
        "id": "step_14",
        "type": "method",
        "title": "كيف أجد معامل x^m؟",
        "content": {
          "algorithm": [
            "اكتب الحد العام.",
            "عوض a وb.",
            "استخرج أس x بدلالة k.",
            "ساو هذا الأس بـm.",
            "أوجد k.",
            "عوض k واحسب المعامل."
          ],
          "takeaway": "حل معادلة الأس أولًا."
        }
      },
      {
        "id": "step_15",
        "type": "worked_example",
        "title": "مثال على استخراج معامل",
        "content": {
          "statement": "أوجد معامل \\(x^3\\) في \\((2+x)^5\\).",
          "steps": [
            "الحد العام \\(C_5^k2^{5-k}x^k\\).",
            "نريد \\(x^3\\)، إذن k=3.",
            "المعامل \\(C_5^3 2^2=10\\times4=40\\)."
          ],
          "final_answer": "المعامل 40.",
          "takeaway": "لا حاجة لتطوير القوة كلها."
        }
      },
      {
        "id": "step_16",
        "type": "concept",
        "title": "ماذا نفعل مع (a-b)^n؟",
        "content": {
          "teacher": "نحوّل الطرح إلى جمع عدد سالب: (a-b)^n=(a+(-b))^n.",
          "law": "\\((a-b)^n=\\sum C_n^k a^{n-k}(-b)^k\\)",
          "sign_rule": [
            "k زوجي → الإشارة موجبة.",
            "k فردي → الإشارة سالبة."
          ],
          "takeaway": "ضع السالب داخل القوة."
        }
      },
      {
        "id": "step_17",
        "type": "worked_example",
        "title": "مثال على الطرح",
        "content": {
          "statement": "طور \\((x-1)^4\\).",
          "steps": [
            "المعاملات 1،4،6،4،1.",
            "الإشارات تتناوب.",
            "\\(x^4-4x^3+6x^2-4x+1\\)."
          ],
          "final_answer": "\\(x^4-4x^3+6x^2-4x+1\\)."
        }
      },
      {
        "id": "step_18",
        "type": "application",
        "title": "التوفيقات داخل الاحتمال",
        "content": {
          "teacher": "بعد أن تختار التوفيقات كنموذج عد، يمكن استعمالها لحساب عدد الحالات الممكنة والملائمة.",
          "mini_example": {
            "situation": "7 حمراء و5 زرقاء، نسحب 3 معًا، ونريد بالضبط كرتين حمراوين.",
            "possible": "\\(C_{12}^3\\)",
            "favorable": "\\(C_7^2C_5^1\\)",
            "probability": "\\(\\frac{C_7^2C_5^1}{C_{12}^3}\\)"
          },
          "takeaway": "في السحب المتزامن: عد الممكن والملائم بالتوفيقات."
        }
      },
      {
        "id": "step_19",
        "type": "method",
        "title": "خطة ثنائي الحد",
        "content": {
          "algorithm": [
            "1. حدد n وa وb.",
            "2. إذا طلب تطويرًا كاملًا استعمل معاملات باسكال أو الدستور.",
            "3. إذا طلب حدًا أو معاملًا فقط استعمل الحد العام.",
            "4. راقب الأسس.",
            "5. في الطرح راقب الإشارات."
          ],
          "takeaway": "حدد المطلوب أولًا: تطوير كامل أم حد واحد؟"
        }
      },
      {
        "id": "step_20",
        "type": "common_mistakes",
        "title": "أخطاء شائعة",
        "content": {
          "mistakes": [
            {
              "title": "نسيان C_n^k",
              "wrong": "أكتب القوى فقط.",
              "correct": "كل حد له معامل توفيق."
            },
            {
              "title": "عكس الأسس",
              "wrong": "أجعل القوتين تتحركان في نفس الاتجاه.",
              "correct": "أس a ينقص وأس b يزيد."
            },
            {
              "title": "الخلط بين k ورقم الحد",
              "wrong": "الحد رقم k.",
              "correct": "الحد الموافق لـk هو T_{k+1}."
            },
            {
              "title": "نسيان السالب",
              "wrong": "أتعامل مع (a-b)^n كأنه (a+b)^n.",
              "correct": "استعمل (-b)^k."
            }
          ]
        }
      },
      {
        "id": "step_21",
        "type": "summary",
        "title": "الخلاصة",
        "content": {
          "remember": [
            "\\(C_n^p\\) = اختيار p من n دون ترتيب.",
            "\\(C_n^0=C_n^n=1\\).",
            "\\(C_n^1=n\\).",
            "\\(C_n^p=C_n^{n-p}\\).",
            "علاقة باسكال تربط معاملات متجاورة.",
            "في ثنائي الحد: \\(C_n^k a^{n-k}b^k\\).",
            "قوة a تنقص وقوة b تزيد.",
            "في الطرح نكتب (-b)^k."
          ],
          "takeaway": "افهم معنى C أولًا، ثم تصبح خصائصه وثنائي الحد أسهل."
        }
      },
      {
