      {
        "id": "step_4",
        "type": "law",
        "title": "قانون الاحتمال الشرطي",
        "content": {
          "teacher": "داخل A نريد الجزء الذي يحقق B أيضًا، أي A∩B.",
          "law_guides": [
            {
              "title": "الاحتمال الشرطي",
              "law": "\\(P(B\\mid A)=\\frac{P(A\\cap B)}{P(A)}\\), مع \\(P(A)\\ne0\\)",
              "meaning": "نقسم احتمال الجزء المشترك على احتمال المجموعة التي نعرف أننا داخلها.",
              "how_to_use": "حدد الشرط A، ثم التقاطع A∩B، ثم اقسم.",
              "warning": "المقام هو P(A)، لا P(B)."
            }
          ],
          "takeaway": "شرط A → المقام P(A)."
        }
      },
      {
        "id": "step_5",
        "type": "worked_example",
        "title": "أول مثال بالقانون",
        "content": {
          "statement": "60% من مجموعة نساء، و45% من المجموعة نساء ممرضات. ما احتمال أن يكون الشخص ممرضًا علما أنه امرأة؟",
          "steps": [
            "نرمز للنساء بـF والممرضين بـI.",
            "المطلوب \\(P(I\\mid F)\\).",
            "\\(P(F)=0.60\\).",
            "\\(P(I\\cap F)=0.45\\).",
            "\\(P(I\\mid F)=0.45/0.60=0.75\\)."
          ],
          "final_answer": "75%.",
          "takeaway": "قسمة التقاطع على الشرط تعطي النسبة داخل الشرط."
        }
      },
      {
        "id": "step_6",
        "type": "law",
        "title": "العلاقة الضربية",
        "content": {
          "teacher": "من نفس القانون نستطيع حساب التقاطع إذا عرفنا الاحتمال الشرطي.",
          "law_guides": [
            {
              "title": "العلاقة الضربية",
              "law": "\\(P(A\\cap B)=P(A)P(B\\mid A)\\)",
              "meaning": "احتمال A مضروبًا في احتمال B داخل A.",
              "how_to_use": "استعملها عندما تعرف P(A) وP(B|A)."
