            ],
            "rows": [
              [
                "\\(+\\infty\\)",
                "\\(+\\infty\\)"
              ],
              [
                "\\(0^+\\)",
                "\\(-\\infty\\)"
              ],
              [
                "\\(L>0\\)",
                "\\(\\ln L\\)"
              ]
            ]
          },
          "method_steps": [
            "حدد \\(u(x)\\).",
            "احسب نهاية \\(u(x)\\).",
            "تحقق أن \\(u(x)>0\\) قرب النهاية.",
            "اختر الحالة المناسبة من الجدول."
          ],
          "attention": "إذا كانت نهاية الداخل سالبة، فلا يمكن تطبيق ln في \\(\\mathbb R\\).",
          "memory_tip": "الداخل أولًا، ثم ln.",
          "takeaway": "نهاية الداخل تحدد نهاية ln."
        }
      },
      {
        "id": "step_7",
        "type": "worked_example",
        "title": "ثلاث حالات مباشرة",
        "content": {
          "teacher": "صنف نهاية الداخل أولًا: هل تذهب إلى \\(+\\infty\\)، أم \\(0^+\\)، أم عدد موجب؟",
          "examples": [
            {
              "expression": "\\(\\lim_{x\\to+\\infty}\\ln(3x+1)\\)",
              "inside_limit": "\\(3x+1\\to+\\infty\\)",
              "result": "\\(+\\infty\\)"
            },
            {
              "expression": "\\(\\lim_{x\\to2^+}\\ln(x-2)\\)",
              "inside_limit": "\\(x-2\\to0^+\\)",
              "result": "\\(-\\infty\\)"
            },
            {
              "expression": "\\(\\lim_{x\\to0}\\ln(x^2+1)\\)",
              "inside_limit": "\\(x^2+1\\to1\\)",
              "result": "\\(\\ln1=0\\)"
            }
          ],
          "takeaway": "إذا كانت نهاية الداخل واضحة، فالنهاية اللوغاريتمية غالبًا مباشرة."
        }
      },
      {
        "id": "step_8",
        "type": "method",
        "title": "متى أستعمل تغيير المتغير أو خواص ln؟",
        "content": {
          "teacher": "إذا لم تكن النهاية واضحة مباشرة، أعد كتابة التعبير بطريقة تجعل الداخل أبسط.",
          "useful_transformations": [
            "\\(\\ln(1/x)=-\\ln x\\)",
            "\\(\\ln(a/b)=\\ln a-\\ln b\\)",
            "\\(\\ln(x^n)=n\\ln x\\) عندما تكون الشروط مناسبة"
          ],
          "worked_example": {
            "question": "احسب \\(\\lim_{x\\to+\\infty}\\ln(1/x)\\).",
            "steps": [
              "\\(1/x\\to0^+\\).",
              "إذن مباشرة \\(\\ln(1/x)\\to-\\infty\\).",
              "ويمكن أيضًا كتابة \\(\\ln(1/x)=-\\ln x\\)."
            ],
            "final_answer": "\\(-\\infty\\)"
          },
          "takeaway": "اختر الكتابة التي تكشف النهاية المرجعية بسرعة."
        }
      },
      {
        "id": "step_9",
        "type": "concept",
        "title": "حالة عدم التعيين +∞−∞",
        "content": {
          "teacher": "إذا ظهر فرق بين لوغاريتمين وكلاهما يتجه إلى \\(+\\infty\\)، فلا نطرح النهايتين مباشرة. نجمعهما في لوغاريتم واحد.",
          "example": "\\(\\ln(x+1)-\\ln x=\\ln\\left(\\frac{x+1}{x}\\right)=\\ln\\left(1+\\frac1x\\right)\\).",
          "result": "\\[\\lim_{x\\to+\\infty}[\\ln(x+1)-\\ln x]=\\ln1=0\\]",
          "central_idea": "فرق لوغاريتمين يتحول إلى لوغاريتم خارج.",
          "attention": "\\(+\\infty-\\infty\\) ليس جوابًا، بل حالة عدم تعيين.",
          "memory_tip": "فرق ln → ln خارج.",
          "takeaway": "بسّط أولًا، ثم احسب النهاية."
        }
