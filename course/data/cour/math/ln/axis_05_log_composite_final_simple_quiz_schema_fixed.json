    "estimated_minutes": 50,
    "difficulty": "medium",
    "lesson_goal": "أن يفهم التلميذ أن كل شيء في \\(\\ln(u(x))\\) يبدأ من الدالة الداخلية: المجال من \\(u>0\\)، الإشارة من مقارنة \\(u\\) بالعدد 1، والمشتقة من \\(u'/u\\)، ثم يستعمل ذلك لدراسة التغير والرسم.",
    "prerequisites": [
      "معرفة تعريف ln ومجالها.",
      "معرفة أن ln متزايدة تمامًا.",
      "معرفة أن ln(1)=0.",
      "معرفة مشتقة ln(x)=1/x.",
      "معرفة قاعدة اشتقاق الدالة المركبة.",
      "حل المتراجحات البسيطة.",
      "دراسة إشارة كثير حدود أو كسر.",
      "قراءة جدول تغير."
    ],
    "learning_outcomes": [
      "يتعرف على البنية ln(u(x)).",
      "يحدد المجال بحل u(x)>0.",
      "يميز بين u(x)>0 وu(x)≠0.",
      "يحسب مشتقة ln(u(x)) باستعمال u'/u.",
      "يحدد إشارة ln(u(x)) بمقارنة u(x) مع 1.",
      "يحل ln(u(x))=0.",
      "يدرس تغير ln(u(x)) من إشارة u'/u.",
      "يستنتج أن اتجاه تغير ln(u) يتبع u على مجال موجب.",
      "يرسم ln(x+a) بالانسحاب.",
      "يدرس ln(x²-1) على مجالين منفصلين.",
      "يبني جدول إشارة وجدول تغير.",
      "يتجنب إهمال المجال قبل الاشتقاق."
    ],
    "lesson_strategy": {
      "main_idea": "في ln(u): 0 للمجال، 1 للإشارة، وu'/u للمشتقة.",
      "bac_skill": "تحديد المجال، الإشارة، المشتقة، التغير والمقارب للدوال من الشكل ln(u).",
      "common_obstacle": "نسيان شرط u>0 أو نسيان u' في المشتقة."
    },
    "learning_path": [
      {
        "id": "step_1",
        "type": "motivation",
        "title": "كل شيء يبدأ من داخل ln",
        "content": {
          "teacher": "في الدالة \\(f(x)=\\ln(u(x))\\)، لا تبدأ بـln مباشرة. انظر أولًا إلى ما داخلها: هذه هي الدالة \\(u(x)\\). المجال، المشتقة، الإشارة والتغير كلها تعتمد على هذا الداخل.",
          "simple_model": "\\(x\\longrightarrow u(x)\\longrightarrow\\ln(u(x))\\)",
          "example": "في \\(\\ln(3x-1)\\) لدينا \\(u(x)=3x-1\\).",
          "central_idea": "حدد \\(u(x)\\) أولًا، ثم طبّق قواعد ln.",
          "memory_tip": "داخل ln أولًا.",
          "takeaway": "أول سؤال دائمًا: ما هي \\(u(x)\\)؟"
        }
      },
      {
        "id": "step_2",
        "type": "concept",
        "title": "المجال: داخل ln يجب أن يكون موجبًا",
        "content": {
          "teacher": "الدالة ln لا تقبل الصفر ولا الأعداد السالبة. لذلك مجال \\(\\ln(u(x))\\) نحصل عليه من الشرط \\(u(x)>0\\).",
          "rule": "\\[\\boxed{D_{\\ln(u)}=\\{x\\in D_u\\mid u(x)>0\\}}\\]",
          "examples": [
            "\\(\\ln(x-4)\\): نحل \\(x-4>0\\Rightarrow x>4\\).",
            "\\(\\ln(x^2)\\): نحل \\(x^2>0\\Rightarrow x\\ne0\\).",
            "\\(\\ln(4-x^2)\\): نحل \\(4-x^2>0\\Rightarrow -2<x<2\\)."
          ],
          "attention": "الشرط هو \\(u(x)>0\\)، وليس فقط \\(u(x)\\ne0\\).",
          "memory_tip": "مجال ln(u): الداخل موجب تمامًا.",
          "takeaway": "ابدأ المجال بحل \\(u(x)>0\\)."
        }
      },
      {
        "id": "step_3",
        "type": "worked_example",
        "title": "أمثلة سريعة على المجال",
        "content": {
          "teacher": "طريقة الحل واحدة، لكن شكل المجال يتغير حسب \\(u(x)\\).",
          "examples": [
            {
              "function": "\\(f(x)=\\ln(x+1)\\)",
              "condition": "\\(x+1>0\\)",
              "domain": "\\(]-1,+\\infty[\\)"
            },
            {
              "function": "\\(g(x)=\\ln(x^2)\\)",
              "condition": "\\(x^2>0\\)",
              "domain": "\\(\\mathbb R^*\\)"
            },
            {
              "function": "\\(h(x)=\\ln(x^2-1)\\)",
              "condition": "\\(x^2-1>0\\)",
              "domain": "\\(]-\\infty,-1[\\cup]1,+\\infty[\\)"
            }
          ],
          "attention": "قد يكون المجال مجالًا واحدًا أو اتحاد مجالين.",
          "takeaway": "حل \\(u>0\\) كما تحل أي متراجحة أو جدول إشارة."
        }
      },
      {
        "id": "step_4",
        "type": "concept",
        "title": "إشارة ln(u): قارن u بالعدد 1",
        "content": {
          "teacher": "بعد أن نتأكد أن \\(u(x)>0\\)، نحدد إشارة \\(\\ln(u(x))\\) بمقارنة \\(u(x)\\) بالعدد 1.",
          "rule": [
            "\\[\\ln(u(x))<0\\iff0<u(x)<1\\]",
            "\\[\\ln(u(x))=0\\iff u(x)=1\\]",
            "\\[\\ln(u(x))>0\\iff u(x)>1\\]"
          ],
          "simple_explanation": "لأن ln متزايدة و\\(\\ln(1)=0\\).",
          "attention": "كون \\(u>0\\) لا يعني أن \\(\\ln(u)>0\\).",
          "memory_tip": "0 للمجال، 1 للإشارة.",
          "takeaway": "المجال من \\(u>0\\)، والإشارة من مقارنة \\(u\\) بـ1."
        }
      },
      {
        "id": "step_5",
        "type": "method",
        "title": "المعادلات والمتراجحات من الشكل ln(u)",
        "content": {
          "teacher": "بعد كتابة المجال، نستعمل أن ln وexp دالتان متعاكستان وأن ln متزايدة.",
          "algorithm": [
            "حدد المجال من \\(u(x)>0\\).",
            "\\(\\ln(u)=a\\iff u=e^a\\).",
            "\\(\\ln(u)<a\\iff u<e^a\\) داخل المجال.",
            "\\(\\ln(u)>a\\iff u>e^a\\) داخل المجال.",
            "في النهاية خذ تقاطع الحل مع المجال."
          ],
          "worked_example": {
            "question": "حل \\(\\ln(2x-1)=2\\).",
            "steps": [
              "\\(2x-1>0\\Rightarrow x>1/2\\).",
              "\\(2x-1=e^2\\).",
              "\\(x=(1+e^2)/2\\)."
            ],
            "final_answer": "\\(S=\\{(1+e^2)/2\\}\\)."
          },
          "attention": "لا تنس المجال بعد حل المعادلة.",
          "takeaway": "المجال أولًا، ثم نحذف ln باستعمال exp."
        }
      },
      {
        "id": "step_6",
        "type": "definition",
        "title": "مشتقة ln(u(x))",
        "content": {
          "teacher": "مشتقة ln للدالة المركبة بسيطة: مشتقة الداخل في البسط، والداخل نفسه في المقام.",
          "rule": "\\[\\boxed{(\\ln(u(x)))'=\\frac{u'(x)}{u(x)}}\\qquad u(x)>0\\]",
          "method": [
            "حدد \\(u(x)\\).",
            "احسب \\(u'(x)\\).",
            "اكتب \\(u'(x)/u(x)\\)."
          ],
          "examples": [
            "\\((\\ln(3x+1))'=\\frac{3}{3x+1}\\).",
            "\\((\\ln(x^2+1))'=\\frac{2x}{x^2+1}\\)."
          ],
          "attention": "نسيان \\(u'(x)\\) من أكثر الأخطاء شيوعًا.",
          "memory_tip": "u شرطة على u.",
          "takeaway": "\\((\\ln u)'=u'/u\\)."
        }
      },
      {
        "id": "step_7",
        "type": "worked_example",
        "title": "اشتقاق ln(u) خطوة بخطوة",
        "content": {
          "teacher": "في كل مثال نكتب المجال ثم \\(u\\) ثم \\(u'\\) ثم المشتقة.",
          "examples": [
            {
              "function": "\\(f(x)=\\ln(x+2)\\)",
              "domain": "\\(x>-2\\)",
              "inner": "\\(u=x+2\\)",
              "inner_derivative": "\\(u'=1\\)",
              "derivative": "\\(f'(x)=1/(x+2)\\)"
            },
            {
              "function": "\\(g(x)=\\ln(x^2+1)\\)",
              "domain": "\\(\\mathbb R\\)",
              "inner": "\\(u=x^2+1\\)",
              "inner_derivative": "\\(u'=2x\\)",
              "derivative": "\\(g'(x)=2x/(x^2+1)\\)"
            },
            {
              "function": "\\(h(x)=\\ln(4-x^2)\\)",
              "domain": "\\(]-2,2[\\)",
              "inner": "\\(u=4-x^2\\)",
              "inner_derivative": "\\(u'=-2x\\)",
              "derivative": "\\(h'(x)=-2x/(4-x^2)\\)"
            }
          ],
          "takeaway": "رتب الحل: المجال → u → u' → u'/u."
        }
      },
      {
        "id": "step_8",
        "type": "concept",
        "title": "اتجاه تغير ln(u)",
        "content": {
          "teacher": "على مجال \\(\\ln(u)\\) لدينا \\(u(x)>0\\)، أي أن مقام المشتقة موجب. لذلك إشارة \\(u'/u\\) هي نفس إشارة \\(u'\\).",
          "rule": "\\[\\boxed{\\operatorname{sgn}((\\ln u)')=\\operatorname{sgn}(u')}\\]",
          "consequences": [
            "إذا كانت \\(u'>0\\)، فإن \\(\\ln(u)\\) متزايدة.",
            "إذا كانت \\(u'<0\\)، فإن \\(\\ln(u)\\) متناقصة."
          ],
          "central_idea": "داخل المجال، ln تحفظ اتجاه تغير الدالة الداخلية.",
          "memory_tip": "المقام موجب، إذن ركز على \\(u'\\).",
          "takeaway": "تغير ln(u) يتبع تغير u على مجالها."
        }
      },
