    ],
    "learning_outcomes": [
      "يحدد الجملة الميكانيكية المدروسة ومركز عطالتها.",
      "يميز بين الجسم والمرجع والمعلم.",
      "يصف موضع الجسم باستعمال شعاع الموضع وإحداثياته.",
      "يميز بين المسار المستقيم والدائري والمنحني.",
      "يحدد خصائص شعاع السرعة.",
      "يحسب مركبات السرعة انطلاقًا من المعادلات الزمنية.",
      "يفهم معنى شعاع التسارع ويحسب مركباته.",
      "يستنتج طبيعة حركة بسيطة من السرعة والتسارع."
    ],
