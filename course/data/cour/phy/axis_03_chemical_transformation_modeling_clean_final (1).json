            },
            {
              "mistake": "الحصول على كمية سالبة",
              "correction": "راجع x والمحدد."
            },
            {
              "mistake": "استعمال xmax عند لحظة وسطية",
              "correction": "استعمل x(t)."
            },
            {
              "mistake": "نسيان mol",
              "correction": "اكتب الوحدة."
            }
          ],
          "key_ideas": [
            "x يقيس تقدم التفاعل.",
            "المعاملات تحدد التغيرات.",
            "المتفاعلات n₀-νx والنواتج n₀+νx.",
            "xmax أصغر n₀/ν.",
            "صاحب الأصغر هو المحد.",
            "الفائض تبقى كميته موجبة.",
            "في التحول التام xf=xmax.",
            "تركيب لحظة t يحسب بـx(t)."
          ],
          "method_template": [
            "حوّل إلى mol.",
            "أنشئ الجدول.",
            "احسب xmax.",
            "حدد المحد والفائض.",
            "استخرج xf.",
            "عوض.",
            "تحقق."
          ],
          "memory_tip": "حوّل، جدول، قارن، عوض، تحقق.",
          "takeaway": "جدول التقدم هو قلب المحور."
        }
      },
      {
