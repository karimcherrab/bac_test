    "axis_tag": "chemical_transformation_modeling",
    "axis_title": "نمذجة التحول الكيميائي",
    "lesson_goal": "أن يفهم التلميذ معنى تقدم التفاعل وجدول التقدم، ثم يحسب xmax وxf ويحدد المتفاعل المحد والفائض والتركيب المولي، حتى يحل أسئلة البكالوريا المتكررة.",
    "prerequisites": [
      "قراءة معادلة موزونة.",
      "معرفة كمية المادة ووحدتها mol.",
      "استعمال n=m/M وn=cV وn=Vg/VM.",
      "التمييز بين المتفاعلات والنواتج."
    ],
    "learning_outcomes": [
      "يفهم معنى تقدم التفاعل ووحدته.",
      "يحوّل المعطيات إلى كمية مادة بالمول.",
      "يبني جدول تقدم انطلاقًا من معادلة موزونة.",
      "يحسب التقدم الأعظمي ويحدد المتفاعل المحد والفائض.",
      "يميز بين التقدم النهائي والتقدم الأعظمي.",
      "يحسب التركيب المولي عند لحظة وفي النهاية."
    ],
    "lesson_intro": {
      "welcome": "سنفهم جدول التقدم بدل حفظه.",
      "big_idea": "كل تقدم x يغير الكميات حسب المعاملات.",
      "student_promise": "ستستطيع إنشاء الجدول وتحديد المحد وحساب التركيب النهائي."
    },
    "learning_path": [
      {
        "id": "step_1",
        "type": "motivation",
        "title": "لماذا نحتاج إلى نمذجة التحول الكيميائي؟",
        "content": {
          "teacher": "المعادلة الكيميائية تخبرنا من يتفاعل وماذا يتشكل، لكنها لا تخبرنا مباشرة كم بقي من كل نوع. لذلك نستعمل جدول التقدم لتحويل المعادلة إلى حسابات على كميات المادة.",
          "example": "في تفاعل معدن مع حمض نريد معرفة كمية المعدن المستهلكة وكمية الغاز المتشكلة.",
          "central_idea": "المعادلة تقول من يتفاعل، وجدول التقدم يقول كم يتغير.",
          "takeaway": "النمذجة = وصف كمي للتحول.",
          "memory_tip": "المعادلة: من؟ الجدول: كم؟"
        }
      },
      {
        "id": "step_2",
        "type": "concept",
        "title": "ماذا تعني معاملات المعادلة؟",
        "content": {
          "teacher": "في المعادلة \\(aA+bB\rightarrow cC+dD\\)، تحدد المعاملات نسب الاستهلاك والتشكل.",
          "general_equation": "\\(aA+bB\\rightarrow cC+dD\\)",
          "example": {
            "equation": "\\(2H_2+O_2\\rightarrow2H_2O\\)",
            "reading": "كل 2 mol من H₂ تتفاعل مع 1 mol من O₂ فتتشكل 2 mol من H₂O."
          },
          "attention": "المعامل نسبة ثابتة في المعادلة، وليس كمية المادة الابتدائية.",
          "takeaway": "المعاملات تحدد نسب التغير."
        }
      },
      {
        "id": "step_3",
        "type": "definition",
        "title": "ما هو تقدم التفاعل x؟",
        "content": {
          "teacher": "تقدم التفاعل \\(x\\) مقدار بوحدة mol يقيس مدى حدوث التفاعل. يبدأ من الصفر ويزداد حتى يصل إلى قيمة نهائية.",
          "states": [
            {
              "state": "ابتدائية",
              "value": "\\(x=0\\)"
            },
            {
              "state": "أثناء التحول",
              "value": "\\(0<x<x_f\\)"
            },
            {
              "state": "نهائية",
              "value": "\\(x=x_f\\)"
            }
          ],
          "attention": "x ليس زمنًا؛ وحدته mol.",
          "takeaway": "x عداد لتقدم التفاعل."
        }
      },
      {
        "id": "step_4",
        "type": "concept",
        "title": "كيف تتغير كميات المادة بدلالة x؟",
        "content": {
          "teacher": "المتفاعلات تُستهلك فتنقص، والنواتج تتشكل فتزداد. مقدار التغير يساوي المعامل مضروبًا في x.",
          "relations": [
            "\\(n(A)=n_0(A)-ax\\)",
            "\\(n(B)=n_0(B)-bx\\)",
            "\\(n(C)=n_0(C)+cx\\)",
            "\\(n(D)=n_0(D)+dx\\)"
          ],
          "sign_rule": "المتفاعل ناقص، والناتج زائد.",
          "takeaway": "متفاعل −، ناتج +، والمعامل يضرب في x."
        }
      },
      {
        "id": "step_5",
        "type": "table",
        "title": "البنية العامة لجدول التقدم",
        "content": {
          "teacher": "يتكون جدول التقدم من ثلاث حالات: ابتدائية، أثناء التحول، ونهائية.",
          "table": {
            "equation": "\\(aA+bB\\rightarrow cC+dD\\)",
            "rows": [
              {
                "state": "ابتدائية",
                "progress": "0",
                "A": "n₀(A)",
                "B": "n₀(B)",
                "C": "0",
                "D": "0"
              },
              {
                "state": "أثناء",
                "progress": "x",
                "A": "n₀(A)-ax",
                "B": "n₀(B)-bx",
                "C": "cx",
                "D": "dx"
              },
              {
                "state": "نهائية",
                "progress": "x_f",
                "A": "n₀(A)-ax_f",
                "B": "n₀(B)-bx_f",
                "C": "cx_f",
                "D": "dx_f"
              }
            ]
          },
          "takeaway": "ابتدائي، أثناء، نهائي."
        }
      },
      {
        "id": "step_6",
        "type": "method",
        "title": "حساب كميات المادة الابتدائية",
        "content": {
          "teacher": "قبل الجدول نحول جميع المعطيات إلى كمية مادة بالمول.",
          "formulas": [
            {
              "case": "كتلة",
              "formula": "\\(n=\\frac{m}{M}\\)"
            },
            {
              "case": "محلول",
              "formula": "\\(n=cV\\)"
            },
            {
              "case": "غاز",
              "formula": "\\(n=\\frac{V_g}{V_M}\\)"
            },
            {
              "case": "جسيمات",
              "formula": "\\(n=\\frac{N}{N_A}\\)"
            }
          ],
          "unit_attention": [
            "حوّل mL إلى L في n=cV.",
            "استعمل وحدات متوافقة في Vg وVM."
          ],
          "takeaway": "حوّل إلى mol قبل الجدول."
        }
      },
      {
        "id": "step_7",
        "type": "worked_example",
        "title": "مثال موجه: بناء جدول تقدم",
        "content": {
          "teacher": "نتفاعل 0.10 mol من Fe مع 0.30 mol من H₃O⁺ وفق: \\(Fe+2H_3O^+\\rightarrow Fe^{2+}+H_2+2H_2O\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "المعاملات",
              "result": "Fe:1، H₃O⁺:2، Fe²⁺:1، H₂:1"
            },
            {
              "step_number": 2,
              "title": "ابتدائي",
              "result": "0.10، 0.30، 0، 0"
            },
            {
              "step_number": 3,
              "title": "أثناء",
              "result": "0.10-x، 0.30-2x، x، x"
            }
          ],
          "progress_table": {
            "columns": [
              "الحالة",
              "x",
              "Fe",
              "H₃O⁺",
              "Fe²⁺",
              "H₂"
            ],
            "rows": [
              [
                "ابتدائية",
                "0",
                "0.10",
                "0.30",
                "0",
                "0"
              ],
              [
                "أثناء",
                "x",
                "0.10-x",
                "0.30-2x",
                "x",
                "x"
              ],
              [
                "نهائية",
                "x_f",
                "0.10-x_f",
                "0.30-2x_f",
                "x_f",
                "x_f"
              ]
            ],
            "unit": "mol"
          },
          "takeaway": "اقرأ المعامل ثم ضع الإشارة الصحيحة."
        }
      },
      {
        "id": "step_8",
        "type": "method",
        "title": "التقدم الأعظمي والمتفاعل المحد والفائض",
        "content": {
          "teacher": "لا يمكن أن تصبح كمية أي متفاعل سالبة. لذلك نحسب لكل متفاعل النسبة بين كميته الابتدائية ومعامله، ثم نأخذ أصغر قيمة.",
          "non_negative_conditions": [
            "\\(n_0(A)-ax\\ge0\\Rightarrow x\\le\\frac{n_0(A)}{a}\\)",
            "\\(n_0(B)-bx\\ge0\\Rightarrow x\\le\\frac{n_0(B)}{b}\\)"
          ],
          "xmax_definition": "\\(x_{max}=\\min\\left(\\frac{n_0(A)}{a},\\frac{n_0(B)}{b},...\\right)\\)",
          "limiting_reactant_rule": "المحدد = صاحب أصغر \\(\\frac{n_0}{\\nu}\\)",
          "excess_reactant_formula": "\\(n_f=n_0-\\nu x_{max}\\)",
          "worked_example": {
            "ratios": {
              "Fe": "0.10/1=0.10",
              "H3O+": "0.30/2=0.15",
              "conclusion": "Fe هو المحد."
            },
            "excess_calculation": {
              "calculation": "\\(n_f(H_3O^+)=0.30-2(0.10)=0.10\\,mol\\)",
              "conclusion": "H₃O⁺ فائض."
            }
          },
          "attention": "لا نقارن كميات المادة الابتدائية مباشرة؛ بل نقارن \\(n_0/\\nu\\).",
          "takeaway": "أصغر \\(n_0/\\nu\\) يعطي \\(x_{max}\\) ويحدد المتفاعل المحد، أما المتفاعل الآخر فهو فائض."
        }
      },
      {
        "id": "step_9",
        "type": "comparison",
        "title": "الفرق بين x_f وx_{max}",
        "content": {
          "teacher": "xmax قيمة نظرية من البداية، أما xf فهي القيمة الفعلية في النهاية.",
          "comparisons": [
            {
              "concept": "xmax",
              "meaning": "أكبر تقدم ممكن نظريًا",
              "source": "من n₀ والمعاملات"
            },
            {
              "concept": "xf",
              "meaning": "التقدم الفعلي النهائي",
              "source": "من قياس أو منحنى"
            }
          ],
          "cases": [
            "\\(x_f=x_{max}\\): تحول تام",
            "\\(x_f<x_{max}\\): تحول غير تام"
          ],
          "takeaway": "xmax نظري، xf فعلي."
        }
      },
      {
        "id": "step_10",
        "type": "method",
        "title": "استخراج x_f من قياس تجريبي",
        "content": {
          "teacher": "نكتب كمية النوع من القياس، ثم نساويها بعلاقتها في جدول التقدم.",
          "cases": [
            {
              "measured": "حجم غاز",
              "relation": "\\(n_g=\\frac{V_g}{V_M}=\\nu_g x\\)"
            },
            {
              "measured": "كتلة ناتج",
              "relation": "\\(\\frac{m}{M}=\\nu x\\)"
            },
            {
              "measured": "تركيز",
              "relation": "\\([X]V=n_0\\pm\\nu x\\)"
            }
          ],
          "algorithm": [
            "حدد النوع المقاس.",
            "حوّل القياس إلى كمية مادة.",
            "اكتب علاقة الجدول.",
            "ساوِ العبارتين.",
            "استنتج xf."
          ],
          "takeaway": "القياس + علاقة الجدول = xf."
        }
      },
      {
        "id": "step_11",
        "type": "worked_example",
        "title": "حساب التركيب المولي عند لحظة وفي النهاية",
        "content": {
          "teacher": "إذا عرفنا x(t)، نعوضه في سطر أثناء التحول للحصول على كمية كل نوع عند تلك اللحظة.",
          "general_rule": "\\(n_i(t)=n_{i,0}+\\nu_i x(t)\\)",
          "instant_example": {
            "given": "x(t)=0.04 mol",
            "results": [
              "n(Fe)=0.10-0.04=0.06 mol",
              "n(H₃O⁺)=0.30-2(0.04)=0.22 mol",
              "n(Fe²⁺)=0.04 mol",
              "n(H₂)=0.04 mol"
            ]
          },
          "attention": "في لحظة وسطية نستعمل x(t)، وليس xf أو xmax.",
          "complete_example": {
            "statement": "لدينا n₀(Mg)=0.080 mol وn₀(H₃O⁺)=0.120 mol، والتفاعل: \\(Mg+2H_3O^+\\rightarrow Mg^{2+}+H_2+2H_2O\\). التحول تام.",
            "steps": [
              {
                "step_number": 1,
                "title": "النسب",
                "calculation": "0.080/1=0.080 و0.120/2=0.060"
              },
              {
                "step_number": 2,
                "title": "xmax",
                "result": "0.060 mol"
              },
              {
                "step_number": 3,
                "title": "المحدد",
                "result": "H₃O⁺"
              },
              {
                "step_number": 4,
                "title": "التمام",
                "result": "xf=xmax=0.060 mol"
              },
              {
                "step_number": 5,
                "title": "النهائي",
                "results": [
                  "nf(Mg)=0.020 mol",
                  "nf(H₃O⁺)=0",
                  "nf(Mg²⁺)=0.060 mol",
                  "nf(H₂)=0.060 mol"
                ]
              }
            ]
          },
          "takeaway": "عند لحظة t نستعمل \\(x(t)\\)، وفي النهاية نستعمل \\(x_f\\)."
        }
      },
      {
        "id": "step_12",
        "type": "summary",
        "title": "منهجية الحل والخلاصة",
        "content": {
          "teacher": "كل سؤال في هذا المحور يعود إلى جدول التقدم.",
          "method": [
            "حوّل المعطيات إلى mol.",
            "أنشئ جدول التقدم.",
            "احسب xmax إذا طلب المحد.",
            "استخرج xf من القياس أو من تمام التحول.",
            "عوض في الجدول."
