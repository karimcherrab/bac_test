          "simple_model": "\\(\\text{قياس تجريبي}\\longrightarrow\\text{علاقة}\\longrightarrow x(t)\\)",
          "central_idea": "نفس التحول يمكن متابعته بقياسات مختلفة حسب التجربة.",
          "conditions": [
