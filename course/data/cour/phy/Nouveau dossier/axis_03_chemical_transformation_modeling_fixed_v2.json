      {
        "id": "step_8",
        "type": "method",
        "title": "التقدم الأعظمي والمتفاعل المحد والفائض",
        "content": {
          "teacher": "لا يمكن أن تصبح كمية أي متفاعل سالبة. لذلك نحسب لكل متفاعل النسبة بين كميته الابتدائية ومعامله، ثم نأخذ أصغر قيمة.",
          "non_negative_conditions": [
            "\\(n_0(A)-ax\\ge0\\Rightarrow x\\le\\frac{n_0(A)}{a}\\)",
            "\\(n_0(B)-bx\\ge0\\Rightarrow x\\le\\frac{n_0(B)}{b}\\)"
          ],
          "xmax_definition": "\\(x_{max}=\\min\\left(\\frac{n_0(A)}{a},\\frac{n_0(B)}{b},...\\right)\\)",
          "limiting_reactant_rule": "المحدد = صاحب أصغر \\(\\frac{n_0}{\\nu}\\)",
          "excess_reactant_formula": "\\(n_f=n_0-\\nu x_{max}\\)",
          "worked_example": {
            "ratios": {
              "Fe": "0.10/1=0.10",
              "H3O+": "0.30/2=0.15",
              "conclusion": "Fe هو المحد."
            },
            "excess_calculation": {
              "calculation": "\\(n_f(H_3O^+)=0.30-2(0.10)=0.10\\,mol\\)",
              "conclusion": "H₃O⁺ فائض."
            }
          },
          "attention": "لا نقارن كميات المادة الابتدائية مباشرة؛ بل نقارن \\(n_0/\\nu\\).",
          "takeaway": "أصغر قيمة لـ \\(\\frac{n_0}{\\nu}\\) تساوي \\(x_{max}\\) وتحدد المتفاعل المحد، أما المتفاعل الآخر فهو فائض."
        }
      },
      {
        "id": "step_9",
        "type": "comparison",
        "title": "الفرق بين التقدم النهائي والتقدم الأعظمي",
        "content": {
          "teacher": "\\(x_{max}\\) قيمة نظرية تحسب من الحالة الابتدائية، أما \\(x_f\\) فهو التقدم الفعلي عند نهاية التحول.",
          "comparisons": [
            {
              "concept": "\\(x_{max}\\)",
              "meaning": "أكبر تقدم ممكن نظريًا",
              "source": "يحسب من كميات المادة الابتدائية والمعاملات."
            },
            {
              "concept": "\\(x_f\\)",
              "meaning": "التقدم الفعلي في نهاية التحول",
              "source": "يستخرج من قياس تجريبي أو من معطى أن التحول تام."
