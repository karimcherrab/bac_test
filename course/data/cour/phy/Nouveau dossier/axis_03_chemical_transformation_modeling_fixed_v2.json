    "learning_path": [
      {
        "id": "step_1",
        "type": "motivation",
        "title": "لماذا نحتاج إلى نمذجة التحول الكيميائي؟",
        "content": {
          "teacher": "المعادلة الكيميائية تخبرنا من يتفاعل وماذا يتشكل، لكنها لا تخبرنا مباشرة كم بقي من كل نوع. لذلك نستعمل جدول التقدم لتحويل المعادلة إلى حسابات على كميات المادة.",
          "example": "في تفاعل معدن مع حمض نريد معرفة كمية المعدن المستهلكة وكمية الغاز المتشكلة.",
          "central_idea": "المعادلة تقول من يتفاعل، وجدول التقدم يقول كم يتغير.",
          "takeaway": "النمذجة = وصف كمي للتحول.",
          "memory_tip": "المعادلة: من؟ الجدول: كم؟"
        }
      },
      {
        "id": "step_2",
        "type": "concept",
        "title": "ماذا تعني معاملات المعادلة؟",
        "content": {
          "teacher": "بعد كتابة معادلة التفاعل موزونة على الشكل \\(aA+bB\\longrightarrow cC+dD\\)، تحدد المعاملات الستوكيومترية نسب استهلاك المتفاعلات وتشكل النواتج.",
          "general_equation": "\\(aA+bB\\longrightarrow cC+dD\\)",
          "example": {
            "equation": "\\(2H_2+O_2\\rightarrow2H_2O\\)",
            "reading": "كل 2 mol من H₂ تتفاعل مع 1 mol من O₂ فتتشكل 2 mol من H₂O."
          },
          "attention": "المعامل الستوكيومتري عدد ثابت مأخوذ من المعادلة الموزونة، ولا يمثل كمية المادة الابتدائية.",
          "takeaway": "المعاملات تحدد نسب التغير."
        }
      },
      {
        "id": "step_3",
        "type": "definition",
        "title": "ما هو تقدم التفاعل x؟",
        "content": {
          "teacher": "تقدم التفاعل \\(x\\) مقدار بوحدة mol يقيس مدى حدوث التفاعل. يبدأ من الصفر ويزداد حتى يصل إلى قيمة نهائية.",
          "states": [
            {
              "state": "ابتدائية",
              "value": "\\(x=0\\)"
            },
            {
              "state": "أثناء التحول",
              "value": "\\(0<x<x_f\\)"
            },
            {
              "state": "نهائية",
              "value": "\\(x=x_f\\)"
            }
          ],
          "attention": "x ليس زمنًا؛ وحدته mol.",
          "takeaway": "x عداد لتقدم التفاعل."
        }
      },
      {
        "id": "step_4",
        "type": "concept",
        "title": "كيف تتغير كميات المادة بدلالة x؟",
        "content": {
          "teacher": "المتفاعلات تُستهلك فتنقص، والنواتج تتشكل فتزداد. مقدار التغير يساوي المعامل مضروبًا في x.",
          "relations": [
            "\\(n(A)=n_0(A)-ax\\)",
            "\\(n(B)=n_0(B)-bx\\)",
            "\\(n(C)=n_0(C)+cx\\)",
            "\\(n(D)=n_0(D)+dx\\)"
          ],
          "sign_rule": "المتفاعل ناقص، والناتج زائد.",
          "takeaway": "متفاعل −، ناتج +، والمعامل يضرب في x."
        }
      },
      {
        "id": "step_5",
        "type": "table",
        "title": "البنية العامة لجدول التقدم",
        "content": {
          "teacher": "يتكون جدول التقدم من ثلاث حالات: ابتدائية، أثناء التحول، ونهائية.",
          "table": {
            "equation": "\\(aA+bB\\rightarrow cC+dD\\)",
            "rows": [
              {
                "state": "ابتدائية",
                "progress": "0",
                "A": "n₀(A)",
                "B": "n₀(B)",
                "C": "0",
                "D": "0"
              },
              {
                "state": "أثناء",
                "progress": "x",
                "A": "n₀(A)-ax",
                "B": "n₀(B)-bx",
                "C": "cx",
                "D": "dx"
              },
              {
                "state": "نهائية",
                "progress": "x_f",
                "A": "n₀(A)-ax_f",
                "B": "n₀(B)-bx_f",
                "C": "cx_f",
                "D": "dx_f"
              }
            ]
          },
          "takeaway": "ابتدائي، أثناء، نهائي."
        }
      },
      {
        "id": "step_6",
        "type": "method",
        "title": "تذكير: كمية المادة n وكيف نحسبها",
        "content": {
          "teacher": "قبل إنشاء جدول التقدم يجب تحويل كل المعطيات إلى كمية مادة نرمز لها بـ \\(n\\)، ووحدتها \\(\\mathrm{mol}\\). نختار القانون حسب نوع المعطى الموجود في التمرين.",
          "central_idea": "جدول التقدم لا يستعمل الكتلة أو الحجم أو التركيز مباشرة؛ بل يستعمل كمية المادة \\(n\\) بوحدة \\(\\mathrm{mol}\\).",
          "formulas_title": "قوانين حساب كمية المادة",
          "formulas": [
            {
              "case": "إذا أعطيت الكتلة",
              "formula": "\\(n=\\frac{m}{M}\\)",
              "symbols": "\\(m\\): الكتلة بالغرام، و\\(M\\): الكتلة المولية بـ \\(\\mathrm{g\\,mol^{-1}}\\)."
            },
            {
              "case": "إذا أعطي محلول",
              "formula": "\\(n=cV\\)",
              "symbols": "\\(c\\): التركيز المولي، و\\(V\\): حجم المحلول باللتر."
            },
            {
              "case": "إذا أعطي حجم غاز",
              "formula": "\\(n=\\frac{V_g}{V_M}\\)",
              "symbols": "\\(V_g\\): حجم الغاز، و\\(V_M\\): الحجم المولي في الشروط نفسها."
            },
            {
              "case": "إذا أعطي عدد الجسيمات",
              "formula": "\\(n=\\frac{N}{N_A}\\)",
              "symbols": "\\(N\\): عدد الجسيمات، و\\(N_A\\): ثابت أفوغادرو."
            }
          ],
          "unit_attention": [
            "في العلاقة \\(n=cV\\) نحول الحجم من \\(\\mathrm{mL}\\) إلى \\(\\mathrm{L}\\).",
            "في العلاقة \\(n=\\frac{V_g}{V_M}\\) يجب استعمال الوحدة نفسها للحجمين.",
            "النتيجة النهائية لكمية المادة تكتب دائمًا بوحدة \\(\\mathrm{mol}\\)."
          ],
          "worked_example": {
            "statement": "لدينا محلول تركيزه \\(c=0.20\\,\\mathrm{mol\\,L^{-1}}\\) وحجمه \\(V=50\\,\\mathrm{mL}\\). احسب كمية المادة.",
            "steps": [
              {
                "step_number": 1,
                "title": "تحويل الحجم إلى اللتر",
                "calculation": "\\(50\\,\\mathrm{mL}=0.050\\,\\mathrm{L}\\)"
              },
              {
                "step_number": 2,
                "title": "اختيار القانون",
                "calculation": "\\(n=cV\\)"
              },
              {
                "step_number": 3,
                "title": "التعويض",
                "calculation": "\\(n=0.20\\times0.050=1.0\\times10^{-2}\\,\\mathrm{mol}\\)"
              }
            ]
          },
          "takeaway": "قبل جدول التقدم: حدد نوع المعطى، اختر قانون \\(n\\)، حوّل الوحدات، ثم اكتب النتيجة بـ \\(\\mathrm{mol}\\)."
        }
      },
      {
        "id": "step_7",
        "type": "worked_example",
        "title": "مثال موجه: بناء جدول تقدم",
        "content": {
          "teacher": "نتفاعل 0.10 mol من Fe مع 0.30 mol من H₃O⁺ وفق: \\(Fe+2H_3O^+\\rightarrow Fe^{2+}+H_2+2H_2O\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "نقرأ المعاملات الستوكيومترية",
              "explanation": "نأخذ المعامل الموجود أمام كل نوع في المعادلة.",
