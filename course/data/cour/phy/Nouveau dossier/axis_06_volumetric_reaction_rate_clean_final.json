      {
        "id": "step_6",
        "type": "method",
        "title": "السرعة من تراكيز المتفاعلات والنواتج",
        "content": {
          "teacher": "عند ثبات الحجم، نحسب السرعة من تركيز أي نوع مع مراعاة الإشارة والمعامل.",
          "sign_rules": [
            "\\(v\\ge0\\)",
            "\\(d[A]/dt<0\\) لمتفاعل",
            "\\(d[C]/dt>0\\) لناتج"
          ],
          "relations": [
            "\\(v=-\\frac1a\\frac{d[A]}{dt}\\)",
            "\\(v=-\\frac1b\\frac{d[B]}{dt}\\)",
            "\\(v=\\frac1c\\frac{d[C]}{dt}\\)",
            "\\(v=\\frac1d\\frac{d[D]}{dt}\\)"
          ],
          "condition": "هذه العلاقات بدلالة التركيز تفترض ثبات حجم المزيج.",
          "reactant_example": {
            "statement": "في 2A+B→C، ميل مماس [A](t) يساوي -0.040 mol·L⁻¹·s⁻¹.",
            "steps": [
              {
                "step_number": 1,
                "calculation": "\\(v=-\\frac12d[A]/dt\\)"
              },
              {
                "step_number": 2,
                "calculation": "\\(v=-\\frac12(-0.040)=0.020mol.L^{-1}.s^{-1}\\)"
              }
            ]
          },
          "reactant_graph_method": [
            "اقرأ معامل A.",
            "احسب ميل المماس.",
            "اضرب في -1/a.",
            "اكتب الوحدة."
          ],
          "product_relation": "\\(v=\\frac1c\\frac{d[C]}{dt}\\)",
          "product_example": "في A→3C، إذا d[C]/dt=0.090 فإن v=0.030 mol·L⁻¹·s⁻¹.",
          "takeaway": "للمتفاعل نأخذ إشارة سالبة، وللناتج إشارة موجبة، ثم نقسم على المعامل."
        }
      },
      {
        "id": "step_7",
        "type": "method",
        "title": "السرعة من الحجم والضغط والناقلية والكتلة",
        "content": {
          "teacher": "عندما لا يعطى منحنى التقدم مباشرة، نكتب أولًا علاقة الكمية المقاسة بالتقدم ثم نشتقها بالنسبة للزمن.",
          "gas_method": {
            "derivation": [
              "\\(x=\\frac{V_g}{\\nu_gV_M}\\)",
              "\\(v=\\frac{1}{V\\nu_gV_M}\\frac{dV_g}{dt}\\)"
            ],
            "attention": "V حجم المزيج، Vg حجم الغاز، VM الحجم المولي."
          },
          "pressure_and_conductivity": [
            {
              "measurement": "الضغط",
              "relation": "\\(P=P_0+K_px\\)",
              "rate": "\\(v=\\frac{1}{VK_p}\\frac{dP}{dt}\\)"
            },
            {
              "measurement": "الناقلية",
              "relation": "\\(\\sigma=\\sigma_0+K_\\sigma x\\)",
              "rate": "\\(v=\\frac{1}{VK_\\sigma}\\frac{d\\sigma}{dt}\\)"
            }
          ],
          "pressure_attention": "إذا كان K سالبًا تكون مشتقة القياس سالبة لكن v موجبة.",
          "mass_method": {
            "derivation": [
              "\\(m_g=m_0-m(t)\\)",
              "\\(n_g=\\frac{m_0-m(t)}{M_g}=\\nu_gx\\)",
              "\\(v=-\\frac{1}{V\\nu_gM_g}\\frac{dm}{dt}\\)"
            ],
            "takeaway": "منحنى كتلة متناقص يعطي سرعة موجبة."
          },
          "takeaway": "اكتب العلاقة بالـx أولًا، ثم اشتق، ثم راع الحجم والمعامل والإشارة."
        }
