    "chapter_title": "المتابعة الزمنية لتطور تحول كيميائي",
    "axis_tag": "volumetric_reaction_rate",
    "axis_title": "السرعة الحجمية للتحول الكيميائي",
    "lesson_goal": "أن يفهم التلميذ السرعة الحجمية ويحسبها من منحنيات مختلفة باستعمال المماس والمعاملات الستوكيومترية والوحدات الصحيحة، حتى يحل أسئلة البكالوريا.",
    "prerequisites": [
      "فهم تقدم التفاعل \\(x(t)\\).",
      "معرفة طرق المتابعة الزمنية للتحول.",
      "قراءة منحنى واستخراج ميل قاطع أو مماس.",
      "التمييز بين حجم المزيج والحجم المقاس.",
      "تحويل \\(\\mathrm{mL}\\) إلى \\(\\mathrm{L}\\)."
    ],
    "learning_outcomes": [
      "يعرف السرعة الحجمية ووحدتها.",
      "يميز بين السرعة المتوسطة واللحظية.",
      "يستخرج ميل المماس من منحنى.",
      "يحسب السرعة من منحنى التقدم.",
      "يحسبها من تركيز متفاعل أو ناتج.",
      "يراعي الإشارة والمعامل الستوكيومتري.",
      "يحسبها من الحجم أو الضغط أو الناقلية أو الكتلة.",
      "يتحقق من الحجم والوحدة النهائية."
    ],
    "lesson_intro": {
      "welcome": "ستتعلم كيف تحول شكل المنحنى إلى سرعة عددية.",
      "big_idea": "الميل يخبرنا بسرعة التغير.",
      "student_promise": "ستحسب السرعة من مختلف منحنيات البكالوريا."
    },
    "learning_path": [
      {
        "id": "step_1",
        "type": "motivation",
        "title": "ماذا يعني أن تحولًا أسرع؟",
        "content": {
          "teacher": "التحول الأسرع يحقق مقدارًا أكبر من التقدم خلال المدة نفسها.",
          "example": "خلال 10 s: تفاعل يحقق 0.05 mol أسرع من تفاعل يحقق 0.02 mol.",
          "central_idea": "السرعة تقارن تغير التقدم بالزمن.",
          "takeaway": "سرعة التحول = تقدم خلال زمن."
        }
      },
      {
        "id": "step_2",
        "type": "definition",
        "title": "تعريف السرعة الحجمية ووحدتها",
        "content": {
          "teacher": "سرعة التفاعل هي dx/dt. والسرعة الحجمية هي سرعة التفاعل منسوبة إلى حجم المزيج.",
          "relations": [
            "\\(v_r=\\frac{dx}{dt}\\)",
            "\\(v_{vol}=\\frac{1}{V}\\frac{dx}{dt}\\)"
          ],
          "units": [
            "\\(mol.L^{-1}.s^{-1}\\)",
            "\\(mol.L^{-1}.min^{-1}\\)"
          ],
          "attention": "حوّل mL إلى L ووحّد وحدة الزمن.",
          "takeaway": "السرعة الحجمية هي معدل تقدم التفاعل في وحدة الزمن ووحدة الحجم."
        }
      },
      {
        "id": "step_3",
        "type": "method",
        "title": "السرعة المتوسطة والسرعة اللحظية",
        "content": {
          "teacher": "المتوسطة بين لحظتين، واللحظية عند لحظة واحدة.",
          "relations": [
            "\\(\\bar v=\\frac{1}{V}\\frac{x_2-x_1}{t_2-t_1}\\)",
            "\\(v(t)=\\frac{1}{V}\\frac{dx}{dt}\\)"
          ],
          "average_method": [
            "حدد x1 وx2.",
            "احسب Δx.",
            "احسب Δt.",
            "طبق Δx/(VΔt).",
            "اكتب الوحدة."
          ],
          "worked_example": "إذا x1=0.030 mol وx2=0.066 mol وV=0.200 L وΔt=30 s، فإن \\(\\bar v=6.0\\times10^{-3}mol.L^{-1}.s^{-1}\\).",
          "takeaway": "نستعمل القاطع للسرعة المتوسطة، والمماس للسرعة اللحظية."
        }
      },
      {
        "id": "step_4",
        "type": "worked_example",
        "title": "استخراج السرعة اللحظية من المماس",
        "content": {
          "teacher": "عند اللحظة المطلوبة نرسم المماس، نختار نقطتين واضحتين عليه، نحسب ميله، ثم نقسم على V.",
          "algorithm": [
            "حدد اللحظة.",
            "ارسم المماس.",
            "اختر نقطتين على المماس.",
            "احسب Δx/Δt.",
            "اقسم على V."
          ],
          "worked_example": {
            "statement": "مماس يمر بـA(20s,0.030mol) وB(60s,0.078mol)، وV=0.250L.",
            "steps": [
              {
                "step_number": 1,
                "title": "الميل",
                "calculation": "\\(dx/dt=(0.078-0.030)/(60-20)=1.2\\times10^{-3}mol.s^{-1}\\)"
              },
              {
                "step_number": 2,
                "title": "السرعة الحجمية",
                "calculation": "\\(v=1.2\\times10^{-3}/0.250=4.8\\times10^{-3}mol.L^{-1}.s^{-1}\\)"
              }
            ]
          },
          "takeaway": "نحسب ميل المماس أولًا، ثم نقسم على حجم المزيج."
        }
      },
