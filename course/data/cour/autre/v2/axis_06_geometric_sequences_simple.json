      },
      {
        "id": "step_15",
        "type": "concept",
        "title": "مجموع حدود متتالية هندسية",
        "content": {
          "teacher": "لجمع عدد كبير من الحدود الهندسية، نحتاج إلى ثلاثة أشياء: أول حد في المجموع، الأساس، وعدد الحدود.",
          "formula": "\\(\\boxed{S=u_p\\frac{1-q^N}{1-q}}\\quad(q\\ne1)\\)",
          "equivalent_formula": "يمكن أيضًا كتابة \\(S=u_p\\frac{q^N-1}{q-1}\\).",
          "number_of_terms": "إذا كان المجموع من \\(u_p\\) إلى \\(u_r\\)، فإن \\(N=r-p+1\\).",
          "special_case": "إذا كان \\(q=1\\)، فكل الحدود متساوية، وبالتالي \\(S=N\\times u_p\\).",
          "memory_tip": "أول حد × (1 - الأساس^عدد الحدود) ÷ (1 - الأساس).",
          "attention": "لا تخلط بين رتبة الحد الأخير وعدد الحدود.",
          "takeaway": "قبل قانون المجموع، احسب \\(N\\)."
        }
      },
      {
        "id": "step_16",
        "type": "method",
        "title": "منهجية حساب المجموع",
        "content": {
          "algorithm": [
            "1. حدد أول حد في المجموع.",
            "2. حدد الأساس \\(q\\).",
            "3. احسب عدد الحدود: رتبة الأخير - رتبة الأول + 1.",
            "4. تحقق هل \\(q=1\\) أم لا.",
            "5. إذا \\(q\\ne1\\)، طبق صيغة المجموع."
          ],
          "exam_tip": "اكتب عدد الحدود في سطر مستقل؛ هذا يمنع أغلب الأخطاء.",
          "takeaway": "أول حد + أساس + عدد الحدود."
        }
