      {
        "id": "step_10",
        "type": "method",
        "title": "كيف أحسب الأساس من حدين؟",
        "content": {
          "teacher": "إذا أعطاك التمرين حدين غير متتاليين، لا تقسمهما مباشرة. احسب أولًا عدد الانتقالات بينهما.",
          "formula": "\\(\\boxed{u_b=u_aq^{b-a}}\\)",
          "algorithm": [
            "1. احسب فرق الرتب \\(b-a\\).",
            "2. اكتب \\(u_b=u_aq^{b-a}\\).",
            "3. عوض قيم الحدين.",
            "4. حل المعادلة لإيجاد \\(q\\)."
          ],
          "attention": "\\(q=\\frac{u_b}{u_a}\\) مباشرة فقط عندما يكون الحدّان متتاليين.",
          "extra_attention": "إذا كان فرق الرتب زوجيًا، فقد تظهر قيمتان محتملتان للأساس ما لم يعط التمرين شرطًا إضافيًا مثل \\(q>0\\).",
          "takeaway": "في الهندسية: فرق الرتب يظهر في أس \\(q\\)."
        }
      },
      {
        "id": "step_11",
        "type": "worked_example",
        "title": "مثال: حساب الأساس وحد آخر",
        "content": {
          "statement": "متتالية هندسية تحقق \\(u_2=6\\) و\\(u_5=162\\)، مع \\(q>0\\). احسب \\(q\\)، ثم \\(u_7\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "نحسب فرق الرتب",
              "calculation": "\\(5-2=3\\).",
              "result": "هناك ثلاثة انتقالات."
            },
            {
              "step_number": 2,
              "title": "نربط الحدين",
              "calculation": "\\(u_5=u_2q^3\\Rightarrow162=6q^3\\).",
              "result": "\\(q^3=27\\)."
            },
            {
              "step_number": 3,
              "title": "نستخرج الأساس",
              "calculation": "\\(q=3\\).",
              "result": "الأساس موجب كما في المعطيات."
            },
            {
              "step_number": 4,
              "title": "نحسب \\(u_7\\)",
              "calculation": "\\(u_7=u_5q^{7-5}=162\\times3^2=1458\\).",
              "result": "\\(u_7=1458\\)."
            }
          ],
          "takeaway": "احسب فرق الرتب قبل أي تعويض."
        }
      },
      {
        "id": "step_12",
        "type": "property",
        "title": "اتجاه تغير المتتالية الهندسية الموجبة",
