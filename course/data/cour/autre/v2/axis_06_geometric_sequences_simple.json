      },
      {
        "id": "step_3",
        "type": "observation",
        "title": "كيف أتعرف على المتتالية الهندسية؟",
        "content": {
          "teacher": "إذا كانت الحدود غير منعدمة، نقسم كل حد على الحد السابق. إذا وجدنا النسبة نفسها دائمًا، فالمتتالية هندسية.",
          "examples": [
            {
              "sequence": "\\(3,6,12,24,\\ldots\\)",
              "calculation": "\\(6/3=2\\)، \\(12/6=2\\)، \\(24/12=2\\)",
              "conclusion": "هندسية أساسها \\(q=2\\)."
            },
            {
              "sequence": "\\(16,8,4,2,\\ldots\\)",
              "calculation": "\\(8/16=1/2\\)، \\(4/8=1/2\\)",
              "conclusion": "هندسية أساسها \\(q=1/2\\)."
            },
            {
              "sequence": "\\(1,3,6,10,\\ldots\\)",
              "calculation": "النسب ليست ثابتة.",
              "conclusion": "ليست هندسية."
            }
          ],
          "attention": "الملاحظة من حدود قليلة تساعد على الفهم، لكن البرهان العام يجب أن يكون صحيحًا لكل \\(n\\).",
          "takeaway": "ابحث عن النسبة الثابتة."
        }
      },
      {
        "id": "step_4",
        "type": "definition",
        "title": "التعريف والقاعدة الأساسية",
        "content": {
          "teacher": "نقول إن \\((u_n)\\) متتالية هندسية إذا كان الانتقال من كل حد إلى الحد الموالي يتم بالضرب في عدد ثابت \\(q\\).",
          "formulas": [
            "\\(u_{n+1}=q\\,u_n\\)",
            "إذا كان \\(u_n\\ne0\\): \\(\\frac{u_{n+1}}{u_n}=q\\)"
          ],
          "symbols": [
            {
              "symbol": "\\(q\\)",
              "meaning": "أساس المتتالية الهندسية."
            }
          ],
          "simple_cases": [
            "إذا \\(q=2\\)، نضاعف الحد كل مرة.",
            "إذا \\(q=\\frac12\\)، نأخذ نصف الحد كل مرة.",
            "إذا \\(q=-2\\)، تتغير الإشارة مع الضرب."
          ],
          "attention": "عند احتمال أن يكون \\(u_n=0\\)، لا تقسم عليه؛ استعمل العلاقة \\(u_{n+1}=qu_n\\).",
          "takeaway": "الأساس هو عامل الضرب الثابت."
        }
      },
      {
        "id": "step_5",
        "type": "method",
        "title": "كيف أثبت أن متتالية هندسية؟",
        "content": {
          "teacher": "في البكالوريا قد يطلب منك: «أثبت أن المتتالية هندسية». الفكرة هي الوصول إلى \\(u_{n+1}=q u_n\\) حيث \\(q\\) ثابت.",
          "algorithm": [
            "1. احسب \\(u_{n+1}\\).",
            "2. حاول كتابته على شكل عدد ثابت مضروبًا في \\(u_n\\).",
            "3. أو احسب \\(\\frac{u_{n+1}}{u_n}\\) إذا كان \\(u_n\\ne0\\).",
            "4. إذا حصلت على ثابت \\(q\\)، فالمتتالية هندسية أساسها \\(q\\)."
          ],
          "conclusion_template": "بما أن \\(u_{n+1}=q u_n\\) لكل \\(n\\)، فإن \\((u_n)\\) متتالية هندسية أساسها \\(q\\).",
          "takeaway": "إثبات الهندسية = إظهار عامل ضرب ثابت."
        }
      },
      {
        "id": "step_6",
        "type": "worked_example",
        "title": "مثال: إثبات أن المتتالية هندسية",
        "content": {
          "statement": "لتكن \\(u_n=5\\times3^n\\). أثبت أن \\((u_n)\\) هندسية وحدد أساسها.",
          "steps": [
            {
              "step_number": 1,
              "title": "نحسب الحد الموالي",
              "calculation": "\\(u_{n+1}=5\\times3^{n+1}\\).",
              "result": "نستعمل خاصية القوى."
            },
            {
              "step_number": 2,
              "title": "نفصل عاملًا ثابتًا",
              "calculation": "\\(u_{n+1}=5\\times3^n\\times3=3u_n\\).",
              "result": "ظهر عامل ثابت يساوي 3."
            },
            {
              "step_number": 3,
              "title": "نستنتج",
              "calculation": "\\(u_{n+1}=3u_n\\).",
              "result": "إذن المتتالية هندسية أساسها \\(q=3\\)."
            }
          ],
          "attention": "في \\(5\\times3^n\\)، الأساس هو \\(3\\) وليس \\(5\\).",
          "takeaway": "استعمل \\(q^{n+1}=q^n\\times q\\)."
        }
      },
      {
        "id": "step_7",
        "type": "concept",
        "title": "كيف نصل من حد معلوم إلى أي حد؟",
        "content": {
          "teacher": "إذا عرفنا حدًا \\(u_p\\) والأساس \\(q\\)، فإننا نضرب في \\(q\\) عددًا من المرات يساوي فرق الرتبتين.",
          "main_formula": "\\(\\boxed{u_n=u_pq^{n-p}}\\)",
          "meaning": "من الرتبة \\(p\\) إلى الرتبة \\(n\\) توجد \\(n-p\\) انتقالات.",
          "small_example": "من \\(u_3\\) إلى \\(u_8\\) توجد \\(8-3=5\\) انتقالات، لذلك \\(u_8=u_3q^5\\).",
          "memory_tip": "حد جديد = حد معلوم × الأساس^(عدد الانتقالات).",
          "takeaway": "الأس في الحد العام هو فرق الرتب."
        }
      },
      {
        "id": "step_8",
        "type": "special_case",
        "title": "البداية من \\(u_0\\) أو \\(u_1\\)",
        "content": {
          "teacher": "هذه نقطة مهمة جدًا. لا تستعمل نفس الأس في الحالتين.",
          "table": {
            "headers": [
              "الحد المعلوم",
              "الصيغة"
            ],
            "rows": [
              [
                "\\(u_0\\)",
                "\\(u_n=u_0q^n\\)"
              ],
              [
                "\\(u_1\\)",
                "\\(u_n=u_1q^{n-1}\\)"
              ],
              [
                "\\(u_p\\)",
                "\\(u_n=u_pq^{n-p}\\)"
              ]
            ]
          },
          "example": "إذا \\(u_1=4\\) و\\(q=2\\)، فإن \\(u_5=4\\times2^{5-1}=64\\).",
          "attention": "لا تكتب \\(u_n=u_1q^n\\).",
          "takeaway": "إذا خفت من الخطأ، استعمل دائمًا \\(u_n=u_pq^{n-p}\\)."
        }
      },
      {
        "id": "step_9",
        "type": "worked_example",
        "title": "مثال: إيجاد الحد العام",
        "content": {
          "statement": "متتالية هندسية أساسها \\(q=\\frac12\\) وتحقق \\(u_3=16\\). أوجد \\(u_n\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "نحدد الحد المعلوم",
              "calculation": "الحد المعلوم هو \\(u_3\\).",
              "result": "إذن \\(p=3\\)."
