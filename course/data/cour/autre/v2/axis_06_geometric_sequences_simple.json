            {
              "step_number": 2,
              "title": "نطبق الصيغة",
              "calculation": "\\(u_n=u_3q^{n-3}\\).",
              "result": "نحافظ على فرق الرتب."
            },
            {
              "step_number": 3,
              "title": "نعوض",
              "calculation": "\\(u_n=16\\left(\\frac12\\right)^{n-3}\\).",
              "result": "هذا هو الحد العام."
