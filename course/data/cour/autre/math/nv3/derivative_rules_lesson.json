      {
        "id": "step_2",
        "type": "reference_table",
        "title": "مشتقات الدوال المألوفة",
        "content": {
          "teacher": "هذه القواعد يجب أن تصبح مرجعًا سريعًا عند التلميذ.",
          "rules": [
            {
              "function": "\\(f(x)=k\\)",
              "derivative": "\\(f'(x)=0\\)",
              "domain": "\\(\\mathbb{R}\\)",
              "note": "k ثابت حقيقي."
            },
            {
              "function": "\\(f(x)=x\\)",
              "derivative": "\\(f'(x)=1\\)",
              "domain": "\\(\\mathbb{R}\\)"
            },
            {
              "function": "\\(f(x)=x^n\\)",
              "derivative": "\\(f'(x)=nx^{n-1}\\)",
              "domain": "\\(\\mathbb{R}\\)",
              "condition": "\\(n\\in\\mathbb{N},\\ n\\ge2\\)"
            },
            {
              "function": "\\(f(x)=\\frac1x\\)",
              "derivative": "\\(f'(x)=-\\frac1{x^2}\\)",
              "domain": "\\(\\mathbb{R}\\setminus\\{0\\}\\)"
            },
            {
              "function": "\\(f(x)=\\sqrt{x}\\)",
              "derivative": "\\(f'(x)=\\frac1{2\\sqrt{x}}\\)",
              "domain": "\\(]0,+\\infty[\\)"
            },
            {
              "function": "\\(f(x)=\\cos x\\)",
              "derivative": "\\(f'(x)=-\\sin x\\)",
              "domain": "\\(\\mathbb{R}\\)"
            },
            {
              "function": "\\(f(x)=\\sin x\\)",
              "derivative": "\\(f'(x)=\\cos x\\)",
              "domain": "\\(\\mathbb{R}\\)"
            }
          ],
          "memory_tip": "الثابت يختفي، وقوة x تنزل معاملًا وينقص الأس بواحد.",
          "attention": "مشتقة الجذر مكتوبة على المجال المفتوح ]0,+∞[.",
          "quick_check": {
            "question": "ما مشتقة \\(x^5\\)؟",
            "answer": "\\(5x^4\\)."
          }
        }
      },
      {
        "id": "step_3",
        "type": "concept",
        "title": "مجال الاشتقاق قبل الحساب",
        "content": {
          "teacher": "قبل اشتقاق الدالة يجب التأكد من المجال الذي تكون عليه العبارات المعرفة والقابلة للاشتقاق.",
          "examples": [
            {
              "function": "\\(\\frac1x\\)",
              "restriction": "\\(x\\ne0\\)"
            },
            {
              "function": "\\(\\sqrt{x}\\)",
              "restriction": "\\(x>0\\) عند استعمال صيغة المشتقة."
            },
            {
              "function": "\\(\\frac{u(x)}{v(x)}\\)",
              "restriction": "\\(v(x)\\ne0\\)"
            }
          ],
          "why": "قد تكون عبارة الدالة معرفة في نقطة لكن صيغة مشتقتها تحتاج مجالًا أضيق.",
          "how_to_think": "حدد القيم الممنوعة وشروط الجذر والمقام.",
          "attention": "لا تكتب مشتقة دون ذكر المجال عندما يكون فيه منع.",
          "quick_check": {
            "question": "ما الشرط الأساسي لاشتقاق خارج u/v؟",
            "answer": "\\(v(x)\\ne0\\)."
          }
        }
      },
      {
        "id": "step_4",
        "type": "rule",
        "title": "مشتقة مجموع ومضاعف ثابت",
        "content": {
          "teacher": "إذا كانت u وv قابلتين للاشتقاق، فإن مشتقة المجموع هي مجموع المشتقتين، والثابت يبقى عاملًا.",
          "rules": [
            "\\((u+v)'=u'+v'\\)",
            "\\((ku)'=ku'\\)"
          ],
          "why": "الاشتقاق يحافظ على الجمع، والثابت لا يتغير.",
          "how_to_think": "اشتق كل حد على حدة.",
          "attention": "لا تشتق الثابت k؛ يبقى كما هو.",
          "quick_check": {
            "question": "ما مشتقة \\(3u(x)+v(x)\\)؟",
            "answer": "\\(3u'(x)+v'(x)\\)."
          }
        }
      },
      {
        "id": "step_5",
        "type": "worked_example",
        "title": "مثال على المجموع",
        "content": {
          "statement": "احسب مشتقة \\(f(x)=-\\frac12x^3+3x^2-x+3\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "نشتق كل حد",
              "calculation": "\\((-\\frac12x^3)'=-\\frac32x^2\\)",
              "result": "استعملنا قاعدة القوة."
            },
            {
              "step_number": 2,
              "title": "نكمل الحدود",
              "calculation": "\\((3x^2)'=6x,\\quad(-x)'=-1,\\quad(3)'=0\\)",
              "result": "اشتققنا كل حد مستقلًا."
            },
            {
              "step_number": 3,
              "title": "نجمع النتائج",
              "calculation": "\\(f'(x)=-\\frac32x^2+6x-1\\)",
              "result": "هذه هي الدالة المشتقة."
            }
          ],
          "final_conclusion": "\\(f'(x)=-\\frac32x^2+6x-1\\).",
          "attention": "لا تنس أن مشتقة الثابت تساوي صفرًا."
        }
      },
      {
        "id": "step_6",
        "type": "rule",
        "title": "مشتقة الجداء",
        "content": {
          "teacher": "مشتقة الجداء ليست جداء المشتقتين.",
          "rule": "\\((uv)'=u'v+uv'\\)",
          "reading": "مشتقة الأول في الثاني، زائد الأول في مشتقة الثاني.",
          "why": "يتغير العاملان معًا، لذلك تظهر مساهمتان.",
          "how_to_think": "اكتب سطرًا يحدد u وv ثم طبق القاعدة بترتيب.",
          "attention": "الخطأ الشائع هو كتابة \\((uv)'=u'v'\\)، وهذا غير صحيح.",
          "quick_check": {
            "question": "ما مشتقة \\(u(x)v(x)\\)؟",
            "answer": "\\(u'v+uv'\\)."
          }
        }
      },
      {
        "id": "step_7",
        "type": "worked_example",
        "title": "مثال على الجداء",
        "content": {
          "statement": "احسب مشتقة \\(g(x)=(x+1)\\sqrt{x}\\) على \\(]0,+\\infty[\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "نحدد العاملين",
              "calculation": "\\(u(x)=x+1,\\quad v(x)=\\sqrt{x}\\)",
              "result": "\\(u'(x)=1,\\quad v'(x)=\\frac1{2\\sqrt{x}}\\)."
            },
            {
              "step_number": 2,
              "title": "نطبق قاعدة الجداء",
              "calculation": "\\(g'(x)=1\\cdot\\sqrt{x}+(x+1)\\frac1{2\\sqrt{x}}\\)",
              "result": "طبقنا u'v+uv'."
            },
            {
              "step_number": 3,
              "title": "نوحد المقام",
              "calculation": "\\(g'(x)=\\frac{2x+x+1}{2\\sqrt{x}}=\\frac{3x+1}{2\\sqrt{x}}\\)",
              "result": "الصيغة النهائية."
            }
          ],
          "final_conclusion": "\\(g'(x)=\\frac{3x+1}{2\\sqrt{x}}\\) على \\(]0,+\\infty[\\).",
          "attention": "حدد المجال قبل استعمال مشتقة الجذر."
        }
      },
      {
        "id": "step_8",
        "type": "rule",
        "title": "مشتقة المقلوب",
        "content": {
          "teacher": "إذا كانت u قابلة للاشتقاق ولا تنعدم، فإن مشتقة مقلوبها تعطى بالقاعدة التالية.",
          "rule": "\\(\\left(\\frac1u\\right)'=-\\frac{u'}{u^2}\\)",
          "condition": "\\(u(x)\\ne0\\)",
          "why": "الإشارة سالبة والمقام مربع.",
          "how_to_think": "اكتب: ناقص مشتقة الداخل على مربع الداخل.",
          "attention": "لا تنس المربع في المقام.",
          "quick_check": {
            "question": "ما مشتقة \\(1/u(x)\\)؟",
            "answer": "\\(-u'(x)/u(x)^2\\)."
          }
        }
      },
      {
        "id": "step_9",
        "type": "rule",
        "title": "مشتقة خارج دالتين",
        "content": {
          "teacher": "إذا كانت u وv قابلتين للاشتقاق وv لا تنعدم، فإن مشتقة الخارج تعطى بالقانون التالي.",
          "rule": "\\(\\left(\\frac uv\\right)'=\\frac{u'v-v'u}{v^2}\\)",
          "condition": "\\(v(x)\\ne0\\)",
          "reading": "مشتقة البسط في المقام، ناقص مشتقة المقام في البسط، على مربع المقام.",
          "why": "ترتيب الحدين مهم بسبب الإشارة السالبة.",
          "how_to_think": "ابدأ دائمًا بـ u'v ثم اطرح v'u.",
          "attention": "لا تعكس الحدين في البسط.",
          "quick_check": {
            "question": "ما مقام مشتقة u/v؟",
            "answer": "\\(v^2\\)."
          }
        }
      },
      {
        "id": "step_10",
        "type": "worked_example",
        "title": "مثال على الخارج",
        "content": {
          "statement": "احسب مشتقة \\(h(x)=\\frac{\\sin x}{x}\\) على \\(\\mathbb{R}\\setminus\\{0\\}\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "نحدد البسط والمقام",
              "calculation": "\\(u(x)=\\sin x,\\quad v(x)=x\\)",
              "result": "\\(u'(x)=\\cos x,\\quad v'(x)=1\\)."
            },
            {
              "step_number": 2,
              "title": "نطبق قاعدة الخارج",
              "calculation": "\\(h'(x)=\\frac{x\\cos x-1\\cdot\\sin x}{x^2}\\)",
              "result": "طبقنا u'v-v'u."
            },
            {
              "step_number": 3,
              "title": "نكتب النتيجة",
              "calculation": "\\(h'(x)=\\frac{x\\cos x-\\sin x}{x^2}\\)",
              "result": "الصيغة النهائية."
            }
          ],
          "final_conclusion": "\\(h'(x)=\\frac{x\\cos x-\\sin x}{x^2}\\).",
          "attention": "المجال يستثني الصفر."
        }
      },
      {
        "id": "step_11",
        "type": "concept",
        "title": "الدالة المركبة",
        "content": {
          "teacher": "عندما تكون الدالة على الشكل v(u(x))، فإننا نشتق الدالة الخارجية عند u(x)، ثم نضرب في مشتقة الدالة الداخلية.",
          "rule": "\\((v\\circ u)'(x)=v'(u(x))\\,u'(x)\\)",
          "reading": "مشتقة الخارج مع إبقاء الداخل، ثم الضرب في مشتقة الداخل.",
          "why": "التغير يمر عبر مرحلتين: تغير u ثم تغير v.",
          "how_to_think": "حدد الداخل أولًا، ثم الخارج.",
          "attention": "نسيان u'(x) هو الخطأ الأشهر في الدوال المركبة.",
          "quick_check": {
            "question": "ما العامل الذي يجب ألا ننساه في مشتقة v(u(x))؟",
            "answer": "\\(u'(x)\\)."
          }
        }
      },
      {
        "id": "step_12",
        "type": "rule",
        "title": "مشتقة u(ax+b)",
        "content": {
          "teacher": "إذا كانت u قابلة للاشتقاق، فإن تركيبها مع دالة خطية يعطي قاعدة خاصة سهلة.",
          "rule": "\\(\\frac{d}{dx}u(ax+b)=a\\,u'(ax+b)\\)",
          "examples": [
            "\\((\\sin(ax+b))'=a\\cos(ax+b)\\)",
            "\\((\\cos(ax+b))'=-a\\sin(ax+b)\\)"
          ],
          "why": "مشتقة الداخل ax+b هي a.",
          "how_to_think": "اشتق الدالة المعتادة ثم اضرب في a.",
          "attention": "لا تنس معامل x الموجود داخل القوس.",
          "quick_check": {
            "question": "ما مشتقة \\(\\sin(3x-1)\\)؟",
            "answer": "\\(3\\cos(3x-1)\\)."
          }
        }
      },
      {
        "id": "step_13",
        "type": "rule",
        "title": "مشتقة الجذر المركب",
        "content": {
          "teacher": "إذا كانت u موجبة وقابلة للاشتقاق، فإن مشتقة جذرها تعتمد على مشتقة u.",
          "rule": "\\((\\sqrt{u})'=\\frac{u'}{2\\sqrt{u}}\\)",
          "condition": "\\(u(x)>0\\)",
          "why": "هذه تطبيق مباشر لقاعدة تركيب الدوال.",
          "how_to_think": "مشتقة الداخل على ضعفي جذر الداخل.",
          "attention": "لا تكتب \\(1/(2\\sqrt{u'})\\).",
          "quick_check": {
            "question": "أين تظهر u' في القاعدة؟",
            "answer": "في البسط."
          }
        }
      },
      {
        "id": "step_14",
        "type": "rule",
        "title": "مشتقة قوة دالة",
        "content": {
          "teacher": "إذا كانت u قابلة للاشتقاق، فإن مشتقة u^n تجمع بين قاعدة القوة وقاعدة التركيب.",
          "rule": "\\((u^n)'=n\\,u'\\,u^{n-1}\\)",
          "condition": "\\(n\\in\\mathbb{N},\\ n\\ge2\\)",
          "why": "ننزل الأس وننقصه بواحد ثم نضرب في مشتقة الداخل.",
          "how_to_think": "الأس، ثم u'، ثم u مرفوعة للأس ناقص واحد.",
          "attention": "لا تنس u'.",
          "quick_check": {
            "question": "ما مشتقة \\((x^2+1)^3\\)؟",
            "answer": "\\(6x(x^2+1)^2\\)."
          }
        }
      },
      {
        "id": "step_15",
        "type": "rule",
        "title": "مشتقة مقلوب قوة دالة",
        "content": {
          "teacher": "للدالة 1/u^n قاعدة مباشرة عندما u لا تنعدم.",
          "rule": "\\(\\left(\\frac1{u^n}\\right)'=-\\frac{n\\,u'}{u^{n+1}}\\)",
          "condition": "\\(u(x)\\ne0\\)",
          "why": "تجمع القاعدة بين مشتقة القوة ومشتقة المقلوب.",
          "how_to_think": "ناقص n في u' على u للأس n+1.",
          "attention": "الأس في المقام يصبح n+1.",
          "quick_check": {
            "question": "ما مشتقة \\(1/u^3\\)؟",
            "answer": "\\(-3u'/u^4\\)."
          }
        }
      },
      {
        "id": "step_16",
        "type": "worked_example",
        "title": "مثال على دالة مركبة",
        "content": {
          "statement": "احسب مشتقة \\(f(x)=(2x^2-x+3)^4\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "نحدد الداخل",
              "calculation": "\\(u(x)=2x^2-x+3\\)",
              "result": "\\(u'(x)=4x-1\\)."
            },
            {
              "step_number": 2,
              "title": "نطبق قاعدة القوة المركبة",
              "calculation": "\\(f'(x)=4u'(x)u(x)^3\\)",
              "result": "استعملنا (u^n)'=nu'u^{n-1}."
            },
            {
              "step_number": 3,
              "title": "نعوض",
              "calculation": "\\(f'(x)=4(4x-1)(2x^2-x+3)^3\\)",
              "result": "الصيغة النهائية."
            }
          ],
          "final_conclusion": "\\(f'(x)=4(4x-1)(2x^2-x+3)^3\\).",
          "attention": "لا نحتاج إلى نشر القوة."
        }
      },
      {
        "id": "step_17",
        "type": "worked_example",
        "title": "مثال على جذر دالة",
        "content": {
          "statement": "احسب مشتقة \\(h(x)=\\sqrt{x^2-4}\\) على \\(]2,+\\infty[\\).",
          "steps": [
            {
              "step_number": 1,
              "title": "نحدد الداخل",
              "calculation": "\\(u(x)=x^2-4\\)",
              "result": "\\(u'(x)=2x\\)."
            },
            {
              "step_number": 2,
              "title": "نطبق قاعدة الجذر",
              "calculation": "\\(h'(x)=\\frac{2x}{2\\sqrt{x^2-4}}\\)",
              "result": "طبقنا u'/(2√u)."
            },
            {
              "step_number": 3,
              "title": "نبسط",
              "calculation": "\\(h'(x)=\\frac{x}{\\sqrt{x^2-4}}\\)",
              "result": "الصيغة النهائية."
            }
          ],
          "final_conclusion": "\\(h'(x)=\\frac{x}{\\sqrt{x^2-4}}\\) على \\(]2,+\\infty[\\).",
          "attention": "يجب أن يكون x²−4 موجبًا داخل مجال الاشتقاق."
        }
      },
      {
        "id": "step_18",
        "type": "method",
        "title": "كيف أختار قاعدة الاشتقاق؟",
        "content": {
          "method_goal": "تحليل بنية الدالة قبل الاشتقاق.",
          "algorithm": [
