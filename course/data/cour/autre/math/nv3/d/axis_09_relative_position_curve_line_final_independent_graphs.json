      {
        "id": "step_7",
        "type": "worked_example",
        "title": "مثال مع مستقيم أفقي",
        "content": {
          "statement": "لتكن \\(g(x)=x^2-4x+3\\). ادرس وضعية منحناها بالنسبة إلى المستقيم \\(\\Delta:y=-1\\).",
          "steps": [
            {
              "step_number": 1,
              "calculation": "\\(g(x)-(-1)=x^2-4x+4=(x-2)^2\\)",
              "result": "الفرق مربع، فهو موجب أو منعدم."
            },
            {
              "step_number": 2,
              "calculation": "\\((x-2)^2\\ge0\\) لكل \\(x\\in\\mathbb{R}\\)",
              "result": "المنحنى لا ينزل تحت المستقيم."
            },
            {
              "step_number": 3,
              "calculation": "\\((x-2)^2=0\\Longleftrightarrow x=2\\)",
              "result": "يلتقي المنحنى والمستقيم عند فاصلة واحدة."
            }
          ],
          "final_conclusion": "يكون منحنى \\(g\\) فوق المستقيم \\(y=-1\\) على \\(\\mathbb{R}\\)، ويلتقيه عند النقطة \\(A(2,-1)\\).",
          "geometric_note": "بما أن الفرق مربع وينعدم عند قيمة واحدة، فإن المستقيم يمس المنحنى في هذه النقطة."
        }
