              "condition": "\\(f(x)-(ax+b)<0\\)",
              "conclusion": "يكون المنحنى \\(C_f\\) تحت المستقيم \\(d\\)."
            },
            {
              "condition": "\\(f(x)-(ax+b)=0\\)",
              "conclusion": "يتقاطع المنحنى والمستقيم عند الفاصلة \\(x\\)."
            }
