    "learning_path": [
      {
        "id": "step_1",
        "type": "motivation",
        "title": "لماذا ندرس الدالة الداخلية أولًا؟",
        "content": {
          "teacher": "في الدالة المركبة لا يدخل \\(x\\) مباشرة في الدالة الخارجية، بل يمر أولًا عبر دالة داخلية. لذلك يجب معرفة إلى ماذا تؤول الدالة الداخلية قبل دراسة الدالة الخارجية.",
          "example": "في \\(\\sqrt{x^2+1}\\)، العبارة \\(x^2+1\\) هي الدالة الداخلية، والجذر التربيعي هو الدالة الخارجية.",
          "goal": "سنتعلم قراءة الدالة المركبة من الداخل إلى الخارج.",
          "attention": "لا تبدأ بحساب نهاية الدالة الخارجية قبل معرفة نهاية مدخلها."
        }
      },
      {
        "id": "step_2",
        "type": "definition",
        "title": "ما هي الدالة المركبة؟",
        "content": {
          "teacher": "إذا كانت \\(g\\) دالة داخلية و\\(f\\) دالة خارجية، فإن الدالة المركبة تكتب \\(f\\circ g\\) أو \\(f(g(x))\\).",
          "general_form": "\\((f\\circ g)(x)=f(g(x))\\).",
          "definitions": [
            {
              "name": "الدالة الداخلية",
              "symbol": "\\(g(x)\\)",
              "meaning": "الدالة التي تطبق أولًا على \\(x\\)."
            },
            {
              "name": "الدالة الخارجية",
              "symbol": "\\(f\\)",
              "meaning": "الدالة التي تطبق على النتيجة \\(g(x)\\)."
            }
          ],
          "example": "إذا كانت \\(g(x)=x^2+1\\) و\\(f(t)=\\sqrt{t}\\)، فإن \\(f(g(x))=\\sqrt{x^2+1}\\).",
          "memory_tip": "في التركيب نعمل من الداخل إلى الخارج.",
          "attention": "\\(f(g(x))\\) لا تساوي عادة \\(g(f(x))\\)."
        }
      },
      {
        "id": "step_3",
        "type": "rule",
        "title": "قاعدة نهاية الدالة المركبة",
        "content": {
          "teacher": "إذا كانت \\(g(x)\\) تؤول إلى \\(b\\)، وكانت نهاية \\(f(t)\\) عندما \\(t\\) يؤول إلى \\(b\\) تساوي \\(L\\)، فإن نهاية \\(f(g(x))\\) تساوي \\(L\\).",
          "rule": "\\(\\lim_{x\\to a}g(x)=b\\) و\\(\\lim_{t\\to b}f(t)=L\\Rightarrow\\lim_{x\\to a}f(g(x))=L\\).",
          "steps": [
            "نحسب \\(\\lim g(x)\\).",
            "نسمي النتيجة \\(b\\).",
            "نحسب أو نستعمل \\(\\lim_{t\\to b}f(t)\\).",
            "نستنتج نهاية \\(f(g(x))\\)."
          ],
          "attention": "يجب أن تكون الدالة المركبة معرفة قرب القيمة المدروسة."
        }
      },
      {
        "id": "step_4",
        "type": "method",
