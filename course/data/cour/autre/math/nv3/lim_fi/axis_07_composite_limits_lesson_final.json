            },
            {
              "step_number": 3,
              "instruction": "تحقق أن القيمة الناتجة مناسبة لمجال الدالة الخارجية."
            },
            {
              "step_number": 4,
              "instruction": "استعمل نهاية الدالة الخارجية عند القيمة الناتجة."
            },
            {
              "step_number": 5,
              "instruction": "اكتب النتيجة النهائية."
            }
          ],
          "conclusion_template": "بما أن \\(g(x)\\to b\\) وعندما \\(t\\to b\\) فإن \\(f(t)\\to L\\)، نستنتج أن \\(f(g(x))\\to L\\).",
          "attention": "لا تعوض في الدالة الخارجية قبل إيجاد نهاية الداخل."
