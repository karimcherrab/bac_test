    "notes": [
      "بُني الملف لشعبة علوم تجريبية فقط.",
      "تم الاعتماد على درس محور المرجعيات الأساسية في النهايات وعلى ملفات بكالوريا علوم تجريبية 2008 و2009 و2014 المرسلة.",
      "تم إبقاء الأفكار سطحية ومباشرة ومناسبة لتوليد اختبار المحور، دون التوسع في تقنيات حالات عدم التعيين أو المقاربات كموضوع مستقل.",
      "ملف تقني رياضي 2008 لم يُدخل في إحصاءات أو BAC Ideas لأنه خارج الشعبة المطلوبة."
    ]
  },
  "lesson_scope": {
    "learning_outcomes": [
      "يفهم أن النهاية تصف سلوك قيم الدالة ولا تمثل دائمًا قيمة الدالة في النقطة.",
      "يقرأ الرمز \\(\\lim_{x\\to a}f(x)=L\\) ويشرح معنى كل رمز فيه.",
      "يميز بين النهاية عند عدد حقيقي والنهاية عند \\(+\\infty\\) أو \\(-\\infty\\).",
      "يميز بين الاقتراب من اليمين والاقتراب من اليسار.",
      "يتعرف على النهايات المرجعية للدوال \\(x\\)، \\(x^2\\)، \\(x^3\\)، \\(|x|\\)، \\(\\sqrt{x}\\) و\\(\\frac{1}{x}\\).",
      "يحدد إشارة \\(\\frac{1}{x}\\) قرب الصفر وعند المالانهاية.",
      "يختار المرجعية المناسبة ويكتب النتيجة بصورة صحيحة."
    ],
    "concepts": [
      "معنى النهاية ورمزها.",
      "النهاية عند عدد حقيقي وعند +∞ و-∞.",
      "النهاية اليمنى واليسرى.",
      "النهايات المرجعية لـ x وx² وx³ و|x| و√x و1/x.",
      "إشارة 1/x قرب الصفر وعند المالانهاية.",
      "اختيار المرجعية المناسبة.",
      "التعرف البسيط على حالة ∞-∞ عندما تظهر في تطبيق مباشر."
    ],
    "methods": [
      "قراءة موضع وجهة الاقتراب.",
      "تحديد نهاية كل جزء من عبارة بسيطة.",
      "استعمال المرجعيات الأساسية.",
      "تحديد 0⁺ أو 0⁻ قبل استنتاج نهاية كسر قرب قيمة ممنوعة.",
      "استعمال أعلى قوة في كثيرة الحدود عند المالانهاية.",
      "التصريح بحالة ∞-∞ ورفعها بإخراج أعلى قوة عندما يكون ذلك مباشرًا."
    ],
    "prerequisites": [
      "معرفة مجموعة تعريف دالة بسيطة.",
      "معرفة معنى القيمة المطلقة والجذر التربيعي.",
      "التمييز بين عدد موجب وعدد سالب.",
      "قراءة تمثيل بياني بسيط لدالة."
    ],
    "excluded_topics": [
      "الاشتقاق ودراسة اتجاه التغير.",
      "الاستمرارية كمهارة مستقلة.",
      "إنشاء جدول التغيرات.",
      "حساب أو إثبات المقارب الأفقي أو المائل كهدف مستقل.",
      "حالات عدم التعيين المعقدة وتقنيات رفعها.",
      "قاعدة لوبيتال.",
      "التطويرات المحدودة."
    ]
  },
