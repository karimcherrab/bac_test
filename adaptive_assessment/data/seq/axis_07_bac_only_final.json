    "notes": [
      "هذا الملف مخصص لاختبار أفكار البكالوريا فقط في محور نهاية المتتالية والتقارب والتباعد.",
      "skills موجودة كمصفوفة فارغة لمنع ظهور أفكار شرح المحور في الاختبار.",
      "bac_ideas محصورة حصريا في SEQ_BAC_49 إلى SEQ_BAC_57.",
      "تم الفصل تربويا بين إثبات وجود النهاية (SEQ_BAC_49) وبين حسابها من حد عام صريح (SEQ_BAC_50) وبين تعيينها من علاقة تراجعية بعد إثبات التقارب (SEQ_BAC_51).",
      "بعض الأفكار تعتمد على نتائج محاور سابقة مثل الرتابة والحصر والمتتالية الهندسية، لكنها هنا تصنف حسب الهدف النهائي في سؤال البكالوريا: التقارب أو النهاية."
    ]
  },
  "lesson_scope": {
    "learning_outcomes": [
      "إتقان أفكار البكالوريا التسع المرتبطة بالتقارب والتباعد وحساب نهايات المتتاليات."
    ],
    "concepts": [
      "التقارب الرتيب.",
      "النهاية من حد عام صريح.",
      "معادلة نقطة التثبيت L=f(L).",
      "حصر الخطأ هندسيا.",
      "مبرهنة الحصر.",
      "التقارب المتذبذب.",
      "التقارب حسب وسيط.",
      "نهاية q^n حسب q.",
      "نهاية متتالية المجاميع S_n."
    ],
    "methods": [
      "رتيبة + محدودة ⇒ متقاربة.",
      "حساب النهاية من الصيغة الصريحة.",
      "تمرير النهاية في العلاقة التراجعية بعد إثبات التقارب.",
      "استعمال |u_n-L|≤Cq^n.",
      "استعمال مبرهنة الحصر.",
      "تحليل |q|.",
      "حساب نهاية S_n بعد إيجاد عبارته."
    ],
    "prerequisites": [],
    "excluded_topics": [
      "أي فكرة درس عامة لم تظهر ضمن أفكار BAC المحددة.",
      "التخمين البياني كهدف مستقل.",
      "الرتابة والحصر كهدف نهائي مستقلين.",
      "أي فكرة خارج SEQ_BAC_49 إلى SEQ_BAC_57."
    ]
  },
