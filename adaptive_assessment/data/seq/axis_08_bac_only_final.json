    "notes": [
      "هذا الملف مخصص لاختبار أفكار البكالوريا فقط في محور المتتالية المحدودة.",
      "skills موجودة كمصفوفة فارغة لمنع ظهور أفكار شرح المحور في الاختبار.",
      "bac_ideas محصورة حصريا في SEQ_BAC_58 إلى SEQ_BAC_64.",
      "هذا المحور يعمل غالبا كجسر نحو الرتابة والتقارب: الحصر يثبت أولا، ثم يُستعمل لاحقا لإثبات اتجاه التغير أو اختيار النهاية."
    ]
  },
  "lesson_scope": {
    "learning_outcomes": [
      "إتقان أفكار البكالوريا السبع المرتبطة بالحصر والتحديد وتوظيفهما في دراسة المتتالية."
    ],
    "concepts": [
      "الحصر من جهتين.",
      "التحديد من الأعلى.",
      "التحديد من الأسفل.",
      "إيجابية تعبير لضمان التعريف.",
      "استقرار المجال f(I)⊂I.",
      "اختيار النهاية باستعمال الحصر.",
      "الحصر حول نقطة التثبيت."
    ],
    "methods": [
      "إثبات a<u_n<b.",
      "إثبات u_n≤M أو u_n≥m.",
      "إثبات شروط تعريف اللوغاريتم أو المقلوب.",
      "إثبات f(I)⊂I ثم التراجع.",
      "استعمال الحصر لاختيار جذر معادلة النهاية.",
      "استعمال الحصر في دراسة الرتابة."
    ],
    "prerequisites": [],
    "excluded_topics": [
